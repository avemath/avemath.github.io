---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MarginNote from '@/components/MarginNote.astro';
import RayTracer from '@/components/research/RayTracer.astro';
import MeshPlayground from '@/components/playground/MeshPlayground.astro';
import PoolSide from '@/components/drawings/PoolSide.astro';
import SoundRace from '@/components/research/SoundRace.astro';
import PoolPing from '@/components/research/PoolPing.astro';
import Seafloor from '@/components/research/Seafloor.astro';
import arrivalsData from '@/data/bellhop-arrivals.json';

// Fig. R3 (BELLHOP arrivals view): every arrival from the bellhopSim comms scenario (1000 m of water, sand bottom, source
// at 50 m, receiver 15 km away at 100 m, 3.5 kHz), recomputed with BELLHOP using the repo's own
// export settings. The counts match docs/figures/figures.json in that repo.
const ch = arrivalsData.comms;
const DB_FLOOR = -40;
const maxDelay = Math.ceil(Math.max(...ch.arrivals.map((a) => a.delay_ms)) / 500) * 500;
// Margins sized for 17-unit labels: the last delay tick fits inside the right edge, and the axis
// names sit clear of the tick numbers.
const R2 = { x0: 58, x1: 566, y0: 40, y1: 184 };
const ax = (ms: number) => R2.x0 + (ms / maxDelay) * (R2.x1 - R2.x0);
const ay = (db: number) => R2.y1 - ((Math.max(DB_FLOOR, db) - DB_FLOOR) / -DB_FLOOR) * (R2.y1 - R2.y0);
const bars = ch.arrivals.map((a) => ({ x: ax(a.delay_ms), y: ay(a.db), strongest: a.db === 0, inside: a.db >= -20 }));
const windowMs = ch.spread_within_20db_ms;
const firstStrong = Math.min(...ch.arrivals.filter((a) => a.db >= -20).map((a) => a.delay_ms));
const delayTicks = Array.from({ length: maxDelay / 500 + 1 }, (_, i) => i * 500);

// Fig. R1: an illustration of the kind of network the project is about. Positions are drawing
// coordinates, not data.
const nodes = [
  { id: 'ship', label: 'ship', x: 16, y: 22, text: 'Surface ship: radio links through the air, acoustic links down into the water.' },
  { id: 'buoy', label: 'buoy', x: 62, y: 16, text: 'Buoy: sits at the surface, so it can pass messages between radio above and acoustic below.' },
  { id: 'auv', label: 'AUV', x: 44, y: 58, text: 'AUV: underwater, so its only link is acoustic. Slow, delayed by seconds, and easy to lose.' },
  { id: 'sensor', label: 'sensor', x: 80, y: 72, text: 'Sensor: collects data all day and can send only a little of it.' },
];
const links = [
  { a: 'ship', b: 'buoy', kind: 'radio' },
  { a: 'ship', b: 'auv', kind: 'acoustic' },
  { a: 'auv', b: 'sensor', kind: 'acoustic' },
  { a: 'buoy', b: 'sensor', kind: 'acoustic' },
];
const at = (id: string) => nodes.find((n) => n.id === id)!;
---

<BaseLayout
  bitGirl
  title="Research"
  description="Underwater acoustic channels, my ONR research on data management for distributed naval platforms, bellhopSim, and an acoustic pool alarm."
  image="/og/research.png"
  footer="research"
>
  <div class="rs">
    <Seafloor />
    <p class="rgauge" data-depth-gauge hidden aria-hidden="true"><span class="rgauge__k">depth</span><b data-depth-read>0 m</b></p>
    <div class="rs__content">
    <section id="below" class="wrap rpanel" style="--dp:4%" data-rpanel data-depth-panel data-perch="below" data-perch-x="0.9 0.12" aria-labelledby="research-title">
      <p class="rpanel__tag" data-depth-tag hidden aria-hidden="true"></p>
      <div class="rp">
        <div class="rp__fig">
          <figure class="rfig plate">
            <div class="fig__bar">
              <p class="fig__label">Why sound</p>
              <p class="fig__label">radio vs sound, above and below the water</p>
            </div>
            <SoundRace />
            <figcaption class="plate__cap"><b>Fig. R0.</b> The same message four ways. In air, radio wins outright. In seawater, radio is soaked up within meters (worse the higher the frequency), and sound, slower but nearly lossless, is what gets through.</figcaption>
          </figure>
        </div>
        <div class="rp__text">
          <h1 id="research-title" class="research__h1">Research, below the <em>surface</em>.</h1>
          <p class="zone-r__text">
            Underwater acoustic channels do everything a radio channel does, slower and worse: long delays, strong multipath, Doppler from
            anything that moves. I work on getting data through them anyway, and on one question of my own about what a pool sounds like.
          </p>
          <p class="rs__cap">
            <b>On a ledge above the deep.</b> Scroll down and the water darkens with depth, from the murky green shallows to the glow at the
            bottom. The little blue crabs on the ledges are for my grandfathers.
          </p>
          <p
            class="hand rs__look"
            tabindex="0"
            role="img"
            aria-label="The seafloor behind this page. Use the left and right arrow keys to look around, and up and down to look up and down."
            data-sea-keys
          >
            drag the water to look around, or focus here and use the arrow keys ♡
          </p>
          <MarginNote where="below" />
        </div>
      </div>
    </section>

    <section id="onr" class="wrap rpanel" style="--dp:28%" data-rpanel data-depth-panel data-perch="onr" data-perch-x="0.9 0.12" aria-labelledby="onr-title">
      <p class="rpanel__tag" data-depth-tag hidden aria-hidden="true"></p>
      <div class="rp">
        <div class="rp__fig">
          <figure class="rfig plate" data-perch="net" data-perch-x="0.85">
            <div class="fig__bar">
              <p class="fig__label">Platform network</p>
              <p class="fig__label">hover a node</p>
            </div>
            <div class="net" data-net data-draw>
              <svg viewBox="0 0 100 90" preserveAspectRatio="none" class="net__links" aria-hidden="true">
                {links.map((l) => <line x1={at(l.a).x} y1={at(l.a).y} x2={at(l.b).x} y2={at(l.b).y} class={`net__link net__link--${l.kind}`} data-a={l.a} data-b={l.b} />)}
              </svg>
              {
                nodes.map((n) => (
                  <button type="button" class="net__node" style={`left:${n.x}%;top:${(n.y / 90) * 100}%`} data-node={n.id} aria-describedby="net-read">
                    {n.label}
                  </button>
                ))
              }
              <p class="net__read" id="net-read" data-net-read aria-live="polite">Hover or focus a node.</p>
              <script type="application/json" data-net-nodes set:html={JSON.stringify(nodes.map(({ id, text }) => ({ id, text })))} />
            </div>
            <figcaption class="plate__cap">
              <b>Fig. R1.</b> A drawing of the kind of network the project is about, not project data. Solid lines are radio, green lines
              acoustic. The dots are messages: quick along the radio links, slow along the acoustic ones.
              <span class="fig__try"><span class="on-mouse">Hover</span><span class="on-touch">Tap</span> a node to see how it links to the others.</span>
            </figcaption>
          </figure>
        </div>
        <div class="rp__text">
          <h2 id="onr-title" class="research__h2" data-decode>Intelligent data management for distributed naval&nbsp;platforms</h2>
          <p class="zone-r__text">
            ONR funded, with Integer Technologies. In the words of the public contract announcement, the project is “the development of
            decision-making tools for data management on board distributed naval platforms.” Thesis track, expected May 2028.
          </p>
          <p class="zone-r__small">Advisor: Dr. Shuangqing Wei, LSU.</p>
          <p class="zone-r__small">Details are limited to what the project has published.</p>
          <p class="zone-r__links">
            <a class="link" href="/work/onr-intelligent-data-management/">What I can share</a>
            <a class="link" href="https://lsu.edu/eng/news/2024/09/lsu-integer-partner-to-optimize-navy-and-marine-corps-operations.php">The public announcement</a>
          </p>
          <MarginNote where="onr" />
        </div>
      </div>
    </section>

    <section id="signals" class="wrap rpanel" style="--dp:50%" data-rpanel data-depth-panel data-perch="signals" data-perch-x="0.9 0.12" aria-labelledby="signals-title">
      {/* TODO(ave): check wording. This panel is new on /research/ (Nov 9); its text is from the Signals playground write-up and the home card. */}
      <p class="rpanel__tag" data-depth-tag hidden aria-hidden="true"></p>
      <div class="rp">
        <div class="rp__fig">
          <figure class="rfig plate">
            <div class="fig__bar">
              <p class="fig__label">A packet through the water</p>
              <p class="fig__label">FH-BFSK, live</p>
            </div>
            <MeshPlayground compact />
            <figcaption class="plate__cap">
              <b>Fig. R2.</b> One message as a JANUS style FH-BFSK packet: close ripples for a 1, wide ones for a 0, each bit a 6.25 ms chip
              hopping between 13 tone pairs. The modem math runs in your browser.
            </figcaption>
          </figure>
        </div>
        <div class="rp__text">
          <h2 id="signals-title" class="research__h2" data-decode>Getting bits through</h2>
          <p class="zone-r__text">
            I learn by building. The first tool I made while studying was a page for frequency-hopping BFSK, the modulation the JANUS underwater
            acoustic standard uses. Send a packet and watch it cross the water: each bit is one 6.25 ms chip that hops between 13 tone pairs,
            and a real detector decodes it on the far side.
          </p>
          <div class="zone-r__actions">
            <a class="btn" href="/work/signals-playground/#playground">The full playground</a>
            <a class="link" href="/work/signals-playground/">Case study</a>
          </div>
          <MarginNote where="signals" />
        </div>
      </div>
    </section>

    <section id="bellhop" class="wrap rpanel" style="--dp:70%" data-rpanel data-depth-panel data-perch="bellhop" data-perch-x="0.9 0.12" aria-labelledby="bellhop-title">
      <p class="rpanel__tag" data-depth-tag hidden aria-hidden="true"></p>
      <div class="rp">
        <div class="rp__fig">
          <figure class="rfig plate">
            <div class="fig__bar">
              <p class="fig__label">The sound channel</p>
              <div class="tabset" role="tablist" aria-label="Sound channel: views" data-tabs>
                <button type="button" role="tab" id="r3-tab-rays" aria-controls="r3-rays" aria-selected="true" tabindex="0">Ray tracer</button>
                <button type="button" role="tab" id="r3-tab-arr" aria-controls="r3-arr" aria-selected="false" tabindex="-1">BELLHOP arrivals</button>
              </div>
            </div>
            <div id="r3-rays" role="tabpanel" aria-labelledby="r3-tab-rays">
              <RayTracer />
              <p class="fig__note">Traced in your browser through bellhopSim's sound speed profiles, with BELLHOP's ray equations. Ping sends a pulse along every ray at the local speed of sound; the bold rays are the eigenrays that reach the receiver. There is no bottom loss here, so paths that BELLHOP would let the seabed absorb still show.</p>
            </div>
            <div id="r3-arr" role="tabpanel" aria-labelledby="r3-tab-arr" hidden>
              <div class="arr-row">
                <div class="arr-row__plot" role="group" aria-label="Arrivals chart: use the arrow keys to step through the arrivals" tabindex="0" aria-describedby="arr-read" data-arr-plot>
                  <div class="rfig__plot" data-draw data-hscroll="Arrivals plot">
                    <svg viewBox="0 0 600 230" class="arr" style="--fig-w:600px" role="img" aria-label={`${ch.arrivals.length} arrivals of one ping at 15 km over ${(ch.delay_spread_ms / 1000).toFixed(1)} seconds. ${ch.n_within_20db} are within 20 dB of the strongest, spread over ${Math.round(windowMs)} ms.`}>
                      <rect class="arr__win" x={ax(firstStrong)} y={R2.y0 - 6} width={ax(firstStrong + windowMs) - ax(firstStrong)} height={R2.y1 - R2.y0 + 6} />
                      <text class="arr__lab" x={ax(firstStrong) + 6} y={R2.y0 - 14}>20 dB window: {Math.round(windowMs)} ms</text>
                      {[0, -10, -20, -30, -40].map((d) => <text class="arr__tick" x={R2.x0 - 10} y={ay(d) + 5} text-anchor="end">{d}</text>)}
                      <line class="arr__axis" x1={R2.x0} y1={R2.y1} x2={R2.x1} y2={R2.y1} />
                      {bars.map((b) => <line class:list={['arr__bar', b.inside && 'arr__bar--in', b.strongest && 'arr__bar--top']} x1={b.x} x2={b.x} y1={R2.y1} y2={b.y} />)}
                      {bars.map((b, i) => <rect class="arr__hit" x={b.x - 4} y={R2.y0 - 6} width="8" height={R2.y1 - R2.y0 + 6} data-arr={i} />)}
                      {delayTicks.map((t) => <text class="arr__tick" x={ax(t)} y={R2.y1 + 20} text-anchor="middle">{t}</text>)}
                      <text class="arr__tick" x={R2.x1} y={R2.y1 + 40} text-anchor="end">delay, ms</text>
                      <text class="arr__tick" x={R2.x0 - 10} y={R2.y0 - 22} text-anchor="end">dB</text>
                    </svg>
                  </div>
                </div>
                <div class="arr-sketch">
                  <svg viewBox="0 0 220 150" class="arr-sketch__svg" aria-hidden="true">
                    <path class="arr-sketch__wall" d="M10 18H210M10 132H210" />
                    <text class="arr-sketch__t" x="12" y="13">surface</text>
                    <text class="arr-sketch__t" x="12" y="146">bottom</text>
                    <path class="arr-sketch__path" d="" data-arr-path />
                    <rect class="arr-sketch__src" x="20" y="34" width="8" height="8" />
                    <rect class="arr-sketch__rx" x="192" y="40" width="8" height="8" />
                  </svg>
                  <p class="arr-sketch__read mono" id="arr-read" aria-live="polite" data-arr-read>Hover an arrival, or focus the chart and use the arrow keys.</p>
                </div>
              </div>
              <script type="application/json" data-arr-data set:html={JSON.stringify(ch.arrivals)} />
              <p class="fig__note">
                {ch.arrivals.length} arrivals from BELLHOP itself: 1000 m of water, source at 50 m, receiver 15 km out at 100 m, 3.5 kHz, sandy
                bottom. The strongest is in green; {ch.n_within_20db} fall within 20 dB of it.
              </p>
            </div>
            <figcaption class="plate__cap">
              <b>Fig. R3.</b> Sound bends toward the slow water. Rays and eigenrays in the browser, and the real arrivals BELLHOP computed for
              bellhopSim's comms scenario.
            </figcaption>
          </figure>
        </div>
        <div class="rp__text">
          <h2 id="bellhop-title" class="research__h2" data-decode>bellhopSim</h2>
          <p class="zone-r__text">
            An interactive Python simulator around BELLHOP (a standard model of how sound travels underwater), built around the Munk deep-ocean case: eigenrays (the paths sound takes from source to receiver), arrival structure, delay spread within 20 dB of the
            strongest arrival, and a BER sweep. While documenting it I found three physics bugs (range units, bottom density units, the BER
            model) and fixed them with regression tests.
          </p>
          <div class="zone-r__actions">
            <a class="btn" href="/work/bellhop-sim/">Figures and fixes</a>
            <a class="link" href="https://github.com/avemath/bellhopSim">Code</a>
          </div>
          <MarginNote where="bellhop" />
        </div>
      </div>
    </section>

    <section id="pool-alarm" class="wrap rpanel" style="--dp:96%" data-rpanel data-depth-panel data-perch="pool-alarm" data-perch-x="0.9 0.12" aria-labelledby="pool-title">
      {/* NAME: working title until Avery picks one. Update the title here and in acoustic-pool-alarm.md then, and delete this comment. */}
      <p class="rpanel__tag" data-depth-tag hidden aria-hidden="true"></p>
      <div class="rp">
        <div class="rp__fig">
          <figure class="rfig plate rfig--pool">
            <div class="fig__bar">
              <p class="fig__label">Pool, side view</p>
              <div class="tabset" role="tablist" aria-label="Pool alarm: views" data-tabs>
                <button type="button" role="tab" id="r3-tab-concept" aria-controls="r3-concept" aria-selected="true" tabindex="0">Concept</button>
                <button type="button" role="tab" id="r3-tab-drawing" aria-controls="r3-drawing" aria-selected="false" tabindex="-1">Drawing</button>
              </div>
            </div>
            <div id="r3-concept" role="tabpanel" aria-labelledby="r3-tab-concept">
              <PoolPing />
            </div>
            <div id="r3-drawing" role="tabpanel" aria-labelledby="r3-tab-drawing" hidden>
              <PoolSide />
            </div>
            <figcaption class="plate__cap"><b>Fig. R4.</b> A concept drawing of the idea, not results: nothing here is measured yet.</figcaption>
          </figure>
        </div>
        <div class="rp__text">
          <h2 id="pool-title" class="research__h2">Acoustic Pool Alarm <span class="research__wt">(working title)</span></h2>
          <p class="zone-r__text">
            My own project. Can listening underwater in a home pool tell the difference between a kid swimming and a kid in
            trouble, fast enough to matter? Right now: reviewing prior work and ASTM F2208, the standard for residential pool alarms, and
            planning the first bench tests.
          </p>
          <div class="zone-r__actions">
            <a class="btn btn--line-accent" href="/work/acoustic-pool-alarm/">Follow along</a>
            <a class="link" href="/work/because-of-adam/">Because of ADAM</a>
          </div>
          <MarginNote where="pool-alarm" />
        </div>
      </div>
    </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* One continuous scene: the water behind everything (Seafloor.astro), and the work in solid sheet
     panels on top, with open water between them to look into and drag. */
  .rs {
    position: relative;
    isolation: isolate;
  }

  .rs__content {
    position: relative;
    z-index: 1;
    padding-block: clamp(1.25rem, 3vw, 2rem) clamp(4rem, 30vh, 16rem);
    touch-action: pan-y;
  }

  :global(html[data-sea-drag]) .rs__content {
    cursor: grabbing;
    user-select: none;
  }

  /* Glass sheets over the fixed scene. Each panel's tint follows its depth (--dp, 0% at the top of
     the dive, 100% at the bottom): lighter teal-green near the surface, darker and bluer deeper, at
     90% opacity with the water blurred behind it. A double hairline plate border, and a mono depth
     tag in the top corner that matches the gauge. Muted text inside is darkened (light) or lifted
     (dark) to keep 4.5:1 over the darkest water. */
  .rpanel {
    --muted: #46534d;
    --rp-top: #e4f0e8;
    --rp-deep: #d2dde6;
    position: relative;
    padding: clamp(1.5rem, 3vw, 2.75rem);
    background: color-mix(in srgb, color-mix(in srgb, var(--rp-deep) var(--dp, 0%), var(--rp-top)) 90%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid var(--rule);
    box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.55);
  }

  .rpanel::before {
    content: '';
    position: absolute;
    inset: 7px;
    border: 1px solid var(--rule);
    pointer-events: none;
  }

  :global([data-theme='dark']) .rpanel {
    --muted: #a3b6ac;
    --rp-top: #1b302a;
    --rp-deep: #0f1a25;
  }

  /* Real gaps between panels, so the scene shows through on the way down. */
  .rpanel + .rpanel {
    margin-top: clamp(12rem, 40vh, 28rem);
  }

  .rpanel__tag {
    position: absolute;
    top: 14px;
    right: 18px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  /* The depth gauge: fixed at the right edge from 1024px, the same reading as the panels' tags. */
  .rgauge {
    position: fixed;
    right: max(0.75rem, calc((100vw - var(--wrap-max, 1800px)) / 2 - 6rem));
    top: 50%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
    margin: 0;
    padding: 0.4rem 0.6rem;
    border: 1px solid rgb(230 239 234 / 0.35);
    background: rgb(8 20 18 / 0.55);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: #e6efea;
    font-family: var(--font-mono);
    translate: 0 -50%;
    pointer-events: none;
  }

  .rgauge__k {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #b9cbc2;
  }

  .rgauge b {
    font-size: 1rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 1023px) {
    .rgauge {
      display: none;
    }
  }

  .rs__cap {
    margin-top: 1rem;
    max-width: 40em;
    color: var(--text-soft);
  }

  .rs__cap b {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
  }

  .rs__look {
    display: inline-block;
    margin-top: 0.9rem;
    font-size: 1.0625rem;
    cursor: grab;
  }

  .rs__look:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }

  :global(html:not([data-sea-live])) .rs__look {
    display: none;
  }

  /* The plate: figure on the left (7 of 12 columns), text on the right, from 1024px. Below that the
     figure stacks above the text. No column is ever empty. */
  .rp {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.75rem);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .rp {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }

  .rp__fig,
  .rp__text {
    min-width: 0;
  }

  /* The "Try" hint inside a caption: its own line, no rule above it. */
  .plate__cap .fig__try {
    display: block;
    margin-top: 0.35rem;
    padding: 0;
    border-top: 0;
  }

  .rp__text > :first-child {
    margin-top: 0;
  }

  .rp__text :global(.mnote) {
    margin-top: 1.75rem;
  }

  .research__h1 {
    font-size: clamp(2.75rem, 7vw, 5rem);
  }

  .research__h2 {
    margin-top: 0.75rem;
    font-size: clamp(2.1rem, 4.4vw, 3.25rem);
  }

  .research__wt {
    font-size: 0.45em;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--muted);
  }

  .zone-r__text {
    margin-top: 1.25rem;
    max-width: 28em;
    color: var(--text-soft);
  }

  .zone-r__small {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--text-soft);
  }

  .zone-r__links,
  .zone-r__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.5rem;
  }

  .zone-r__links {
    margin-top: 1rem;
    font-size: 0.9375rem;
  }

  /* ---- Figures on dark water ---- */
  .rfig {
    margin: 0;
    min-width: 0;
  }

  /* The pool drawing sits in a narrow column at about 0.72 of its viewBox; 18 units read as 13px. */
  .rfig--pool :global(.dw__svg .t),
  .rfig--pool :global(.dw__svg .t--mono) {
    font-size: 18px;
  }

  .rfig__plot {
    padding: 0.75rem;
  }

  .rfig__cap {
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: 0.875rem;
    color: var(--text-soft);
  }

  .rays,
  .arr,
  .pool {
    width: 100%;
    height: auto;
  }

  .rays__surface {
    stroke: var(--line-strong);
  }

  .rays__bottom {
    stroke: var(--line);
    stroke-dasharray: 3 4;
  }

  .rays__ray {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
  }

  .rays__ray--soft {
    stroke-opacity: 0.55;
    stroke-width: 1;
  }

  .rays__src {
    fill: var(--accent);
  }

  .rays__rx {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.5;
  }

  /* R1: nodes are buttons, so they take focus in order and work by keyboard. */
  .net {
    position: relative;
    aspect-ratio: 10 / 8;
    margin: 0.75rem;
  }

  .net__links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .net__link {
    stroke: var(--line-strong);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .net__link--acoustic {
    stroke: var(--accent);
    stroke-opacity: 0.6;
  }

  .net__link[data-hot] {
    stroke-width: 2.5;
    stroke-opacity: 1;
  }

  .net__node {
    position: absolute;
    z-index: 2;
    translate: -50% -50%;
    min-width: 4.5rem;
    min-height: 2.5rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--text);
    background: var(--surface);
    font-size: 0.875rem;
    color: var(--text);
    cursor: pointer;
  }

  .net__node[aria-pressed='true'],
  .net__node:hover {
    border: 2px solid var(--accent);
    color: var(--accent-ink);
  }

  .net__read {
    position: absolute;
    left: 0;
    bottom: 0;
    max-width: 16rem;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--line-strong);
    background: var(--paper);
    color: var(--text);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  /* R2 */
  .arr__win {
    fill: var(--accent-wash);
  }

  /* The plot draws at about 0.78 of its viewBox on desktop, so 17 units read as 13px. */
  .arr__lab {
    font-family: var(--font-mono);
    font-size: 17px;
    fill: var(--text-soft);
  }

  .arr__tick {
    font-family: var(--font-mono);
    font-size: 17px;
    fill: var(--muted);
  }

  .arr__axis {
    stroke: var(--line-strong);
  }

  .arr__bar {
    stroke: var(--line-strong);
    stroke-width: 2;
  }

  .arr__bar--in {
    stroke: var(--text);
    stroke-width: 3;
  }

  .arr__bar--top {
    stroke: var(--accent);
    stroke-width: 4;
  }

</style>

<style>
  /* R2: the arrivals chart with the path sketch beside it. */
  .arr-row {
    display: grid;
    gap: 0.75rem;
    align-items: center;
  }

  /* The sketch sits beside the chart only when the figure itself is wide enough. */
  .rfig {
    container-type: inline-size;
  }

  @container (min-width: 760px) {
    .arr-row {
      grid-template-columns: minmax(0, 3fr) minmax(10rem, 1fr);
    }
  }

  .arr-row > * {
    min-width: 0;
  }

  .arr-row__plot:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: -2px;
  }

  .arr__hit {
    fill: transparent;
    cursor: pointer;
  }

  .arr__bar--pick {
    stroke: var(--rose) !important;
    stroke-width: 4 !important;
  }

  .arr-sketch {
    padding: 0 0.75rem 0.5rem;
  }

  .arr-sketch__svg {
    display: block;
    width: 100%;
    max-width: 16rem;
    height: auto;
  }

  .arr-sketch__wall {
    stroke: var(--line-strong);
    stroke-width: 1.5;
  }

  .arr-sketch__path {
    fill: none;
    stroke: var(--rose);
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .arr-sketch__src,
  .arr-sketch__rx {
    fill: var(--text);
  }

  .arr-sketch__t {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--muted);
  }

  .arr-sketch__read {
    margin-top: 0.35rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--text-soft);
  }

  /* R1: messages moving along the links. */
  .net :global(.net__msg) {
    position: absolute;
    z-index: 1;
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    border-radius: 50%;
    pointer-events: none;
  }

  .net :global(.net__msg--radio) {
    background: var(--text);
  }

  .net :global(.net__msg--acoustic) {
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent);
  }
</style>

<script>
  import { prefersReducedMotion } from '../scripts/preferences';

  // Depth: the dive is the 0 to 5000 m water column the figures use, spread over the page's scroll.
  // The gauge reads the depth now; each panel's tag reads what the gauge shows when that panel is
  // centered on screen. One function for both, so they agree.
  {
    const DIVE = 5000;
    const gauge = document.querySelector<HTMLElement>('[data-depth-gauge]');
    const read = document.querySelector<HTMLElement>('[data-depth-read]');
    const panels = [...document.querySelectorAll<HTMLElement>('[data-depth-panel]')];
    const maxScroll = () => Math.max(1, document.documentElement.scrollHeight - innerHeight);
    const depthAt = (y: number) => Math.round((DIVE * Math.min(1, Math.max(0, y / maxScroll()))) / 10) * 10;
    const fmt = (m: number) => (m ? `-${m} m` : '0 m');
    const tags = () => {
      for (const p of panels) {
        const tag = p.querySelector<HTMLElement>('[data-depth-tag]');
        if (!tag) continue;
        const r = p.getBoundingClientRect();
        const centered = scrollY + r.top + r.height / 2 - innerHeight / 2;
        tag.textContent = fmt(depthAt(centered));
        tag.dataset.depth = String(depthAt(centered));
        tag.hidden = false;
      }
    };
    const now = () => {
      if (read) read.textContent = fmt(depthAt(scrollY));
      if (gauge) {
        gauge.dataset.depth = String(depthAt(scrollY));
        gauge.hidden = false;
      }
    };
    tags();
    now();
    addEventListener('scroll', now, { passive: true });
    new ResizeObserver(() => {
      tags();
      now();
    }).observe(document.body);
  }

  // R2: point at an arrival (hover, tap, or the arrow keys on the focused chart) to see its path:
  // the surface and bottom bounce counts come straight from the BELLHOP arrivals data.
  const plot = document.querySelector<HTMLElement>('[data-arr-plot]');
  if (plot) {
    const arrivals: { delay_ms: number; db: number; surface: number; bottom: number }[] = JSON.parse(document.querySelector('[data-arr-data]')!.textContent!);
    const bars = [...plot.querySelectorAll<SVGLineElement>('.arr__bar')];
    const path = document.querySelector<SVGPathElement>('[data-arr-path]')!;
    const read = document.querySelector<HTMLElement>('[data-arr-read]')!;
    const kind = (s: number, b: number) => (s === 0 && b === 0 ? 'direct' : b === 0 ? 'surface bounce' : s === 0 ? 'bottom bounce' : 'surface and bottom bounces');
    // The sketch: from the source to the receiver, touching the surface and the bottom in turn as
    // many times as the arrival did.
    const sketch = (s: number, b: number) => {
      const src = [24, 38];
      const rx = [196, 44];
      const n = s + b;
      const pts = [src];
      let ns = s;
      let nb = b;
      // Alternate, starting with the boundary that has more bounces left.
      let top = s >= b;
      for (let k = 0; k < n; k++) {
        if ((top && ns > 0) || nb === 0) {
          pts.push([24 + ((k + 1) * 172) / (n + 1), 18]);
          ns--;
          top = false;
        } else {
          pts.push([24 + ((k + 1) * 172) / (n + 1), 132]);
          nb--;
          top = true;
        }
      }
      pts.push(rx);
      return 'M' + pts.map((p) => p.map((v) => v.toFixed(1)).join(' ')).join('L');
    };
    let at = -1;
    const pick = (i: number) => {
      at = Math.max(0, Math.min(arrivals.length - 1, i));
      const a = arrivals[at];
      bars.forEach((b, k) => b.classList.toggle('arr__bar--pick', k === at));
      path.setAttribute('d', sketch(a.surface, a.bottom));
      read.textContent = `Arrival ${at + 1} of ${arrivals.length}: ${a.delay_ms.toFixed(1)} ms, ${a.db.toFixed(1)} dB, ${kind(a.surface, a.bottom)} (surface ${a.surface}, bottom ${a.bottom}).`;
    };
    plot.querySelectorAll<SVGRectElement>('[data-arr]').forEach((r) => {
      const i = Number(r.dataset.arr);
      r.addEventListener('pointerenter', () => pick(i));
      r.addEventListener('click', () => pick(i));
    });
    plot.addEventListener('keydown', (e) => {
      const to = { ArrowRight: at + 1, ArrowLeft: at - 1, Home: 0, End: arrivals.length - 1 }[e.key];
      if (to === undefined) return;
      e.preventDefault();
      pick(to);
    });
  }

  // R1: messages move along the links while the figure is on screen: quick on the radio links, slow
  // on the acoustic ones. Still with reduced motion.
  const netEl = document.querySelector<HTMLElement>('[data-net]');
  if (netEl && !prefersReducedMotion()) {
    const lines = [...netEl.querySelectorAll<SVGLineElement>('[data-a]')];
    const msgs = lines.map((l, k) => {
      const dot = document.createElement('span');
      const radio = l.classList.contains('net__link--radio');
      dot.className = `net__msg net__msg--${radio ? 'radio' : 'acoustic'}`;
      dot.setAttribute('aria-hidden', 'true');
      netEl.append(dot);
      const g = (n: string) => Number(l.getAttribute(n));
      return { dot, x1: g('x1'), y1: g('y1') / 0.9, x2: g('x2'), y2: g('y2') / 0.9, ms: radio ? 700 : 5200, offset: k * 900 };
    });
    let raf = 0;
    let onScreen = false;
    const t0 = performance.now();
    const tick = (now: number) => {
      raf = 0;
      if (!onScreen || document.hidden) return;
      for (const m of msgs) {
        // Each message crosses, rests a moment, and comes back the other way.
        const cycle = m.ms * 2 + 1200;
        const t = (now - t0 + m.offset) % cycle;
        const half = m.ms + 600;
        const u = t < m.ms ? t / m.ms : t < half ? 1 : t < half + m.ms ? 1 - (t - half) / m.ms : 0;
        m.dot.style.left = `${m.x1 + (m.x2 - m.x1) * u}%`;
        m.dot.style.top = `${m.y1 + (m.y2 - m.y1) * u}%`;
      }
      raf = requestAnimationFrame(tick);
    };
    new IntersectionObserver(([e]) => {
      onScreen = e.isIntersecting;
      if (onScreen && !raf) raf = requestAnimationFrame(tick);
    }).observe(netEl);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && onScreen && !raf) raf = requestAnimationFrame(tick);
    });
  }
</script>

<script>
  // R1: hovering, focusing or tapping a node lights its links and says what it is.
  const net = document.querySelector<HTMLElement>('[data-net]');
  if (net) {
    const texts: { id: string; text: string }[] = JSON.parse(net.querySelector('[data-net-nodes]')!.textContent!);
    const read = net.querySelector<HTMLElement>('[data-net-read]')!;
    const nodes = [...net.querySelectorAll<HTMLButtonElement>('[data-node]')];
    const links = [...net.querySelectorAll<SVGLineElement>('[data-a]')];
    const pick = (b: HTMLButtonElement) => {
      const id = b.dataset.node!;
      nodes.forEach((n) => n.setAttribute('aria-pressed', String(n === b)));
      links.forEach((l) => l.toggleAttribute('data-hot', l.dataset.a === id || l.dataset.b === id));
      read.textContent = texts.find((t) => t.id === id)!.text;
    };
    nodes.forEach((b) => {
      b.setAttribute('aria-pressed', 'false');
      ['mouseenter', 'focus', 'click'].forEach((ev) => b.addEventListener(ev, () => pick(b)));
    });
  }
</script>
