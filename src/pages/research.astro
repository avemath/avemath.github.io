---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MarginNote from '@/components/MarginNote.astro';
import BellhopRays from '@/components/drawings/BellhopRays.astro';
import PoolSide from '@/components/drawings/PoolSide.astro';
import Seafloor from '@/components/research/Seafloor.astro';
import arrivalsData from '@/data/bellhop-arrivals.json';

// Fig. R2: every arrival from the bellhopSim comms scenario (1000 m of water, sand bottom, source
// at 50 m, receiver 15 km away at 100 m, 3.5 kHz), recomputed with BELLHOP using the repo's own
// export settings. The counts match docs/figures/figures.json in that repo.
const ch = arrivalsData.comms;
const DB_FLOOR = -40;
const maxDelay = Math.ceil(Math.max(...ch.arrivals.map((a) => a.delay_ms)) / 500) * 500;
// Margins sized for 17-unit labels: the last delay tick fits inside the right edge, and the axis
// names sit clear of the tick numbers.
const R2 = { x0: 58, x1: 566, y0: 40, y1: 184 };
const ax = (ms: number) => R2.x0 + (ms / maxDelay) * (R2.x1 - R2.x0);
const ay = (db: number) => R2.y1 - ((Math.max(DB_FLOOR, db) - DB_FLOOR) / -DB_FLOOR) * (R2.y1 - R2.y0);
const bars = ch.arrivals.map((a) => ({ x: ax(a.delay_ms), y: ay(a.db), strongest: a.db === 0, inside: a.db >= -20 }));
const windowMs = ch.spread_within_20db_ms;
const firstStrong = Math.min(...ch.arrivals.filter((a) => a.db >= -20).map((a) => a.delay_ms));
const delayTicks = Array.from({ length: maxDelay / 500 + 1 }, (_, i) => i * 500);

// Fig. R1: an illustration of the kind of network the project is about. Positions are drawing
// coordinates, not data.
const nodes = [
  { id: 'ship', label: 'ship', x: 16, y: 22, text: 'Surface ship: radio links through the air, acoustic links down into the water.' },
  { id: 'buoy', label: 'buoy', x: 62, y: 16, text: 'Buoy: sits at the surface, so it can pass messages between radio above and acoustic below.' },
  { id: 'auv', label: 'AUV', x: 44, y: 58, text: 'AUV: underwater, so its only link is acoustic. Slow, delayed by seconds, and easy to lose.' },
  { id: 'sensor', label: 'sensor', x: 80, y: 72, text: 'Sensor: collects data all day and can send only a little of it.' },
];
const links = [
  { a: 'ship', b: 'buoy', kind: 'radio' },
  { a: 'ship', b: 'auv', kind: 'acoustic' },
  { a: 'auv', b: 'sensor', kind: 'acoustic' },
  { a: 'buoy', b: 'sensor', kind: 'acoustic' },
];
const at = (id: string) => nodes.find((n) => n.id === id)!;
---

<BaseLayout
  bitGirl
  title="Research"
  description="Underwater acoustic channels, my ONR research on data management for distributed naval platforms, bellhopSim, and an acoustic pool alarm."
  image="/og/research.png"
  footer="research"
>
  <div class="rs">
    <Seafloor />
    <div class="rs__content">
      <section class="wrap rpanel rpanel--intro" aria-labelledby="research-title" data-rpanel data-perch="intro" data-perch-x="0.88 0.14">
        <h1 id="research-title" class="research__h1">Research, below the <em>surface</em>.</h1>
        <p class="rs__cap">
          <b>On a ledge above the deep.</b> Scroll down and the water darkens with depth, from the murky green shallows to the glow at the
          bottom. The little blue crabs on the ledges are for my grandfathers.
        </p>
        <p
          class="hand rs__look"
          tabindex="0"
          role="img"
          aria-label="The seafloor behind this page. Use the left and right arrow keys to look around, and up and down to look up and down."
          data-sea-keys
        >
          drag the water to look around, or focus here and use the arrow keys ♡
        </p>
      </section>

    <section id="below" class="wrap zone-r rpanel" data-rpanel data-perch="below" data-perch-x="0.9 0.12">
      <div class="zone-r__grid">
        <div>
          <p class="zone-r__text">
            Underwater acoustic channels do everything a radio channel does, slower and worse: long delays, strong multipath, Doppler from
            anything that moves. I work on getting data through them anyway, and on one question of my own about what a pool sounds like.
          </p>
        </div>
        <div class="zone-r__fig">
        <figure class="rfig">
          <div class="rfig__plot" data-draw>
            <svg viewBox="0 0 320 170" class="rays" role="img" aria-label="Three paths from a source to a receiver: one direct, one off the surface, one off the bottom.">
              <line class="rays__surface" x1="0" y1="22" x2="320" y2="22" />
              <line class="rays__bottom" x1="0" y1="160" x2="320" y2="160" />
              <path class="rays__ray rays__ray--soft" d="M40 40 L160 22 L280 98" />
              <path class="rays__ray" d="M40 40 L280 98" />
              <path class="rays__ray rays__ray--soft" d="M40 40 L176 160 L280 98" />
              <rect class="rays__src" x="34" y="34" width="12" height="12" />
              <rect class="rays__rx" x="274" y="92" width="12" height="12" />
            </svg>
          </div>
          <figcaption class="rfig__cap mono">source, surface bounce, bottom bounce, direct</figcaption>
        </figure>
          <MarginNote where="below" />
        </div>
      </div>
    </section>

    <section id="onr" class="wrap zone-r rpanel" data-rpanel data-perch="onr" data-perch-x="0.9 0.12" aria-labelledby="onr-title">
      <div class="zone-r__grid zone-r__grid--flip">
        <div class="zone-r__fig">
        <figure class="rfig rfig--boxed" data-perch="net" data-perch-x="0.85">
          <div class="fig__bar">
            <p class="fig__label">Fig. R1 / Platform network</p>
            <p class="fig__label">hover a node</p>
          </div>
          <div class="net" data-net data-draw>
            <svg viewBox="0 0 100 90" preserveAspectRatio="none" class="net__links" aria-hidden="true">
              {links.map((l) => <line x1={at(l.a).x} y1={at(l.a).y} x2={at(l.b).x} y2={at(l.b).y} class={`net__link net__link--${l.kind}`} data-a={l.a} data-b={l.b} />)}
            </svg>
            {
              nodes.map((n) => (
                <button type="button" class="net__node" style={`left:${n.x}%;top:${(n.y / 90) * 100}%`} data-node={n.id} aria-describedby="net-read">
                  {n.label}
                </button>
              ))
            }
            <p class="net__read" id="net-read" data-net-read aria-live="polite">Hover or focus a node.</p>
            <script type="application/json" data-net-nodes set:html={JSON.stringify(nodes.map(({ id, text }) => ({ id, text })))} />
          </div>
          <p class="fig__note">A drawing of the kind of network the project is about, not project data. Solid lines are radio, green lines acoustic.</p>
          <p class="fig__try"><span class="on-mouse">Hover</span><span class="on-touch">Tap</span> a node to see how it links to the others.</p>
        </figure>
          <MarginNote where="onr" />
        </div>
        <div>
          <h2 id="onr-title" class="research__h2" data-decode>Intelligent data management for distributed naval&nbsp;platforms</h2>
          <p class="zone-r__text">
            ONR funded, with Integer Technologies. In the words of the public contract announcement, the project is “the development of
            decision-making tools for data management on board distributed naval platforms.” Thesis track, expected May 2028.
          </p>
          <p class="zone-r__small">Advisor: Dr. Shuangqing Wei, LSU.</p>
          <p class="zone-r__small">Details are limited to what the project has published.</p>
          <p class="zone-r__links">
            <a class="link" href="/work/onr-intelligent-data-management/">What I can share</a>
            <a class="link" href="https://lsu.edu/eng/news/2024/09/lsu-integer-partner-to-optimize-navy-and-marine-corps-operations.php">The public announcement</a>
          </p>
        </div>
      </div>
    </section>

    <section id="bellhop" class="wrap zone-r rpanel" data-rpanel data-perch="bellhop" data-perch-x="0.9 0.12" aria-labelledby="bellhop-title">
      <div class="zone-r__grid">
        <div>
          <h2 id="bellhop-title" class="research__h2" data-decode>bellhopSim</h2>
          <p class="zone-r__text">
            An interactive Python simulator around BELLHOP (a standard model of how sound travels underwater), built around the Munk deep-ocean case: eigenrays (the paths sound takes from source to receiver), arrival structure, delay spread within 20 dB of the
            strongest arrival, and a BER sweep. While documenting it I found three physics bugs (range units, bottom density units, the BER
            model) and fixed them with regression tests.
          </p>
          <div class="zone-r__actions">
            <a class="btn" href="/work/bellhop-sim/">Figures and fixes</a>
            <a class="link" href="https://github.com/avemath/bellhopSim">Code</a>
          </div>
        </div>
        <div class="zone-r__fig">
        <figure class="rfig rfig--boxed">
          <div class="fig__bar">
            <p class="fig__label">Fig. R2 / Arrivals, 15 km, sandy bottom</p>
            <div class="tabset" role="tablist" aria-label="bellhopSim: views" data-tabs>
              <button type="button" role="tab" id="r2-tab-live" aria-controls="r2-live" aria-selected="true" tabindex="0">Arrivals</button>
              <button type="button" role="tab" id="r2-tab-drawing" aria-controls="r2-drawing" aria-selected="false" tabindex="-1">Drawing</button>
            </div>
          </div>
          <div id="r2-live" role="tabpanel" aria-labelledby="r2-tab-live">
          <div class="rfig__plot" data-draw data-hscroll="Arrivals plot">
            <svg viewBox="0 0 600 230" class="arr" style="--fig-w:600px" role="img" aria-label={`${ch.arrivals.length} arrivals of one ping at 15 km over ${(ch.delay_spread_ms / 1000).toFixed(1)} seconds. ${ch.n_within_20db} are within 20 dB of the strongest, spread over ${Math.round(windowMs)} ms.`}>
              <rect class="arr__win" x={ax(firstStrong)} y={R2.y0 - 6} width={ax(firstStrong + windowMs) - ax(firstStrong)} height={R2.y1 - R2.y0 + 6} />
              <text class="arr__lab" x={ax(firstStrong) + 6} y={R2.y0 - 14}>20 dB window: {Math.round(windowMs)} ms</text>
              {[0, -10, -20, -30, -40].map((d) => <text class="arr__tick" x={R2.x0 - 10} y={ay(d) + 5} text-anchor="end">{d}</text>)}
              <line class="arr__axis" x1={R2.x0} y1={R2.y1} x2={R2.x1} y2={R2.y1} />
              {bars.map((b) => <line class:list={['arr__bar', b.inside && 'arr__bar--in', b.strongest && 'arr__bar--top']} x1={b.x} x2={b.x} y1={R2.y1} y2={b.y} />)}
              {delayTicks.map((t) => <text class="arr__tick" x={ax(t)} y={R2.y1 + 20} text-anchor="middle">{t}</text>)}
              <text class="arr__tick" x={R2.x1} y={R2.y1 + 40} text-anchor="end">delay, ms</text>
              <text class="arr__tick" x={R2.x0 - 10} y={R2.y0 - 22} text-anchor="end">dB</text>
            </svg>
          </div>
          <p class="fig__note">
            {ch.arrivals.length} arrivals from BELLHOP: 1000 m of water, source at 50 m, receiver at 100 m, 3.5 kHz. The strongest is in
            green; {ch.n_within_20db} fall within 20 dB of it.
          </p>
          </div>
          <div id="r2-drawing" role="tabpanel" aria-labelledby="r2-tab-drawing" hidden>
            <BellhopRays />
          </div>
        </figure>
          <MarginNote where="bellhop" />
        </div>
      </div>
    </section>

    <section id="pool-alarm" class="wrap zone-r rpanel" data-rpanel data-perch="pool-alarm" data-perch-x="0.9 0.12" aria-labelledby="pool-title">
      {/* NAME: working title until Avery picks one. Update the title here and in acoustic-pool-alarm.md then, and delete this comment. */}
      <div class="zone-r__grid zone-r__grid--flip">
        <div class="zone-r__fig">
        <figure class="rfig rfig--boxed rfig--pool">
          <div class="fig__bar">
            <p class="fig__label">Fig. R3 / Pool, side view</p>
            <p class="fig__label">in progress</p>
          </div>
          <PoolSide />
        </figure>
          <MarginNote where="pool-alarm" />
        </div>
        <div>
          <h2 id="pool-title" class="research__h2">Acoustic Pool Alarm <span class="research__wt">(working title)</span></h2>
          <p class="zone-r__text">
            My own project. Can listening underwater in a home pool tell the difference between a kid swimming and a kid in
            trouble, fast enough to matter? Right now: reviewing prior work and ASTM F2208, the standard for residential pool alarms, and
            planning the first bench tests.
          </p>
          <div class="zone-r__actions">
            <a class="btn btn--line-accent" href="/work/acoustic-pool-alarm/">Follow along</a>
            <a class="link" href="/work/because-of-adam/">Because of ADAM</a>
          </div>
        </div>
      </div>
    </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* One continuous scene: the water behind everything (Seafloor.astro), and the work in solid sheet
     panels on top, with open water between them to look into and drag. */
  .rs {
    position: relative;
    isolation: isolate;
  }

  .rs__content {
    position: relative;
    z-index: 1;
    padding-block: clamp(1.25rem, 3vw, 2rem) clamp(4rem, 30vh, 16rem);
    touch-action: pan-y;
  }

  :global(html[data-sea-drag]) .rs__content {
    cursor: grabbing;
    user-select: none;
  }

  /* A muted, slightly translucent surface: #e8efea at 90% in light mode, #16241f at 88% in dark, with
     the water blurred behind it. Over the darkest water a light panel reads as about #d1d8d4, so
     muted text inside panels is darkened to keep 4.5:1 there (5.1:1 at worst). */
  .rpanel {
    --muted: #4a5751;
    background: rgb(232 239 234 / 0.9);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid var(--rule);
    box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.55);
  }

  :global([data-theme='dark']) .rpanel {
    --muted: #9db0a6;
    background: rgb(22 36 31 / 0.88);
  }

  .rpanel + .rpanel {
    margin-top: clamp(14rem, 42vh, 30rem);
  }

  .rpanel--intro {
    max-width: min(46rem, calc(100% - 2 * var(--gutter)));
    margin-left: max(var(--gutter), calc((100% - 75rem) / 2 + var(--gutter)));
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
  }

  @media (max-width: 759px) {
    .rpanel--intro {
      max-width: none;
      margin-inline: 0;
    }
  }

  .rs__cap {
    margin-top: 1rem;
    max-width: 40em;
    color: var(--text-soft);
  }

  .rs__cap b {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
  }

  .rs__look {
    display: inline-block;
    margin-top: 0.9rem;
    font-size: 1.0625rem;
    cursor: grab;
  }

  .rs__look:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }

  :global(html:not([data-sea-live])) .rs__look {
    display: none;
  }


  .zone-r {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .zone-r:last-of-type {
    border-bottom: 0;
  }

  .zone-r__fig {
    min-width: 0;
  }

  .zone-r__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .zone-r__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: clamp(2.5rem, 5vw, 4.5rem);
    }

    .zone-r__grid--flip {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    }
  }

  @media (max-width: 959px) {
    .zone-r__grid--flip > .zone-r__fig {
      order: 2;
    }
  }

  .research__h1 {
    font-size: clamp(2.75rem, 7vw, 5rem);
  }

  .research__h2 {
    margin-top: 0.75rem;
    font-size: clamp(2.1rem, 4.4vw, 3.25rem);
  }

  .research__wt {
    font-size: 0.45em;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--muted);
  }

  .zone-r__text {
    margin-top: 1.25rem;
    max-width: 28em;
    color: var(--text-soft);
  }

  .zone-r__small {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--text-soft);
  }

  .zone-r__links,
  .zone-r__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.5rem;
  }

  .zone-r__links {
    margin-top: 1rem;
    font-size: 0.9375rem;
  }

  /* ---- Figures on dark water ---- */
  .rfig {
    margin: 0;
    min-width: 0;
  }

  /* The pool drawing sits in a narrow column at about 0.72 of its viewBox; 18 units read as 13px. */
  .rfig--pool :global(.dw__svg .t),
  .rfig--pool :global(.dw__svg .t--mono) {
    font-size: 18px;
  }

  .rfig--boxed {
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .rfig__plot {
    padding: 0.75rem;
  }

  .rfig:not(.rfig--boxed) .rfig__plot {
    border: 1px solid var(--line);
    border-bottom: 0;
  }

  .rfig__cap {
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: 0.875rem;
    color: var(--text-soft);
  }

  .rays,
  .arr,
  .pool {
    width: 100%;
    height: auto;
  }

  .rays__surface {
    stroke: var(--line-strong);
  }

  .rays__bottom {
    stroke: var(--line);
    stroke-dasharray: 3 4;
  }

  .rays__ray {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
  }

  .rays__ray--soft {
    stroke-opacity: 0.55;
    stroke-width: 1;
  }

  .rays__src {
    fill: var(--accent);
  }

  .rays__rx {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.5;
  }

  /* R1: nodes are buttons, so they take focus in order and work by keyboard. */
  .net {
    position: relative;
    aspect-ratio: 10 / 8;
    margin: 0.75rem;
  }

  .net__links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .net__link {
    stroke: var(--line-strong);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .net__link--acoustic {
    stroke: var(--accent);
    stroke-opacity: 0.6;
  }

  .net__link[data-hot] {
    stroke-width: 2.5;
    stroke-opacity: 1;
  }

  .net__node {
    position: absolute;
    translate: -50% -50%;
    min-width: 4.5rem;
    min-height: 2.5rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--text);
    background: var(--surface);
    font-size: 0.875rem;
    color: var(--text);
    cursor: pointer;
  }

  .net__node[aria-pressed='true'],
  .net__node:hover {
    border: 2px solid var(--accent);
    color: var(--accent-ink);
  }

  .net__read {
    position: absolute;
    left: 0;
    bottom: 0;
    max-width: 16rem;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--line-strong);
    background: var(--paper);
    color: var(--text);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  /* R2 */
  .arr__win {
    fill: var(--accent-wash);
  }

  /* The plot draws at about 0.78 of its viewBox on desktop, so 17 units read as 13px. */
  .arr__lab {
    font-family: var(--font-mono);
    font-size: 17px;
    fill: var(--text-soft);
  }

  .arr__tick {
    font-family: var(--font-mono);
    font-size: 17px;
    fill: var(--muted);
  }

  .arr__axis {
    stroke: var(--line-strong);
  }

  .arr__bar {
    stroke: var(--line-strong);
    stroke-width: 2;
  }

  .arr__bar--in {
    stroke: var(--text);
    stroke-width: 3;
  }

  .arr__bar--top {
    stroke: var(--accent);
    stroke-width: 4;
  }

</style>

<script>
  // R1: hovering, focusing or tapping a node lights its links and says what it is.
  const net = document.querySelector<HTMLElement>('[data-net]');
  if (net) {
    const texts: { id: string; text: string }[] = JSON.parse(net.querySelector('[data-net-nodes]')!.textContent!);
    const read = net.querySelector<HTMLElement>('[data-net-read]')!;
    const nodes = [...net.querySelectorAll<HTMLButtonElement>('[data-node]')];
    const links = [...net.querySelectorAll<SVGLineElement>('[data-a]')];
    const pick = (b: HTMLButtonElement) => {
      const id = b.dataset.node!;
      nodes.forEach((n) => n.setAttribute('aria-pressed', String(n === b)));
      links.forEach((l) => l.toggleAttribute('data-hot', l.dataset.a === id || l.dataset.b === id));
      read.textContent = texts.find((t) => t.id === id)!.text;
    };
    nodes.forEach((b) => {
      b.setAttribute('aria-pressed', 'false');
      ['mouseenter', 'focus', 'click'].forEach((ev) => b.addEventListener(ev, () => pick(b)));
    });
  }
</script>
