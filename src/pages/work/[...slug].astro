---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import CaseStudyLayout from '@/layouts/CaseStudyLayout.astro';
import SpectrumDemo from '@/components/demos/SpectrumDemo.astro';
import WeaponLogicDemo from '@/components/demos/WeaponLogicDemo.astro';
import OfdmDemo from '@/components/demos/OfdmDemo.astro';
import { getProjects, isWebsite, type Project } from '@/lib/projects';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  // Previous and next stay within a group (the client sites, or the project's type) and skip
  // limited-detail pages, so a reader finishing one case study lands on a related one.
  const group = (p: Project) => (isWebsite(p) ? 'websites' : p.data.type);
  return projects.map((project) => {
    const grouped = projects.filter((p) => group(p) === group(project) && (p.id === project.id || p.data.confidentiality !== 'limited'));
    // A project alone in its group (the research post) pages through everything instead.
    const chain = grouped.length > 1 ? grouped : projects.filter((p) => p.id === project.id || p.data.confidentiality !== 'limited');
    const i = chain.findIndex((p) => p.id === project.id);
    return { params: { slug: project.id }, props: { project, prev: chain[i - 1], next: chain[i + 1] } };
  });
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
  prev?: Project;
  next?: Project;
}

const { project, prev, next } = Astro.props;
const { Content, headings } = await render(project);
const demo = project.data.demo;
---

<CaseStudyLayout project={project} headings={headings} prev={prev} next={next}>
  {demo === 'spectrum' && <SpectrumDemo slot="demo" />}
  {demo === 'weapon-logic' && <WeaponLogicDemo slot="demo" />}
  {demo === 'ofdm' && <OfdmDemo slot="demo" />}
  <Content />
</CaseStudyLayout>
