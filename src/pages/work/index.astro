---
import BaseLayout from '@/layouts/BaseLayout.astro';
import WorkCard from '@/components/WorkCard.astro';
import { getWorkOrder, workSection, workSections } from '@/lib/projects';

const order = await getWorkOrder();
const sections = workSections.map((s) => ({ ...s, projects: order.filter((p) => workSection(p) === s.id) }));
// Figure numbers run through the whole page, in order.
const figOf = new Map(order.map((p, i) => [p.id, i + 1]));
---

<BaseLayout
  title="Work"
  description="Engineering, research and client websites by Avery Matherne, each with a case study on what I did and how."
  section="projects"
>
  <section class="section work-head" id="all">
    <div class="wrap">
      <h1 class="section-title work-head__title">All work</h1>
      <p class="section-lede">
        {order.length} projects: the engineering and research first, then the websites. Every card opens a case study with what I did and
        how.
      </p>
      <nav class="filters" aria-label="Jump to a kind of work">
        <a class="filter" href="#all">All <span class="filter__n">{order.length}</span></a>
        {
          [sections[0], sections[2], sections[1]].map((s) => (
            <a class="filter" href={`#${s.id}`}>
              {s.label} <span class="filter__n">{s.projects.length}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  {
    sections.map((s) => (
      <section id={s.id} class="section work-sec" aria-labelledby={`${s.id}-title`}>
        <div class="wrap">
          <div class="work-sec__head">
            <h2 id={`${s.id}-title`} class="section-title section-title--sm" data-decode>
              {s.label}
            </h2>
            <p class="work-sec__intro">{s.intro}</p>
          </div>
          <div class="work-grid">
            {s.projects.map((p) => (
              <WorkCard project={p} fig={figOf.get(p.id)!} />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="section section--tight">
    <div class="wrap work-end">
      <p>Want the story behind the work, or to see the research underwater?</p>
      <p class="work-end__links">
        <a class="btn" href="/research/">The research page</a>
        <a class="link" href="/about/">About me</a>
        <a class="link" href="/contact/">Get in touch</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .work-head {
    padding-bottom: 1.5rem;
  }

  .work-head__title {
    margin-top: 0;
    font-size: clamp(2.5rem, 6vw, 4rem);
  }

  /* Plain anchors: they work with no script at all. */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.75rem;
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--text);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
  }

  .filter:hover {
    border-color: var(--text);
  }

  .filter__n {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
  }

  .work-sec {
    scroll-margin-top: 4rem;
  }

  .work-sec__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--text);
  }

  .work-sec__head .section-title {
    margin-top: 0;
  }

  .work-sec__intro {
    max-width: 30rem;
    color: var(--muted);
  }

  .work-grid {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }

  .work-end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    color: var(--text-soft);
  }

  .work-end__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
</style>
