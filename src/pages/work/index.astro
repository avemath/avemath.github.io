---
import BaseLayout from '@/layouts/BaseLayout.astro';
import WorkCard from '@/components/WorkCard.astro';
import WebsitesShowcase from '@/components/WebsitesShowcase.astro';
import { getWorkOrder, workSection, workSections } from '@/lib/projects';

const order = await getWorkOrder();
const sections = workSections.map((s) => ({ ...s, projects: order.filter((p) => workSection(p) === s.id) }));
// Figure numbers run through the page, in order. The client sites with a screenshot and a live
// address show as the same large rows as the home page; any other website work follows as cards.
const showcased = (p: (typeof order)[number]) => !!(p.data.cover && p.data.links.live && p.data.client?.permission);
const webStart = order.findIndex((p) => workSection(p) === 'websites') + 1;
const webRows = order.filter((p) => workSection(p) === 'websites' && showcased(p));
const figOf = new Map(order.map((p, i) => [p.id, i + 1]));
let n = webStart + webRows.length;
for (const p of order) if (workSection(p) === 'websites' && !showcased(p)) figOf.set(p.id, n++);
---

<BaseLayout
  title="Work"
  description="Engineering, research and client websites by Avery Matherne, each with a case study on what I did and how."
  section="projects"
>
  <section class="section work-head band-paper" id="all">
    <div class="wrap">
      <h1 class="section-title work-head__title">All work</h1>
      <p class="section-lede">
        {order.length} projects: the engineering and research first, then the websites. Every card opens a case study with what I did and
        how.
      </p>
      <nav class="filters" aria-label="Jump to a kind of work">
        <a class="filter" href="#all">All <span class="filter__n">{order.length}</span></a>
        {
          [sections[0], sections[2], sections[1]].map((s) => (
            <a class="filter" href={`#${s.id}`}>
              {s.label} <span class="filter__n">{s.projects.length}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  {
    sections.map((s, i) => (
      <section id={s.id} class:list={['section work-sec', i % 2 === 0 ? 'band-sheet' : 'band-paper']} aria-labelledby={`${s.id}-title`}>
        <div class="wrap">
          <div class="work-sec__head">
            <h2 id={`${s.id}-title`} class="section-title section-title--sm" data-decode>
              {s.label}
            </h2>
            <p class="work-sec__intro">{s.intro}</p>
          </div>
          {s.id === 'websites' && <WebsitesShowcase rowsOnly firstFig={webStart} />}
          {(s.id === 'websites' ? s.projects.filter((p) => !showcased(p)) : s.projects).length > 0 && (
            <div class:list={['work-grid', s.id === 'websites' && 'work-grid--after-sites']}>
              {(s.id === 'websites' ? s.projects.filter((p) => !showcased(p)) : s.projects).map((p) => (
                <WorkCard project={p} fig={figOf.get(p.id)!} />
              ))}
            </div>
          )}
        </div>
      </section>
    ))
  }

  <section class="section section--tight band-paper">
    <div class="wrap work-end">
      <p>Want the story behind the work, or to see the research underwater?</p>
      <p class="work-end__links">
        <a class="btn" href="/research/">The research page</a>
        <a class="link" href="/about/">About me</a>
        <a class="link" href="/contact/">Get in touch</a>
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  // The nav marks the section in view: Projects for Engineering, Research for Research, Websites
  // for Websites. A hash on load (/work/#websites) counts from the start.
  const keyOf: Record<string, string> = { engineering: 'projects', research: 'research', websites: 'websites' };
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-key]')];
  const mark = (section: string) => {
    const key = keyOf[section] ?? 'projects';
    links.forEach((a) => (a.dataset.navKey === key ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
  };
  mark(location.hash.slice(1));
  const sections = ['engineering', 'research', 'websites'].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  // A section counts as in view once its top passes 35% down the screen.
  // While the page is still jumping to a hash, the observer's first report would be stale.
  let settled = !location.hash;
  addEventListener('load', () => setTimeout(() => (settled = true), 400));
  const io = new IntersectionObserver(
    () => {
      if (!settled) return;
      const line = innerHeight * 0.35;
      const current = sections.filter((s) => s.getBoundingClientRect().top <= line).pop();
      mark(current?.id ?? 'engineering');
    },
    { rootMargin: '-35% 0px -64% 0px' },
  );
  sections.forEach((s) => io.observe(s));
  addEventListener('hashchange', () => mark(location.hash.slice(1)));
</script>

<style>
  /* The heading starts about 56px under the nav. */
  .work-head {
    padding-top: 3.5rem;
    padding-bottom: 1.5rem;
  }

  /* The interior page title: the case study's size and weight. */
  .work-head__title {
    margin-top: 0;
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  /* Plain anchors: they work with no script at all. */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.75rem;
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--text);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
  }

  .filter:hover {
    border-color: var(--text);
  }

  .filter__n {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 400;
  }

  .work-sec {
    scroll-margin-top: 4rem;
  }

  .work-sec__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--text);
  }

  .work-sec__head .section-title {
    margin-top: 0;
  }

  .work-sec__intro {
    max-width: 30rem;
    color: var(--muted);
  }

  .work-grid {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }

  /* After the website rows, a card gets the same space the rows keep between themselves. */
  .work-grid--after-sites {
    margin-top: clamp(4rem, 8vw, 6.5rem);
  }

  .work-end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    color: var(--text-soft);
  }

  .work-end__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
</style>
