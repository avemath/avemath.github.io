---
// /work/: the workbench (every project as an object on my bench, chosen to see its detail), the
// thread map ("How it connects"), the client sites' showcase rows and tools, and "Every project",
// a compact index grouped as Engineering, Research, and Websites and client tools. The groups keep
// the ids #engineering, #research and #websites, so existing links and the nav highlighting work.
import BaseLayout from '@/layouts/BaseLayout.astro';
import ToolPanel from '@/components/ToolPanel.astro';
import WebsitesShowcase from '@/components/WebsitesShowcase.astro';
import Workbench from '@/components/work/Workbench.astro';
import ThreadMap from '@/components/work/ThreadMap.astro';
import { getWorkOrder, workSection, workSections, typeLabels, statusLabels, projectHref } from '@/lib/projects';
import { projectWhen } from '@/lib/format';

const order = await getWorkOrder();
const sections = workSections.map((s) => ({ ...s, projects: order.filter((p) => workSection(p) === s.id) }));
// The client sites with a screenshot and a live address show as the home page's large rows; the
// tools built for client businesses follow as panels.
const showcased = (p: (typeof order)[number]) => !!(p.data.cover && p.data.links.live && p.data.client?.permission);
const webRows = order.filter((p) => workSection(p) === 'websites' && showcased(p));
const tools = order.filter((p) => workSection(p) === 'websites' && !showcased(p));
const when = (p: (typeof order)[number]) => projectWhen(p.data.period.start, p.data.period.end, p.data.status);
---

<BaseLayout
  title="Work"
  description="The work of Avery Matherne, laid out on a workbench: hardware, signals research, client websites and tools, how they connect, and a case study for each."
  bitGirl
  section="projects"
>
  <!-- Arriving at a #section or a project's #slug, skip the lazy layout so the jump lands on the real position. -->
  <script is:inline>
    if (location.hash) document.documentElement.classList.add('cv-off');
  </script>
  <section class="section work-head band-paper" id="all">
    <div class="wrap">
      <h1 class="section-title work-head__title">All work</h1>
      <p class="section-lede">
        {order.length} projects, laid out on my bench. Choose anything to see what it is; every project has a case study. {/* TODO(ave): check wording. */}
      </p>
      <nav class="filters" aria-label="Jump to a kind of work">
        <a class="filter" href="#all">All <span class="filter__n">{order.length}</span></a>
        {
          [sections[0], sections[2], sections[1]].map((s) => (
            <a class="filter" href={`#${s.id}`}>
              {s.label} <span class="filter__n">{s.projects.length}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <section class="section work-bench band-sheet" aria-labelledby="bench-title">
    <div class="wrap">
      <h2 id="bench-title" class="sr-only">The workbench</h2>
      <Workbench projects={order} />
    </div>
  </section>

  <section class="section work-map band-paper" aria-labelledby="map-title">
    <div class="wrap">
      <div class="work-sec__head">
        <h2 id="map-title" class="section-title section-title--sm" data-decode>How it connects</h2>
        {/* TODO(ave): check wording. */}
        <p class="work-sec__intro">Each line is a thread through my work. Where two lines meet, a project belongs to both.</p>
      </div>
      <div class="work-map__box"><ThreadMap projects={order} /></div>
    </div>
  </section>

  <section id="client-sites" class="section work-sites band-sheet" aria-labelledby="sites-title">
    <div class="wrap">
      <div class="work-sec__head">
        <h2 id="sites-title" class="section-title section-title--sm" data-decode>Client sites</h2>
        <p class="work-sec__intro">{sections[2].intro}</p>
      </div>
      <WebsitesShowcase rowsOnly firstFig={1} />
      {
        tools.length > 0 && (
          <>
            <h3 class="work-sites__tools">Client tools</h3>
            <div class="tools">
              {tools.map((p, k) => (
                <ToolPanel project={p} fig={webRows.length + 1 + k} flip={k % 2 === 1} />
              ))}
            </div>
          </>
        )
      }
    </div>
  </section>

  <section class="section work-index band-paper" aria-labelledby="index-title">
    <div class="wrap">
      <div class="work-sec__head">
        <h2 id="index-title" class="section-title section-title--sm" data-decode>Every project</h2>
        <p class="work-sec__intro">{order.length} projects, each with a case study.</p>
      </div>
      {
        sections.map((s) => (
          <section class="ix" id={s.id} aria-labelledby={`${s.id}-title`}>
            <h3 class="ix__title" id={`${s.id}-title`}>
              {s.label} <span class="ix__n">{s.projects.length}</span>
            </h3>
            <ul class="ix__list">
              {s.projects.map((p) => (
                <li class="ix__row">
                  <a class="ix__name" href={projectHref(p)}>
                    {p.data.title}
                  </a>
                  <span class="ix__kind">{typeLabels[p.data.type]}</span>
                  <span class="ix__when">{when(p)}</span>
                  <span class="ix__status">{statusLabels[p.data.status]}</span>
                  <a class="ix__cs link" href={projectHref(p)} aria-label={`Case study: ${p.data.title}`}>
                    Case study
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>

  <section class="section section--tight band-paper">
    <div class="wrap work-end">
      <p>Want the story behind the work, or to see the research underwater?</p>
      <p class="work-end__links">
        <a class="btn" href="/research/">The research page</a>
        <a class="link" href="/about/">About me</a>
        <a class="link" href="/contact/">Get in touch</a>
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  // The nav marks where you are on /work/: Projects everywhere, except Websites while the Client
  // sites showcase is in view (or the address names it, or the old #websites). A hash on load
  // counts from the start.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-key]')];
  const mark = (key: 'projects' | 'websites') => links.forEach((a) => (a.dataset.navKey === key ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
  const fromHash = () => mark(['client-sites', 'websites'].includes(location.hash.slice(1)) ? 'websites' : 'projects');
  fromHash();
  const sites = document.getElementById('client-sites');
  // While the page is still jumping to a hash, the observer's first report would be stale.
  let settled = !location.hash;
  addEventListener('load', () => setTimeout(() => (settled = true), 400));
  if (sites) {
    new IntersectionObserver(
      ([e]) => {
        if (settled) mark(e.isIntersecting ? 'websites' : 'projects');
      },
      // In view once its top passes 35% down the screen, until its bottom rises above that line.
      { rootMargin: '-35% 0px -64% 0px' },
    ).observe(sites);
  }
  addEventListener('hashchange', fromHash);
</script>

<style>
  /* The heading starts about 56px under the nav. */
  .work-head {
    padding-top: 3.5rem;
    padding-bottom: 1.5rem;
  }

  /* The interior page title: the case study's size and weight. */
  .work-head__title {
    margin-top: 0;
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  /* Plain anchors: they work with no script at all. */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.75rem;
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--text);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
  }

  .filter:hover {
    border-color: var(--text);
  }

  .filter__n {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 400;
  }

  /* Below the bench, the browser skips laying out the map, the client sites and the index until they
     near the screen, so the first paint does not wait on them. Off when arriving at a #hash. */
  :global(html:not(.cv-off)) .work-map,
  :global(html:not(.cv-off)) .work-sites,
  :global(html:not(.cv-off)) .work-index {
    content-visibility: auto;
    contain-intrinsic-size: auto 1200px;
  }

  /* The bench sits right under the title. */
  .work-bench {
    padding-top: 1.25rem;
  }

  .work-sec__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--text);
  }

  .work-sec__head .section-title {
    margin-top: 0;
  }

  .work-sec__intro {
    max-width: 30rem;
    color: var(--muted);
  }

  .work-map__box {
    margin-top: 1.5rem;
  }

  .work-sites__tools {
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--rule);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }

  /* The client tools: large panels at the scale of the website displays above them. */
  .tools {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  /* ---- Every project: one row each, grouped ---- */
  .ix {
    margin-top: 2rem;
    scroll-margin-top: 5rem;
  }

  .ix__title {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 1.375rem;
  }

  .ix__n {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--muted);
  }

  .ix__list {
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .ix__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.15rem 1rem;
    align-items: baseline;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .ix__name {
    min-width: 0;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }

  .ix__name:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }

  .ix__kind,
  .ix__when,
  .ix__status {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .ix__cs {
    justify-self: end;
    font-size: 0.9375rem;
  }

  /* Phones: the name on its own line, then kind, dates, status and the link, wrapping as words. */
  @media (max-width: 759px) {
    .ix__row {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.2rem 0.9rem;
    }

    .ix__name {
      flex: 1 0 100%;
    }

    .ix__kind,
    .ix__when,
    .ix__status,
    .ix__cs {
      white-space: nowrap;
    }

    .ix__cs {
      margin-left: auto;
    }
  }

  @media (min-width: 760px) {
    .ix__row {
      grid-template-columns: minmax(0, 3fr) minmax(0, 1.1fr) minmax(0, 1.6fr) minmax(0, 0.9fr) auto;
    }
  }

  .work-end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    color: var(--text-soft);
  }

  .work-end__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
</style>
