---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import StatusStrip from '@/components/StatusStrip.astro';
import FigureCard from '@/components/fig/FigureCard.astro';
import TimingFig from '@/components/fig/TimingFig.astro';
import ChainFig from '@/components/fig/ChainFig.astro';
import MatrixFig from '@/components/fig/MatrixFig.astro';
import CodeHow from '@/components/fig/CodeHow.astro';
import CodeFile from '@/components/fig/CodeFile.astro';
import SignalsLive from '@/components/live/SignalsLive.astro';
import BelowSurface from '@/components/BelowSurface.astro';
import MarginNote from '@/components/MarginNote.astro';
import RampageSystem from '@/components/drawings/RampageSystem.astro';
import V2vLink from '@/components/drawings/V2vLink.astro';
import LedChain from '@/components/drawings/LedChain.astro';
import SignalsHop from '@/components/drawings/SignalsHop.astro';
import WebsitesShowcase from '@/components/WebsitesShowcase.astro';
import HomeSkills from '@/components/HomeSkills.astro';
import site from '@/data/site.json';
import { cut, lineOf, region } from '@/lib/excerpt';
import { hopSequence, toneHz, F_HIGH, F_LOW } from '@/lib/fhbfsk';
import eigenrays from '@/assets/projects/bellhop-sim/ssp_and_rays.png';
import pico from '../../vendor/rampage/pico_direct.py?raw';
import ofdmRx from '../lib/ofdm-rx.ts?raw';
import ledFw from '../lib/led-firmware.ts?raw';

const SELF = 'https://github.com/avemath/avemath.github.io/blob/main';
const RAMPAGE = 'https://github.com/avemath/RAMpage/blob/929c280/pico_direct.py';

// Fig. 01, How it works: the strike itself, straight from the Pico's firmware.
const picoHow = cut(pico, '# Increment activation counter', 45, 'py');
const picoNotes: { text: string; lines: [number, number] }[] = [
  { text: 'Count the shot, start the 500 ms cooldown, and lock out once all 17 are used.', lines: [lineOf(pico, '# Increment activation counter'), lineOf(pico, 'weapon_depleted = True') + 1] },
  { text: 'Fill: the main valve opens for 50 ms to build pressure, then closes.', lines: [lineOf(pico, '# 1. Open main valve'), lineOf(pico, '# 4. Dweel time') - 1] },
  { text: 'Extend: the piston valve opens for 400 ms, full extension.', lines: [lineOf(pico, '# 5. Open piston valves'), lineOf(pico, 'utime.sleep_ms(SOLENOID_ACTIVATION_TIME)')] },
  { text: 'Close the piston valve and open the main valve again to vent.', lines: [lineOf(pico, '# 7. Close valves'), lineOf(pico, '# 8. Re-open main valve') + 1] },
];

// Fig. 02, How it works: the receiver stages in the port of the MATLAB receiver.
const rxHow = region(ofdmRx, 'rx', 'ts');
const rxNotes: { text: string; lines: [number, number] }[] = [
  { text: 'CFO: the phase step between known preamble symbols, averaged, gives the frequency offset to remove.', lines: [lineOf(ofdmRx, '// 1. Coarse CFO'), lineOf(ofdmRx, 'rx = rx.map((z, n) => rot(z, -step * n));')] },
  { text: 'A line fit to the leftover phase on the training symbols, then the polarity is fixed.', lines: [lineOf(ofdmRx, '// 2. Fit a line'), lineOf(ofdmRx, 'if (corr < 0)')] },
  { text: 'Costas loop: each decision steers the phase estimate a little.', lines: [lineOf(ofdmRx, '// 3. Decision-directed Costas'), lineOf(ofdmRx, 'return y;', lineOf(ofdmRx, '// 3. Decision-directed Costas'))] },
  { text: 'MMSE: divide out the channel estimate on each subcarrier, weighted by the noise.', lines: [lineOf(ofdmRx, 'if (on.mmse) {'), lineOf(ofdmRx, 'y = [num[0] / den, num[1] / den];')] },
];

// Fig. 03, How it works: FFT bins into 16 bands, AGC and smoothing, as in loop().
const ledHow = region(ledFw, 'bands', 'ts');
const bandStart = lineOf(ledFw, '#region how:bands');
const ledNotes: { text: string; lines: [number, number] }[] = [
  { text: 'Average the FFT bins inside each of the 16 log-spaced bands, and gate out the noise.', lines: [lineOf(ledFw, 'for (let b = 0; b < 16; b++) {', bandStart), lineOf(ledFw, 'if (val > peak) peak = val;', bandStart) + 1] },
  { text: 'AGC: the full-scale level rises fast with loud music and falls slowly back.', lines: [lineOf(ledFw, 'if (peak > s.levelMax)', bandStart), lineOf(ledFw, 'else s.levelMax = Math.max(LEVELMAX_FLOOR', bandStart)] },
  { text: 'Scale each band to the 16 rows, smooth it, and let the peak dots hold and fall.', lines: [lineOf(ledFw, 'const h = Math.min(H', bandStart), lineOf(ledFw, 'else peakValues[b] = Math.max(0, peakValues[b] - PEAK_FALL_RATE);', bandStart)] },
];

// Fig. 05: the first eight chips of the Signals playground's hop pattern (seed 87).
const bits = [1, 0, 1, 1, 0, 0, 1, 1];
const hops = hopSequence(8, 87);
const hopY = (hz: number) => 12 + ((F_HIGH - hz) / (F_HIGH - F_LOW)) * 96;
---

<BaseLayout jsonLd={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url }]}>
  <Hero />
  <StatusStrip />

  <section id="projects" class="section projects" aria-labelledby="projects-title">
    <div class="wrap">
      <div class="projects__head">
        <h2 id="projects-title" class="section-title projects__title" data-decode>Projects</h2>
        <p class="projects__note">every figure is live and built from the real code</p>
      </div>

      <div class="projects__cards">
        <FigureCard id="rampage" fig="01" kind="Timing diagram" wide eyebrow="Senior design capstone, 1st place" title="RAMpage">
          <TimingFig />
          <RampageSystem slot="drawing" />
          <CodeHow slot="how" excerpt={picoHow} file="pico_direct.py" url={`${RAMPAGE}#L${picoHow.from}-L${picoHow.from + 44}`} notes={picoNotes} />
          <CodeFile
            slot="code"
            source={pico}
            lang="py"
            file="pico_direct.py"
            url={RAMPAGE}
            note="The Pico W firmware as it ran on the robot, vendored unmodified. The figure runs src/lib/rampage-firmware.ts, a line for line port of it."
          />
          <Fragment slot="text">
            <p>
              A 30 lb combat robot with a pneumatic plow. I wrote the control software: a Pico W reads the RC receiver with hardware
              interrupts, sequences two valves, enforces a 17 shot air budget and stops on signal loss. A Pi 4B streams video over UDP on its
              own, so a video crash never touches the weapon.
            </p>
          </Fragment>
          <Fragment slot="actions">
            <button type="button" class="btn btn--solid" data-fire>Fire the plow</button>
            <a class="btn" href="/work/rampage/">Case study</a>
          </Fragment>
        </FigureCard>

        <FigureCard id="v2v" fig="02" kind="Receiver chain" flip eyebrow="EE 4003, with Jason Phan" title="V2V collision warning over OFDM">
          <ChainFig />
          <V2vLink slot="drawing" />
          <CodeHow slot="how" excerpt={rxHow} file="src/lib/ofdm-rx.ts" url={`${SELF}/src/lib/ofdm-rx.ts#L${rxHow.from}`} notes={rxNotes} />
          <CodeFile
            slot="code"
            source={ofdmRx}
            lang="ts"
            file="src/lib/ofdm-rx.ts"
            url={`${SELF}/src/lib/ofdm-rx.ts`}
            note="The receiver from V2V_TXRXf.m (github.com/avemath/v2v-bsm-ofdm), ported to run in the browser. The figure runs this file."
          />
          <Fragment slot="text">
            <p>
              A BPSK-OFDM link modeled on 802.11p (the car version of Wi-Fi), running between two PlutoSDRs, which are software radios. I
              built the receiver: packet detection, timing recovery, CFO correction, a Costas loop (it tracks leftover phase drift), MMSE
              equalization and Viterbi decoding. Two cars trade safety messages and the receiver computes time to collision.
            </p>
          </Fragment>
          <Fragment slot="actions">
            <button type="button" class="btn btn--solid" data-step>Step through the receiver</button>
            <a class="btn" href="/work/v2v-bsm-ofdm/">Case study</a>
          </Fragment>
        </FigureCard>

        <FigureCard id="led" fig="03" kind="16 by 16 matrix" eyebrow="Personal project, one built for each sister" title="LED audio spectrum">
          <MatrixFig />
          <LedChain slot="drawing" />
          <CodeHow slot="how" excerpt={ledHow} file="src/lib/led-firmware.ts" url={`${SELF}/src/lib/led-firmware.ts#L${ledHow.from}`} notes={ledNotes} />
          <CodeFile
            slot="code"
            source={ledFw}
            lang="ts"
            file="src/lib/led-firmware.ts"
            url={`${SELF}/src/lib/led-firmware.ts`}
            note="The ESP32 firmware (github.com/avemath/led-audio-spectrum), ported to the browser. The figure runs this file."
          />
          <Fragment slot="text">
            <p>
              An ESP32 drives a 16 by 16 matrix from a microphone: 128 point FFT into 16 log spaced bands, an adaptive noise floor, AGC and
              debounced switching between the spectrum and an idle glow. Tuned so quiet, distant music still reads.
            </p>
          </Fragment>
          <Fragment slot="actions">
            <button type="button" class="btn btn--solid" data-mic>Try it with your mic</button>
            <a class="btn" href="https://github.com/avemath/led-audio-spectrum">Firmware</a>
            <a class="link projects__cs" href="/work/led-audio-spectrum/">Case study</a>
          </Fragment>
        </FigureCard>
      </div>

      <p class="projects__more">Three more below, then the research.</p>

      <ul class="minis">
        <li class="mini paper">
          <div class="fig__bar mini__bar">
            <p class="fig__label">Fig. 04 / Eigenrays</p>
            <p class="fig__label">Figures</p>
          </div>
          <div class="mini__fig" data-draw>
            <Image src={eigenrays} alt="BELLHOP output: the Munk sound speed profile beside 50 rays leaving a source at 1300 m and bending back toward the channel axis over 100 km." widths={[400, 640]} sizes="(min-width: 960px) 24rem, calc(100vw - 2rem)" format="webp" quality={76} loading="lazy" class="mini__img" />
          </div>
          <div class="mini__body">
            <h3 class="mini__title"><a href="/work/bellhop-sim/" class="stretched">bellhopSim</a></h3>
            <p class="mini__offers"><span class="sr-only">Offers: </span>Figures · Drawing · Code</p>
            <p class="mini__text">BELLHOP (a standard model of how sound travels underwater) for shallow water, with the three physics bugs I found and fixed.</p>
          </div>
          <p class="fig__try">Open the figures and the fixes.</p>
        </li>

        <li class="mini paper" data-live-host>
          <div class="fig__bar mini__bar">
            <p class="fig__label">Fig. 05 / Hop pattern</p>
            <div class="tabset" role="tablist" aria-label="Signals playground: views" data-tabs>
              <button type="button" role="tab" id="sig-tab-live" aria-controls="sig-live" aria-selected="true" tabindex="0">Live</button>
              <button type="button" role="tab" id="sig-tab-drawing" aria-controls="sig-drawing" aria-selected="false" tabindex="-1">Drawing</button>
            </div>
          </div>
          <div id="sig-live" role="tabpanel" aria-labelledby="sig-tab-live">
          <div class="mini__fig mini__fig--live" data-live-media data-draw>
            <svg viewBox="0 0 320 120" class="mini__hops" aria-hidden="true">
              {
                hops.map((p, i) => (
                  <rect x={20 + i * 36} y={hopY(toneHz(p, bits[i])) - 2} width="26" height="4" fill={i % 2 ? 'var(--text)' : 'var(--accent)'} />
                ))
              }
            </svg>
            <SignalsLive />
          </div>
          <p class="fig__try">Press Try it, then Play, and listen.</p>
          </div>
          <div id="sig-drawing" role="tabpanel" aria-labelledby="sig-tab-drawing" hidden>
            <SignalsHop />
          </div>
          <div class="mini__note"><MarginNote where="signals" /></div>
          <div class="mini__body">
            <h3 class="mini__title"><a href="/work/signals-playground/">Signals playground</a></h3>
            <p class="mini__offers"><span class="sr-only">Offers: </span>Live · Drawing · Code</p>
            <p class="mini__text">A JANUS style FH-BFSK preamble, one chip at a time. You can hear each hop.</p>
          </div>
        </li>

        <li class="mini paper mini--accent">
          <div class="fig__bar mini__bar">
            <p class="fig__label">In progress</p>
            <p class="fig__label">Research page</p>
          </div>
          <div class="mini__fig" data-draw>
            <svg viewBox="0 0 320 120" class="mini__pool" aria-hidden="true">
              <path d="M30 30 H290 V100 H30 Z" />
              <path class="mini__water" d="M30 42 H290" />
              <circle cx="46" cy="92" r="4" />
              <circle cx="274" cy="92" r="4" />
              <path class="mini__ray" d="M46 92 L160 58 L274 92" />
            </svg>
          </div>
          <div class="mini__body">
            <h3 class="mini__title"><a href="/research/#pool-alarm" class="stretched">Acoustic Pool Alarm</a> <span class="mini__wt">(working title)</span></h3>
            <p class="mini__text">Can a hydrophone tell a swimmer from a child in trouble? My own project with Because of ADAM.</p>
          </div>
          <p class="fig__try">Go below to see the plan.</p>
        </li>
      </ul>
      <p class="projects__all"><a class="btn" href="/work/#engineering">All engineering projects</a></p>
    </div>
  </section>

  <BelowSurface />
  <WebsitesShowcase />
  <div class="ground-alt"><HomeSkills /></div>
</BaseLayout>

<style>
  .projects__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--accent);
  }

  .projects__title {
    margin-top: 0;
  }

  .projects__note {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .projects__cards {
    display: grid;
    gap: 1.75rem;
    margin-top: 1.75rem;
  }

  .projects__all {
    margin-top: 1.75rem;
  }

  .projects__more {
    margin-top: 1.75rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .projects__cs {
    align-self: center;
  }

  .minis {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.75rem;
  }

  @media (min-width: 760px) {
    .minis {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .minis:has([data-live-on]) {
      align-items: start;
    }
  }

  .mini {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .mini--accent {
    border-color: var(--accent);
  }

  .mini__bar {
    min-height: 2.6rem;
  }

  .mini__fig {
    position: relative;
    aspect-ratio: 8 / 3;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .mini__fig[data-live-on] {
    aspect-ratio: auto;
    overflow: visible;
  }

  .mini__fig[data-live-on] > :not(:global(.live)) {
    display: none;
  }

  .mini__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 75% 40%;
  }

  .mini__hops,
  .mini__pool {
    width: 100%;
    height: 100%;
  }

  .mini__pool path {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.25;
  }

  .mini__pool .mini__water {
    stroke: var(--line-strong);
    stroke-dasharray: 4 4;
  }

  .mini__pool circle {
    fill: var(--accent);
  }

  .mini__pool .mini__ray {
    stroke: var(--accent);
  }

  .mini__note {
    padding: 0 1rem;
  }

  .mini__body {
    flex: 1;
    padding: 1rem 1rem 1.15rem;
  }

  .mini__title {
    font-size: 1.1875rem;
    font-variation-settings: 'wdth' 100;
    letter-spacing: -0.01em;
  }

  .mini__title a {
    text-decoration: none;
  }

  .mini__title a:hover {
    text-decoration: underline;
  }

  .mini__wt {
    font-weight: 400;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .mini__offers {
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .mini__text {
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    color: var(--text-soft);
  }
</style>
