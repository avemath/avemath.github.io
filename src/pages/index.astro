---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import NowStrip from '@/components/NowStrip.astro';
import ProjectTile from '@/components/ProjectTile.astro';
import Spotlight from '@/components/Spotlight.astro';
import WebsitesShowcase from '@/components/WebsitesShowcase.astro';
import ResearchSection from '@/components/ResearchSection.astro';
import FieldNotes from '@/components/FieldNotes.astro';
import ContactForm from '@/components/ContactForm.astro';
import Icon from '@/components/Icon.astro';
import DepthGauge from '@/components/DepthGauge.astro';
import RampageLive from '@/components/live/RampageLive.astro';
import V2vLive from '@/components/live/V2vLive.astro';
import LedLive from '@/components/live/LedLive.astro';
import LandspaceLive from '@/components/live/LandspaceLive.astro';
import { zoneStyles } from '@/lib/depth';
import { getProjects } from '@/lib/projects';
import site from '@/data/site.json';
// The tall tile needs a tall photo: the whole robot on the bench, from its gallery.
import rampageBench from '@/assets/projects/rampage/shop-lid.jpg';
import ledMatrix from '@/assets/projects/led-audio-spectrum/matrix-poster.jpg';

const projects = await getProjects();
const bySlug = Object.fromEntries(projects.map((p) => [p.id, p]));

// Featured work shows each project once, the client sites having their own section below. Three
// spotlight rows come first, each with a live version of the project built from its real code;
// then a compact grid of the rest, with the limited-detail research last.
const spotlit = {
  rampage: bySlug['rampage'],
  v2v: bySlug['v2v-bsm-ofdm'],
  led: bySlug['led-audio-spectrum'],
};
const grid = ['landspace', 'bellhop-sim', 'onr-intelligent-data-management'].map((slug) => bySlug[slug]).filter(Boolean);
---

<BaseLayout jsonLd={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url }]}>
  <style is:inline slot="head" set:html={zoneStyles()} />
  <div class="home">
    <Hero />
    <NowStrip />

    <div class="home-flow">
      <section id="featured" class="section home-section zone" aria-labelledby="featured-title" data-section="featured">
        <span class="spine" aria-hidden="true"></span>
        <div class="wrap">
          <div class="fw__head">
            <div>
              <p class="eyebrow">Featured work</p>
              <h2 id="featured-title" class="section-title">
                <span class="aud aud--hire">Radio, sound, a combat robot, a title app and my research</span>
                <span class="aud aud--research">My research, then radio, sound, a robot and a title app</span>
                <span class="aud aud--website">The engineering behind the sites: radio, sound, a robot, a title app and research</span>
              </h2>
              <p class="section-lede split__lede">
                <span class="aud aud--hire">The first projects run right here, from their real code. Every one opens a case study with what I did and how.</span>
                <span class="aud aud--research">Research and communications work, then the engineering and software behind it. The first projects run right here, from their real code.</span>
                <span class="aud aud--website">After the client sites above, the engineering behind how I work. The first projects run right here, from their real code.</span>
              </p>
            </div>
            <div class="fw__links">
              <a class="btn" href="/work/">All work <Icon name="arrow-right" /></a>
              <p class="split__more">
                <a class="link" href="/about/#experience">Experience, skills and recommendations</a> are on the About page.
              </p>
            </div>
          </div>

          <div class="spotlights">
            {
              spotlit.rampage && (
                <Spotlight
                  project={spotlit.rampage}
                  photo={rampageBench}
                  focus="50% 45%"
                  what="The weapon and safety firmware from the robot's Pico W, running in your browser on the same logic, step for step."
                  tryThis={['Press Fire a few times and watch the air count drop from 17.', 'Hit E-stop, then try to fire.', 'Press Reset to reboot the Pico and refill the count.']}
                  why="Weapon safety and video run on separate controllers, a Pico W and a Pi 4B, so neither one can stall the other."
                >
                  <RampageLive />
                </Spotlight>
              )
            }
            {
              spotlit.v2v && (
                <Spotlight
                  project={spotlit.v2v}
                  flip
                  what="Two cars sharing safety messages over my OFDM link, with the receiver that decodes them and the brake rule from my MATLAB code."
                  tryThis={['Drag the closing speed and watch the time to collision change.', 'Find the speed where Brake recommended appears.', 'Press Receive again and watch the four receiver stages lock.']}
                  why="It ran as a real radio link on two ADALM-PLUTO software-defined radios at 2.9 GHz, not only in simulation."
                  metricLabel="Radio link"
                >
                  <V2vLive />
                </Spotlight>
              )
            }
            {
              spotlit.led && (
                <Spotlight
                  project={spotlit.led}
                  photo={ledMatrix}
                  what="The 16 by 16 matrix from my ESP32 build, running the firmware's boot scroll, FFT and silence detection in your browser."
                  tryThis={['Press Power on and watch the boot scroll.', 'Let the demo track play and watch it switch from the glow to the spectrum.', 'Press Try my mic with music playing nearby.']}
                  why="It reads quiet music from across the room and fades to a glow in silence."
                >
                  <LedLive />
                </Spotlight>
              )
            }
          </div>

          <p class="fw__more-label mono">More work</p>
          {/* Every tile image loads lazily: the hero fills the first screen on phones and desktops,
              so even the first tile is below the fold and should not compete with the hero text. */}
          <div class="bento">
            {
              grid.map((p) => (
                <ProjectTile project={p!} size="lg" metric>
                  {p!.id === 'landspace' && <LandspaceLive slot="live" />}
                </ProjectTile>
              ))
            }
          </div>
        </div>
      </section>

      <ResearchSection />
      <WebsitesShowcase />
      <FieldNotes />

      <section id="contact" class="section section--tight home-section zone" aria-labelledby="contact-title" data-section="contact">
        <span class="spine" aria-hidden="true"></span>
        <div class="wrap grid gap-12 lg:grid-cols-[1fr_1.3fr] lg:items-center">
          <div>
            <p class="eyebrow">Contact</p>
            <h2 id="contact-title" class="section-title section-title--sm">Send a note</h2>
            <p class="section-lede">Have a role, a research question or a website in mind? {site.replyTime}</p>
            <ul class="mt-8 space-y-4 contact-list">
              <li>
                <p class="label">Email</p>
                <a class="link mt-1 inline-flex items-center gap-2 text-lg" href={`mailto:${site.email}`}><Icon name="mail" /> {site.email}</a>
              </li>
              <li>
                <p class="label">Elsewhere</p>
                <div class="mt-1 flex flex-wrap gap-4">
                  <a class="link inline-flex items-center gap-2" href={site.socials.linkedin}><Icon name="linkedin" /> LinkedIn</a>
                  <a class="link inline-flex items-center gap-2" href={site.socials.github}><Icon name="github" /> GitHub</a>
                </div>
              </li>
              <li>
                <p class="label">Based in</p>
                <p class="mt-1 inline-flex items-center gap-2 text-soft"><Icon name="pin" /> {site.location}. Happy to work remotely.</p>
              </li>
            </ul>
          </div>
          <div class="card p-6 sm:p-8">
            <ContactForm idPrefix="home" emailLine={false} />
          </div>
        </div>
      </section>
    </div>
    <DepthGauge />
  </div>
</BaseLayout>


<style>
  .home-flow {
    display: flex;
    flex-direction: column;
  }

  /* Section order for each audience comes from src/lib/depth.ts (zoneStyles), together with each
     section's depth, so the order and the depth labels cannot drift apart. */

  .fw__head {
    display: grid;
    gap: 1rem 3rem;
  }

  @media (min-width: 1100px) {
    .fw__head {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      align-items: end;
    }
  }

  .fw__links {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }

  .split__more {
    font-size: 0.92rem;
    color: var(--text-soft);
  }

  .spotlights {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .fw__more-label {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* The rest of the work: a compact grid, one row of three on wide screens. */
  .bento {
    display: grid;
    gap: 1.1rem;
    margin-top: 1rem;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 720px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .bento {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Phones: each tile is a compact row, a cropped picture on the left and the title, a short
     summary and its number on the right. The outcome line and the tech chips stay on wider
     screens and in the case study, so the four tiles fit in about a screen. */
  @media (max-width: 719px) {
    .bento {
      gap: 0.75rem;
    }

    .bento > :global(.tile) {
      grid-area: auto !important;
    }

    .bento :global(.tile__inner) {
      display: grid;
      grid-template-columns: 6.75rem minmax(0, 1fr);
    }

    .bento :global(.tile__media) {
      aspect-ratio: auto;
      min-height: 0 !important;
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }

    /* Drawn art: show its middle, at the full height of the row. */
    .bento :global(.tile__media > .art) {
      position: absolute;
      top: 0;
      left: 50%;
      width: auto;
      height: 100%;
      aspect-ratio: 600 / 375;
      max-width: none;
      translate: -50% 0;
    }

    .bento :global(.tile__live) {
      display: none;
    }

    .bento :global(.tile__body) {
      gap: 0.4rem;
      padding: 0.8rem 0.9rem 0.85rem;
    }

    .bento :global(.tile__body .chip--type) {
      padding: 0.1rem 0.45rem;
      font-size: 0.66rem;
    }

    .bento :global(.tile__title) {
      font-size: 1.05rem;
      line-height: 1.25;
    }

    .bento :global(.tile__summary) {
      font-size: 0.85rem;
      line-height: 1.45;
      -webkit-line-clamp: 2 !important;
    }

    .bento :global(.tile__metric-v) {
      font-size: 1.35rem;
    }

    .bento :global(.tile__outcome),
    .bento :global(.tile__chips) {
      display: none;
    }

    .bento :global(.tile__links) {
      padding-top: 0.5rem;
      font-size: 0.84rem;
    }

    .split__lede {
      display: none;
    }
  }

  /* A tile that spans two rows lets its picture take the extra height, so the text sits at the
     bottom with no gap under it. In the tall slot the picture also grows past its usual ratio. */
  .bento > :global(.tile) :global(.tile__media) {
    flex: 1 1 auto;
    min-height: 12rem;
  }

  .bento > :global(.tile) :global(.tile__body) {
    flex: 0 0 auto;
  }

  .bento > :global(.tile) :global(.tile__img) {
    position: absolute;
    inset: 0;
  }

  /* Phones: the rest of the page tightens too, so the whole descent is a short read. Content is
     the same; only the layout changes, and every link and control stays in the page. */
  @media (max-width: 719px) {
    /* Now strip: two columns. */
    .home :global(.now__grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      column-gap: 1rem;
    }

    .home :global(.now__item) {
      padding: 0.8rem 0 0.9rem !important;
      border-left: 0 !important;
    }

    .home :global(.now__item:nth-child(-n + 2)) {
      border-top: 0 !important;
    }

    .home :global(.now__item dd) {
      font-size: 0.84rem;
    }

    /* Featured: the spotlights sit closer together. */
    .spotlights {
      gap: 2.25rem;
    }

    /* Research: a smaller sound speed chart. */
    .home :global(.ssp__profile) {
      max-width: 12.5rem;
      margin-inline: auto;
    }

    /* Research: the related work lists titles only; each case study has the summary. */
    .home :global(.research__row-sub) {
      display: none !important;
    }

    .home :global(.research__row) {
      padding-block: 0.7rem;
    }

    /* Client sites and field notes: rows you swipe through, with the next card peeking in. */
    .home :global(.sites),
    .home :global(.notes) {
      display: flex !important;
      gap: 0.75rem !important;
      margin-inline: calc(-1 * var(--gutter));
      padding: 0.25rem var(--gutter) 0.75rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      overscroll-behavior-x: contain;
    }

    .home :global(.sites > .site),
    .home :global(.notes > .note) {
      flex: 0 0 84%;
      scroll-snap-align: start;
    }

    /* Contact: the form keeps every field, a little tighter. */
    .home :global(.cform__row) {
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }

    .home :global(.cform textarea) {
      min-height: 0;
      height: 6.5rem;
    }

    #contact :global(.card) {
      padding: 1.1rem;
    }

    /* The footer frame right below lists GitHub, LinkedIn and Baton Rouge, so on a phone the
       contact section keeps only the email line. */
    .contact-list > li:not(:first-child) {
      display: none;
    }

    .contact-list {
      margin-top: 1.25rem;
    }

    /* Featured tiles: the whole tile is the link, so the decorative "Case study" row goes. A tile
       with a live site keeps the row, for that link. */
    .bento :global(.tile__links:not(:has(.tile__ext))) {
      display: none;
    }

    /* The sound speed profile a little narrower, so the figure takes less of the screen. */
    .home :global(.ssp svg.ssp__profile) {
      width: 76%;
      margin-inline: auto;
    }

    .home :global(.hero) {
      padding-bottom: 3.25rem;
    }

    /* Less water between sections: the bands and waves still mark each step down. */
    .home-flow > :global(.section) {
      padding-block: 2.25rem;
    }

    .home-flow > :global(.section--tight) {
      padding-block: 1.9rem;
    }
  }

  /* A live tile while it runs: its panel replaces the picture, and the tile grows to fit it. */
  .bento :global(.tile__media[data-live-on]) {
    aspect-ratio: auto;
  }

  .bento :global(.tile__media[data-live-on] > :not(.live)) {
    display: none;
  }

  @media (max-width: 719px) {
    .bento :global(.tile[data-live-on] .tile__inner) {
      display: flex;
      flex-direction: column;
    }

    .bento :global(.tile__media[data-live-on]) {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    /* At rest on a phone, the button sits under the small picture. */
    .bento :global(.live__try) {
      right: 0.4rem;
      bottom: 0.4rem;
      padding: 0.3rem 0.55rem;
      font-size: 0.66rem;
    }
  }

  /* Audience-specific intro lines. */
  .aud {
    display: none;
  }
  .home:has(#aud-hire:checked) .aud--hire,
  .home:has(#aud-research:checked) .aud--research,
  .home:has(#aud-website:checked) .aud--website {
    display: inline;
  }
  .home:not(:has(input[name='audience']:checked)) .aud--hire {
    display: inline;
  }
</style>
