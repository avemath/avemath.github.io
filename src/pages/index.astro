---
import type { ImageMetadata } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import NowStrip from '@/components/NowStrip.astro';
import ProjectTile from '@/components/ProjectTile.astro';
import WebsitesShowcase from '@/components/WebsitesShowcase.astro';
import ResearchSection from '@/components/ResearchSection.astro';
import FieldNotes from '@/components/FieldNotes.astro';
import ContactForm from '@/components/ContactForm.astro';
import Icon from '@/components/Icon.astro';
import DepthGauge from '@/components/DepthGauge.astro';
import { zoneStyles } from '@/lib/depth';
import { getProjects } from '@/lib/projects';
import site from '@/data/site.json';
// The tall tile needs a tall photo: the whole robot on the bench, from its gallery.
import rampageBench from '@/assets/projects/rampage/shop-lid.jpg';

const projects = await getProjects();
const bySlug = Object.fromEntries(projects.map((p) => [p.id, p]));

// Featured work shows each project once. The client sites have their own strip below, so the
// bento is the research, engineering and software work: one tall tile, one wide tile and four
// smaller ones. Each tile names its grid area, and each audience lays the areas out (see the
// CSS), so a row can never have a hole.
//
// Area check, per audience (desktop 4 columns / tablet 2 columns). RAMpage's photo takes the
// tall slot; the research drawing reads best wide.
//   hire:     ram ram v2v v2v | ram ram led led | onr onr onr onr | land land bell bell
//             tablet: ram v2v | ram led | onr onr | land bell
//   research: onr onr onr onr | ram ram v2v v2v | ram ram bell bell | led led land land
//             tablet: onr onr | ram v2v | ram bell | led land
//   website:  land land land land | ram ram v2v v2v | ram ram led led | onr onr bell bell
//             tablet: land land | ram v2v | ram led | onr bell
// Every area appears once per layout and every row is full. If you add or remove a tile, add its
// area to all six layouts.
const bento: { slug: string; area: string; photo?: ImageMetadata; focus?: string }[] = [
  { slug: 'onr-intelligent-data-management', area: 'onr' },
  { slug: 'v2v-bsm-ofdm', area: 'v2v' },
  { slug: 'led-audio-spectrum', area: 'led' },
  { slug: 'rampage', area: 'ram', photo: rampageBench, focus: '50% 45%' },
  { slug: 'landspace', area: 'land' },
  { slug: 'bellhop-sim', area: 'bell' },
];
---

<BaseLayout jsonLd={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url }]}>
  <style is:inline slot="head" set:html={zoneStyles()} />
  <div class="home">
    <Hero />
    <NowStrip />

    <div class="home-flow">
      <section id="featured" class="section home-section zone" aria-labelledby="featured-title" data-section="featured">
        <span class="spine" aria-hidden="true"></span>
        <div class="wrap pinned">
          <div class="pinned__head">
            <p class="eyebrow">Featured work</p>
            <h2 id="featured-title" class="section-title">
              <span class="aud aud--hire">Radio, sound, a combat robot, a title app and my research</span>
              <span class="aud aud--research">My research, then radio, sound, a robot and a title app</span>
              <span class="aud aud--website">The engineering behind the sites: radio, sound, a robot, a title app and research</span>
            </h2>
            <p class="section-lede split__lede">
              <span class="aud aud--hire">Every tile opens a case study with what I did and how.</span>
              <span class="aud aud--research">Research and communications work first, then the engineering and software behind it. Three tiles open live demos.</span>
              <span class="aud aud--website">After the client sites above, the engineering behind how I work. Every tile opens a case study.</span>
            </p>
            <a class="btn mt-6" href="/work/">All work <Icon name="arrow-right" /></a>
            <p class="split__more">
              <a class="link" href="/about/#experience">Experience, skills and recommendations</a> are on the About page.
            </p>
            <p class="corner" aria-hidden="true">{String(bento.length).padStart(2, '0')} projects</p>
          </div>

          {/* Every tile image loads lazily: the hero fills the first screen on phones and desktops,
              so even the first tile is below the fold and should not compete with the hero text. */}
          <div class="bento">
            {
              bento.map((b) => {
                const p = bySlug[b.slug];
                return p ? <ProjectTile project={p} size="lg" metric photo={b.photo} focus={b.focus} style={`grid-area:${b.area}`} /> : null;
              })
            }
          </div>
        </div>
      </section>

      <ResearchSection />
      <WebsitesShowcase />
      <FieldNotes />

      <section id="contact" class="section section--tight home-section zone" aria-labelledby="contact-title" data-section="contact">
        <span class="spine" aria-hidden="true"></span>
        <div class="wrap grid gap-12 lg:grid-cols-[1fr_1.3fr] lg:items-center">
          <div>
            <p class="eyebrow">Contact</p>
            <h2 id="contact-title" class="section-title section-title--sm">Send a note</h2>
            <p class="section-lede">Have a role, a research question or a website in mind? {site.replyTime}</p>
            <ul class="mt-8 space-y-4">
              <li>
                <p class="label">Email</p>
                <a class="link mt-1 inline-flex items-center gap-2 text-lg" href={`mailto:${site.email}`}><Icon name="mail" /> {site.email}</a>
              </li>
              <li>
                <p class="label">Elsewhere</p>
                <div class="mt-1 flex flex-wrap gap-4">
                  <a class="link inline-flex items-center gap-2" href={site.socials.linkedin}><Icon name="linkedin" /> LinkedIn</a>
                  <a class="link inline-flex items-center gap-2" href={site.socials.github}><Icon name="github" /> GitHub</a>
                </div>
              </li>
              <li>
                <p class="label">Based in</p>
                <p class="mt-1 inline-flex items-center gap-2 text-soft"><Icon name="pin" /> {site.location}. Happy to work remotely.</p>
              </li>
            </ul>
          </div>
          <div class="card p-6 sm:p-8">
            <ContactForm idPrefix="home" emailLine={false} />
          </div>
        </div>
      </section>
    </div>
    <DepthGauge />
  </div>
</BaseLayout>


<style>
  .home-flow {
    display: flex;
    flex-direction: column;
  }

  /* Section order for each audience comes from src/lib/depth.ts (zoneStyles), together with each
     section's depth, so the order and the depth labels cannot drift apart. */

  .split__more {
    margin-top: 1.25rem;
    font-size: 0.92rem;
    color: var(--text-soft);
  }

  @media (min-width: 1100px) {
    .split__lede {
      font-size: 1rem;
    }
  }

  /* Featured bento: named areas, laid out per audience, so every row is full. */
  .bento {
    display: grid;
    gap: 1.1rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (max-width: 719px) {
    .bento > :global(.tile) {
      grid-area: auto !important;
    }
  }

  @media (min-width: 720px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas: 'ram v2v' 'ram led' 'onr onr' 'land bell';
    }

    .home:has(#aud-research:checked) .bento {
      grid-template-areas: 'onr onr' 'ram v2v' 'ram bell' 'led land';
    }

    .home:has(#aud-website:checked) .bento {
      grid-template-areas: 'land land' 'ram v2v' 'ram led' 'onr bell';
    }
  }

  @media (min-width: 1100px) {
    .bento {
      margin-top: 0;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-areas: 'ram ram v2v v2v' 'ram ram led led' 'onr onr onr onr' 'land land bell bell';
    }

    .home:has(#aud-research:checked) .bento {
      grid-template-areas: 'onr onr onr onr' 'ram ram v2v v2v' 'ram ram bell bell' 'led led land land';
    }

    .home:has(#aud-website:checked) .bento {
      grid-template-areas: 'land land land land' 'ram ram v2v v2v' 'ram ram led led' 'onr onr bell bell';
    }
  }

  /* A tile that spans two rows lets its picture take the extra height, so the text sits at the
     bottom with no gap under it. In the tall slot the picture also grows past its usual ratio. */
  .bento > :global(.tile) :global(.tile__media) {
    flex: 1 1 auto;
    min-height: 12rem;
  }

  .bento > :global(.tile) :global(.tile__body) {
    flex: 0 0 auto;
  }

  .bento > :global(.tile) :global(.tile__img) {
    position: absolute;
    inset: 0;
  }

  /* Audience-specific intro lines. */
  .aud {
    display: none;
  }
  .home:has(#aud-hire:checked) .aud--hire,
  .home:has(#aud-research:checked) .aud--research,
  .home:has(#aud-website:checked) .aud--website {
    display: inline;
  }
  .home:not(:has(input[name='audience']:checked)) .aud--hire {
    display: inline;
  }
</style>
