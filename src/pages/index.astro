---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import StatusStrip from '@/components/StatusStrip.astro';
import AboutTeaser from '@/components/AboutTeaser.astro';
import FigureCard from '@/components/fig/FigureCard.astro';
import TimingFig from '@/components/fig/TimingFig.astro';
import ChainFig from '@/components/fig/ChainFig.astro';
import MatrixFig from '@/components/fig/MatrixFig.astro';
import CodeHow from '@/components/fig/CodeHow.astro';
import CodeFile from '@/components/fig/CodeFile.astro';
import V2vStagesHow from '@/components/fig/V2vStagesHow.astro';
import SignalsLive from '@/components/live/SignalsLive.astro';
import BelowSurface from '@/components/BelowSurface.astro';
import MarginNote from '@/components/MarginNote.astro';
import RampageSystem from '@/components/drawings/RampageSystem.astro';
import V2vLink from '@/components/drawings/V2vLink.astro';
import LedChain from '@/components/drawings/LedChain.astro';
import SignalsHop from '@/components/drawings/SignalsHop.astro';
import WebsitesShowcase from '@/components/WebsitesShowcase.astro';
import Toolbox from '@/components/Toolbox.astro';
import site from '@/data/site.json';
import { cut, lineOf, region } from '@/lib/excerpt';
import { hopSequence, toneHz, F_HIGH, F_LOW } from '@/lib/fhbfsk';
import { v2vStages } from '@/lib/v2v-stages';
import eigenrays from '@/assets/projects/bellhop-sim/ssp_and_rays.png';
import pico from '../../vendor/rampage/pico_direct.py?raw';
import ledFw from '../lib/led-firmware.ts?raw';

const SELF = 'https://github.com/avemath/avemath.github.io/blob/main';
// The How it works excerpt links to line numbers, so it points at a commit where the file is the same.
const SELF_PINNED = 'https://github.com/avemath/avemath.github.io/blob/6ad0c1f';
const RAMPAGE = 'https://github.com/avemath/RAMpage/blob/929c280/pico_direct.py';

// Fig. 01, How it works: the strike itself, straight from the Pico's firmware.
const picoHow = cut(pico, '# Increment activation counter', 45, 'py');
const picoNotes: { text: string; lines: [number, number] }[] = [
  { text: 'Count the activation, start the 500 ms cooldown, and lock out once all 17 are used (about the first six push with at least 30 lbf).', lines: [lineOf(pico, '# Increment activation counter'), lineOf(pico, 'weapon_depleted = True') + 1] },
  { text: 'Plow home: the exhaust (main_solenoid, GP14) stays open for 50 ms, then closes, then a 50 ms dwell.', lines: [lineOf(pico, '# 1. Open main valve'), lineOf(pico, '# 4. Dweel time') - 1] },
  { text: 'Plow out: both inlets (piston_solenoid, GP15) open together for 400 ms, full extension.', lines: [lineOf(pico, '# 5. Open piston valves'), lineOf(pico, 'utime.sleep_ms(SOLENOID_ACTIVATION_TIME)')] },
  { text: 'The inlets close and the exhaust reopens, so the plow vents and retracts.', lines: [lineOf(pico, '# 7. Close valves'), lineOf(pico, '# 8. Re-open main valve') + 1] },
];

// Fig. 02: the MATLAB file that ran on the radios, and where each receiver stage sits in it.
// Pinned to a commit, like RAMPAGE, so the stage line ranges never drift from the vendored copy.
const V2V_FILE = 'https://github.com/avemath/v2v-bsm-ofdm/blob/c5328e5/V2V_TXRXf.m';
const v2vLines = v2vStages.map((st, i) => `${i + 1} ${st.name} ${st.lines[0]} to ${st.lines[1]}`).join('; ');

// Fig. 03, How it works: FFT bins into 16 bands, AGC and smoothing, as in loop().
const ledHow = region(ledFw, 'bands', 'ts');
const bandStart = lineOf(ledFw, '#region how:bands');
const ledNotes: { text: string; lines: [number, number] }[] = [
  { text: 'Average the FFT bins inside each of the 16 log-spaced bands, and gate out the noise.', lines: [lineOf(ledFw, 'for (let b = 0; b < 16; b++) {', bandStart), lineOf(ledFw, 'if (val > peak) peak = val;', bandStart) + 1] },
  { text: 'AGC: the full-scale level rises fast with loud music and falls slowly back.', lines: [lineOf(ledFw, 'if (peak > s.levelMax)', bandStart), lineOf(ledFw, 'else s.levelMax = Math.max(LEVELMAX_FLOOR', bandStart)] },
  { text: 'Scale each band to the 16 rows, smooth it, and let the peak dots hold and fall.', lines: [lineOf(ledFw, 'const h = Math.min(H', bandStart), lineOf(ledFw, 'else peakValues[b] = Math.max(0, peakValues[b] - PEAK_FALL_RATE);', bandStart)] },
];

// Fig. 05: the first eight chips of the Signals playground's hop pattern (seed 87).
const bits = [1, 0, 1, 1, 0, 0, 1, 1];
const hops = hopSequence(8, 87);
const hopY = (hz: number) => 12 + ((F_HIGH - hz) / (F_HIGH - F_LOW)) * 96;
---

<BaseLayout jsonLd={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url }]}>
  <Hero />
  <StatusStrip />
  <AboutTeaser />

  <section id="projects" class="section projects" aria-labelledby="projects-title">
    <div class="wrap">
      <div class="projects__head">
        <h2 id="projects-title" class="section-title projects__title" data-decode>Projects</h2>
        <p class="projects__note">every figure is live and built from the real code</p>
      </div>

      <div class="projects__cards">
        <FigureCard id="rampage" fig="01" kind="Timing diagram" wide eyebrow="Senior design capstone, 1st overall in the Bengal Bot Brawl" title="RAMpage">
          <TimingFig />
          <RampageSystem slot="drawing" />
          <CodeHow slot="how" excerpt={picoHow} file="pico_direct.py" url={`${RAMPAGE}#L${picoHow.from}-L${picoHow.from + 44}`} notes={picoNotes} />
          <CodeFile
            slot="code"
            code="pico-direct"
            file="pico_direct.py"
            url={RAMPAGE}
            note="The Pico W firmware as it ran on the robot, vendored unmodified. The figure runs src/lib/rampage-firmware.ts, a line for line port of it."
          />
          <Fragment slot="text">
            <p>
              A 30 lb combat robot with a pneumatic plow. I wrote the control software: a Pico W reads the RC receiver with hardware
              interrupts, sequences the inlet and exhaust valves, and holds a hard limit of 17 activations in firmware, of which about the
              first six push with at least 30 lbf before reservoir pressure drops. A kill, a lost signal or an error opens the exhaust and cuts the
              receiver's power through a solid-state relay. A Pi 4B streams video over UDP on its own, so a video crash never touches the
              weapon.
            </p>
          </Fragment>
          <Fragment slot="actions">
            <button type="button" class="btn btn--solid" data-fire>Fire the plow</button>
            <a class="btn" href="/work/rampage/">Case study</a>
          </Fragment>
        </FigureCard>

        <FigureCard id="v2v" fig="02" kind="Receiver chain" flip eyebrow="EE 4003, with lab partner Jason Phan" title="V2V collision warning over OFDM">
          <ChainFig />
          <V2vLink slot="drawing" />
          <V2vStagesHow slot="how" url={V2V_FILE} />
          <CodeFile
            slot="code"
            code="v2v-txrx"
            file="V2V_TXRXf.m"
            url={V2V_FILE}
            note={`The transmitter and receiver that ran on the radios. The receiver stages, by line: ${v2vLines}. The live figure runs a browser port, src/lib/ofdm-rx.ts.`}
          />
          <Fragment slot="text">
            <p>
              An OFDM radio link (data split across many narrow carriers at once), modeled on IEEE 802.11p (the car version of Wi-Fi), run over the air between two ADALM-PLUTO software radios.
              I designed and wrote the transmitter, the nine-stage receiver and the warning logic. One radio sends both cars' safety
              messages in turn; the other decodes them and computes time to collision. All five hardware runs decoded with zero bit errors.
            </p>
          </Fragment>
          <Fragment slot="actions">
            <button type="button" class="btn btn--solid" data-step>Step through the receiver</button>
            <a class="btn" href="/work/v2v-bsm-ofdm/">Case study</a>
          </Fragment>
        </FigureCard>

        <FigureCard id="led" fig="03" kind="16 by 16 matrix" eyebrow="Personal project, one built for each sister" title="LED audio spectrum">
          <MatrixFig />
          <LedChain slot="drawing" />
          <CodeHow slot="how" excerpt={ledHow} file="src/lib/led-firmware.ts" url={`${SELF_PINNED}/src/lib/led-firmware.ts#L${ledHow.from}`} notes={ledNotes} />
          <CodeFile
            slot="code"
            code="led-firmware"
            file="src/lib/led-firmware.ts"
            url={`${SELF}/src/lib/led-firmware.ts`}
            note="The ESP32 firmware (github.com/avemath/led-audio-spectrum), ported to the browser. The figure runs this file."
          />
          <Fragment slot="text">
            <p>
              An ESP32 drives a 16 by 16 matrix from a microphone: 128 point FFT into 16 log spaced bands, an adaptive noise floor, AGC and
              debounced switching between the spectrum and an idle glow. Tuned so quiet, distant music still reads.
            </p>
          </Fragment>
          <Fragment slot="actions">
            <button type="button" class="btn btn--solid" data-mic>Try it with your mic</button>
            <a class="btn" href="https://github.com/avemath/led-audio-spectrum">Firmware</a>
            <a class="link projects__cs" href="/work/led-audio-spectrum/">Case study</a>
          </Fragment>
        </FigureCard>
      </div>

      <p class="projects__more">Three more below, then the research.</p>

      <ul class="minis">
        <li class="mini paper">
          <div class="fig__bar mini__bar">
            <p class="fig__label">Fig. 04 / Eigenrays</p>
            <p class="fig__label">Figures</p>
          </div>
          <div class="mini__fig" data-draw>
            <Image src={eigenrays} alt="BELLHOP output: the Munk sound speed profile beside 50 rays leaving a source at 1300 m and bending back toward the channel axis over 100 km." widths={[400, 640]} sizes="(min-width: 960px) 24rem, (min-width: 720px) 30vw, calc(100vw - 2rem)" format="webp" quality={76} loading="lazy" class="mini__img" />
          </div>
          <div class="mini__body">
            <h3 class="mini__title"><a href="/work/bellhop-sim/" class="stretched">bellhopSim</a></h3>
            <p class="mini__offers above-stretch">
              <a href="/work/bellhop-sim/#gallery">Figures</a>
              <a href="/research/#bellhop">Drawing</a>
              <a href="https://github.com/avemath/bellhopSim">Code</a>
            </p>
            <p class="mini__text">An interactive BELLHOP (a standard model of how sound travels underwater) simulator, built around the Munk deep-ocean case, with the three physics bugs I found and fixed.</p>
          </div>
          <p class="fig__try">Open the figures and the fixes.</p>
        </li>

        <li class="mini paper" data-live-host>
          <div class="fig__bar mini__bar">
            <p class="fig__label">Fig. 05 / Hop pattern</p>
            <div class="tabset" role="tablist" aria-label="Signals playground: views" data-tabs>
              <button type="button" role="tab" id="sig-tab-live" aria-controls="sig-live" aria-selected="true" tabindex="0">Live</button>
              <button type="button" role="tab" id="sig-tab-drawing" aria-controls="sig-drawing" aria-selected="false" tabindex="-1">Drawing</button>
            </div>
          </div>
          <div id="sig-live" role="tabpanel" aria-labelledby="sig-tab-live">
          <div class="mini__fig mini__fig--live" data-live-media data-draw>
            <svg viewBox="0 0 400 120" preserveAspectRatio="xMinYMid meet" class="mini__hops" aria-hidden="true">
              {
                hops.map((p, i) => (
                  <rect x={20 + i * 36} y={hopY(toneHz(p, bits[i])) - 2} width="26" height="4" fill={i % 2 ? 'var(--text)' : 'var(--accent)'} />
                ))
              }
            </svg>
            <SignalsLive />
          </div>
          <p class="fig__try">Press Try it, then Play, and listen.</p>
          </div>
          <div id="sig-drawing" role="tabpanel" aria-labelledby="sig-tab-drawing" hidden>
            <SignalsHop />
          </div>
          <div class="mini__note"><MarginNote where="signals" /></div>
          <div class="mini__body">
            <h3 class="mini__title"><a href="/work/signals-playground/">Signals playground</a></h3>
            <p class="mini__offers">
              <a href="#sig-live" data-tab-target="sig-tab-live">Live</a>
              <a href="#sig-drawing" data-tab-target="sig-tab-drawing">Drawing</a>
              <a href="https://github.com/avemath/avemath.github.io/blob/main/src/components/demos/SignalsDemo.astro">Code</a>
            </p>
            <p class="mini__text">A JANUS style FH-BFSK preamble, one chip at a time. You can hear each hop.</p>
          </div>
        </li>

        <li class="mini paper mini--accent">
          <div class="fig__bar mini__bar">
            <p class="fig__label">In progress</p>
            <p class="fig__label">Research page</p>
          </div>
          <div class="mini__fig" data-draw>
            <svg viewBox="0 0 320 120" class="mini__pool" aria-hidden="true">
              <path d="M30 30 H290 V100 H30 Z" />
              <path class="mini__water" d="M30 42 H290" />
              <circle cx="160" cy="42" r="4" />
              <path class="mini__ray" d="M142 46 A18 18 0 0 0 178 46 M126 46 A34 34 0 0 0 194 46 M110 46 A50 50 0 0 0 210 46" />
            </svg>
          </div>
          <div class="mini__body">
            <h3 class="mini__title"><a href="/research/#pool-alarm" class="stretched">Acoustic Pool Alarm</a> <span class="mini__wt">(working title)</span></h3>
            <p class="mini__text">Can an alarm that listens underwater tell a swimmer from a child in trouble? My own project.</p>
          </div>
          <p class="fig__try">Go below to see the plan.</p>
        </li>
      </ul>
      <p class="projects__all"><a class="btn" href="/work/#engineering">All engineering projects</a></p>
    </div>
  </section>

  <BelowSurface />
  <div class="ground-alt"><WebsitesShowcase /></div>
  <Toolbox />
</BaseLayout>

<style>
  /* Below the fold, the browser skips laying these out until they near the screen, so the body font's
     swap after first paint relayouts only what is visible. (Not Projects: its sticky RAMpage
     toolbar and tooltips must not be clipped.) */
  :global(.below),
  :global(#websites),
  :global(#toolbox) {
    content-visibility: auto;
    contain-intrinsic-size: auto 1200px;
  }

  .projects__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--accent);
  }

  .projects__title {
    margin-top: 0;
  }

  .projects__note {
    font-size: 1rem;
    color: var(--text-soft);
  }

  .projects__cards {
    display: grid;
    gap: 1.75rem;
    margin-top: 1.75rem;
  }

  .projects__all {
    margin-top: 1.75rem;
  }

  .projects__more {
    margin-top: 1.75rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .projects__cs {
    align-self: center;
  }

  .minis {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.75rem;
  }

  /* Three across only once each column can be about 280px wide. */
  @media (min-width: 1024px) {
    .minis {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .minis:has([data-live-on]) {
      align-items: start;
    }
  }

  .mini {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .mini--accent {
    border-color: var(--accent);
  }

  .mini__bar {
    min-height: 2.6rem;
  }

  .mini__fig {
    position: relative;
    background: var(--fig-tint);
    aspect-ratio: 8 / 3;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .mini__fig[data-live-on] {
    aspect-ratio: auto;
    overflow: visible;
  }

  .mini__fig[data-live-on] > :not(:global(.live)) {
    display: none;
  }

  /* The whole plot, axes included, on its own white paper. */
  .mini__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #fff;
  }

  .mini__hops,
  .mini__pool {
    width: 100%;
    height: 100%;
  }

  .mini__pool path {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.25;
  }

  .mini__pool .mini__water {
    stroke: var(--line-strong);
    stroke-dasharray: 4 4;
  }

  .mini__pool circle {
    fill: var(--accent);
  }

  .mini__pool .mini__ray {
    stroke: var(--accent);
  }

  .mini__note {
    padding: 0 1rem;
  }

  .mini__body {
    flex: 1;
    padding: 1rem 1rem 1.15rem;
  }

  .mini__title {
    font-size: 1.1875rem;
    letter-spacing: -0.01em;
  }

  .mini__title a {
    text-decoration: none;
  }

  .mini__title a:hover {
    text-decoration: underline;
  }

  .mini__wt {
    font-weight: 400;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .mini__offers {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    margin-top: 0.2rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .mini__offers a {
    padding-block: 0.2rem;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.25em;
  }

  .mini__text {
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    color: var(--text-soft);
  }
</style>
