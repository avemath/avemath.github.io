---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SignalPanel from '@/components/SignalPanel.astro';
---

<BaseLayout title="No carrier" description="There is nothing at this address." noindex>
  <section class="nf on-navy dot-grid">
    <div class="wrap nf__grid">
      <div>
        <p class="nf__code mono">404</p>
        <h1 class="nf__title">No carrier.</h1>
        <p class="nf__text">There is nothing at this address.</p>
        <p class="nf__links">
          <a class="btn" href="/">Back to the surface</a>
          <a class="link" href="/work/">Or see all work</a>
        </p>
      </div>
      <SignalPanel empty />
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: clamp(3rem, 8vw, 6rem);
    min-height: calc(100dvh - 4rem);
  }

  .nf__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .nf__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }

  .nf__code {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .nf__title {
    margin-top: 0.75rem;
    font-size: clamp(3rem, 8vw, 5.25rem);
  }

  .nf__text {
    margin-top: 1.25rem;
    color: var(--muted);
  }

  .nf__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 2rem;
  }

  .nf__links .btn {
    --btn-line: var(--on-navy);
  }
</style>
