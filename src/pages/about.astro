---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import NowStrip from '@/components/NowStrip.astro';
import site from '@/data/site.json';
import offclock from '@/data/offclock.json';
import gradHall from '@/assets/about/grad-taylor-hall.jpg';
import gradTiger from '@/assets/about/grad-tiger.jpg';
import rePlus from '@/assets/about/re-plus.jpg';

// A real portrait replaces the scope the moment a file named portrait.* lands in src/assets.
const portraitFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/portrait.{jpg,jpeg,png,webp}', { eager: true });
const portrait = Object.values(portraitFiles)[0]?.default;

// Off-the-clock photos are optional; entries without one render as text cards.
const offclockFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/offclock/*.{jpg,jpeg,png,webp}', { eager: true });
const offclockPhoto = (name: string) => (name ? Object.entries(offclockFiles).find(([p]) => p.endsWith(`/${name}`))?.[1].default : undefined);

// Topographic contour texture: a nod to land work and Louisiana waterways. Leaf green on the paper theme.
const contours = Array.from({ length: 14 }, (_, i) => {
  let d = '';
  for (let x = -20; x <= 1220; x += 30) {
    const y = 40 + i * 42 + Math.sin(x / 140 + i * 0.7) * 22 + Math.sin(x / 47 + i) * 6;
    d += `${x === -20 ? 'M' : 'L'} ${x} ${y.toFixed(1)} `;
  }
  return d;
});

const principles = [
  ['Say what\'s true', 'Every claim gets a source, a number or a link. If I don\'t know, I say so.'],
  ['Build for everyone', 'Keyboard, screen reader, slow phone, reduced motion. If it doesn\'t work for them, it doesn\'t work.'],
  ['Hand it over', 'The people who own a thing should be able to run it without me. I write the guide.'],
  ['Test the scary part', 'Kill switches, signal loss, empty air tanks. Find out on the bench, not in the arena.'],
];
---

<BaseLayout title="About" description="About Avery Matherne: computer engineer, graduate researcher at LSU, web designer, land agent and nonprofit co-founder.">
  <section class="about-hero">
    <svg class="contours" viewBox="0 0 1200 620" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      {contours.map((d, i) => <path d={d} style={`--i:${i}`} />)}
    </svg>
    <div class="wrap about-hero__inner">
      <div>
        <p class="eyebrow">About</p>
        <h1 class="about-title">I like systems that work when it matters.</h1>
        <p class="section-lede">
          I'm Ave. I'm a computer engineer and graduate researcher at LSU, I design and build websites, I do ownership research as a land agent, and
          I co-founded a drowning awareness nonprofit with my family. It sounds like a lot of different things. It's mostly the same thing:
          figuring out how something really works, then building it so other people can rely on it. Away from a desk I'm outside, usually
          around plants.
        </p>
      </div>
      {
        portrait ? (
          <div class="portrait portrait--photo">
            <Image src={portrait} alt={site.name} widths={[320, 480, 640]} sizes="(min-width: 960px) 16rem, 60vw" format="webp" quality={82} />
          </div>
        ) : (
          <div class="portrait" aria-hidden="true">
            <svg viewBox="0 0 200 200">
              <circle cx="100" cy="100" r="96" />
              <circle cx="100" cy="100" r="70" />
              <circle cx="100" cy="100" r="44" />
              <path d="M100 100 L168 32" class="portrait__sweep" />
              <text x="100" y="112" text-anchor="middle">AM</text>
            </svg>
          </div>
        )
      }
    </div>
  </section>

  <NowStrip />

  <section class="section">
    <div class="wrap about-grid">
    <div class="prose about-prose">
      <h2>Engineering</h2>
      <p>
        I studied computer engineering at LSU, with a minor in computer science, on the Tiger Excellence Non-Resident Award all four
        years. The work that hooked me lives where hardware meets signals. For senior design I was lead programmer on
        <a href="/work/rampage/">RAMpage</a>, a 30 lb pneumatic combat robot that took first place. In my communications design course I
        went past a research assignment and built a <a href="/work/v2v-bsm-ofdm/">vehicle-to-vehicle radio link</a> on real
        software-defined radios. On my own time I built an <a href="/work/led-audio-spectrum/">LED spectrum visualizer</a> that runs
        FFTs on live audio.
      </p>
      <p>
        Now I'm working on an M.S. in electrical and computer engineering, focused on communications and signal processing, and I'm a
        graduate research assistant on an <a href="/work/onr-intelligent-data-management/">Office of Naval Research project</a> with
        Integer Technologies, where I also interned. The radio link is how I got there: Dr. Aldo Duarte recommended me for the project
        based on that work in his course.
      </p>
      <figure class="about-fig">
        <div class="about-fig__pair">
          <Image src={gradHall} alt="Avery in an LSU graduation gown tossing a cap into the air in front of Patrick F. Taylor Hall." widths={[400, 640, 800]} sizes="(min-width: 1100px) 20rem, 50vw" format="webp" quality={80} />
          <Image src={gradTiger} alt="Avery in a graduation gown hugging the bronze tiger statue on campus." widths={[400, 640, 800]} sizes="(min-width: 1100px) 20rem, 50vw" format="webp" quality={80} />
        </div>
        <figcaption>Graduation day, May 2026, outside Patrick F. Taylor Hall and at the tiger statue.</figcaption>
      </figure>

      <h2>Websites</h2>
      <p>
        The people closest to me needed websites, and I wanted to build them right: a
        <a href="/work/petro-land-ventures/">land services firm</a>, my sister's
        <a href="/work/grace-mae-alterations/">bridal alterations studio</a>, and our family's
        <a href="/work/because-of-adam/">nonprofit</a>. Each one is fast, accessible, tested, and editable by the person who owns it. Now I
        take on projects for small businesses and nonprofits. <a href="/services/">Here's how I work.</a>
      </p>

      <h2>Land work</h2>
      <p>
        Since 2020 I've worked as a contract land agent, doing ownership research and permitting coordination for oil, gas and renewable
        energy projects. It's detail work with real money and real families on the other end, and it taught me to be precise with records
        and clear with people. It's also why I built <a href="/work/landspace/">Landspace</a>: I wanted the map, the records and the title
        problems in one place.
      </p>
      <figure class="about-fig">
        <Image src={rePlus} alt="Avery and her brother smiling side by side at a crowded conference venue, both wearing lanyards." widths={[640, 960, 1280]} sizes="(min-width: 1100px) 42rem, 100vw" format="webp" quality={80} />
        <figcaption>At RE+, a renewable energy conference, with my brother.</figcaption>
      </figure>

      <h2>Why water matters to me</h2>
      <p>
        On June 5, 2017, my little brother Adam drowned in our backyard pool. He was 14 months old, and the house was full of family.
        He survived. In 2020 my siblings and I started <a href="/work/because-of-adam/">Because of ADAM</a> to share
        everything we wish we'd known: drowning is fast and silent, and layers of protection save lives.
      </p>
    </div>
    <aside class="about-rail" aria-labelledby="rules-title">
      <p class="eyebrow">How I work</p>
      <h2 id="rules-title" class="section-title section-title--sm">Four rules I keep</h2>
      <dl class="rules">
        {
          principles.map(([t, b], i) => (
            <div class="rule card" data-reveal>
              <dt>
                <span class="mono rule__n" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                {t}
              </dt>
              <dd>{b}</dd>
            </div>
          ))
        }
      </dl>
    </aside>
    </div>
  </section>

  <section id="off-the-clock" class="section section--tight" aria-labelledby="offclock-title">
    <div class="wrap">
      <p class="eyebrow">Off the clock</p>
      <h2 id="offclock-title" class="section-title section-title--sm">When I'm not building something</h2>
      <p class="section-lede">The parts of me that don't show up on a résumé.</p>
      <ul class="offclock">
        {
          offclock.map((o) => {
            const photo = offclockPhoto(o.photo);
            return (
              <li class="offclock__item card" data-reveal>
                {photo && (
                  <div class="offclock__photo">
                    <Image src={photo} alt={o.alt} widths={[480, 720, 960]} sizes="(min-width: 960px) 24rem, 100vw" format="webp" quality={80} />
                  </div>
                )}
                <div class="offclock__body">
                  <p class="label">{o.label}</p>
                  <h3 class="offclock__title">{o.title}</h3>
                  <p class="offclock__text">{o.text}</p>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="section section--band">
    <div class="wrap">
      <div class="about-cta card">
        <p class="font-display text-2xl font-semibold tracking-tight">Want to work together, or just talk shop?</p>
        <div class="flex flex-wrap gap-3">
          <a class="btn btn--primary" href="/contact/">Send a note <Icon name="arrow-right" /></a>
          <a class="btn" href={site.resumePdf} download><Icon name="download" /> Résumé</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* isolation keeps the z-index: -1 contours inside this box; without it they fall behind
     the body background and never paint. */
  .about-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(4rem, 9vw, 7rem) clamp(3rem, 6vw, 5rem);
  }

  /* The contour lines sit behind the scope on the right, not behind the headline. */
  .contours {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    -webkit-mask-image: linear-gradient(90deg, transparent 30%, #000 65%);
    mask-image: linear-gradient(90deg, transparent 30%, #000 65%);
  }

  .contours path {
    fill: none;
    stroke: var(--leaf);
    stroke-opacity: calc(0.09 + var(--i) * 0.02);
    stroke-width: 1;
  }

  :global(:root:not([data-theme='dark'])) .contours path {
    stroke-opacity: calc(0.16 + var(--i) * 0.025);
  }

  .about-hero__inner {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .about-hero__inner {
      grid-template-columns: 1.6fr 1fr;
    }
  }

  .about-title {
    margin-top: 1rem;
    max-width: 15ch;
    font-size: clamp(2.6rem, 6.5vw, 4.75rem);
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .portrait {
    justify-self: center;
    width: min(16rem, 60vw);
    aspect-ratio: 1;
    padding: 1rem;
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent-wash), transparent 70%);
  }

  .portrait svg {
    width: 100%;
    height: 100%;
  }

  /* Below the two-column layout the placeholder scope would sit alone under the intro, so
     it is hidden; a real portrait shows at a modest size instead. */
  @media (max-width: 959px) {
    .about-hero__inner {
      gap: 2rem;
    }

    .portrait:not(.portrait--photo) {
      display: none;
    }

    .portrait--photo {
      width: min(11rem, 40vw);
      justify-self: start;
    }
  }

  /* With a photo, the ring becomes a frame: the image fills the circle and the wash stays behind it. */
  .portrait--photo {
    padding: 0.5rem;
    background: radial-gradient(circle, var(--accent-wash), transparent 72%);
  }

  .portrait--photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
  }

  .offclock {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .offclock__item {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: none;
  }

  .offclock__photo {
    aspect-ratio: 1;
    background: var(--surface-2);
  }

  .offclock__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .offclock__body {
    padding: 1.35rem 1.4rem 1.5rem;
  }

  .offclock__title {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .offclock__text {
    margin-top: 0.5rem;
    color: var(--text-soft);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .portrait circle {
    fill: none;
    stroke: var(--accent);
    stroke-opacity: 0.45;
  }

  .portrait__sweep {
    stroke: var(--amber);
    stroke-width: 2;
    stroke-linecap: round;
    transform-origin: 100px 100px;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-motion='reduce'])) .portrait__sweep {
      animation: spin 8s linear infinite;
    }
  }

  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }

  .portrait text {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 600;
    fill: var(--text);
    letter-spacing: -1px;
  }

  .about-prose h2:first-child {
    margin-top: 0;
  }

  .about-fig {
    margin: 0;
  }

  .about-fig__pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .about-fig :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 1rem;
  }

  .about-fig figcaption {
    margin-top: 0.7rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  /* The story reads at a measure on the left; the four rules keep it company on the right. */
  .about-grid {
    display: grid;
    gap: 3rem;
  }

  .about-prose {
    max-width: 42rem;
  }

  @media (min-width: 1100px) {
    .about-grid {
      grid-template-columns: minmax(0, 42rem) minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }

    .about-rail {
      position: sticky;
      top: 6rem;
    }

    /* One compact column in the rail, so the cards keep a readable measure. */
    .about-grid .rules {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      margin-top: 1.5rem;
    }

    .about-grid .rule {
      padding: 1.1rem 1.25rem;
    }

    .about-grid .rule dt {
      margin-top: 0.25rem;
    }
  }

  /* Two by two on tablets and four across on desktop, so four cards never leave a lone one. */
  .rules {
    display: grid;
    gap: 1rem;
    margin-top: 2.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 560px) {
    .rules {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .rules {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .rule {
    padding: 1.5rem;
    box-shadow: none;
  }

  .rule__n {
    display: block;
    margin-bottom: 0.6rem;
    font-size: 0.75rem;
    color: var(--accent-ink);
  }

  :global([data-theme='dark']) .rule__n {
    color: var(--accent);
  }

  @media (max-width: 719px) {
    .rule {
      padding: 1.2rem 1.25rem;
    }

    .rule dt {
      margin-top: 0.3rem;
    }
  }

  .rule dt {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
  }

  .rule dd {
    margin-top: 0.4rem;
    color: var(--text-soft);
    font-size: 0.95rem;
  }

  .about-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }
</style>
