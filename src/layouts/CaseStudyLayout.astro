---
import { Image, getImage } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import ProjectArt from '@/components/ProjectArt.astro';
import Icon from '@/components/Icon.astro';
import { type Project, typeLabels, statusLabels, projectHref, workSection, workSections } from '@/lib/projects';
import { formatRange } from '@/lib/format';
import site from '@/data/site.json';

interface Props {
  project: Project;
  headings: MarkdownHeading[];
  prev?: Project;
  next?: Project;
}

const { project, headings, prev, next } = Astro.props;
const d = project.data;
const finished = d.status === 'complete' || d.status === 'archived';
const period = formatRange(d.period.start, d.period.end ?? (finished ? d.period.start : null));
const limited = d.confidentiality === 'limited';
// The contents list covers the demo and the gallery too, not only the Markdown headings.
const toc = [
  ...(d.demo ? [{ slug: 'demo', text: 'Try it in your browser' }] : []),
  ...headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text })),
  ...(d.gallery && !limited ? [{ slug: 'gallery', text: 'Gallery' }] : []),
];

// Clips in the gallery get an optimized poster; nothing downloads until someone presses play.
const posters = new Map<string, string>();
for (const g of d.gallery ?? []) {
  if ('video' in g) posters.set(g.video, (await getImage({ src: g.poster, width: 1280, format: 'webp', quality: 80 })).src);
}
// Gallery photos and figures link to a full-size copy, so dense figures stay readable on a phone.
const fullSize = new Map<number, string>();
for (const [i, g] of (d.gallery ?? []).entries()) {
  if (!('video' in g)) fullSize.set(i, (await getImage({ src: g.src, format: 'webp', quality: 85 })).src);
}
const ogImage = `/og/${project.id}.png`;
// The nav marks Projects for engineering, Websites for sites and Research for research.
const sec = workSection(project);
const navSection = sec === 'engineering' ? 'projects' : sec;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: d.title,
    description: d.summary,
    url: new URL(projectHref(project), Astro.site).href,
    creator: { '@id': `${site.url}/#person` },
    dateCreated: d.period.start,
    keywords: d.stack.join(', '),
    ...(d.links.live ? { sameAs: d.links.live } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Work', item: `${site.url}/work/` },
      { '@type': 'ListItem', position: 2, name: d.title, item: new URL(projectHref(project), Astro.site).href },
    ],
  },
];
---

<BaseLayout
  title={d.seoTitle ?? d.title}
  description={d.seoDescription ?? d.summary}
  image={ogImage}
  type="article"
  jsonLd={jsonLd}
  section={navSection}
>
  <article class="case descent">
    <div class="case__zone case__zone--top">
    <header class="case__head">
      <div class="wrap wrap--case">
        <nav aria-label="Breadcrumb" class="crumbs no-print">
          <ol>
            <li><a href="/work/" class="link">Work</a></li>
            <li><a href={`/work/#${sec}`} class="link">{workSections.find((s) => s.id === sec)!.label}</a></li>
            <li aria-current="page">{d.title}</li>
          </ol>
        </nav>

        <div class="case__intro">
        <div class="case__intro-text">
        <div class="mt-8 flex flex-wrap items-center gap-2">
          <span class="chip chip--type">{typeLabels[d.type]}</span>
          <span class="chip">
            {(d.status === 'live' || d.status === 'ongoing') && <span class="status-dot" aria-hidden="true" />}
            {statusLabels[d.status]}
          </span>
          {
            limited && (
              <span class="chip chip--limited">
                <Icon name="lock" class="h-3 w-3" /> Limited detail
              </span>
            )
          }
        </div>

        <h1 class="case__title">{d.title}</h1>
        <p class="case__summary">{d.summary}</p>
        </div>

        {/* The project's signature beside the title: its cover where it has one, or its drawn art.
            Limited-detail projects only ever show their drawn art. */}
        {
          d.cover && !limited ? (
            <div class="case__sig no-print">
              <Image
                src={d.cover}
                alt={d.coverAlt ?? ''}
                widths={[400, 560, 720, 960]}
                sizes="(min-width: 1216px) 30rem, (min-width: 1024px) 38vw, calc(100vw - 2rem)"
                format="webp"
                quality={78}
                loading="eager"
                fetchpriority="high"
              />
            </div>
          ) : (
            <div class="case__sig no-print" aria-hidden="true">
              <ProjectArt slug={project.id} fit="meet" />
            </div>
          )
        }
        </div>

        <dl class="case__facts">
          <div>
            <dt class="label">My role</dt>
            <dd>{d.role}</dd>
          </div>
          {
            d.team && (
              <div>
                <dt class="label">Team</dt>
                <dd>{d.team}</dd>
              </div>
            )
          }
          <div>
            <dt class="label">When</dt>
            <dd>{period}</dd>
          </div>
          <div>
            <dt class="label">Built with</dt>
            <dd>
              <ul class="flex flex-wrap gap-1.5 pt-1">
                {d.stack.map((s) => <li class="chip">{s}</li>)}
              </ul>
            </dd>
          </div>
        </dl>

        <div class="mt-8 flex flex-wrap gap-3 no-print">
          {
            d.links.live && (
              <a class="btn btn--primary" href={d.links.live}>
                Visit site <Icon name="arrow-up-right" />
              </a>
            )
          }
          {
            d.links.repo && !limited && (
              <a class="btn" href={d.links.repo}>
                <Icon name="github" /> View on GitHub
              </a>
            )
          }
          {
            d.links.writeup && (
              <a class="btn" href={d.links.writeup}>
                Public announcement <Icon name="arrow-up-right" />
              </a>
            )
          }
        </div>
      </div>
    </header>

    <div class="wrap wrap--case">
      {
        d.metrics && !limited && (
          <dl class="case__metrics">
            {d.metrics.map((m) => (
              <div>
                <dd class="case__metric">{m.value}</dd>
                <dt class="label">{m.label}</dt>
              </div>
            ))}
          </dl>
        )
      }
    </div>

    </div>

    <div class="case__zone">
    <slot name="demo" />

    <div class="case__body">
      {
        toc.length > 2 && (
          <aside class="case__toc no-print" aria-label="On this page">
            <p class="label">On this page</p>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`} data-toc-link>
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </aside>
        )
      }
      <div class="prose case__prose" data-fig-viewer={project.id === 'v2v-bsm-ofdm' ? '' : undefined}>
        <slot />
      </div>
    </div>

    </div>

    <div class="case__zone case__zone--end">
    {
      d.gallery && !limited && (
        <section id="gallery" class="case__gallery-wrap" aria-labelledby="gallery-title">
          <h2 id="gallery-title" class="section-title section-title--sm">Gallery</h2>
          <div class="case__gallery">
            {d.gallery.map((g, i) => (
              <figure class="shot" data-reveal>
                <div class="shot__img">
                  {'video' in g ? (
                    <video controls muted playsinline preload="none" loop={g.loop} poster={posters.get(g.video)} aria-label={g.alt}>
                      <source src={g.video} type="video/mp4" />
                      <track kind="captions" src={g.captions} srclang="en" label="English" default />
                    </video>
                  ) : (
                    <a class="shot__link" href={fullSize.get(i)}>
                      <Image src={g.src} alt={g.alt} widths={[640, 800, 960, 1280, 1600, 2000]} sizes="(min-width: 1100px) 1000px, 100vw" format="webp" quality={80} />
                      <span class="sr-only">(opens full size)</span>
                    </a>
                  )}
                </div>
                {g.caption && <figcaption>{g.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      )
    }

    {
      // The first and last case studies already offer "All work" in the pager, so the link would repeat it.
      prev && next && <p class="wrap wrap--case case__all no-print"><a class="link" href="/work/"><Icon name="arrow-left" class="inline h-4 w-4" /> Back to all work</a></p>
    }
    <nav class="wrap wrap--case case__pager no-print" aria-label="More projects">
      {
        prev ? (
          <a class="pager card card--lift" href={projectHref(prev)}>
            <span class="label">
              <Icon name="arrow-left" class="inline h-3 w-3" /> Previous
            </span>
            <span class="pager__title">{prev.data.title}</span>
          </a>
        ) : (
          <a class="pager card card--lift" href="/work/">
            <span class="label">
              <Icon name="arrow-left" class="inline h-3 w-3" /> Browse
            </span>
            <span class="pager__title">All work</span>
          </a>
        )
      }
      {
        next ? (
          <a class="pager pager--next card card--lift" href={projectHref(next)}>
            <span class="label">
              Next <Icon name="arrow-right" class="inline h-3 w-3" />
            </span>
            <span class="pager__title">{next.data.title}</span>
          </a>
        ) : (
          prev && (
            <a class="pager pager--next card card--lift" href="/work/">
              <span class="label">
                Browse <Icon name="arrow-right" class="inline h-3 w-3" />
              </span>
              <span class="pager__title">All work</span>
            </a>
          )
        )
      }
    </nav>

    <section class="wrap wrap--case pb-16 md:pb-24 no-print">
      <div class="case__cta card">
        <div>
          <p class="font-display text-2xl font-medium tracking-tight">Want to talk about this project?</p>
          <p class="mt-1 text-soft">I'm happy to go deeper on any of it. {site.replyTime}</p>
        </div>
        <a class="btn btn--primary" href={`/contact/?topic=${d.type === 'client-site' || d.type === 'nonprofit' ? 'website' : d.type === 'research' ? 'research' : 'job'}`}>
          Get in touch <Icon name="arrow-right" />
        </a>
      </div>
    </section>
    </div>
  </article>
</BaseLayout>

<style>
  .case__zone--top {
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  /* Without a metrics row the head already ends in its own padding; the zone adds only a little,
     so every case study opens its body the same distance below the head. */
  .case__zone--top:not(:has(.case__metrics)) {
    padding-bottom: 1rem;
  }

  .case__zone--end {
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  /* Without a gallery the body's own bottom padding is the gap, as it is after a gallery. */
  .case__zone--end:not(:has(.case__gallery-wrap)) {
    padding-top: 0;
  }

  .case__head {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(2rem, 4vw, 3rem);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  /* The slash trails each item, so a wrapped line never starts with one. */
  .crumbs li:not(:last-child)::after {
    content: '/';
    margin-left: 0.5rem;
    color: var(--muted);
  }

  .crumbs a {
    display: inline-block;
    padding-block: 0.3rem;
  }

  .crumbs [aria-current] {
    padding-block: 0.3rem;
    color: var(--text);
  }

  .case__all {
    margin-block: clamp(2.5rem, 5vw, 3.5rem) 1.25rem;
    font-size: 0.9375rem;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.92rem;
  }

  /* Title block on the left, the project's signature on the right, as tall as the title block.
     On phones the signature stacks below the summary. */
  .case__intro {
    display: grid;
    gap: 1.75rem;
  }

  @media (min-width: 1024px) {
    .case__intro {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: clamp(2rem, 4vw, 3.5rem);
      align-items: stretch;
    }
  }

  .case__sig {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: color-mix(in oklab, var(--surface-2) 70%, var(--bg));
    box-shadow: var(--shadow);
  }

  @media (min-width: 1024px) {
    .case__sig {
      align-self: end;
      aspect-ratio: auto;
      height: 100%;
      min-height: 15rem;
      max-height: 24rem;
    }
  }

  .case__sig :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .case__title {
    margin-top: 1.25rem;
    max-width: 18ch;
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  .case__summary {
    margin-top: 1.25rem;
    max-width: 44rem;
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    color: var(--text-soft);
  }

  .case__facts {
    display: grid;
    gap: 1.25rem 2rem;
    margin-top: 2.25rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .case__facts {
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    }
  }

  .case__facts dd {
    margin-top: 0.35rem;
    font-size: 0.95rem;
  }

  .case__metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--surface);
  }

  /* Labels start at the top and values sit on one baseline at the bottom, however the labels wrap. */
  .case__metrics > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: space-between;
    gap: 0.35rem;
    padding: 1.25rem 1.4rem;
  }

  .case__metrics > div + div {
    border-left: 1px solid var(--line);
  }

  @media (max-width: 560px) {
    .case__metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .case__metrics > div + div {
      border-left: 0;
    }

    .case__metrics > div:nth-child(even) {
      border-left: 1px solid var(--line);
    }

    .case__metrics > div:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }

    .case__metrics > div:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  .case__metrics .label {
    text-wrap: balance;
  }

  /* At 320 a half-width cell needs a little less padding to fit a word like "accessibility". */
  @media (max-width: 359px) {
    .case__metrics > div {
      padding-inline: 1rem;
    }
  }

  .case__metric {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  /* A fluid layout: the contents rail (about 220px) on the left, then a content column that grows
     with the screen. Text stops at about 80 characters; figures, images and code break out wider,
     up to about 1100px. Body type grows a little on large screens. The gallery uses the same
     columns, so its photos line up with the figures above. */
  .case__body,
  .case__gallery-wrap {
    --rail: 220px;
    --rail-gap: clamp(2rem, 3vw, 3.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    width: 100%;
    max-width: calc(var(--rail) + var(--rail-gap) + 1100px + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .case__body {
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .case__prose {
    font-size: clamp(1.0625rem, 0.95rem + 0.28vw, 1.25rem);
    line-height: 1.62;
  }

  .case__prose > :global(:is(figure, pre, table, .case__fig, video, .figure-wide)) {
    max-width: 1100px;
  }

  @media (min-width: 1024px) {
    .case__body {
      grid-template-columns: var(--rail) minmax(0, 1fr);
      gap: var(--rail-gap);
    }

    .case__gallery-wrap {
      padding-left: calc(var(--gutter) + var(--rail) + var(--rail-gap));
    }
  }

  .case__toc {
    display: none;
  }

  @media (min-width: 1024px) {
    .case__toc {
      display: block;
      position: sticky;
      top: 6rem;
      align-self: start;
    }
  }

  .case__toc ol {
    margin-top: 0.85rem;
    border-left: 1px solid var(--line);
  }

  .case__toc a {
    display: block;
    margin-left: -1px;
    padding: 0.35rem 0 0.35rem 0.9rem;
    border-left: 1px solid transparent;
    font-size: 0.9rem;
    color: var(--text-soft);
    text-decoration: none;
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .case__toc a:hover,
  .case__toc a[aria-current='true'] {
    color: var(--text);
    border-left-color: var(--accent);
  }

  .case__prose > :global(h2:first-child) {
    margin-top: 0;
  }

  /* A photo placed in the text (written as a <figure> in the Markdown): the whole photo, never
     cropped, with its caption under it. An instant print keeps its own white border, smaller. */
  .case__prose :global(.case__fig) {
    margin: 2rem 0;
  }

  .case__prose :global(.case__fig p) {
    margin: 0;
  }

  .case__prose :global(.case__fig img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }

  /* An instant print shows at the text column's full width (it is portrait, so never taller than
     most of the screen), with its own white border. */
  .case__prose :global(.case__fig--print) {
    max-width: min(80ch, 100%);
  }

  .case__prose :global(.case__fig--print img) {
    max-height: 92vh;
    width: auto;
    max-width: 100%;
    margin-inline: auto;
  }

  .case__prose :global(.case__fig--print img) {
    border: 0;
    box-shadow: var(--shadow);
  }

  .case__prose :global(.case__fig figcaption) {
    margin-top: 0.6rem;
    font-size: 0.875rem;
    color: var(--text-soft);
  }

  /* The gallery spans the contents rail and the reading column (62rem), from the container's edge. */
  .case__gallery-wrap {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .case__gallery {
    max-width: 1100px;
  }

  /* Same size as the other section headings in the case study, on the gallery's own left edge. */
  .case__gallery-wrap > .section-title {
    font-size: 1.75rem;
  }

  .case__gallery {
    display: grid;
    gap: 2rem 1.25rem;
    margin-top: 1.5rem;
    counter-reset: shot;
  }

  /* One shot per row, each at the gallery's full width: no small photos. A portrait photo is held
     to most of the screen's height and centered. */
  .shot__img :global(img) {
    max-height: 88vh;
    object-fit: contain;
  }

  /* Each shot spans two rows of the gallery grid (image, caption), so captions in a row line up
     even when the images differ in height. */
  .shot {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 0;
    align-content: start;
    margin: 0;
    counter-increment: shot;
  }

  .shot__img {
    align-self: start;
  }

  /* Specimen captions: "Fig. N." in Bodoni italic, then the caption. */
  .shot figcaption::before {
    content: 'Fig. ' counter(shot) '. ';
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.9375rem;
    color: var(--text);
  }

  :global([data-theme='dark']) .shot figcaption::before {
    color: var(--accent-ink);
  }

  .shot__img {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 1rem;
    box-shadow: var(--shadow);
    background: var(--surface);
  }

  .shot__img :global(img),
  .shot__img :global(video) {
    display: block;
    width: 100%;
    height: auto;
  }

  .shot__img :global(video) {
    background: var(--screen);
  }

  /* The clips are about 860 to 960 px wide; shown any wider they turn soft, so they stop there. */
  .shot:has(video) {
    width: 100%;
    max-width: 54rem;
  }

  /* The frame clips anything outside it, so a video's focus ring sits inside its edge. */
  .shot__img :global(video:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: -3px;
  }

  .shot__link {
    position: relative;
    display: block;
    cursor: zoom-in;
  }

  /* The frame clips overflow and the image would cover an inset outline, so the focus ring is drawn on top. */
  .shot__link:focus-visible {
    outline: none;
  }

  .shot__link:focus-visible::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 1rem;
    box-shadow: inset 0 0 0 3px var(--accent);
    pointer-events: none;
  }

  .shot figcaption {
    margin-top: 0.85rem;
    font-size: 0.9rem;
    color: var(--text-soft);
  }

  .case__pager {
    display: grid;
    gap: 1rem;
    padding-bottom: 2rem;
  }

  @media (min-width: 720px) {
    .case__pager {
      grid-template-columns: 1fr 1fr;
    }
  }

  .case__pager > .pager:only-child {
    grid-column: 1 / -1;
  }

  @media (max-width: 719px) {
    .case__pager {
      padding-bottom: 1.25rem;
    }

    .pager {
      padding: 0.9rem 1.2rem;
      gap: 0.2rem;
    }
  }

  .pager {
    display: grid;
    gap: 0.4rem;
    padding: 1.25rem 1.4rem;
    text-decoration: none;
    box-shadow: none;
  }

  .pager--next {
    text-align: right;
  }

  .pager__title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
  }

  .case__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }
</style>

<script>
  import { mountFigureViewer } from '../scripts/figure-viewer';
  document.querySelectorAll<HTMLElement>('[data-fig-viewer]').forEach(mountFigureViewer);
  // Highlight the table of contents entry for the section in view.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  if (links.length) {
    const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter(Boolean) as HTMLElement[];
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => a.setAttribute('aria-current', String(a.hash.slice(1) === e.target.id)));
        }
      },
      { rootMargin: '-20% 0px -70% 0px' },
    );
    targets.forEach((t) => io.observe(t));
  }
</script>
