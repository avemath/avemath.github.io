---
import { PAPER } from '@/lib/theme';
import '@/styles/global.css';
import SEO from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import BitGirl from '@/components/BitGirl.astro';
import Footer from '@/components/Footer.astro';
import CommandPalette from '@/components/CommandPalette.astro';
import site from '@/data/site.json';
// The Latin font files, preloaded so text can render in the right face on first paint.
import bodoniUrl from '@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-wght-normal.woff2?url';
import bodoniItalicUrl from '@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-wght-italic.woff2?url';

// Hanken Grotesk sets the body text, including the hero's lines (often the largest text on a phone).
import hankenUrl from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';

// A page whose first screen also uses the handwriting or the mono face asks for them too, so they
// arrive before the first paint instead of swapping in after it (About).
import kalamUrl from '@fontsource/kalam/files/kalam-latin-400-normal.woff2?url';
import monoUrl from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

const extraFonts = { hand: kalamUrl, mono: monoUrl };

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  bare?: boolean;
  /** An optional small label at the right of the nav. */
  navLabel?: string;
  /** Which nav item to mark as the current place, when the path alone does not say. */
  section?: 'projects' | 'websites' | 'research';
  /** The research page has its own footer: back to the surface, and the links. */
  footer?: 'default' | 'research' | 'links';
  /** Set on <html> as data-page, for a page that scopes its own palette (About). */
  page?: string;
  /** The bit girl lives on this page (home, About, Research); the footer is one of her perches. */
  bitGirl?: boolean;
  /** Faces beyond the body and display ones that this page's first screen uses, to preload. */
  preloadFonts?: (keyof typeof extraFonts)[];
}

const { bare = false, navLabel, section, footer = 'default', page, bitGirl = false, preloadFonts = [], ...seo } = Astro.props;
const fontPreloads = [hankenUrl, bodoniUrl, bodoniItalicUrl, ...preloadFonts.map((f) => extraFonts[f])];
---

<!doctype html>
<html lang="en" data-theme="dark" data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content={PAPER.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={PAPER.dark} media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Apply saved or system theme and motion settings before first paint.
      (function () {
        var d = document.documentElement;
        var theme, motion;
        try {
          theme = localStorage.getItem('theme');
          motion = localStorage.getItem('motion');
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        d.dataset.theme = theme;
        // Arriving at a #section lands instantly: a smooth jump still under way when the page
        // finishes loading can end in the wrong place. Smooth scrolling returns once landed.
        if (location.hash.length > 1) d.dataset.landing = '';
        // The browser chrome follows the chosen theme, even when it differs from the system's.
        var pick = document.querySelector('meta[name="theme-color"][media*="' + theme + '"]');
        if (pick) document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) { m.setAttribute('content', pick.getAttribute('content')); });
        // Lets CSS show controls that only work with JavaScript, before first paint, so they never shift the page.
        d.classList.add('js');
        if (motion === 'reduce') d.dataset.motion = 'reduce';
      })();
    </script>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {fontPreloads.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO {...seo} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {!bare && <Header label={navLabel} section={section} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!bare && <Footer variant={footer} perch={bitGirl} />}
    {bitGirl && <BitGirl />}
    <CommandPalette />

    <script>
      import { initPreferenceControls } from '../scripts/preferences';
      import { initReveals, initDrawIn } from '../scripts/motion';
      import { initDecodeHeadings } from '../scripts/decode-headings';
      import { initSketches } from '../scripts/sketch';
      import { initTexture } from '../scripts/texture';
      import { initTabs } from '../scripts/tabs';
      import { initHScroll } from '../scripts/hscroll';
      initPreferenceControls();
      initReveals();
      initDecodeHeadings();
      initDrawIn();
      initTabs();
      initSketches();
      initTexture();

      // Arriving at a #section: once the fonts and the page have loaded (which can move things above
      // it), land on the section again, unless the visitor has already scrolled.
      if (location.hash.length > 1) {
        let moved = false;
        for (const ev of ['wheel', 'touchmove', 'keydown', 'pointerdown']) addEventListener(ev, () => (moved = true), { once: true, passive: true });
        const land = () => {
          const id = decodeURIComponent(location.hash.slice(1));
          const target = document.getElementById(id);
          if (target && !moved) target.scrollIntoView({ block: 'start', behavior: 'instant' });
        };
        // Until a moment after load, any change in the page's height (images, fonts, figures
        // laying out) lands again; then smooth scrolling comes back.
        const ro = new ResizeObserver(land);
        ro.observe(document.body);
        const settle = () => {
          land();
          setTimeout(() => {
            land();
            ro.disconnect();
            delete document.documentElement.dataset.landing;
          }, 1200);
        };
        document.fonts?.ready.then(land);
        if (document.readyState === 'complete') settle();
        else addEventListener('load', settle, { once: true });
      }
      initHScroll();
    </script>

    {
      // Analytics wait for the load event, so the beacon's third-party connection never competes
      // with the hero text. It still reads the page's timings from the buffered performance entries.
      site.cloudflareAnalyticsToken && (
        <script is:inline define:vars={{ beacon: JSON.stringify({ token: site.cloudflareAnalyticsToken }) }}>
          addEventListener('load', function () {
            // Only the live site reports; a local preview would only log the beacon's CORS refusal.
            if (location.hostname !== 'avemath.github.io') return;
            var s = document.createElement('script');
            s.defer = true;
            s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
            s.setAttribute('data-cf-beacon', beacon);
            document.body.appendChild(s);
          });
        </script>
      )
    }
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
