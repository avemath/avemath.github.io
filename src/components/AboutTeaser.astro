---
// A short About on the home page, so the person behind the work is one scroll away: the About
// portrait, whole, and the first lines of its opening, with a link to the rest.
import { Image } from 'astro:assets';
import portrait from '@/assets/portrait.jpg';
---

<section class="about-t band-paper" aria-labelledby="about-t-title">
  <div class="wrap about-t__row">
    <Image src={portrait} alt="Avery in a white dress, smiling, in front of a light wood wall." widths={[240, 360, 540, 720, 960]} sizes="(min-width: 900px) 22.5rem, min(70vw, 18rem)" format="webp" quality={80} loading="lazy" class="about-t__photo" />
    <div class="about-t__text">
      <p class="eyebrow about-t__eyebrow">About</p>
      <h2 id="about-t-title" class="section-title about-t__title">I like systems that work when it matters.</h2>
      <p class="about-t__lede">
        I'm Ave. I'm a graduate researcher in electrical and computer engineering at LSU, I design and build websites, I do ownership research as a land
        agent, and I co-founded a drowning awareness nonprofit with my family. It's mostly the same thing: figuring out how something
        really works, then building it so other people can rely on it.
      </p>
      <a class="btn about-t__more" href="/about/">More about me</a>
    </div>
  </div>
</section>

<style>
  /* A full feature band: the portrait large (about 360px at 1440, growing with the screen), the
     heading at section size and the words at the large body size. */
  .about-t {
    padding-block: clamp(3.5rem, 8vw, 7rem);
  }

  .about-t__row {
    display: grid;
    gap: 2rem clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }

  @media (min-width: 900px) {
    .about-t__row {
      grid-template-columns: 22.5rem minmax(0, 1fr);
    }
  }

  /* The whole photo, never cropped: fixed width, its own height. */
  .about-t__photo {
    width: min(70vw, 18rem);
    height: auto;
    border: 1px solid var(--line);
    box-shadow: var(--plate-shadow);
  }

  @media (min-width: 900px) {
    .about-t__photo {
      width: 22.5rem;
    }
  }

  .about-t__eyebrow {
    color: var(--muted);
  }

  .about-t__title {
    max-width: 16ch;
    line-height: 1;
  }

  .about-t__lede {
    margin-top: 1.25rem;
    max-width: 38em;
    font-size: clamp(1.15rem, 1.4vw, 1.375rem);
    line-height: 1.55;
    color: var(--text-soft);
  }

  .about-t__more {
    margin-top: 1.75rem;
  }
</style>
