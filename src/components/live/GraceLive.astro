---
// The Grace Mae live version: the bustle explorer from gracemaealterations.com, working here.
// The drawing is the site's own code (vendor/gracemae, compiled to src/lib/bustle-drawing.js);
// the wording is the explorer's (vendor/gracemae/bustle-text.json). See src/scripts/live/grace.ts.
import LiveShell from './LiveShell.astro';
import text from '../../../vendor/gracemae/bustle-text.json';

const STYLES = [
  ['american', 'American'],
  ['french', 'French'],
  ['austrian', 'Austrian'],
  ['ballroom', 'Ballroom'],
  ['detachable-train', 'Detachable train'],
] as const;
const TRAINS = [
  ['sweep', text.bustleTrainSweep],
  ['chapel', text.bustleTrainChapel],
  ['cathedral', text.bustleTrainCathedral],
] as const;
---

<LiveShell
  kind="grace"
  description="The bustle explorer from gracemaealterations.com, working here. Pick a bustle style and a train length, then bustle it to see the train lift the way it would after the ceremony."
  href="/work/grace-mae-alterations/"
  hrefLabel="How I built the site"
>
  <p slot="title" class="gm__title mono">gracemaealterations.com · Bustle guide</p>

  <div class="gm">
    <div class="gm__drawing">
      <svg viewBox="0 0 680 520" role="img" aria-labelledby="gm-title gm-desc" data-gm-svg>
        <title id="gm-title" data-gm-title></title>
        <desc id="gm-desc">The gown drawn from the back and from the side. Gold arrows show where each pickup point goes.</desc>
        <defs data-gm-defs></defs>
        <rect x="0" y="0" width="680" height="520" fill="url(#gm-glow)"></rect>
        <line x1="360" y1="40" x2="360" y2="480" stroke="rgba(250,247,242,0.08)"></line>
        <g data-gm-layer></g>
        <text x="20" y="34" class="gm__view" data-gm-wide>{text.bustleBack.toUpperCase()}</text>
        <text x="380" y="34" class="gm__view" data-gm-wide>{text.bustleSide.toUpperCase()}</text>
      </svg>
      <div class="gm__views" role="group" aria-label="View">
        <button type="button" data-gm-view="side" aria-pressed="true" hidden>{text.bustleSide}</button>
        <button type="button" data-gm-view="back" aria-pressed="false" hidden>{text.bustleBack}</button>
      </div>
      <div class="gm__caption" aria-hidden="true">
        <p class="gm__stage" data-gm-stage></p>
        <p class="gm__step" data-gm-step></p>
      </div>
    </div>

    <div class="gm__controls">
      <fieldset>
        <legend>{text.bustleStyleLegend}</legend>
        <div class="gm__chips">
          {
            STYLES.map(([id, name], i) => (
              <label class="gm__chip">
                <input type="radio" name="gm-style" value={id} checked={i === 0} />
                {name}
              </label>
            ))
          }
        </div>
      </fieldset>
      <fieldset>
        <legend>{text.bustleTrainLegend}</legend>
        <div class="gm__chips">
          {
            TRAINS.map(([id, name]) => (
              <label class="gm__chip">
                <input type="radio" name="gm-train" value={id} checked={id === 'chapel'} />
                {name}
              </label>
            ))
          }
        </div>
      </fieldset>
      <div class="gm__go">
        <button type="button" class="btn btn--small btn--primary" data-gm-toggle>{text.bustleButtonUp}</button>
        <label class="gm__slider">
          <span class="sr-only">{text.bustleSliderLabel}</span>
          <input type="range" min="0" max="100" value="0" data-gm-slider />
        </label>
      </div>
      <p class="sr-only" aria-live="polite" data-gm-spoken></p>

      <div class="gm__info">
        <p class="gm__name" data-gm-name></p>
        <p class="gm__also" data-gm-also></p>
        <p class="gm__how" data-gm-how></p>
        <p class="gm__pts"><b>{text.bustleTypicalPoints}:</b> <span data-gm-points></span></p>
        <p class="gm__key">
          <span><svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="3.5" fill="#C9A84C"></circle></svg>{text.bustleKeyHook}</span>
          <span><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="4.2" fill="none" stroke="#C9A84C" stroke-width="1.4" stroke-dasharray="2.2 2"></circle></svg>{text.bustleKeyTie}</span>
        </p>
      </div>
    </div>
  </div>
</LiveShell>

<style>
  .gm__title {
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .gm {
    display: grid;
    gap: 0.85rem;
  }

  /* The drawing in the site's own colors: near black, ivory and gold, in both of this site's themes. */
  .gm__drawing {
    position: relative;
    overflow: hidden;
    border: 1px solid rgb(250 247 242 / 0.1);
    background: #1f1b1b;
  }

  .gm__drawing svg {
    display: block;
    width: 100%;
    height: auto;
    max-height: 22rem;
  }

  .gm__view {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 2.2px;
    fill: rgb(250 247 242 / 0.6);
  }

  .gm__views {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    display: flex;
  }

  .gm__views button {
    min-height: 2rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid rgb(250 247 242 / 0.3);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #faf7f2;
    cursor: pointer;
  }

  .gm__views button[aria-pressed='true'] {
    background: #faf7f2;
    color: #1c1c1c;
  }

  .gm__views button[hidden] {
    display: none;
  }

  .gm__caption {
    position: absolute;
    inset: auto 0 0;
    padding: 2rem 0.85rem 0.6rem;
    background: linear-gradient(to top, #1f1b1b, rgb(31 27 27 / 0.85) 60%, transparent);
    pointer-events: none;
  }

  .gm__stage {
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #c9a84c;
  }

  .gm__step {
    margin-top: 0.1rem;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-size: 1rem;
    line-height: 1.35;
    color: #faf7f2;
  }

  .gm__controls {
    display: grid;
    gap: 0.7rem;
  }

  @container (min-width: 34rem) {
    .gm__controls {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 1.25rem;
    }

    .gm__go,
    .gm__info {
      grid-column: 1 / -1;
    }
  }

  .gm__controls fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .gm__controls legend {
    margin-bottom: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-soft);
  }

  .gm__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .gm__chip {
    display: inline-flex;
    align-items: center;
    min-height: 2.1rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.35rem;
    font-size: 0.8rem;
    cursor: pointer;
  }

  .gm__chip:has(:checked) {
    border-color: var(--text);
    background: var(--text);
    color: var(--bg);
  }

  .gm__chip:has(:focus-visible) {
    outline: 2px solid var(--amber-line);
    outline-offset: 2px;
  }

  .gm__chip input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .gm__go {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .gm__go .btn {
    flex: none;
    min-width: 7.5rem;
  }

  .gm__slider {
    flex: 1;
    min-width: 0;
  }

  .gm__slider input {
    width: 100%;
    accent-color: var(--accent-ink);
  }

  .gm__info {
    padding-top: 0.7rem;
    border-top: 1px solid var(--line);
    font-size: 0.8rem;
    color: var(--text-soft);
  }

  .gm__name {
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-size: 1.3rem;
    color: var(--text);
  }

  .gm__also {
    font-size: 0.72rem;
  }

  .gm__how {
    margin-top: 0.45rem;
    color: var(--text);
  }

  .gm__pts {
    margin-top: 0.35rem;
  }

  .gm__pts b {
    font-weight: 600;
    color: var(--text);
  }

  .gm__key {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-top: 0.5rem;
    font-size: 0.72rem;
  }

  .gm__key span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
</style>
