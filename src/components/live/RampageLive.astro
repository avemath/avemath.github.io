---
// The RAMpage live tile: the real weapon and safety firmware (src/lib/rampage-firmware.ts) behind
// a small control panel, and the robot's system as built. Picking a block shows the code that runs
// on it, cut at build time from the vendored firmware (vendor/rampage), with its real line numbers.
import LiveShell from './LiveShell.astro';
import { MAX_WEAPON_ACTIVATIONS } from '@/lib/rampage-firmware';
import pico from '../../../vendor/rampage/pico_direct.py?raw';
import pi4 from '../../../vendor/rampage/pi4_direct.py?raw';

const REPO = 'https://github.com/avemath/RAMpage/blob/929c280';

/** `count` lines of `source`, starting at the first line that contains `from`. */
function cut(source: string, file: string, from: string, count: number) {
  const lines = source.split('\n');
  const start = lines.findIndex((l) => l.includes(from));
  if (start < 0) throw new Error(`RAMpage excerpt not found: ${from}`);
  const body = lines.slice(start, start + count);
  const indent = Math.min(...body.filter((l) => l.trim()).map((l) => l.match(/^ */)![0].length));
  return { code: body.map((l) => l.slice(indent)).join('\n'), file, from: start + 1, to: start + count, url: `${REPO}/${file}#L${start + 1}-L${start + count}` };
}

const KW = /^(def|if|else|elif|return|for|in|not|and|or|global|try|except|break|continue|True|False|None|pass|while)$/;
/** A small Python highlighter: comments, strings, numbers and keywords. */
function highlight(code: string) {
  const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const token = /(#[^\n]*)|(f?"(?:[^"\\\n]|\\.)*"|f?'(?:[^'\\\n]|\\.)*')|(\b\d+(?:\.\d+)?\b)|([A-Za-z_]\w*)/g;
  let out = '';
  let last = 0;
  for (const m of code.matchAll(token)) {
    out += esc(code.slice(last, m.index));
    const [t, com, str, num, word] = m;
    if (com) out += `<span class="hl-c">${esc(t)}</span>`;
    else if (str) out += `<span class="hl-s">${esc(t)}</span>`;
    else if (num) out += `<span class="hl-n">${esc(t)}</span>`;
    else if (word && KW.test(word)) out += `<span class="hl-k">${esc(t)}</span>`;
    else out += esc(t);
    last = m.index! + t.length;
  }
  return out + esc(code.slice(last));
}

const blocks = [
  {
    id: 'rx',
    name: 'FlySky receiver',
    role: 'Drive, and two switch channels',
    text: 'The Pico times each pulse from the receiver with a pin interrupt on both edges, and throws out anything outside 900 to 2100 microseconds.',
    ex: cut(pico, 'pico_direct.py', 'global ch5_pulse_start, ch5_pulse_width, ch5_last_update', 10),
  },
  {
    id: 'esc',
    name: 'ESCs',
    role: 'Drive motors',
    text: "No code runs here. The receiver feeds the speed controllers directly, so a software crash can't take away steering.",
    ex: null,
  },
  {
    id: 'pico',
    name: 'Pico W',
    role: 'Weapon and safety',
    text: 'Each strike runs a fixed valve sequence. This is its second half: drive the piston valve for 400 ms, then reset both valves.',
    ex: cut(pico, 'pico_direct.py', '# 5. Open piston valves to extend plow', 11),
  },
  {
    id: 'pi',
    name: 'Pi 4B',
    role: 'Video over UDP',
    text: 'Each frame is JPEG encoded, stepping quality down until it fits in one 65,000 byte datagram. A frame that still does not fit is skipped, never split.',
    ex: cut(pi4, 'pi4_direct.py', 'if packet_size <= MAX_UDP_SIZE:', 12),
  },
];
---

<LiveShell
  kind="rampage"
  description={`A small version of RAMpage's weapon and safety firmware. Fire the plow, trip the E-stop and reset. The robot carries air for ${MAX_WEAPON_ACTIVATIONS} strikes and locks out at zero. Pick a block of the system to read the code that runs on it.`}
  href="/work/rampage/#demo"
  hrefLabel="Full simulator, with the serial log"
>
  <p slot="title" class="rl__title mono">RAMpage · Pico W firmware</p>

  <div class="rl__status">
    <span class="rl__led" data-rl-led aria-hidden="true"></span>
    <p class="rl__state" data-rl-state aria-live="polite">Starting up</p>
    <p class="rl__air mono"><span data-rl-left>{MAX_WEAPON_ACTIVATIONS}</span> of {MAX_WEAPON_ACTIVATIONS} air</p>
  </div>
  <ol class="rl__shots" aria-hidden="true" data-rl-shots>
    {Array.from({ length: MAX_WEAPON_ACTIVATIONS }, () => <li />)}
  </ol>

  <div class="rl__valves" aria-hidden="true">
    <svg viewBox="0 0 120 44" class="rl__plow" data-rl-plow>
      <path d="M 6 38 H 114" class="rl__floor" />
      <g class="rl__wedge"><path d="M 20 36 L 96 36 L 96 24 Z" /></g>
    </svg>
    <p class="mono">Main valve <b data-rl-main>OPEN</b></p>
    <p class="mono">Piston valve <b data-rl-piston>CLOSED</b></p>
  </div>

  <div class="rl__controls">
    <button type="button" class="btn btn--small btn--primary" data-rl-fire>Fire</button>
    <button type="button" class="btn btn--small rl__estop" data-rl-kill aria-pressed="false">E-stop</button>
    <button type="button" class="btn btn--small" data-rl-reset title="Reboots the Pico, like a power cycle">Reset</button>
  </div>

  <div class="rl__sys">
    <p class="rl__label mono">System, as built</p>
    <div class="rl__blocks" role="group" aria-label="System blocks">
      {
        blocks.map((b, i) => (
          <button type="button" class="rl__block" data-rl-block={b.id} aria-pressed={i === 2 ? 'true' : 'false'} aria-controls="rl-code">
            <span class="rl__bname">{b.name}</span>
            <span class="rl__brole">{b.role}</span>
          </button>
        ))
      }
    </div>
    <div id="rl-code" class="rl__code">
      {
        blocks.map((b, i) => (
          <div data-rl-code={b.id} hidden={i !== 2}>
            <p class="rl__text">{b.text}</p>
            {b.ex && (
              <>
                <pre tabindex="0" aria-label={`Code from ${b.ex.file}, lines ${b.ex.from} to ${b.ex.to}`}><code set:html={highlight(b.ex.code)} /></pre>
                <a class="rl__src mono" href={b.ex.url}>
                  {b.ex.file} · lines {b.ex.from} to {b.ex.to}
                </a>
              </>
            )}
          </div>
        ))
      }
    </div>
  </div>
</LiveShell>

<style>
  .rl__title,
  .rl__label {
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .rl__status {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .rl__led {
    flex: none;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: var(--surface-2);
  }

  .rl__led[data-on] {
    border-color: var(--amber-line);
    background: var(--amber);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--amber) 30%, transparent);
  }

  .rl__state {
    flex: 1;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .rl__state[data-tone='bad'] {
    color: var(--danger);
  }

  .rl__state[data-tone='warn'] {
    color: var(--amber-ink);
  }

  .rl__air {
    font-size: 0.74rem;
    color: var(--text-soft);
  }

  .rl__air span {
    font-size: 1rem;
    color: var(--text);
  }

  .rl__shots {
    display: grid;
    grid-template-columns: repeat(17, minmax(0, 1fr));
    gap: 2px;
  }

  .rl__shots li {
    height: 0.4rem;
    border-radius: 1px;
    background: var(--accent);
  }

  .rl__shots li[data-spent] {
    background: var(--line);
  }

  .rl__valves {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: 0.75rem;
    align-items: center;
    font-size: 0.72rem;
    color: var(--text-soft);
  }

  .rl__plow {
    grid-row: 1 / 3;
    width: 100%;
  }

  .rl__floor {
    stroke: var(--line-strong);
  }

  .rl__wedge {
    fill: var(--accent);
    transform-origin: 96px 36px;
    transform-box: view-box;
    transition: rotate 0.12s ease-out;
  }

  .rl__plow[data-up] .rl__wedge {
    fill: var(--amber-line);
    rotate: -22deg;
  }

  .rl__valves b {
    font-weight: 600;
    color: var(--text);
  }

  .rl__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .rl__estop[aria-pressed='true'] {
    border-color: var(--danger);
    color: var(--danger);
  }

  .rl__sys > *,
  .rl__code > * {
    min-width: 0;
  }

  .rl__sys {
    display: grid;
    gap: 0.5rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line);
  }

  .rl__blocks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem;
  }

  /* With room, the four blocks sit in one row and the code opens full width below them. */
  @container (min-width: 34rem) {
    .rl__blocks {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .rl__block {
    display: grid;
    gap: 0.1rem;
    padding: 0.45rem 0.55rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.45rem;
    text-align: left;
    cursor: pointer;
  }

  .rl__block[aria-pressed='true'] {
    border-color: var(--accent-ink);
    background: var(--accent-wash);
  }

  .rl__bname {
    font-weight: 600;
    font-size: 0.84rem;
  }

  .rl__brole {
    font-size: 0.72rem;
    color: var(--text-soft);
  }

  .rl__text {
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--text-soft);
  }

  .rl__code pre {
    margin-top: 0.45rem;
    max-height: 12rem;
    overflow: auto;
    padding: 0.55rem 0.65rem;
    border-radius: 0.4rem;
    background: #061523;
    color: #d6e6ee;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    line-height: 1.5;
    font-variant-ligatures: none;
  }

  .rl__code code {
    white-space: pre;
  }

  .rl__code :global(.hl-k) {
    color: #8fd3ea;
  }

  .rl__code :global(.hl-n) {
    color: #f5c27a;
  }

  .rl__code :global(.hl-s) {
    color: #a9dfb5;
  }

  .rl__code :global(.hl-c) {
    color: #9fb4c0;
    font-style: italic;
  }

  .rl__src {
    display: inline-block;
    margin-top: 0.3rem;
    font-size: 0.66rem;
    color: var(--muted);
  }
</style>
