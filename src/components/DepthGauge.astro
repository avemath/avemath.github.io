---
// The research page's depth gauge: a scale from the surface to 100 m at the right edge, with a
// marker at the current depth. The depth is wherever the reading line (40% down the screen)
// crosses a section, interpolated across that section's range from src/lib/depth.ts. The same
// number goes into the nav label ("depth 36 m"). Wide screens only; the nav label carries it on
// phones. Decorative: every section's own label states its range in text.
import { gaugeMarks, MAX_DEPTH } from '@/lib/depth';
---

<div class="gauge" aria-hidden="true" data-gauge>
  <div class="gauge__scale">
    {
      gaugeMarks.map((m) => (
        <span class="gauge__mark" style={`--at:${m / MAX_DEPTH}`}>
          {m === 0 || m === MAX_DEPTH ? `${m} m` : m}
        </span>
      ))
    }
    <span class="gauge__dot" data-gauge-dot></span>
  </div>
</div>

<style>
  .gauge {
    display: none;
  }

  @media (min-width: 1280px) {
    .gauge {
      display: block;
      position: fixed;
      z-index: 5;
      top: 6rem;
      bottom: 3rem;
      right: max(1rem, calc((100vw - 76rem) / 2 - 4.5rem));
      width: 3.5rem;
      pointer-events: none;
    }
  }

  .gauge__scale {
    position: relative;
    height: 100%;
    border-left: 1px solid var(--line);
  }

  .gauge__mark {
    position: absolute;
    left: 0.45rem;
    top: calc(var(--at) * 100%);
    translate: 0 -50%;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .gauge__dot {
    position: absolute;
    left: -4px;
    top: calc(var(--depth, 0) * 100%);
    width: 7px;
    height: 7px;
    margin-top: -3.5px;
    border-radius: 50%;
    background: var(--accent);
    transition: top 0.25s ease-out;
  }
</style>

<script>
  import { MAX_DEPTH, zones } from '../lib/depth';

  const gauge = document.querySelector<HTMLElement>('[data-gauge]');
  const label = document.querySelector<HTMLElement>('[data-nav-label]');
  const root = document.querySelector<HTMLElement>('[data-under]');
  const sections = zones.map((z) => ({ z, el: document.getElementById(z.id) })).filter((s) => s.el);

  let queued = false;
  function update() {
    queued = false;
    const line = innerHeight * 0.4;
    let depth = 0;
    for (const { z, el } of sections) {
      const r = el!.getBoundingClientRect();
      if (r.top > line) break;
      const t = Math.min(1, (line - r.top) / Math.max(1, r.height));
      depth = z.from + t * (z.to - z.from);
    }
    const m = Math.round(depth);
    if (label) label.textContent = `depth ${m} m`;
    gauge?.style.setProperty('--depth', String(depth / MAX_DEPTH));
    root?.style.setProperty('--depth', String(depth / MAX_DEPTH));
  }
  const onScroll = () => {
    if (!queued) (queued = true), requestAnimationFrame(update);
  };
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', onScroll);
  update();
</script>
