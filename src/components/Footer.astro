---
import { execSync } from 'node:child_process';
import site from '@/data/site.json';

interface Props {
  /** The research page ends underwater, with a way back up instead of "Say hi." */
  variant?: 'default' | 'research';
}

const { variant = 'default' } = Astro.props;
const year = new Date().getFullYear();
// The revision: the date of the last commit, read at build time. Falls back to the build date
// where git is not available.
let rev = new Date().toISOString().slice(0, 10);
let commit = '';
try {
  [rev, commit] = execSync('git log -1 --format=%cs%n%H', { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim().split('\n');
} catch {
  // No git here: keep the build date, with no link.
}
---

<footer id="contact" class:list={['site-footer on-navy no-print', variant === 'research' && 'site-footer--deep']}>
  <div class="wrap foot">
    {
      variant === 'research' ? (
        <p class="foot__back">
          <a class="btn" href="/">Back to the surface</a>
          <a class="foot__link" href="/#websites">Or see the websites</a>
        </p>
      ) : (
        <div>
          <p class="foot__hi">Say hi.</p>
          <p class="foot__where">{site.location}. I answer email.</p>
        </div>
      )
    }
    <ul class="foot__links">
      <li><a class="foot__link" href={`mailto:${site.email}`}>{site.email}</a></li>
      <li><a class="foot__link" href={site.socials.github} rel="me">GitHub</a></li>
      {variant === 'default' && <li><a class="foot__link" href={site.socials.linkedin} rel="me">LinkedIn</a></li>}
      <li><a class="foot__link foot__link--accent" href={site.resumePdf} download>Résumé (PDF)</a></li>
    </ul>
  </div>

  <div class="foot__bar">
    <div class="wrap foot__bar-row">
      <nav aria-label="Footer">
        <ul class="foot__site">
          <li><a href="/work/">All work</a></li>
          <li><a href="/research/">Research</a></li>
          <li><a href="/services/">Services</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/resume/">Résumé</a></li>
        </ul>
      </nav>
      <button type="button" class="motion-toggle" data-motion-toggle aria-pressed="false">
        <span class="motion-toggle__track" aria-hidden="true"><span></span></span>
        Reduce motion
      </button>
      <p class="foot__small">
        © <span data-year>{year}</span> {site.name}. Built with Astro, hosted on GitHub Pages.
        <a href="https://github.com/avemath/avemath.github.io">Source</a>
        {
          commit ? (
            <a class="foot__rev mono" href={`https://github.com/avemath/avemath.github.io/commit/${commit}`}>
              rev {rev}
            </a>
          ) : (
            <span class="foot__rev mono">rev {rev}</span>
          )
        }
      </p>
      <script is:inline>
        // The build-time year is the fallback; this keeps it current between deploys.
        document.querySelector('[data-year]').textContent = String(new Date().getFullYear());
      </script>
    </div>
  </div>
</footer>

<style>
  /* Above the research page's fixed darkening layer. */
  .site-footer {
    position: relative;
    z-index: 1;
  }

  .site-footer--deep {
    background: var(--navy-deeper);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
    padding-block: clamp(2.75rem, 6vw, 4.5rem) 2.25rem;
  }

  .site-footer--deep .foot {
    align-items: center;
    padding-block: 2rem;
  }

  .foot__back {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  .foot__rev {
    margin-left: 0.75rem;
    font-size: 0.875rem;
  }

  .foot__hi {
    font-size: clamp(3rem, 7vw, 4.5rem);
    font-weight: 800;
    font-variation-settings: 'wdth' 112;
    line-height: 0.94;
    letter-spacing: -0.03em;
  }

  .foot__where {
    margin-top: 0.6rem;
    font-size: 0.875rem;
    color: var(--text-soft);
  }

  .foot__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }

  .foot__link {
    display: inline-block;
    padding-block: 0.4rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
  }

  .foot__link:hover {
    text-decoration-thickness: 2px;
  }

  .foot__link--accent {
    color: var(--accent-ink);
  }

  .foot__bar {
    border-top: 1px solid var(--line);
  }

  .foot__bar-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1rem;
    font-size: 0.875rem;
    color: var(--text-soft);
  }

  .foot__site {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.1rem;
  }

  .foot__site a,
  .foot__small a {
    display: inline-block;
    padding-block: 0.45rem;
    color: var(--text-soft);
    text-underline-offset: 0.25em;
  }

  .foot__site a {
    text-decoration: none;
  }

  .foot__site a:hover {
    text-decoration: underline;
  }

  .motion-toggle {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    gap: 0.6rem;
    color: var(--text-soft);
    cursor: pointer;
  }

  .motion-toggle__track {
    position: relative;
    width: 2.25rem;
    height: 1.3rem;
    border: 1px solid var(--line-strong);
  }

  .motion-toggle__track span {
    position: absolute;
    top: 50%;
    left: 0.2rem;
    width: 0.8rem;
    height: 0.8rem;
    background: var(--muted);
    translate: 0 -50%;
    transition:
      left 0.2s,
      background-color 0.2s;
  }

  .motion-toggle[aria-pressed='true'] .motion-toggle__track {
    border-color: var(--accent);
  }

  .motion-toggle[aria-pressed='true'] .motion-toggle__track span {
    left: 1.1rem;
    background: var(--accent);
  }
</style>
