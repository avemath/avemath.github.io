---
import Icon from './Icon.astro';
import Frond from './Frond.astro';
import site from '@/data/site.json';

const year = new Date().getFullYear();
---

<footer class="site-footer no-print">
  <Frond class="site-footer__frond" />
  <div class="wrap grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-display text-2xl font-semibold tracking-tight">Have something in mind?</p>
      <p class="mt-2 max-w-sm text-soft">Email is the fastest way to reach me.</p>
      <a class="btn mt-6" href={`mailto:${site.email}`}>
        <Icon name="mail" />
        {site.email}
      </a>
    </div>

    <nav aria-label="Footer">
      <p class="label">Site</p>
      <ul class="mt-3 space-y-1">
        <li><a class="footer-link" href="/work/">Work</a></li>
        <li><a class="footer-link" href="/services/">Services</a></li>
        <li><a class="footer-link" href="/about/">About</a></li>
        <li><a class="footer-link" href="/resume/">Résumé</a></li>
        <li><a class="footer-link" href="/contact/">Contact</a></li>
      </ul>
    </nav>

    <div>
      <p class="label">Elsewhere</p>
      <ul class="mt-3 space-y-1">
        <li>
          <a class="footer-link inline-flex items-center gap-2" href={site.socials.github} rel="me">
            <Icon name="github" /> GitHub
          </a>
        </li>
        <li>
          <a class="footer-link inline-flex items-center gap-2" href={site.socials.linkedin} rel="me">
            <Icon name="linkedin" /> LinkedIn
          </a>
        </li>
        <li>
          <a class="footer-link inline-flex items-center gap-2" href={site.resumePdf} download>
            <Icon name="download" /> Résumé PDF
          </a>
        </li>
      </ul>
      <button type="button" class="motion-toggle mt-6" data-motion-toggle aria-pressed="false">
        <span class="motion-toggle__track" aria-hidden="true"><span></span></span>
        Reduce motion
      </button>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="wrap flex flex-col gap-2 py-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© <span data-year>{year}</span> {site.name} · {site.location}</p>
      <script is:inline>
        // The build-time year is the fallback; this keeps it current between deploys.
        document.querySelector('[data-year]').textContent = String(new Date().getFullYear());
      </script>
      <p>
        Built with Astro and hosted on GitHub Pages.
        <a class="link inline-block py-1" href="https://github.com/avemath/avemath.github.io">Source</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-top: 1px solid var(--line);
    background: var(--bg-deep);
  }

  /* A fern, drawn by a function, growing up the right edge behind the columns. The SVG is
     rendered by Frond.astro, so it sits outside this component's style scope. */
  .site-footer :global(.site-footer__frond) {
    position: absolute;
    right: clamp(-3rem, -1vw, -1rem);
    bottom: -0.5rem;
    z-index: -1;
    height: min(34rem, 115%);
    width: auto;
    color: var(--leaf);
    opacity: 0.55;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 45%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 45%);
  }

  :global([data-theme='dark']) .site-footer :global(.site-footer__frond) {
    opacity: 0.32;
  }

  @media (max-width: 767px) {
    .site-footer :global(.site-footer__frond) {
      height: 22rem;
      right: -4rem;
      opacity: 0.35;
    }
  }

  .footer-link {
    display: inline-block;
    padding-block: 0.3rem;
    color: var(--text-soft);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-link:hover {
    color: var(--accent);
  }

  .motion-toggle {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: var(--text-soft);
    cursor: pointer;
  }

  .motion-toggle__track {
    position: relative;
    width: 2.25rem;
    height: 1.3rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    transition: background-color 0.2s;
  }

  .motion-toggle__track span {
    position: absolute;
    top: 50%;
    left: 0.2rem;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--muted);
    translate: 0 -50%;
    transition:
      left 0.2s,
      background-color 0.2s;
  }

  .motion-toggle[aria-pressed='true'] .motion-toggle__track {
    background: var(--accent-wash);
    border-color: var(--accent);
  }

  .motion-toggle[aria-pressed='true'] .motion-toggle__track span {
    left: 1.1rem;
    background: var(--accent);
  }
</style>
