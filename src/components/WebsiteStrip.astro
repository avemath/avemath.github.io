---
// The client sites, compactly: a thumbnail of each live site that opens its case study, then the
// short version of how I work with a link to the services page. The case studies hold what each
// business needed, what I did and the numbers.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { getProjects, isWebsite, projectHref } from '@/lib/projects';
import { displayUrl } from '@/lib/format';

const sites = (await getProjects()).filter((p) => isWebsite(p) && p.data.cover && p.data.links.live);
---

<section id="websites" class="section section--tight home-section zone" aria-labelledby="websites-title" data-section="websites">
  <span class="spine" aria-hidden="true"></span>
  <div class="wrap">
    <div class="strip__head">
      <div>
        <p class="eyebrow">Client work</p>
        <h2 id="websites-title" class="section-title section-title--sm">Live sites built for real clients</h2>
      </div>
      <p class="corner" aria-hidden="true">{String(sites.length).padStart(2, '0')} live sites</p>
    </div>

    <ul class="strip">
      {
        sites.map((p) => (
          <li class="thumb">
            <div class="thumb__shot">
              <Image
                src={p.data.cover!}
                alt=""
                widths={[240, 320, 480, 640]}
                sizes="(min-width: 1100px) 17rem, (min-width: 720px) 45vw, 8.5rem"
                format="webp"
                quality={76}
                loading="lazy"
              />
            </div>
            <div class="thumb__copy">
              <h3 class="thumb__title">
                <a href={projectHref(p)} class="stretched">
                  {p.data.title}
                </a>
              </h3>
              {p.data.client?.kind && <p class="thumb__kind">{p.data.client.kind}</p>}
              <p class="thumb__host mono">
                <span class="status-dot" aria-hidden="true" />
                {displayUrl(p.data.links.live!)}
              </p>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="strip__how">
      <p>
        Five steps from the first conversation to the written guide, with a quote before I start and a preview link while I build. The
        services page has the details and the questions people ask.
      </p>
      <div class="flex flex-wrap gap-3">
        <a class="btn btn--primary" href="/services/">See how I work <Icon name="arrow-right" /></a>
        <a class="btn" href="/contact/?topic=website">Start a project</a>
      </div>
    </div>
  </div>
</section>

<style>
  .strip__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .corner {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Four thumbnails in a row on desktop, two on tablets, and compact rows on phones. */
  .strip {
    display: grid;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  @media (min-width: 720px) {
    .strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .strip {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .thumb {
    position: relative;
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 0.9rem;
    align-items: center;
    padding: 0.6rem;
    border: 1px solid var(--line);
    border-radius: 0.8rem;
    background: var(--surface);
    transition:
      border-color 0.25s,
      translate 0.35s var(--ease-out-expo);
  }

  @media (min-width: 720px) {
    .thumb {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
  }

  .thumb:hover,
  .thumb:focus-within {
    border-color: color-mix(in oklab, var(--accent) 55%, var(--line));
    translate: 0 -2px;
  }

  .thumb:has(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .thumb a:focus-visible {
    outline: none;
  }

  .thumb__shot {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: 0.5rem;
    background: var(--surface-2);
  }

  .thumb__shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .thumb__copy {
    padding: 0.1rem 0.2rem 0.2rem;
    min-width: 0;
  }

  .thumb__title {
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .thumb__title a {
    text-decoration: none;
  }

  .thumb__kind {
    margin-top: 0.25rem;
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--text-soft);
  }

  .thumb__host {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.45rem;
    font-size: 0.7rem;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .strip__how {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(2rem, 4vw, 2.75rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .strip__how p {
    max-width: 44rem;
    color: var(--text-soft);
  }

  @media (min-width: 960px) {
    .strip__how {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 2rem;
    }
  }
</style>
