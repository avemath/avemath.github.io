---
// An acronym or jargon name with its meaning on demand, for places with no room to spell it out
// (titles, chips, tags, figure labels, the status strip). A real button with a dotted underline;
// hover, keyboard focus or a tap shows a small popover with the full name and a one-line meaning
// from src/data/glossary.json, which is also its accessible description. It closes on Escape, on a
// tap elsewhere, or when the pointer or focus leaves. The popover is fixed in place, small and kept
// on screen, so it never moves the page or covers it on a phone. Only this instance's definition is
// in the HTML; no glossary is sent to the browser.
// Not for use inside a link (a button can't sit in one): there, spell the term out nearby instead.
import glossary from '@/data/glossary.json';

interface Props {
  /** The glossary term, as it appears in glossary.json. */
  term: string;
  /** What to show, if not the term itself (for example "SDRs"). */
  label?: string;
}
const { term, label } = Astro.props;
const g = glossary.terms.find((t) => t.term === term);
if (!g) throw new Error(`<Term term="${term}">: no such term in src/data/glossary.json`);
// A stable id per term and page position.
const id = `term-${term.replace(/[^\w]/g, '')}-${Math.random().toString(36).slice(2, 7)}`;
// Tell <Terms> on this page that this term is explained now.
(((Astro.locals as Record<string, unknown>).termsSeen ??= new Set<string>()) as Set<string>).add(term);
---

<span class="term"><button type="button" class="term__btn" data-term={term} aria-describedby={id} aria-expanded="false">{label ?? term}</button><span class="term__pop" id={id} role="tooltip" hidden>{g.full && <b class="term__full">{g.full}</b>}{g.full && '. '}{g.meaning}</span></span>

<script>
  // One set of listeners for every term on the page.
  let open: HTMLButtonElement | null = null;
  let pinned = false;
  const popOf = (b: HTMLButtonElement) => document.getElementById(b.getAttribute('aria-describedby')!) as HTMLElement | null;
  const place = (b: HTMLButtonElement, pop: HTMLElement) => {
    const r = b.getBoundingClientRect();
    const w = Math.min(288, innerWidth - 24);
    pop.style.width = `${w}px`;
    pop.hidden = false;
    const h = pop.offsetHeight;
    const below = r.bottom + 8 + h <= innerHeight - 8 || r.top - 8 - h < 8;
    pop.style.top = `${below ? r.bottom + 8 : r.top - 8 - h}px`;
    pop.style.left = `${Math.max(12, Math.min(innerWidth - w - 12, r.left + r.width / 2 - w / 2))}px`;
  };
  const show = (b: HTMLButtonElement, pin = false) => {
    if (open && open !== b) hide();
    const pop = popOf(b);
    if (!pop) return;
    open = b;
    pinned = pin;
    b.setAttribute('aria-expanded', 'true');
    place(b, pop);
  };
  function hide() {
    if (!open) return;
    const pop = popOf(open);
    if (pop) pop.hidden = true;
    open.setAttribute('aria-expanded', 'false');
    open = null;
    pinned = false;
  }
  const btnOf = (t: EventTarget | null) => (t instanceof Element ? t.closest<HTMLButtonElement>('.term__btn') : null);
  document.addEventListener('pointerover', (e) => {
    const b = btnOf(e.target);
    if (b && (e as PointerEvent).pointerType === 'mouse' && !pinned) show(b);
  });
  document.addEventListener('pointerout', (e) => {
    const b = btnOf(e.target);
    if (b && b === open && !pinned && (e as PointerEvent).pointerType === 'mouse' && !b.contains(e.relatedTarget as Node)) hide();
  });
  document.addEventListener('focusin', (e) => {
    const b = btnOf(e.target);
    if (b) show(b);
  });
  document.addEventListener('focusout', (e) => {
    const b = btnOf(e.target);
    if (b && b === open) hide();
  });
  document.addEventListener('click', (e) => {
    const b = btnOf(e.target);
    if (b) {
      if (open === b && pinned) hide();
      else show(b, true);
      return;
    }
    if (open) hide();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && open) hide();
  });
  addEventListener('scroll', () => open && !pinned && hide(), { passive: true });
  addEventListener('resize', () => open && hide());
</script>

<style>
  .term__btn {
    display: inline;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    text-decoration: underline dotted;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    cursor: help;
    /* Above a card's stretched link, so it can be pressed on its own. */
    position: relative;
    z-index: 2;
  }

  .term__btn:hover,
  .term__btn[aria-expanded='true'] {
    text-decoration-color: var(--accent);
  }

  .term__btn:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* Out of the flow: fixed in place by the script, so it never moves the page. */
  .term__pop {
    position: fixed;
    z-index: 60;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    background: var(--surface);
    box-shadow: 0 10px 24px -12px rgb(0 0 0 / 0.45);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 400;
    font-style: normal;
    letter-spacing: 0;
    line-height: 1.45;
    text-align: left;
    text-transform: none;
    white-space: normal;
  }

  .term__pop[hidden] {
    display: none;
  }

  /* On paper (the résumé PDF) a term is plain text. */
  @media print {
    .term__btn {
      text-decoration: none;
    }
  }

  .term__full {
    font-weight: 600;
  }
</style>
