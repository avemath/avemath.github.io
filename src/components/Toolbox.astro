---
// The home page Toolbox as a crate of records. Each skill is a sleeve standing in a row, fanned a
// little, like records flipped through in a crate. Moving the pointer across the row flips through
// them: the sleeve under it slides up and forward, and the card under the crate shows its name,
// Know well or Have built with, and the projects that use it (with thumbnails) and the real files.
// Pressing a sleeve pins it open and applies the project filter (the plates that use it stay lit,
// the rest fade to 35%, and a polite live line says where it is used); press it again or Escape to
// clear. Arrow keys flip, Enter or Space pins, and a sideways swipe flips on touch. With reduced
// motion the sleeves are a plain list. Data: `toolbox` in src/lib/skills.ts.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { toolbox } from '@/lib/skills';
import { getProjects, isWebsite } from '@/lib/projects';

const tools = toolbox.map((t, i) => ({ ...t, i }));
// "Python: used in RAMpage, bellhopSim and the Signals playground." for the line under the crate.
const list = (xs: string[]) => (xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`);
const line = (t: (typeof tools)[number]) => `${t.name}: used in ${list([...new Set(t.uses.map((u) => u.project))])}.`;

// A thumbnail for each project link: its case study cover (the client sites use the first site's).
const projects = await getProjects();
const coverOf = (href: string): ImageMetadata | undefined =>
  href === '/#websites' ? projects.find((p) => isWebsite(p) && p.data.cover)?.data.cover : projects.find((p) => `/work/${p.id}/` === href)?.data.cover;

// Muted sleeve colors from the palette's families; light ink on each is 5:1 or better.
const SLEEVES = ['#2e5e48', '#2f5f61', '#5f527a', '#7b4f62', '#6e5a32', '#4a6b58', '#4a5a66', '#6b4f45', '#3d5c4f', '#585277', '#5a6a3c'];

// A simple line icon per skill, on a 24 by 24 grid.
const ICONS: Record<string, string> = {
  Python: 'M9 3h5a3 3 0 0 1 3 3v4H9a3 3 0 0 0-3 3v2H5a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h4V6a3 3 0 0 1 0-3zM15 21h-5a3 3 0 0 1-3-3v-4h8a3 3 0 0 0 3-3V9h1a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-4v1a3 3 0 0 1 0 3z',
  MATLAB: 'M3 18c3 0 4-12 7-12s3 9 5 9 3-5 6-5M3 21h18',
  'MicroPython and C': 'M7 7h10v10H7zM10 3v4M14 3v4M10 17v4M14 17v4M3 10h4M3 14h4M17 10h4M17 14h4',
  'Digital communications': 'M12 21V11M9 21h6M12 11a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM7 5a7 7 0 0 0 0 8M17 5a7 7 0 0 1 0 8M4 3a11 11 0 0 0 0 12M20 3a11 11 0 0 1 0 12',
  'Git and Linux': 'M6 3v12M6 15a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM18 3a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM18 9c0 5-6 4-12 7',
  'Astro and TypeScript': 'M9 4c-3 0-3 2-3 4s-1 4-3 4c2 0 3 2 3 4s0 4 3 4M15 4c3 0 3 2 3 4s1 4 3 4c-2 0-3 2-3 4s0 4-3 4',
  BELLHOP: 'M3 12c4-6 8-6 18-2M3 12c4 6 8 6 18 2M3 12c6-2 12-2 18 0',
  'Apps Script': 'M4 4h16v16H4zM4 9h16M4 14h16M10 4v16',
  'Web Audio': 'M4 9h4l5-4v14l-5-4H4zM16 9a4 4 0 0 1 0 6M19 6a8 8 0 0 1 0 12',
  React: 'M12 13.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zM12 7c5 0 9 2.2 9 5s-4 5-9 5-9-2.2-9-5 4-5 9-5zM7.7 9.5c2.5-4.3 6.3-6.6 8.7-5.2s2.3 5.9-.2 10.2-6.3 6.6-8.7 5.2-2.3-5.9.2-10.2z',
  Supabase: 'M5 6c0-1.7 3.1-3 7-3s7 1.3 7 3-3.1 3-7 3-7-1.3-7-3zM5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3',
};
---

<section id="toolbox" class="section tb band-sheet" aria-labelledby="toolbox-title">
  <div class="wrap tb__grid" data-tb>
    <div class="tb__head">
      <h2 id="toolbox-title" class="section-title tb__title" data-decode>Toolbox</h2>
      <p class="tb__lede">A crate of what I work with. Flip through it, and press a record to light the projects that use it. Know well means I can explain it at a whiteboard without notes.</p>
    </div>
    <div class="tb__body">
      <div class="crate" data-crate>
        <ul class="crate__row" aria-label="Skills, as records in a crate" data-crate-row>
          {
            tools.map((t, i) => (
              <li class="crate__slot" style={`--i:${i};--n:${tools.length};--sleeve:${SLEEVES[i % SLEEVES.length]}`}>
                <button
                  type="button"
                  class:list={['sleeve', `sleeve--${t.level}`]}
                  data-tool={t.i}
                  data-line={line(t)}
                  data-hrefs={[...new Set(t.uses.map((u) => u.href))].join(' ')}
                  aria-pressed="false"
                  aria-describedby={`tb-use-${t.i}`}
                  tabindex={i === 0 ? 0 : -1}
                >
                  <svg class="sleeve__icon" viewBox="0 0 24 24" aria-hidden="true"><path d={ICONS[t.name] ?? 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z'} /></svg>
                  <span class="sleeve__name">{t.name}</span>
                  <span class="sleeve__level">{t.level === 'know' ? 'Know well' : 'Have built with'}</span>
                </button>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="tb__line" aria-live="polite" data-tb-line></p>
      <div class="tb__panel">
        {
          tools.map((t) => (
            <div class="tb__use" id={`tb-use-${t.i}`} data-use={t.i} hidden={t.i !== 0}>
              <p class="tb__k">
                <span class="tb__name">{t.name}</span>
                <span class="tb__lvl">{t.level === 'know' ? 'Know well' : 'Have built with'}</span>
              </p>
              <ul class="tb__where">
                {t.uses.map((u) => {
                  const cover = coverOf(u.href);
                  return (
                    <li>
                      <a class="tb__proj" href={u.href}>
                        {cover && <Image src={cover} alt="" width={72} height={48} fit="cover" class="tb__thumb" loading="lazy" />}
                        <span>{u.project}</span>
                      </a>
                      {u.url ? (
                        <a class="tb__file" href={u.url}>
                          {u.file}
                        </a>
                      ) : (
                        <span class="tb__file tb__file--none">case study only</span>
                      )}
                    </li>
                  );
                })}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="tb__hint">Move across the crate, swipe it, or use the arrow keys to flip through. Press a record, or Enter, to pin it and light its projects; press again or Escape to clear.</p>
    </div>
  </div>
</section>

<script>
  import { initToolbox } from '../scripts/toolbox';
  initToolbox();
</script>

<style>
  .tb__grid {
    display: grid;
    gap: 2rem 2.5rem;
    align-items: start;
  }

  @media (min-width: 1100px) {
    .tb__grid {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    }
  }

  .tb__title {
    margin-top: 0;
    font-size: clamp(2rem, 4.4vw, 3rem);
  }

  .tb__lede {
    margin-top: 0.75rem;
    max-width: 24em;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .tb__body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
  }

  /* ---- The crate ---- */
  .crate {
    --s: 132px; /* sleeve size */
    --ov: 0.52; /* how much of each sleeve hides under the next */
    position: relative;
    padding: 2.25rem 0 0.75rem;
    perspective: 900px;
    touch-action: pan-y;
  }

  @media (max-width: 599px) {
    .crate {
      --s: 104px;
      --ov: 0.74;
    }
  }

  /* The crate's front lip. */
  .crate::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 18%;
    border: 1px solid var(--line);
    border-top: 2px solid var(--line-strong);
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    pointer-events: none;
  }

  .crate__row {
    position: relative;
    display: flex;
    justify-content: center;
    margin: 0;
    padding: 0;
    list-style: none;
    transform: rotateX(14deg);
    transform-origin: 50% 100%;
    transform-style: preserve-3d;
  }

  .crate__slot {
    --off: calc(var(--i) - (var(--n) - 1) / 2);
    position: relative;
    flex: none;
    width: var(--s);
    height: var(--s);
    margin-left: calc(-1 * var(--s) * var(--ov));
    z-index: calc(var(--i) + 1);
  }

  .crate__slot:first-child {
    margin-left: 0;
  }

  .sleeve {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0.35rem;
    padding: 0.65rem 0.7rem;
    border: 1px solid rgb(0 0 0 / 0.25);
    border-radius: 3px;
    background: var(--sleeve);
    color: #f4f7f3;
    font: inherit;
    text-align: left;
    cursor: pointer;
    box-shadow: 0 10px 18px -12px rgb(0 0 0 / 0.55);
    transform: rotate(calc(var(--off) * 1.3deg)) translateY(calc(var(--off) * var(--off) * 0.6px));
    transform-origin: 50% 100%;
    transition: transform 0.25s ease;
  }

  /* A ring worn into the jacket, like an old record sleeve. */
  .sleeve::after {
    content: '';
    position: absolute;
    inset: 8%;
    border: 1px solid rgb(244 247 243 / 0.18);
    border-radius: 50%;
    pointer-events: none;
  }

  .sleeve__icon {
    width: 24%;
    height: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sleeve__name {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    line-height: 1.1;
  }

  .sleeve__level {
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .sleeve--built {
    background-image: repeating-linear-gradient(135deg, rgb(255 255 255 / 0.06) 0 6px, transparent 6px 12px);
  }

  /* Flipping: the records before the open one lean back, the ones after lean forward, and the
     open one slides up and toward you. */
  .crate[data-active] .crate__slot:has(~ .crate__slot .sleeve[data-open]) .sleeve {
    transform: rotateY(-22deg) rotate(calc(var(--off) * 1.3deg));
  }

  .crate[data-active] .crate__slot:has(.sleeve[data-open]) ~ .crate__slot .sleeve {
    transform: rotateY(22deg) rotate(calc(var(--off) * 1.3deg));
  }

  .crate .sleeve[data-open] {
    transform: translateY(-30px) translateZ(40px) scale(1.06);
  }

  .crate__slot:has(.sleeve[data-open]) {
    z-index: 100;
  }

  .sleeve[aria-pressed='true'] {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .sleeve:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  /* Reduced motion: a plain list of the same buttons. */
  @media (prefers-reduced-motion: reduce) {
    .crate::after {
      display: none;
    }

    .crate__row {
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: 0.5rem;
      transform: none;
    }

    .crate__slot,
    .crate__slot:first-child {
      width: auto;
      height: auto;
      margin: 0;
    }

    .crate .sleeve,
    .crate[data-active] .crate__slot .sleeve,
    .crate .sleeve[data-open] {
      position: static;
      flex-direction: row;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.8rem;
      transform: none !important;
      transition: none;
    }

    .sleeve::after,
    .sleeve__level {
      display: none;
    }

    .sleeve__icon {
      width: 18px;
    }
  }

  :global(html[data-motion='reduce']) .crate::after {
    display: none;
  }

  :global(html[data-motion='reduce']) .crate__row {
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 0.5rem;
    transform: none;
  }

  :global(html[data-motion='reduce']) .crate__slot {
    width: auto;
    height: auto;
    margin: 0;
  }

  :global(html[data-motion='reduce']) .crate .sleeve {
    position: static;
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.8rem;
    transform: none !important;
    transition: none;
  }

  :global(html[data-motion='reduce']) .sleeve::after,
  :global(html[data-motion='reduce']) .sleeve__level {
    display: none;
  }

  :global(html[data-motion='reduce']) .sleeve__icon {
    width: 18px;
  }

  /* ---- Under the crate ---- */
  .tb__line {
    min-height: 1.6em;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.125rem;
  }

  .tb__panel {
    min-height: 7rem;
    padding: 0.875rem 1.125rem;
    border-left: 3px solid var(--accent);
    background: var(--fig-tint);
  }

  .tb__k {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }

  .tb__name {
    font-family: var(--font-display);
    font-size: 1.375rem;
  }

  .tb__lvl {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .tb__where {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tb__where li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.9rem;
  }

  .tb__proj {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    font-weight: 600;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }

  .tb__proj :global(.tb__thumb) {
    width: 54px;
    height: 36px;
    object-fit: cover;
    border: 1px solid var(--line);
  }

  .tb__file {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .tb__file--none {
    font-style: italic;
  }

  .tb__hint {
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
