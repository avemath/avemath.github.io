---
// The home page Toolbox: two rows of chips, "Know well" and "Have built with". Each chip is a toggle
// filter (aria-pressed): pressing one keeps the home page's project plates that use it lit, fades
// the others to 35%, and says where it was used in a polite live line under the chips. Press it
// again or Escape to clear. Hovering or focusing a chip still fills the panel with where it was
// used and the real file, from `toolbox` in src/lib/skills.ts.
import { toolbox } from '@/lib/skills';

const rows = [
  { level: 'know', label: 'Know well' },
  { level: 'built', label: 'Have built with' },
] as const;
const tools = toolbox.map((t, i) => ({ ...t, i }));
// "Python: used in RAMpage, bellhopSim and the Signals playground." for the line under the chips.
const list = (xs: string[]) => (xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`);
const line = (t: (typeof tools)[number]) => `${t.name}: used in ${list([...new Set(t.uses.map((u) => u.project))])}.`;
---

<section id="toolbox" class="section tb band-sheet" aria-labelledby="toolbox-title">
  <div class="wrap tb__grid" data-tb>
    <div class="tb__head">
      <h2 id="toolbox-title" class="section-title tb__title" data-decode>Toolbox</h2>
      <p class="tb__lede">Press a tool to see the projects that use it. The top row I can explain at a whiteboard without notes.</p>
    </div>
    <div class="tb__body">
      {
        rows.map((r) => (
          <div class="tb__row">
            <h3 class:list={['tb__label', `tb__label--${r.level}`]} id={`tb-${r.level}`}>
              {r.label}
            </h3>
            <ul class="tb__chips" aria-labelledby={`tb-${r.level}`}>
              {tools
                .filter((t) => t.level === r.level)
                .map((t) => (
                  <li>
                    <button
                      type="button"
                      class:list={['tb__chip', `tb__chip--${t.level}`]}
                      data-tool={t.i}
                      data-line={line(t)}
                      data-hrefs={[...new Set(t.uses.map((u) => u.href))].join(' ')}
                      aria-pressed="false"
                      aria-describedby={`tb-use-${t.i}`}
                    >
                      {t.name}
                    </button>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
      <p class="tb__line" aria-live="polite" data-tb-line></p>
      <div class="tb__panel">
        {
          tools.map((t) => (
            <div class="tb__use" id={`tb-use-${t.i}`} data-use={t.i} hidden={t.i !== 0}>
              <p class="tb__k">
                Used in<span class="sr-only">, for {t.name}</span>
              </p>
              <ul class="tb__where">
                {t.uses.map((u) => (
                  <li>
                    <a class="tb__proj" href={u.href}>
                      {u.project}
                    </a>
                    {u.url ? (
                      <a class="tb__file" href={u.url}>
                        {u.file}
                      </a>
                    ) : (
                      <span class="tb__file tb__file--none">case study only</span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="tb__hint">Press a tool to light the projects that use it. Press it again, or Escape, to clear.</p>
    </div>
  </div>
</section>

<script>
  import { initToolbox } from '../scripts/toolbox';
  initToolbox();
</script>

<style>
  .tb__grid {
    display: grid;
    gap: 2rem 2.5rem;
    align-items: start;
  }

  @media (min-width: 960px) {
    .tb__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
  }

  .tb__title {
    margin-top: 0;
    font-size: clamp(2rem, 4.4vw, 3rem);
  }

  .tb__lede {
    margin-top: 0.75rem;
    max-width: 24em;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .tb__body {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .tb__row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .tb__label {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0;
  }

  .tb__label--know {
    color: var(--accent-ink);
  }

  .tb__label--built {
    color: var(--muted);
  }

  .tb__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tb__line {
    min-height: 1.6em;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.125rem;
  }

  .tb__chip {
    display: inline-flex;
    cursor: pointer;
    font-family: inherit;
    align-items: center;
    min-height: 44px;
    padding: 0 1rem;
    border: 1.5px solid var(--text);
    background: var(--surface);
    color: var(--text);
    font-size: 1.0625rem;
    font-weight: 600;
    text-decoration: none;
  }

  .tb__chip--built {
    border-style: dashed;
    border-color: var(--muted);
  }

  .tb__chip:hover,
  .tb__chip:focus-visible,
  .tb__chip[aria-pressed='true'] {
    border-style: solid;
    border-color: var(--text);
    background: var(--text);
    color: var(--bg-contrast);
  }

  .tb__chip--built:hover,
  .tb__chip--built:focus-visible,
  .tb__chip--built[aria-pressed='true'] {
    border-color: var(--muted);
    background: var(--muted);
    color: var(--bg-contrast);
  }

  .tb__chip:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  .tb__panel {
    min-height: 5.5rem;
    padding: 0.875rem 1.125rem;
    border-left: 3px solid var(--accent);
    background: var(--fig-tint);
  }

  .tb__k {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .tb__where {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tb__where li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.75rem;
  }

  .tb__proj {
    padding-block: 0.15rem;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }

  .tb__file {
    min-width: 0;
    padding-block: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--muted);
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }

  .tb__file--none {
    text-decoration: none;
  }

  .tb__hint {
    margin-top: -0.75rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
