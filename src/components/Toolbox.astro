---
// The home page Toolbox as an old radio: "Tune in" (Concept B in docs/mockups/skills-concepts.html).
// On the deep band in both themes. Each skill is a station on the dial: Know well markers in green,
// Have built with in lilac, taller the more projects use it (capped). Drag the rose needle anywhere
// on the dial and it snaps to the nearest station when you let go; the arrow keys, Home and End,
// and the Previous and Next buttons step station to station. Under the dial a scope goes from
// static to a clean signal as the needle locks on (a sine whose frequency rises with the project
// count for Know well, a two-tone FSK pattern for Have built with), and the locked skill's card
// shows beside it: its level, its name, the projects that use it (with thumbnails) and the files.
// Locking a station applies the project filter on the page (matching plates stay lit, the rest
// fade); Escape clears it. The dial is a real slider for assistive tech (role="slider", with the
// station name as its value), and a polite live line says what was locked. Data: `toolbox` in
// src/lib/skills.ts, the only place the skills live. src/scripts/toolbox.ts runs it.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { toolbox } from '@/lib/skills';
import { getProjects, isWebsite } from '@/lib/projects';

const tools = toolbox.map((t, i) => {
  const projects = [...new Set(t.uses.map((u) => u.project))];
  return { ...t, i, count: projects.length, projects };
});
// "Python: used in RAMpage and bellhopSim." for the live line.
const list = (xs: string[]) => (xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`);
const line = (t: (typeof tools)[number]) => `${t.name}: used in ${list(t.projects)}.`;

// A thumbnail for each project link: its case study cover (the client sites use the first site's).
const projects = await getProjects();
const coverOf = (href: string): ImageMetadata | undefined =>
  href === '/#websites' ? projects.find((p) => isWebsite(p) && p.data.cover)?.data.cover : projects.find((p) => `/work/${p.id}/` === href)?.data.cover;

// What the dial script needs per station.
const stations = tools.map((t) => ({ name: t.name, know: t.level === 'know', count: t.count, tool: t.i, line: line(t), hrefs: [...new Set(t.uses.map((u) => u.href))] }));
const first = tools[0];
---

<section id="toolbox" class="section tb band-sheet" aria-labelledby="toolbox-title">
  <div class="wrap" data-tb>
    <div class="tb__head">
      <h2 id="toolbox-title" class="section-title tb__title" data-decode>Toolbox</h2>
      <p class="tb__lede">
        Tune in. Each skill is a station: the taller the marker, the more projects use it. Drag the needle, and the scope goes from static to
        a clean signal as you lock on.
      </p>
    </div>

    <div class="radio band-deep" data-radio>
      <div
        class="dial"
        role="slider"
        tabindex="0"
        aria-label="Skills tuning dial"
        aria-valuemin="1"
        aria-valuemax={tools.length}
        aria-valuenow="1"
        aria-valuetext={`${first.name}, ${first.level === 'know' ? 'Know well' : 'Have built with'}`}
        aria-describedby="tb-dial-help"
        data-dial
      >
        <canvas class="dial__canvas" aria-hidden="true" data-dial-canvas></canvas>
      </div>
      <p class="sr-only" id="tb-dial-help">Use the left and right arrow keys to move from station to station. Escape clears the project filter.</p>

      <div class="radio__readout">
        <div class="radio__scope">
          <canvas class="scope__canvas" aria-hidden="true" data-scope></canvas>
          <p class="radio__sig mono" aria-hidden="true" data-tune-sig>locked: {first.name}, {first.count} project{first.count === 1 ? '' : 's'}</p>
        </div>
        <div class="radio__detail">
          {
            tools.map((t) => (
              <div class="tb__use" id={`tb-use-${t.i}`} data-use={t.i} hidden={t.i !== 0}>
                <p class="tb__lvl mono">{t.level === 'know' ? 'Know well' : 'Have built with'}</p>
                <h3 class="tb__name">{t.name}</h3>
                <ul class="tb__where">
                  {t.uses.map((u) => {
                    const cover = coverOf(u.href);
                    return (
                      <li>
                        <a class="tb__proj" href={u.href}>
                          {cover && <Image src={cover} alt="" width={72} height={48} fit="cover" class="tb__thumb" loading="lazy" />}
                          <span>{u.project}</span>
                        </a>
                        {u.url ? (
                          <a class="tb__file" href={u.url}>
                            {u.file}
                          </a>
                        ) : (
                          <span class="tb__file tb__file--none">case study only</span>
                        )}
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))
          }
        </div>
      </div>

      <p class="tb__line" aria-live="polite" data-tb-line></p>

      <div class="radio__ctl">
        <button type="button" class="btn btn--small" data-dial-prev>Previous station</button>
        <button type="button" class="btn btn--small" data-dial-next>Next station</button>
        <p class="hand radio__hint" aria-hidden="true">drag the dial, or use the arrow keys</p>
      </div>
      <script type="application/json" data-stations set:html={JSON.stringify(stations)} />
    </div>
  </div>
</section>

<script>
  import { whenNear } from '../scripts/idle';
  // The dial's code downloads and sets up only once it nears the screen.
  const radio = document.querySelector('[data-radio]');
  if (radio) whenNear(radio, () => import('../scripts/toolbox').then((m) => m.initToolbox()));
</script>

<style>
  .tb__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem 2.5rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .tb__title {
    margin-top: 0;
    font-size: clamp(2rem, 4.4vw, 3rem);
  }

  .tb__lede {
    max-width: 34em;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--muted);
  }

  /* ---- The radio ---- */
  .radio {
    padding: clamp(1rem, 3vw, 2.25rem);
    border-radius: 18px;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.06);
  }

  .dial {
    position: relative;
    height: 15rem;
    border-radius: 10px;
    background: linear-gradient(#123329, #0b221b);
    box-shadow: inset 0 2px 10px rgb(0 0 0 / 0.5);
    overflow: hidden;
    cursor: ew-resize;
    touch-action: pan-y;
  }

  @media (max-width: 599px) {
    .dial {
      height: 9rem;
    }
  }

  .dial:focus-visible {
    outline: 3px solid var(--deep-accent);
    outline-offset: 3px;
  }

  .dial__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .radio__readout {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
    align-items: start;
  }

  @media (min-width: 860px) {
    .radio__readout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: center;
    }
  }

  .scope__canvas {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 12 / 5;
    border-radius: 10px;
    background: #0b221b;
    box-shadow: inset 0 2px 10px rgb(0 0 0 / 0.5);
  }

  .radio__sig {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: #a9bfb4;
  }

  .tb__lvl {
    font-size: 0.8125rem;
    color: var(--deep-accent);
  }

  .tb__name {
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.6vw, 3rem);
    font-weight: 400;
    line-height: 1;
  }

  .tb__where {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tb__where li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.9rem;
  }

  .tb__proj {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    font-weight: 600;
    color: var(--deep-ink);
    text-decoration: underline;
    text-decoration-color: var(--deep-accent);
    text-underline-offset: 0.2em;
  }

  .tb__proj :global(.tb__thumb) {
    width: 54px;
    height: 36px;
    object-fit: cover;
    border: 1px solid var(--deep-line);
  }

  .tb__file {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: #a9bfb4;
  }

  .tb__file--none {
    font-style: italic;
  }

  .tb__line {
    min-height: 1.6em;
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.125rem;
  }

  .radio__ctl {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.75rem;
    margin-top: 1rem;
  }

  .radio__hint {
    margin-left: auto;
    font-size: 1.0625rem;
    color: #ebd7e2;
  }
</style>
