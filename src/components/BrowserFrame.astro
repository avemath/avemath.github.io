---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  mobile?: ImageMetadata;
  alt: string;
  url?: string;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
}

const { src, mobile, alt, url, widths = [480, 720, 960, 1280], sizes = '(min-width: 1024px) 50vw, 100vw', eager = false } = Astro.props;
const host = url ? new URL(url).host.replace(/^www\./, '') : '';
---

<figure class="frame">
  <div class="frame__window">
    <div class="frame__bar" aria-hidden="true">
      <span class="frame__dots"><i></i><i></i><i></i></span>
      {host && <span class="frame__url">{host}</span>}
    </div>
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      format="webp"
      quality={78}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      class="frame__shot"
    />
  </div>
  {
    mobile && (
      <div class="frame__phone" aria-hidden="true">
        <Image src={mobile} alt="" widths={[180, 300]} sizes="150px" format="webp" quality={75} loading="lazy" class="frame__phone-shot" />
      </div>
    )
  }
</figure>

<style>
  .frame {
    position: relative;
    margin: 0;
  }

  .frame__window {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 0.85rem;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .frame__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 2rem;
    padding-inline: 0.75rem;
    border-bottom: 1px solid var(--line);
    background: var(--surface-2);
  }

  .frame__dots {
    display: flex;
    gap: 0.35rem;
  }

  .frame__dots i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .frame__url {
    flex: 1;
    max-width: 16rem;
    margin-inline: auto;
    padding: 0.1rem 0.75rem;
    border-radius: 999px;
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
    text-align: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    translate: -1.5rem 0;
  }

  .frame__shot {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
  }

  .frame__phone {
    position: absolute;
    right: -1.25rem;
    bottom: -1.5rem;
    width: 17%;
    min-width: 4.5rem;
    max-width: 8rem;
    padding: 0.3rem;
    border: 1px solid var(--line-strong);
    border-radius: 1.1rem;
    background: var(--bg-deep);
    box-shadow: var(--shadow-lift);
  }

  .frame__phone-shot {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 390 / 844;
    object-fit: cover;
    object-position: top;
    border-radius: 0.85rem;
  }

  /* On phones the frame sits inside the page gutter, so the phone tucks in instead of poking past the edge. */
  @media (max-width: 640px) {
    .frame__phone {
      right: 0.25rem;
      bottom: -1rem;
    }
  }
</style>
