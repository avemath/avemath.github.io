---
import facts from '@/data/facts.json';
import { getProjects, isWebsite } from '@/lib/projects';

// "Sites shipped" is counted from the content collection so it never goes stale.
const sitesShipped = (await getProjects()).filter((p) => isWebsite(p) && p.data.status === 'live').length;
const notes = facts.map((f) => ({ ...f, value: f.value.replace('{sites}', String(sitesShipped)) }));
---

<section id="field-notes" class="section home-section grid-paper" aria-labelledby="notes-title" data-section="field-notes">
  <div class="wrap">
    <p class="eyebrow">Field notes</p>
    <h2 id="notes-title" class="section-title">A few things that are true</h2>
    <p class="section-lede">Facts from the work above, and the stories behind them.</p>

    <ul class="notes">
      {
        notes.map((n, i) => (
          <li class="note-card" data-reveal>
            <p class="note-card__top">
              <span class="mono note-card__idx" aria-hidden="true">
                N{String(i + 1).padStart(2, '0')}
              </span>
              <span class="label">{n.label}</span>
            </p>
            <p class="note-card__value">{n.value}</p>
            <p class="note-card__detail">{n.detail}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .notes {
    display: grid;
    gap: 1rem;
    margin-top: 2.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
  }

  .note-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-height: 13rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--surface);
  }

  .note-card__top {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .note-card__idx {
    font-size: 0.72rem;
    color: var(--accent-ink);
  }

  :global([data-theme='dark']) .note-card__idx {
    color: var(--accent);
  }

  .note-card__value {
    margin-top: auto;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--text);
  }

  .note-card__detail {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-soft);
  }
</style>
