---
import facts from '@/data/facts.json';

// Six facts with the stories behind them, on the research page. Each value starts masked and
// decodes as it scrolls into view; a tap replays it.
const notes = facts;
---

<section id="field-notes" class="notes-sec" aria-labelledby="notes-title">
  <div class="notes-sec__head">
    <h2 id="notes-title" class="section-title notes-sec__title" data-decode>Field notes</h2>
    <p class="notes-sec__hint">tap a note to decode it</p>
  </div>

  <ul class="notes">
    {
      notes.map((n, i) => (
        <li class="note">
          <button type="button" class="note-card" data-note>
            <span class="note-card__top">
              <span class="note-card__label">{n.label}</span>
              <span class="note-card__idx" aria-hidden="true">
                N{String(i + 1).padStart(2, '0')}
              </span>
            </span>
            <span class="sr-only">{n.value}</span>
            <span class="note-card__value" data-note-value data-text={n.value} aria-hidden="true">
              {n.value}
            </span>
            <span class="note-card__detail">{n.detail}</span>
            <span class="note-card__hint" aria-hidden="true">
              <span class="note-card__tap">tap to decode</span>
              <span class="note-card__done">decoded</span>
            </span>
          </button>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .notes-sec__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }

  .notes-sec__title {
    margin-top: 0;
  }

  .notes-sec__hint {
    font-size: 0.875rem;
    color: var(--muted);
  }

  /* Three per row, so six notes make two full rows. */
  .notes {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 640px) {
    .notes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .notes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .note {
    display: grid;
  }

  .note-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    height: 100%;
    padding: 1rem 1.1rem 1.1rem;
    border: 1px solid var(--line);
    background: rgb(4 12 24 / 0.35);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.55;
    text-align: left;
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .note-card:hover {
    border-color: var(--line-strong);
  }

  .note-card__top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--muted);
  }

  .note-card__value {
    font-family: var(--font-sans);
    font-size: 1.75rem;
    font-weight: 800;
    font-variation-settings: 'wdth' 112;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text);
    min-height: 1.05em;
  }

  /* Masked: the glyphs, in mono so they never change width as they resolve. */
  .note-card[data-masked] .note-card__value {
    font-family: var(--font-mono);
    font-weight: 400;
    font-variation-settings: normal;
    font-size: 1.5rem;
    letter-spacing: 0;
    color: var(--muted);
  }

  .note-card__detail {
    color: var(--text-soft);
  }

  .note-card__hint {
    margin-top: auto;
    padding-top: 0.25rem;
    font-size: 0.75rem;
  }

  .note-card__tap {
    color: var(--accent-ink);
  }

  .note-card__done,
  .note-card[data-masked] .note-card__tap {
    display: inline;
  }

  .note-card:not([data-masked]) .note-card__tap,
  .note-card[data-masked] .note-card__done {
    display: none;
  }

  .note-card__done {
    color: var(--muted);
  }
</style>

<script>
  import { decode, mask } from '../scripts/decode';
  import { prefersReducedMotion } from '../scripts/preferences';

  const cards = [...document.querySelectorAll<HTMLButtonElement>('[data-note]')];
  const valueOf = (card: HTMLButtonElement) => card.querySelector<HTMLElement>('[data-note-value]')!;
  const textOf = (card: HTMLButtonElement) => valueOf(card).dataset.text ?? '';

  function reveal(card: HTMLButtonElement) {
    delete card.dataset.masked;
    decode(valueOf(card), textOf(card), 800);
  }

  function showAll() {
    cards.forEach((card) => {
      delete card.dataset.masked;
      valueOf(card).textContent = textOf(card);
    });
  }

  // Cards start masked and decode as they scroll into view, staggered left to right across a
  // row. With reduced motion every fact is simply shown.
  if (!prefersReducedMotion() && 'IntersectionObserver' in window) {
    cards.forEach((card) => {
      card.dataset.masked = '';
      valueOf(card).textContent = mask(textOf(card));
    });
    const io = new IntersectionObserver(
      (entries) => {
        // The entries carry their rectangles, so grouping into rows reads no layout of its own.
        const rows = new Map<number, { card: HTMLButtonElement; left: number }[]>();
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const top = Math.round(e.boundingClientRect.top / 8);
          rows.set(top, [...(rows.get(top) ?? []), { card: e.target as HTMLButtonElement, left: e.boundingClientRect.left }]);
        }
        for (const row of rows.values()) {
          row
            .sort((a, b) => a.left - b.left)
            .map((r) => r.card)
            .forEach((card, i) => {
              io.unobserve(card);
              setTimeout(() => card.dataset.masked !== undefined && reveal(card), i * 160);
            });
        }
      },
      { threshold: 0.5 },
    );
    cards.forEach((card) => io.observe(card));
  }

  // A tap decodes a card early, or replays the effect.
  cards.forEach((card) =>
    card.addEventListener('click', () => {
      if (card.dataset.masked === undefined && !prefersReducedMotion()) valueOf(card).textContent = mask(textOf(card));
      reveal(card);
    }),
  );

  // Turning motion off mid-visit shows everything at once.
  window.addEventListener('motionchange', () => {
    if (prefersReducedMotion()) showAll();
  });
</script>
