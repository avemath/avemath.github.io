---
import facts from '@/data/facts.json';

// Six facts whose stories are not already told elsewhere on the home page.
const notes = facts;
---

<section id="field-notes" class="section section--tight home-section grid-paper" aria-labelledby="notes-title" data-section="field-notes">
  <div class="wrap">
    <p class="eyebrow">Field notes</p>
    <h2 id="notes-title" class="section-title section-title--sm">A few things that are true</h2>
    <p class="section-lede">Facts from the work above, and the stories behind them.</p>

    <ul class="notes">
      {
        notes.map((n, i) => (
          <li class="note-card" data-reveal>
            <p class="note-card__top">
              <span class="note-card__label">{n.label}</span>
              <span class="mono note-card__idx" aria-hidden="true">
                N{String(i + 1).padStart(2, '0')}
              </span>
            </p>
            <p class="note-card__value">{n.value}</p>
            <p class="note-card__detail">{n.detail}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* One ledger panel with hairline cells, not a grid of floating cards. Column counts
     always give full rows (6 = 3 x 2 or 2 x 3), so no cell is ever empty. */
  .notes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 2rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--line);
    overflow: hidden;
  }

  @media (min-width: 1100px) {
    .notes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .note-card {
    display: flex;
    flex-direction: column;
    padding: 1.35rem 1.4rem 1.5rem;
    background: var(--surface);
  }

  @media (max-width: 719px) {
    .note-card {
      padding: 1rem 1rem 1.15rem;
    }

    .note-card__value {
      font-size: clamp(1.5rem, 7vw, 2rem);
    }

    .note-card__detail {
      font-size: 0.85rem;
    }
  }

  /* The label is the headline of the card: what the fact is about. */
  .note-card__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .note-card__label {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .note-card__idx {
    flex: none;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--accent-ink);
  }

  :global([data-theme='dark']) .note-card__idx {
    color: var(--accent);
  }

  .note-card__value {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 3vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--text);
  }

  .note-card__detail {
    margin-top: 0.75rem;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--text-soft);
  }
</style>
