---
// Fig. R3, the ray tracer, in the spirit of bellhopSim's ray and arrivals modes. Left: the sound
// speed profile c(z) in gold, with the slow channel axis marked when the profile has one. Right:
// depth against range, with a fan of rays from the source and the eigenrays (the rays that reach
// the receiver) drawn bold, colored by their surface and bottom bounces. Below: the receiver's
// arrivals as a stem plot, one stem per eigenray at its travel time.
//
// Controls: the environment (bellhopSim's five profiles, with its default parameters), source
// depth, fan width, the receiver (drag it on the plot, or use its range and depth sliders), and
// Ping, which sends a pulse along every ray at the local sound speed with a running clock.
//
// The rays come from the site's one tracer (src/lib/raytrace.ts, shared with the home hero). The
// drawn fan updates as a slider moves; the dense fan that finds the eigenrays is recomputed after a
// short pause, so dragging stays smooth. Paused off screen. With reduced motion Ping shows the
// finished pulse at once. The summary below the figure is read out politely.
import { PROFILES } from '@/lib/raytrace';
---

<div class="rt" data-rt>
  <div class="rt__ctl">
    <label class="rt__field">
      <span class="rt__k">Environment</span>
      <select data-rt-env>
        {PROFILES.map((p, i) => <option value={p.id} selected={i === 0}>{p.name}</option>)}
      </select>
    </label>
    <label class="rt__field">
      <span class="rt__k">Source depth <output data-rt-zs-out>1300&nbsp;m</output></span>
      <input type="range" min="0" max="1000" step="1" value="260" data-rt-zs />
    </label>
    <label class="rt__field">
      <span class="rt__k">Fan <output data-rt-fan-out>±20°</output></span>
      <input type="range" min="2" max="40" step="1" value="20" data-rt-fan />
    </label>
    <label class="rt__field">
      <span class="rt__k">Receiver range <output data-rt-rr-out>65&nbsp;km</output></span>
      <input type="range" min="1" max="1000" step="1" value="650" data-rt-rr />
    </label>
    <label class="rt__field">
      <span class="rt__k">Receiver depth <output data-rt-rz-out>1300&nbsp;m</output></span>
      <input type="range" min="0" max="1000" step="1" value="260" data-rt-rz />
    </label>
    <div class="rt__go">
      <button type="button" class="btn btn--primary" data-rt-ping>Ping</button>
      <p class="rt__clock">
        <span class="rt__clock-k">time since ping</span>
        <span class="rt__clock-v" data-readout><span data-rt-clock aria-hidden="true">0.00</span>&nbsp;s</span>
      </p>
    </div>
  </div>
  <canvas
    class="rt__main"
    data-rt-main
    role="img"
    aria-label="Rays from the source bending through the sound speed profile, with the eigenrays to the receiver drawn bold. Drag on the plot to move the receiver."
  ></canvas>
  <canvas class="rt__stem" data-rt-stem aria-hidden="true"></canvas>
  <p class="rt__legend" aria-hidden="true">
    <span class="rt__lg" data-rt-lg="d"><span class="rt__sw rt__sw--d"></span>direct</span>
    <span class="rt__lg" data-rt-lg="s"><span class="rt__sw rt__sw--s"></span>surface</span>
    <span class="rt__lg" data-rt-lg="b"><span class="rt__sw rt__sw--b"></span>bottom</span>
    <span class="rt__lg" data-rt-lg="sb"><span class="rt__sw rt__sw--sb"></span>both</span>
  </p>
  <p class="rt__sum" aria-live="polite" data-rt-sum></p>
</div>

<style>
  .rt {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 0.75rem 0.75rem 0.25rem;
  }

  /* An even grid: Environment beside Ping, Source depth beside Fan, Receiver range beside Receiver
     depth. When the figure is wide enough, three columns: Environment, Source depth, Fan, then
     Receiver range, Receiver depth, Ping. Each label sits with its value on one row over its slider. */
  .rt__ctl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem 1.25rem;
    align-items: end;
  }

  /* Two columns: Ping and its clock beside Environment (it is last in the keyboard order, the action
     after the settings), so the panel spends one row less. */
  .rt__go {
    grid-row: 1;
    grid-column: 2;
  }

  @container (min-width: 560px) {
    .rt__ctl {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .rt__go {
      grid-row: auto;
      grid-column: auto;
    }
  }

  /* A narrow figure: one control per row, Ping and the clock on their own row. */
  @container (max-width: 459px) {
    .rt__ctl {
      grid-template-columns: minmax(0, 1fr);
    }

    .rt__ctl .rt__go {
      grid-row: auto;
      grid-column: auto;
    }
  }

  .rt__field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .rt__k {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: var(--fs-13);
    white-space: nowrap;
    color: var(--muted);
  }

  .rt__k output {
    font-family: var(--font-mono);
    color: var(--text);
  }

  .rt__field input[type='range'] {
    width: 100%;
    min-height: 36px;
    accent-color: var(--accent);
  }

  .rt__field select {
    width: 100%;
    min-height: 44px;
    padding: 0 0.6rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-4);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: var(--fs-14);
  }

  .rt__go {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
    min-width: 0;
  }

  /* The clock: what it counts on top, then the seconds, number and unit together, in a fixed
     width (tabular figures, room for "999.99 s") so nothing moves while it runs. */
  .rt__clock {
    display: grid;
    margin: 0;
  }

  .rt__clock-k {
    font-size: var(--fs-13);
    color: var(--muted);
    white-space: nowrap;
  }

  .rt__clock-v {
    min-width: 8ch;
    font-family: var(--font-mono);
    font-size: var(--fs-20);
    line-height: 1.2;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .rt__main {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 1;
    border: 1px solid var(--line);
    background: var(--surface);
    cursor: crosshair;
    touch-action: pan-y;
  }

  .rt__stem {
    display: block;
    width: 100%;
    height: 5rem;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .rt__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    color: var(--muted);
  }

  .rt__sw {
    display: inline-block;
    width: 14px;
    height: 3px;
  }

  .rt__lg {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-right: 0.5rem;
  }

  /* A kind of path with no eigenray in this setup is shown faded, not removed. */
  .rt__lg[data-none] {
    opacity: 0.4;
  }

  .rt__sw--d {
    background: var(--text);
  }

  .rt__sw--s {
    background: var(--teal);
  }

  .rt__sw--b {
    background: var(--lilac);
  }

  .rt__sw--sb {
    background: var(--rose);
  }

  .rt__sum {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-13);
  }
</style>

<script>
  import { mountRayTracer } from '../../scripts/raytracer';
  import { whenNear } from '../../scripts/idle';
  // Tracing the rays is the heaviest thing on the page, so it waits until the figure is near the
  // screen (and the browser has a quiet moment) instead of running at load.
  document.querySelectorAll<HTMLElement>('[data-rt]').forEach((el) => whenNear(el, () => mountRayTracer(el)));
</script>
