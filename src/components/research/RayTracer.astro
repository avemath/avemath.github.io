---
// Fig. R3, the ray tracer, in the spirit of bellhopSim's ray and arrivals modes. Left: the sound
// speed profile c(z) in gold, with the slow channel axis marked when the profile has one. Right:
// depth against range, with a fan of rays from the source and the eigenrays (the rays that reach
// the receiver) drawn bold, colored by their surface and bottom bounces. Below: the receiver's
// arrivals as a stem plot, one stem per eigenray at its travel time.
//
// Controls: the environment (bellhopSim's five profiles, with its default parameters), source
// depth, fan width, the receiver (drag it on the plot, or use its range and depth sliders), and
// Ping, which sends a pulse along every ray at the local sound speed with a running clock.
//
// The rays come from the site's one tracer (src/lib/raytrace.ts, shared with the home hero). The
// drawn fan updates as a slider moves; the dense fan that finds the eigenrays is recomputed after a
// short pause, so dragging stays smooth. Paused off screen. With reduced motion Ping shows the
// finished pulse at once. The summary below the figure is read out politely.
import { PROFILES } from '@/lib/raytrace';
---

<div class="rt" data-rt>
  <div class="rt__ctl">
    <label class="rt__field">
      <span class="rt__k">Environment</span>
      <select data-rt-env>
        {PROFILES.map((p, i) => <option value={p.id} selected={i === 0}>{p.name}</option>)}
      </select>
    </label>
    <label class="rt__field">
      <span class="rt__k">Source depth <output data-rt-zs-out>1300 m</output></span>
      <input type="range" min="0" max="1000" step="1" value="260" data-rt-zs />
    </label>
    <label class="rt__field">
      <span class="rt__k">Fan <output data-rt-fan-out>±20°</output></span>
      <input type="range" min="2" max="40" step="1" value="20" data-rt-fan />
    </label>
    <label class="rt__field">
      <span class="rt__k">Receiver range <output data-rt-rr-out>65 km</output></span>
      <input type="range" min="1" max="1000" step="1" value="650" data-rt-rr />
    </label>
    <label class="rt__field">
      <span class="rt__k">Receiver depth <output data-rt-rz-out>1300 m</output></span>
      <input type="range" min="0" max="1000" step="1" value="260" data-rt-rz />
    </label>
    <div class="rt__go">
      <button type="button" class="btn btn--primary" data-rt-ping>Ping</button>
      <p class="rt__clock" aria-hidden="true"><span data-rt-clock>0.00</span> s</p>
    </div>
  </div>
  <canvas
    class="rt__main"
    data-rt-main
    role="img"
    aria-label="Rays from the source bending through the sound speed profile, with the eigenrays to the receiver drawn bold. Drag on the plot to move the receiver."
  ></canvas>
  <canvas class="rt__stem" data-rt-stem aria-hidden="true"></canvas>
  <p class="rt__legend" aria-hidden="true">
    <span class="rt__sw rt__sw--d"></span>direct <span class="rt__sw rt__sw--s"></span>surface <span class="rt__sw rt__sw--b"></span>bottom <span class="rt__sw rt__sw--sb"></span>both
  </p>
  <p class="rt__sum" aria-live="polite" data-rt-sum></p>
</div>

<style>
  .rt {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 0.75rem 0.75rem 0.25rem;
  }

  .rt__ctl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem 1rem;
    align-items: end;
  }

  @container (min-width: 620px) {
    .rt__ctl {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* A narrow figure: one control per row, Ping and the clock on their own row. */
  @container (max-width: 459px) {
    .rt__ctl {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .rt__field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .rt__k {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .rt__k output {
    font-family: var(--font-mono);
    color: var(--text);
  }

  .rt__field input[type='range'] {
    width: 100%;
    min-height: 36px;
    accent-color: var(--accent);
  }

  .rt__field select {
    min-height: 44px;
    padding: 0 0.6rem;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 0.875rem;
  }

  .rt__go {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .rt__go .btn {
    min-height: 44px;
  }

  .rt__clock {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.5rem;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .rt__main {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line);
    background: var(--surface);
    cursor: crosshair;
    touch-action: pan-y;
  }

  .rt__stem {
    display: block;
    width: 100%;
    height: 7rem;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .rt__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .rt__sw {
    display: inline-block;
    width: 14px;
    height: 3px;
    margin-left: 0.35rem;
    vertical-align: middle;
  }

  .rt__sw--d {
    background: var(--accent);
  }

  .rt__sw--s {
    background: var(--teal);
  }

  .rt__sw--b {
    background: var(--lilac, #8f79c4);
  }

  .rt__sw--sb {
    background: var(--rose);
  }

  .rt__sum {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
</style>

<script>
  import { mountRayTracer } from '../../scripts/raytracer';
  document.querySelectorAll<HTMLElement>('[data-rt]').forEach(mountRayTracer);
</script>
