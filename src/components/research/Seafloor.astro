---
// The water behind the whole Research page. Two layers, both decoration (the page's panels carry
// every word):
//   - the still layer, under the page's full height: a gradient from shallow green at the top to
//     the deep at the bottom, with a still render of the shallows at the top (rendered from the
//     live scene by `npm run assets`). This is the whole scene without WebGL or with reduced motion.
//   - the live layer, fixed to the viewport, where src/scripts/seafloor.ts puts the three.js
//     canvas; it fades in over the still layer once the scene has drawn.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// The stills are generated from a build, so the very first build runs without them.
const stills = import.meta.glob<{ default: ImageMetadata }>('../../assets/research/seafloor-shallow.jpg', { eager: true });
const still = Object.values(stills)[0]?.default;
---

<div class="abyss" aria-hidden="true" data-girl-ignore>
  {still && <Image src={still} alt="" class="abyss__still" widths={[640, 960, 1280, 1600]} sizes="100vw" loading="eager" fetchpriority="high" quality={72} />}
  <div class="abyss__live" data-seafloor></div>
</div>

<style>
  /* The still layer covers the research wrapper (position: relative) from top to bottom. */
  .abyss {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: linear-gradient(180deg, #40593f 0%, #2c4734 18%, #123129 42%, #071a17 68%, #03080b 100%);
    pointer-events: none;
  }

  .abyss__still {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: min(100vh, 900px);
    object-fit: cover;
    -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
  }

  /* The live layer: fixed to the viewport, over the still layer once it has drawn. */
  .abyss__live {
    position: fixed;
    inset: 0;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .abyss__live[data-live],
  .abyss__live[data-mode='still'] {
    opacity: 1;
  }

  .abyss__live :global(.sea__gl) {
    display: block;
    width: 100%;
    height: 100%;
  }

  :global(html[data-motion='reduce']) .abyss__live {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .abyss__live {
      display: none;
    }
  }
</style>

<script>
  import { mountSeafloor } from '../../scripts/seafloor';
  document.querySelectorAll<HTMLElement>('[data-seafloor]').forEach(mountSeafloor);
</script>
