---
// RAMpage's pneumatics as built, from the team's final presentation and pico_direct.py: two
// 200 psi reservoirs, each with its own inlet solenoid valve; both inlets (the firmware's
// piston_solenoid, GP15) open together into one shared supply line. The line drives two
// cylinders, one above the other, whose rods push the one plow, a flat plate (as in the shop and
// arena photos), straight out and back. The exhaust valve (the firmware's
// main_solenoid, GP14) is a branch off the shared line to atmosphere, not a stage in series: open
// at idle so the plow stays pulled in, closed while the inlets drive the plow out, open again to
// vent. Its state is set from src/lib/rampage-firmware.ts by src/scripts/fig/timing.ts.
---

<div class="pn" data-pn data-exhaust="open" data-inlets="closed" data-vent="off">
  <div class="pn__frame" data-hscroll="RAMpage pneumatics">
  <svg class="dw__svg pn__svg" viewBox="0 0 304 236" style="--fig-w:304px" role="img" aria-label="The plow's pneumatics: two reservoirs, each with an inlet valve, feed one shared line to two cylinders whose rods push one flat plow plate straight out; an exhaust valve branches off the shared line to vent." data-sketch>
    <title>RAMpage pneumatics</title>
    <rect class="s f" pathLength="1" x="8" y="20" width="40" height="70" rx="14"></rect>
    <rect class="s f" pathLength="1" x="8" y="132" width="40" height="70" rx="14"></rect>
    <text class="t" x="4" y="222">reservoirs</text>

    <path class="s pn__in" pathLength="1" d="M48 55 H62 M48 167 H62"></path>
    <rect class="s pn__valve pn__valve--in" pathLength="1" x="62" y="40" width="30" height="30"></rect>
    <rect class="s pn__valve pn__valve--in" pathLength="1" x="62" y="152" width="30" height="30"></rect>
    <text class="t" x="77" y="100" text-anchor="middle">inlets</text>
    <text class="t t--mono" x="77" y="114" text-anchor="middle">(GP15)</text>
    <text class="t pn__state" x="77" y="130" text-anchor="middle" data-pn-inlets>closed</text>

    <path class="s pn__line" pathLength="1" d="M92 55 H118 V167 H92 M118 111 H212 M212 74 V142 M212 74 H224 M212 142 H224"></path>

    <path class="s pn__branch" pathLength="1" d="M150 111 V78"></path>
    <rect class="s pn__valve pn__valve--ex" pathLength="1" x="135" y="48" width="30" height="30"></rect>
    <path class="s pn__vent" pathLength="1" d="M150 48 V16 M142 26 L150 14 L158 26"></path>
    <text class="t pn__venttext" x="136" y="24" text-anchor="end">vent</text>
    <text class="t" x="170" y="30">exhaust</text>
    <text class="t t--mono" x="170" y="44">(GP14)</text>
    <text class="t pn__state" x="170" y="58" data-pn-exhaust>open</text>

    <rect class="s f" pathLength="1" x="224" y="61" width="48" height="26"></rect>
    <rect class="s f" pathLength="1" x="224" y="129" width="48" height="26"></rect>
    <text class="t" x="248" y="190" text-anchor="middle">2 cylinders</text>
    <g class="pn__rod">
      <path class="s" pathLength="1" d="M248 74 H292 M248 142 H292"></path>
      <!-- The plow is one flat plate, square to the rods; it only slides out and back. -->
      <rect class="s s--hot f--hot pn__plow" pathLength="1" x="292" y="46" width="8" height="124" data-plow></rect>
    </g>
    <text class="t" x="302" y="36" text-anchor="end">plow</text>
  </svg>
  </div>
  <p class="pn__status"><span class="sr-only">Plow: </span><span data-pn-status>Ready</span></p>
</div>

<style>
  .pn {
    min-width: 0;
  }

  /* The drawing keeps its shape and is capped in height, so with the toolbar above it the whole
     robot fits on screen while Fire is pressed (TimingFig sets --pn-max-h). */
  .pn__svg {
    width: min(100%, 22rem, calc(var(--pn-max-h, 100svh) * 304 / 236));
    height: auto;
    aspect-ratio: 304 / 236;
    margin-inline: auto;
  }

  .pn__valve {
    fill: var(--surface);
    transition: fill 0.12s;
  }

  .pn[data-exhaust='open'] .pn__valve--ex,
  .pn[data-inlets='open'] .pn__valve--in {
    fill: var(--accent);
  }

  .pn__in,
  .pn__line,
  .pn__branch {
    transition: stroke 0.12s;
  }

  /* Inlets open: air flows from both reservoirs through the shared line to the cylinders. */
  .pn[data-inlets='open'] .pn__in,
  .pn[data-inlets='open'] .pn__line {
    stroke: var(--accent);
    stroke-width: 3;
  }

  /* Venting: the shared line empties through the exhaust branch. */
  .pn[data-vent='on'] .pn__branch {
    stroke: var(--accent);
    stroke-width: 3;
  }

  /* The vent: always readable in ink; it turns to the accent while the exhaust vents. */
  .pn__vent {
    stroke: var(--text);
    stroke-width: 1.5;
  }

  .pn__venttext {
    font-size: 13px;
    fill: var(--text);
  }

  .pn[data-vent='on'] .pn__vent {
    stroke: var(--accent);
    stroke-width: 2.5;
  }

  .pn[data-vent='on'] .pn__venttext {
    fill: var(--accent-ink);
    font-weight: 700;
  }

  .pn__rod {
    transition: transform 0.3s ease-out;
  }

  /* Retracted, the plate sits just off the cylinders' ends; with the inlets open, both rods push it
     straight out. Only its position changes, never its shape or angle. */
  .pn[data-inlets='closed'] .pn__rod {
    transform: translateX(-16px);
  }

  .pn[data-inlets='open'] .pn__rod {
    transform: translateX(0);
  }

  .pn__status {
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text);
  }
</style>
