---
// RAMpage's pneumatics as a schematic that moves with the firmware: two air tanks feeding the
// main valve (GP14, the exhaust and reservoir valve in the README), then the piston valve (GP15),
// which feeds two pneumatic cylinders side by side, each with its own rod, both pushing the one
// plow. One valve drives both cylinders, so the timing rows have one piston row. Its state is set
// from src/lib/rampage-firmware.ts by src/scripts/fig/timing.ts, so the valves open and close
// exactly when the firmware switches them. Plumbing confirmed by Ave; cylinder bore and stroke
// are not stated and the drawing does not need them.
---

<div class="pn" data-pn data-main="open" data-piston="closed" data-pressure="off" data-vent="off">
  <svg class="dw__svg pn__svg" viewBox="0 0 404 236" role="img" aria-label="The plow's pneumatics: two air tanks feed the main valve, then the piston valve, which drives two cylinders that push the plow out together." data-sketch>
    <title>RAMpage pneumatics</title>
    <rect class="s f" pathLength="1" x="10" y="34" width="46" height="78" rx="16"></rect>
    <rect class="s f" pathLength="1" x="10" y="126" width="46" height="78" rx="16"></rect>
    <text class="t" x="33" y="224" text-anchor="middle">air tanks</text>
    <path class="s" pathLength="1" d="M56 73 H80 V165 H56 M80 119 H100"></path>

    <rect class="s pn__valve pn__valve--main" pathLength="1" x="100" y="101" width="44" height="36"></rect>
    <text class="t t--mono" x="122" y="152" text-anchor="middle">GP14</text>
    <text class="t" x="122" y="168" text-anchor="middle">main valve</text>
    <text class="t pn__state pn__state--main" x="122" y="184" text-anchor="middle" data-pn-main>open</text>
    <path class="s pn__vent" pathLength="1" d="M122 101 V54 M114 64 L122 52 L130 64"></path>
    <text class="t pn__venttext" x="132" y="64">vent</text>

    <path class="s pn__pipe" pathLength="1" d="M144 119 H200"></path>
    <rect class="s pn__valve pn__valve--piston" pathLength="1" x="200" y="101" width="44" height="36"></rect>
    <text class="t t--mono" x="222" y="152" text-anchor="middle">GP15</text>
    <text class="t" x="222" y="168" text-anchor="middle">piston valve</text>
    <text class="t pn__state" x="222" y="184" text-anchor="middle" data-pn-piston>closed</text>

    <path class="s pn__pipe2" pathLength="1" d="M244 119 H264 M264 75 V163 M264 75 H276 M264 163 H276"></path>
    <rect class="s f" pathLength="1" x="276" y="62" width="58" height="26"></rect>
    <rect class="s f" pathLength="1" x="276" y="150" width="58" height="26"></rect>
    <text class="t" x="276" y="52">2 cylinders</text>
    <g class="pn__rod">
      <path class="s" pathLength="1" d="M306 75 H358 M306 163 H358"></path>
      <path class="s s--hot f--hot pn__plow" pathLength="1" d="M358 48 L374 48 L388 190 L358 190 Z"></path>
    </g>
    <text class="t" x="373" y="210" text-anchor="middle">plow</text>
  </svg>
  <p class="pn__status"><span class="sr-only">Plow: </span><span data-pn-status>Ready</span></p>
</div>

<style>
  .pn {
    min-width: 0;
  }

  .pn__svg {
    max-width: 28rem;
  }

  .pn__valve {
    fill: var(--surface);
    transition: fill 0.12s;
  }

  .pn[data-main='open'] .pn__valve--main,
  .pn[data-piston='open'] .pn__valve--piston {
    fill: var(--accent);
  }

  .pn__pipe,
  .pn__pipe2 {
    transition: stroke 0.12s;
  }

  .pn[data-pressure='on'] .pn__pipe,
  .pn[data-piston='open'] .pn__pipe2 {
    stroke: var(--accent);
    stroke-width: 3;
  }

  /* The vent: always readable in ink; it turns to the accent while the main valve vents. */
  .pn__vent {
    stroke: var(--text);
    stroke-width: 1.5;
  }

  .pn__venttext {
    font-size: 13px;
    fill: var(--text);
  }

  .pn[data-vent='on'] .pn__vent {
    stroke: var(--accent);
    stroke-width: 2.5;
  }

  .pn[data-vent='on'] .pn__venttext {
    fill: var(--accent-ink);
    font-weight: 700;
  }

  .pn__rod {
    transition: transform 0.3s ease-out;
  }

  /* Retracted, the plow sits against the rods' ends; extended, both rods push it out together. */
  .pn[data-piston='closed'] .pn__rod {
    transform: translateX(-22px);
  }

  .pn[data-piston='open'] .pn__rod {
    transform: translateX(0);
  }

  .pn__status {
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text);
  }
</style>
