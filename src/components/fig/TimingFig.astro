---
// Fig. 01: one plow strike as a timing diagram, drawn from the firmware's own constants. The
// trigger is RC channel 6 (channel 5 is the kill switch in pico_direct.py). The valve traces show
// each valve open (high) or closed (low): the exhaust (the firmware's main_solenoid, GP14) rests
// open so the plow stays home, and both inlets (piston_solenoid, GP15) open together to drive it
// out. "Fire the plow" runs src/lib/rampage-firmware.ts, the line for line port of pico_direct.py,
// so the cooldown, the 17 activation limit and the lockout are the firmware's. The air budget row
// also marks the team's air analysis: only about the first six cycles deliver more than 30 lbf.
import RampagePneumatics from '../drawings/RampagePneumatics.astro';
import { LOOP_MS, MAX_WEAPON_ACTIVATIONS, SOLENOID_ACTIVATION_TIME, SOLENOID_SEQUENCE_DELAY } from '@/lib/rampage-firmware';

const X0 = 150;
const X1 = 624;
const SPAN = 700; // ms shown
const x = (ms: number) => X0 + (ms / SPAN) * (X1 - X0);
const HI = 18;
const PRESS = 160; // how long the Fire button holds the switch
// The firmware sees the switch on its next 20 ms loop and starts the sequence.
const t0 = LOOP_MS;
const closeMain = t0 + SOLENOID_SEQUENCE_DELAY;
const openPiston = closeMain + SOLENOID_SEQUENCE_DELAY;
const done = openPiston + SOLENOID_ACTIVATION_TIME;

const rows = [
  {
    key: 'rc',
    name: 'RC channel 6',
    y: 52,
    high: [[0, PRESS]],
    fill: 'none',
    tip: ['trigger switch, RC channel 6', 'read on GP19 by a pin interrupt; one strike per flip'],
  },
  {
    key: 'main',
    name: 'GP14 exhaust',
    y: 104,
    high: [
      [0, closeMain],
      [done, SPAN],
    ],
    fill: 'var(--text)',
    tip: ['exhaust valve, GP14', `open at idle so the plow stays home; closes ${SOLENOID_SEQUENCE_DELAY} ms into a strike, reopens to vent`],
  },
  {
    key: 'piston',
    name: 'GP15 inlets',
    y: 156,
    high: [[openPiston, done]],
    fill: 'var(--accent)',
    tip: ['both inlet valves, GP15', `open together ${SOLENOID_ACTIVATION_TIME} ms, plow out to full extension`],
  },
];

const trace = (y: number, high: number[][]) => {
  let d = `M${X0} ${y}`;
  for (const [a, b] of high) d += ` H${x(a)} V${y - HI} H${x(b)} V${y}`;
  return d + ` H${X1}`;
};

// The team's air analysis: about six cycles above 30 lbf before reservoir pressure drops too far
// (predicted five, measured six). The firmware still allows 17.
const FULL_FORCE = 6;
const cellW = (X1 - X0) / MAX_WEAPON_ACTIVATIONS;
const cells = Array.from({ length: MAX_WEAPON_ACTIVATIONS }, (_, i) => X0 + i * cellW);
const ticks = [0, 100, 200, 300, 400, 500, 600, 700];
---

<div class="tf" data-tf>
  <!-- The controls sit on top of the drawing, so Fire and the plow are on screen together. -->
  <div class="tf__bar" role="group" aria-label="Plow controls">
    <button type="button" class="btn btn--small btn--primary tf__fire" data-fire>Fire</button>
    <fieldset class="tf__speed">
      <legend>Slow-mo</legend>
      <label><input type="radio" name="tf-speed" value="1" data-speed /> Off</label>
      <label><input type="radio" name="tf-speed" value="4" checked data-speed /> 4x</label>
      <label><input type="radio" name="tf-speed" value="16" data-speed /> 16x</label>
    </fieldset>
    <button type="button" class="btn btn--small tf__reset" data-reset>Reset</button>
    <p class="tf__chip" aria-live="polite"><span class="sr-only">Plow: </span><span data-tf-state>Ready</span></p>
  </div>
  <div class="tf__wrap">
  <div class="tf__pn" tabindex="0" role="group" aria-label="Plow drawing. Press Space or Enter to fire." aria-keyshortcuts="Space Enter" data-tf-pn><RampagePneumatics /></div>
  <div class="tf__plot" data-draw data-hscroll="Timing diagram">
    <svg viewBox="0 0 640 262" class="tf__svg" style="--fig-w:640px" role="group" aria-label="Timing diagram of one plow strike. Tab to each trace to read it.">
      <defs>
        <clipPath id="tf-clip"><rect x="0" y="0" width="640" height="200" data-tf-clip></rect></clipPath>
      </defs>
      {ticks.map((t) => <line class="tf__grid" x1={x(t)} x2={x(t)} y1="22" y2="226" />)}
      {
        ticks.map((t) => (
          <text class="tf__tick" x={x(t)} y="252" text-anchor="middle">
            {t === SPAN ? `${t} ms` : t}
          </text>
        ))
      }
      <g clip-path="url(#tf-clip)">
        {
          rows.map((r) => (
            <g class="tf__row" tabindex="0" role="img" aria-label={`${r.tip[0]}: ${r.tip[1]}.`} data-tip={r.tip.join('\n')} data-y={r.y - HI}>
              <rect class="tf__hit" x="0" y={r.y - HI - 10} width="640" height={HI + 20} />
              {r.high.map(([a, b]) => r.fill !== 'none' && <rect x={x(a)} y={r.y - HI} width={x(b) - x(a)} height={HI} fill={r.fill} />)}
              <path class="tf__line" d={trace(r.y, r.high)} />
              <text class="tf__name" x="0" y={r.y - 4}>
                {r.name}
              </text>
            </g>
          ))
        }
      </g>
      <g class="tf__row" tabindex="0" role="img" aria-label={`Air budget: about ${FULL_FORCE} cycles above 30 lbf, ${MAX_WEAPON_ACTIVATIONS} allowed by firmware, which locks out at zero.`} data-tip={`air budget\nabout ${FULL_FORCE} cycles above 30 lbf, ${MAX_WEAPON_ACTIVATIONS} allowed by firmware`} data-y="190" data-budget-row>
        <rect class="tf__hit" x="0" y="190" width="640" height="34" />
        <text class="tf__name" x="0" y="208">air budget</text>
        {cells.map((cx, i) => <rect class:list={['tf__cell', i >= FULL_FORCE && 'tf__cell--weak']} x={cx + 1.5} y="196" width={cellW - 3} height="14" data-cell={i} />)}
      </g>
      <line class="tf__head" x1={X0} x2={X0} y1="16" y2="228" data-tf-head data-x0={X0} data-x1={X1} data-span={SPAN} aria-hidden="true" />
      <g aria-hidden="true" class="tf__callouts">
        <circle cx={x(t0) + (x(closeMain) - x(t0)) / 2} cy="66" r="9" /><text x={x(t0) + (x(closeMain) - x(t0)) / 2} y="70">1</text>
        <circle cx={x(openPiston) + (x(done) - x(openPiston)) / 2} cy="118" r="9" /><text x={x(openPiston) + (x(done) - x(openPiston)) / 2} y="122">2</text>
        <circle cx={X1 - 4} cy="182" r="9" /><text x={X1 - 4} y="186">3</text>
      </g>
    </svg>
    <p class="tf__tip mono" data-tf-tip aria-hidden="true"></p>
  </div>
  </div>
  <div class="fig__note tf__legend">
    <p>
      <span class="tf__item"><span class="callout" aria-hidden="true">1</span> exhaust open {SOLENOID_SEQUENCE_DELAY} ms, plow home</span>
      <span class="tf__item"><span class="callout" aria-hidden="true">2</span> inlets open {SOLENOID_ACTIVATION_TIME} ms, plow out</span>
      <span class="tf__item"><span class="callout" aria-hidden="true">3</span> <span><span data-tf-used>0</span> of {MAX_WEAPON_ACTIVATIONS} used: about six cycles above 30 lbf, {MAX_WEAPON_ACTIVATIONS} allowed by firmware</span></span>
    </p>
    <p class="tf__slow" data-tf-speed-note>played 4x slower than real</p>
  </div>
  <p class="fig__try">Fire it three times and watch the budget.</p>
</div>

<style>
  /* The drawing and the timing rows side by side when there is room, stacked when not. */
  .tf {
    container-type: inline-size;
  }

  .tf__wrap {
    display: grid;
    align-items: center;
  }

  /* Each column may shrink below its drawing's width; on a phone the drawing scrolls instead. */
  .tf__wrap > * {
    min-width: 0;
  }

  .tf__pn {
    padding: 0.75rem 0.75rem 0;
  }

  @container (min-width: 760px) {
    .tf__wrap {
      grid-template-columns: minmax(18rem, 24rem) minmax(0, 1fr);
    }

    .tf__pn {
      padding: 1rem 0 1rem 1rem;
    }
  }

  .tf__head {
    stroke: var(--accent);
    stroke-width: 2;
    opacity: 0;
  }

  .tf[data-running] .tf__head {
    opacity: 1;
  }

  .tf__plot {
    position: relative;
    padding: 1rem 1rem 0.25rem;
  }

  .tf__svg {
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--font-sans);
  }

  .tf__grid {
    stroke: var(--line);
    stroke-dasharray: 2 4;
  }

  .tf__tick {
    font-family: var(--font-mono);
    font-size: 13px;
    fill: var(--muted);
  }

  .tf__name {
    font-size: 13px;
    fill: var(--text-soft);
  }

  .tf__line {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.5;
  }

  .tf__hit {
    fill: transparent;
  }

  .tf__row {
    outline: none;
  }

  .tf__row:hover .tf__name,
  .tf__row:focus-visible .tf__name {
    fill: var(--text);
    font-weight: 700;
  }

  .tf__row:focus-visible .tf__hit {
    stroke: var(--focus);
    stroke-width: 2;
  }

  .tf__cell {
    fill: var(--surface);
    stroke: var(--text);
    stroke-width: 1;
  }

  .tf__cell[data-used] {
    fill: var(--text);
  }

  /* Past the first six, a cycle still fires but below 30 lbf. */
  .tf__cell--weak {
    stroke: var(--line-strong);
    stroke-dasharray: 3 2;
  }

  .tf__cell--weak[data-used] {
    fill: var(--line-strong);
  }

  .tf__callouts circle {
    fill: var(--accent);
  }

  .tf__callouts text {
    fill: #fff;
    font-size: 13px;
    font-weight: 700;
    text-anchor: middle;
  }

  .tf__tip {
    position: absolute;
    top: 0;
    left: 0;
    display: none;
    max-width: 17rem;
    padding: 0.4rem 0.55rem;
    background: var(--navy);
    color: var(--on-navy);
    font-size: 0.875rem;
    line-height: 1.45;
    white-space: pre-line;
    pointer-events: none;
  }

  .tf__tip[data-on] {
    display: block;
  }

  /* Fire, slow-mo, reset and the plow's state: a toolbar on top of the drawing, sticky under the
     site header while the figure is on screen, so pressing Fire never scrolls the plow away. */
  .tf__bar {
    position: sticky;
    top: 4rem;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--line);
    background: var(--fig-tint);
  }

  .tf__bar .btn {
    min-height: 44px;
  }

  /* Header (4rem), toolbar (about 3.5rem on one row, 6.5rem when it wraps on a phone) and a margin. */
  .tf {
    --pn-max-h: calc(100svh - 4rem - 6.5rem - 2rem);
  }

  @container (min-width: 560px) {
    .tf__wrap {
      --pn-max-h: calc(100svh - 4rem - 3.5rem - 2rem);
    }
  }

  .tf__pn {
    outline-offset: -3px;
  }

  @container (max-width: 300px) {
    .tf__pn {
      padding-inline: 0.25rem;
    }
  }

  .tf__speed {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0;
    border: 0;
    padding: 0;
    margin: 0;
  }

  .tf__speed legend {
    float: left;
    margin-right: 0.6rem;
    font-size: 0.9375rem;
    color: var(--text-soft);
  }

  .tf__speed label {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--line-strong);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
    cursor: pointer;
  }

  .tf__speed label + label {
    border-left: 0;
  }

  .tf__speed input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }

  .tf__speed label:has(input:checked) {
    background: var(--text);
    color: var(--bg-contrast);
  }

  .tf__speed label:has(input:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .tf__chip {
    margin-left: auto;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--accent);
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text);
  }

  .tf__legend p {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
  }

  /* The callout sits at the first line when an item wraps. */
  .tf__item {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.45rem;
  }

  .tf__legend .callout {
    width: 20px;
    height: 20px;
    font-size: 13px;
  }

  .tf__legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    color: var(--text-soft);
  }


</style>

<script>
  import { mountTiming } from '../../scripts/fig/timing';
  document.querySelectorAll<HTMLElement>('[data-tf]').forEach(mountTiming);
</script>
