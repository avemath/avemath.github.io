---
// Fig. 02: the V2V receiver as a block diagram of real, focusable stages, in the order
// V2V_TXRXf.m runs them (src/lib/v2v-stages.ts). Picking a stage shows what it does and the
// signal after it, computed in the browser by src/lib/ofdm-rx.ts, the port of the MATLAB
// receiver. No raw capture was kept from the radios, so the live view is simulated; the five
// hardware runs sit under it as a table.
import { v2vStages } from '@/lib/v2v-stages';

const stages = v2vStages.map(({ key, name, text, io, look }) => ({ key, name, text, io, look }));
const first = stages.findIndex((s) => s.key === 'pll');
const runs = [
  { run: 1, dist: '6 in', obs: 'none', snr: '8.2 / 8.2' },
  { run: 2, dist: '3 in', obs: 'none', snr: '7.6 / 7.7' },
  { run: 3, dist: '6 in', obs: 'a hand', snr: '7.5 / 7.6' },
  { run: 4, dist: '6 in', obs: 'a laptop lid', snr: '7.5 / 7.6' },
  { run: 5, dist: '6 in', obs: 'around a corner, no line of sight', snr: '7.3 / 7.1' },
];
---

<div class="cf" data-cf>
  <div class="cf__plot" data-draw>
    <ol class="cf__chain" aria-label="Receiver stages, in signal order">
      {
        stages.map((s, i) => (
          <li class="cf__item">
            <button type="button" class="cf__stage" data-stage={s.key} aria-pressed={i === first ? 'true' : 'false'} aria-describedby="cf-desc">
              <span class="cf__n" aria-hidden="true">{i + 1}</span>{s.name}
            </button>
            {i < stages.length - 1 && <span class="cf__wire" aria-hidden="true" />}
          </li>
        ))
      }
    </ol>
    <div class="cf__detail">
      <div class="cf__desc" id="cf-desc" aria-live="polite">
        <p data-cf-text>{stages[first].text}</p>
        <p class="cf__io" data-cf-io>{stages[first].io}</p>
      </div>
      <figure class="cf__scope">
        <svg viewBox="-1.6 -1.6 3.2 3.2" class="cf__svg" data-cf-svg aria-hidden="true">
          <line x1="-1.6" x2="1.6" y1="0" y2="0"></line>
          <line y1="-1.6" y2="1.6" x1="0" x2="0"></line>
        </svg>
        <div class="cf__bsm" data-cf-bsm hidden></div>
        <figcaption class="cf__cap" data-cf-cap>constellation after this stage</figcaption>
      </figure>
    </div>
  </div>
  <p class="fig__try"><span class="on-mouse">Hover</span><span class="on-touch">Tap</span> a stage, then step through to the brake warning.</p>
  <div class="cf__runs">
    <p class="cf__foot">
      The view above is simulated in the browser: one packet at 5 kHz of offset and 18 dB SNR. No raw capture was kept from the radios.
      Run 4's figures for every stage are under How it works. The five over-the-air runs, all at BER 0.0000:
    </p>
    <table class="cf__table">
      <thead>
        <tr><th scope="col">Run</th><th scope="col">Apart</th><th scope="col">Between the radios</th><th scope="col">corrSNR, dB<span class="sr-only">, car 1 then car 2</span><span aria-hidden="true"> (car 1 / 2)</span></th></tr>
      </thead>
      <tbody>
        {runs.map((r) => <tr><td>{r.run}</td><td>{r.dist}</td><td>{r.obs}</td><td>{r.snr}</td></tr>)}
      </tbody>
    </table>
  </div>
  <script type="application/json" data-cf-stages set:html={JSON.stringify(stages)} />
</div>

<style>
  .cf__plot {
    padding: 1.25rem 1rem 1rem;
  }

  .cf__chain {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: 0.75rem;
  }

  .cf__item {
    display: flex;
    align-items: center;
  }

  .cf__stage {
    min-height: 2.5rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--text);
    background: var(--surface);
    font-size: 0.875rem;
    color: var(--text);
    cursor: pointer;
  }

  .cf__n {
    margin-right: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .cf__stage[aria-pressed='true'] .cf__n {
    color: var(--accent-ink);
  }

  .cf__stage:hover {
    background: var(--surface-2);
  }

  .cf__stage[aria-pressed='true'] {
    border: 2px solid var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
    padding-inline: calc(0.6rem - 1px);
  }

  .cf__wire {
    width: 0.9rem;
    height: 1px;
    background: var(--line-strong);
  }

  .cf__wire[data-hot] {
    height: 2px;
    background: var(--accent);
  }

  .cf__detail {
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 560px) {
    .cf__detail {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .cf__desc {
    padding: 0.85rem 1rem;
    background: var(--text);
    color: var(--bg);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .cf__io {
    margin-top: 0.5rem;
    color: color-mix(in srgb, var(--bg) 78%, var(--text));
  }

  .cf__scope {
    position: relative;
    margin: 0;
    border: 1px solid var(--line);
  }

  .cf__svg {
    width: 100%;
    aspect-ratio: 1;
    max-height: 14rem;
  }

  .cf__svg line {
    stroke: var(--line);
    stroke-width: 0.01;
  }

  .cf__svg :global(circle) {
    fill: var(--text);
  }

  .cf__svg :global(circle.hot) {
    fill: var(--accent);
  }

  .cf__bsm {
    padding: 0.85rem 0.85rem 0.5rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .cf__bsm :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .cf__bsm :global(th),
  .cf__bsm :global(td) {
    padding: 0.15rem 0.3rem;
    text-align: right;
    font-weight: 400;
    white-space: nowrap;
  }

  .cf__bsm :global(th[scope='row']),
  .cf__bsm :global(th[scope='col']:first-child) {
    padding-left: 0;
    text-align: left;
  }

  .cf__bsm :global(th[scope='colgroup']) {
    text-align: center;
    color: var(--text);
  }

  .cf__bsm :global(thead th) {
    color: var(--text-soft);
    border-bottom: 1px solid var(--line);
  }

  .cf__bsm :global(p) {
    margin-top: 0.5rem;
  }

  .cf__bsm :global(.cf__warn) {
    color: var(--accent-ink);
    font-weight: 700;
  }

  .cf__runs {
    padding: 0 1rem 1rem;
  }

  .cf__foot {
    font-size: 0.875rem;
    color: var(--text-soft);
  }

  .cf__table {
    width: 100%;
    margin-top: 0.5rem;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .cf__table th,
  .cf__table td {
    padding: 0.3rem 0.6rem 0.3rem 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .cf__table th {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--text);
  }

  .cf__table td:first-child,
  .cf__table td:last-child {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .cf__cap {
    position: absolute;
    right: 0.4rem;
    bottom: 0.3rem;
    font-size: 0.875rem;
    color: var(--text-soft);
  }

  .cf__bsm:not([hidden]) + .cf__cap {
    position: static;
    padding: 0 0.6rem 0.4rem;
    text-align: right;
  }
</style>

<script>
  import { mountChain } from '../../scripts/fig/chain';
  document.querySelectorAll<HTMLElement>('[data-cf]').forEach(mountChain);
</script>
