---
import Icon from './Icon.astro';
import site from '@/data/site.json';

interface Props {
  /** An optional small muted label at the right of the nav. */
  label?: string;
  /** Which item is the current place: set by /work/ and the case studies. */
  section?: 'projects' | 'websites' | 'research';
}

const { label, section } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// Projects and Websites open their sections of /work/, so the whole list is one click from any
// page. Contact is the footer, which every page has.
const nav = [
  { href: '/work/#engineering', label: 'Projects', key: 'projects' },
  { href: '/work/#websites', label: 'Websites', key: 'websites' },
  { href: '/research/', label: 'Research', key: 'research' },
  { href: '/about/', label: 'About', key: 'about' },
  { href: '/contact/', label: 'Contact', key: 'contact' },
];
// The contact page lights Contact, and the services page (website work) lights Websites.
const isCurrent = (key: string) =>
  key === section ||
  (key === 'research' && path === '/research') ||
  (key === 'about' && path === '/about') ||
  (key === 'contact' && path === '/contact') ||
  (key === 'websites' && path === '/services');
---

<header class="site-header no-print" data-header>
  <div class="wrap site-header__row">
    <a href="/" class="brand" aria-label={`${site.name}, home`}>{site.name}</a>

    <nav aria-label="Main" class="site-nav">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="nav-link" aria-current={isCurrent(item.key) ? (path === '/work' || path === '/research' || path === '/about' || path === '/contact' ? 'page' : 'true') : undefined}
                data-nav-key={item.key}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__end">
      {label && <p class="nav-label mono" data-nav-label>{label}</p>}
      <button type="button" class="icon-btn kbd-btn" data-palette-open aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K" aria-label="Jump to a page or project" title="Jump to (Ctrl K)">
        <Icon name="search" />
      </button>
      <button type="button" class="icon-btn" data-theme-toggle aria-label="Switch color theme" title="Switch color theme">
        <Icon name="sun" class="theme-icon theme-icon--sun h-[1.15em] w-[1.15em]" />
        <Icon name="moon" class="theme-icon theme-icon--moon h-[1.15em] w-[1.15em]" />
      </button>

      <!-- Phone menu. A native disclosure, so it opens before any JavaScript loads. -->
      <details class="mnav" data-mnav>
        <summary class="icon-btn mnav__button">
          <Icon name="menu" class="mnav__icon mnav__icon--open h-[1.15em] w-[1.15em]" />
          <Icon name="close" class="mnav__icon mnav__icon--close h-[1.15em] w-[1.15em]" />
          Menu
        </summary>
        <nav aria-label="Menu" class="mnav__panel">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} class="mnav__link" aria-current={isCurrent(item.key) ? (path === '/work' || path === '/research' || path === '/about' || path === '/contact' ? 'page' : 'true') : undefined}
                data-nav-key={item.key}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <button type="button" class="mnav__link mnav__search" data-palette-open aria-haspopup="dialog">
                <Icon name="search" /> Search the site
              </button>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  /* The nav sits on paper on every page, with a hairline once the page scrolls. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
  }

  .site-header[data-scrolled],
  .site-header:has(.mnav[open]) {
    border-bottom-color: var(--line);
  }

  .site-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4rem;
  }

  .brand {
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav {
    display: none;
  }

  @media (min-width: 860px) {
    .site-nav {
      display: block;
    }
  }

  .site-nav ul {
    display: flex;
    gap: 0.25rem;
  }

  .nav-link {
    display: inline-block;
    padding: 0.5rem 0.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--text);
  }

  .nav-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .nav-link[aria-current] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
    text-decoration-color: var(--accent);
  }

  .nav-link[aria-current] {
    color: var(--accent-ink);
  }

  .site-header__end {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-label {
    min-width: 8ch;
    margin-right: 0.5rem;
    font-size: 0.875rem;
    text-align: right;
    color: var(--text-soft);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 2.5rem;
    height: 2.5rem;
    padding-inline: 0.65rem;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--text);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .icon-btn:hover {
    border-color: var(--text);
  }

  .kbd-btn {
    display: none;
  }

  @media (min-width: 860px) {
    .kbd-btn {
      display: inline-flex;
    }
  }

  :global([data-theme='dark']) .theme-icon--sun,
  :global(:root:not([data-theme='dark'])) .theme-icon--moon {
    display: none;
  }

  /* Phone menu */
  @media (min-width: 860px) {
    .mnav {
      display: none;
    }
  }

  .mnav__button {
    list-style: none;
  }

  .mnav__button::-webkit-details-marker {
    display: none;
  }

  .mnav[open] .mnav__button {
    border-color: var(--text);
  }

  .mnav[open] .mnav__icon--open,
  .mnav:not([open]) .mnav__icon--close {
    display: none;
  }

  .mnav__panel {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    padding: 0.25rem var(--gutter) 1rem;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }

  .mnav__link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.85rem 0.25rem;
    border-bottom: 1px solid var(--line);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  .mnav__link[aria-current] {
    color: var(--accent-ink);
  }

  .mnav__search {
    border-bottom: 0;
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-soft);
  }

  .mnav__search :global(svg) {
    width: 1.1em;
    height: 1.1em;
  }

  /* Small phones: the label gives way so the menu button always fits. */
  @media (max-width: 379px) {
    .nav-label {
      display: none;
    }
  }
</style>

<script>
  // The divider shows once the page has scrolled. A marker 8px tall at the top of the page tells
  // us without reading the scroll position, so nothing forces a layout while the page loads.
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header && 'IntersectionObserver' in window) {
    const mark = document.createElement('div');
    mark.setAttribute('aria-hidden', 'true');
    mark.style.cssText = 'position:absolute;top:0;left:0;width:1px;height:8px;pointer-events:none';
    document.body.prepend(mark);
    new IntersectionObserver(([e]) => header.toggleAttribute('data-scrolled', !e.isIntersecting)).observe(mark);
  }

  // Phone menu: close on Escape, on a tap outside, and once a link or the search button is chosen.
  const menu = document.querySelector<HTMLDetailsElement>('[data-mnav]');
  if (menu) {
    const close = () => menu.removeAttribute('open');
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        close();
        menu.querySelector<HTMLElement>('summary')?.focus();
      }
    });
    menu.querySelectorAll('a, button').forEach((el) => el.addEventListener('click', close));
  }
</script>
