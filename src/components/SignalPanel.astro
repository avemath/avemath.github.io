---
// The signal panel: the hero's preamble as tone bars, read with scope cursors (src/scripts/
// signal-panel.ts). With `empty`, as on the 404 page, it shows the same scope with no signal:
// the grid and the cursors, a readout of dashes, and no sound.
import { CHIPS, CHIP_MS, DURATION_MS } from '@/lib/preamble';
import { F_HIGH, F_LOW, PAIRS } from '@/lib/fhbfsk';

interface Props {
  empty?: boolean;
}

const { empty = false } = Astro.props;
---

<figure class="sig" data-sig data-empty={empty ? '' : undefined} aria-labelledby="sig-cap">
  <div class="sig__screen" data-sig-screen data-fig>
    <canvas class="sig__canvas" aria-hidden="true"></canvas>
    <div class="sig__scope" data-sig-scope tabindex="0" role="img" aria-label={empty ? 'An empty scope: no signal on any tone. Use the arrow keys to move the cursors.' : `A frequency hopping preamble: ${CHIPS} chips of ${CHIP_MS} ms, each one tone between ${F_LOW} and ${F_HIGH} Hz. Use the arrow keys to read chip by chip.`}></div>
    <span class="sig__cur sig__cur--v" data-sig-v aria-hidden="true"></span>
    <span class="sig__cur sig__cur--h" data-sig-h aria-hidden="true"></span>
    <p class="sig__read mono" data-sig-read aria-hidden="true"></p>
    <p class="sig__cap mono" id="sig-cap">{empty ? 'No carrier, 2 kHz / div' : 'FH-BFSK preamble, JANUS band, 2 kHz / div'}</p>
    <p class="sig__hint" data-sig-hint>move the mouse to read the signal</p>
    {
      !empty && (
        <button type="button" class="sig__play" data-sig-play aria-pressed="false">
          <svg viewBox="0 0 12 12" aria-hidden="true">
            <path d="M2 1.5v9l8-4.5z" fill="currentColor" />
          </svg>
          <span data-sig-play-label>Hear it, 2 s</span>
          <span class="sig__prog" aria-hidden="true" />
        </button>
      )
    }
  </div>
  <p class="sr-only" aria-live="polite" data-sig-live></p>
  {
    !empty && (
  <figcaption class="sig__note">
    <span class="sig__plain">
      This is the preamble an underwater modem sends before it talks.
      <span class="sig__do sig__do--mouse">Move your mouse to read it.</span><span class="sig__do sig__do--touch">Tap Hear it to listen.</span>
    </span>
    <span class="sig__tech">
      {/* TODO(ave): check wording. */}
      {DURATION_MS} ms on air, played ten times slower and three octaves lower so it isn't shrill. The band, the {PAIRS} tone pairs and the chip length follow JANUS, the NATO
      standard for underwater modems; the scheme is frequency-hopping binary frequency-shift keying (FH-BFSK), and the hop order is
      the playground's own.
    </span>
  </figcaption>
    )
  }
</figure>

<style>
  .sig {
    margin: 0;
    min-width: 0;
  }

  /* A scope screen: dark in both modes, with its own inks. */
  .sig__screen {
    --text: var(--screen-ink);
    --text-soft: var(--screen-muted);
    --muted: var(--screen-muted);
    --line: var(--screen-line);
    --focus: var(--screen-accent);
    position: relative;
    aspect-ratio: 5 / 4;
    border: 1px solid var(--rule);
    background: var(--screen);
    color: var(--screen-ink);
    overflow: hidden;
    touch-action: pan-y;
  }

  /* The focusable layer over the plot, for reading it by keyboard. The button sits above it. */
  .sig__scope {
    position: absolute;
    inset: 0;
  }

  .sig__scope:focus-visible {
    outline-offset: -3px;
  }

  .sig__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .sig__cur {
    position: absolute;
    display: none;
    pointer-events: none;
    background: color-mix(in srgb, var(--screen-ink) 70%, transparent);
  }

  .sig__cur--v {
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
  }

  .sig__cur--h {
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
  }

  .sig__screen[data-reading] .sig__cur {
    display: block;
  }

  .sig__read {
    position: absolute;
    top: 0;
    left: 0;
    display: none;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--screen-line);
    background: var(--screen);
    font-size: 0.875rem;
    line-height: 1.45;
    white-space: pre;
    color: var(--screen-ink);
    pointer-events: none;
    font-variant-numeric: tabular-nums;
  }

  .sig__screen[data-reading] .sig__read {
    display: block;
  }

  .sig__cap,
  .sig__hint {
    position: absolute;
    left: 0.75rem;
    font-size: 0.875rem;
    color: var(--text-soft);
    pointer-events: none;
  }

  .sig__cap {
    top: 0.6rem;
  }

  .sig__hint {
    bottom: 0.85rem;
  }

  /* Touch screens have no cursors to move, and a narrow screen has no room beside Hear it. */
  @media (hover: none), (max-width: 520px) {
    .sig__hint {
      visibility: hidden;
    }
  }

  .sig__play {
    position: absolute;
    z-index: 1;
    right: 0.75rem;
    bottom: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--screen-ink);
    border-radius: 999px;
    background: var(--screen);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--screen-ink);
    cursor: pointer;
  }

  /* While it plays, a thin bar along the bottom edge shows how far through the 2 s it is. */
  .sig__prog {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: var(--accent);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
  }

  .sig__play svg {
    width: 0.7rem;
    height: 0.7rem;
  }

  .sig__play[aria-pressed='true'] {
    border-color: var(--accent);
  }

  .sig__note {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.75rem;
    color: var(--muted);
  }

  .sig__plain {
    font-size: 0.9375rem;
  }

  .sig__tech {
    font-size: 0.875rem;
  }

  /* The second sentence of the caption matches the device: a mouse reads, a finger listens. */
  .sig__do--touch {
    display: none;
  }

  @media (hover: none) {
    .sig__do--mouse {
      display: none;
    }

    .sig__do--touch {
      display: inline;
    }
  }
</style>

<script>
  import { mountSignalPanel } from '../scripts/signal-panel';
  import { afterLoadIdle } from '../scripts/idle';

  // The panel draws once the page has loaded and the browser is idle, so the headline paints first
  // and the panel's setup (and the touch drift) never lands in the first paint's way.
  const fig = document.querySelector<HTMLElement>('[data-sig]');
  if (fig) afterLoadIdle(() => mountSignalPanel(fig));
</script>
