---
import now from '@/data/now.json';
---

<section class="now" aria-label="What I'm doing now">
  <div class="wrap">
    <dl class="now__grid">
      {
        now.map((item, i) => (
          <div class="now__item">
            <dt class="label">
              <span class="now__idx mono" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              {item.label}
            </dt>
            <dd>{item.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .now {
    border-block: 1px solid var(--line);
    background: var(--surface);
  }

  .now__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .now__item {
    padding: 1.4rem 1.25rem 1.5rem;
  }

  .now__item + .now__item {
    border-left: 1px solid var(--line);
  }

  .now__item dt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .now__idx {
    color: var(--accent);
  }

  .now__item dd {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--text);
  }

  @media (max-width: 960px) {
    .now__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .now__item:nth-child(3) {
      border-left: 0;
    }

    .now__item:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 560px) {
    .now__grid {
      grid-template-columns: 1fr;
    }

    .now__item + .now__item {
      border-left: 0;
      border-top: 1px solid var(--line);
    }

    .now__item {
      padding: 1.1rem 0 1.2rem;
    }
  }
</style>
