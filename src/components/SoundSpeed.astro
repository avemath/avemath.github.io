---
// The sound channel, interactive: a textbook sound speed profile (Munk's canonical shape, with
// the axis at 1,000 m) and ten rays traced through it from a source you can move up and down the
// depth axis. General ocean physics only; nothing here comes from the sponsored research. The
// build draws the rays for a source on the axis, so it reads without JavaScript; the script, which
// loads only when the figure nears the screen, redraws them as the source moves.
import { AXIS, FLOOR, PLOT, RANGE, depthY, rays, describe, speed } from '@/lib/sound-channel';

const Z0 = AXIS;
const first = rays(Z0);

// Profile panel: speed across, depth down.
const sx0 = 54;
const sx1 = 244;
const C0 = 1490;
const C1 = 1550;
const sx = (c: number) => sx0 + ((c - C0) / (C1 - C0)) * (sx1 - sx0);
const curve = Array.from({ length: 81 }, (_, i) => (i / 80) * FLOOR)
  .map((z, i) => `${i ? 'L' : 'M'} ${sx(speed(z)).toFixed(1)} ${depthY(z).toFixed(1)}`)
  .join(' ');
const depthTicks = [0, 1000, 2000, 3000, 4000];
const speedTicks = [1500, 1520, 1540];
const rangeTicks = [0, 25, 50, 75, 100];
const rx = (km: number) => PLOT.rayX0 + ((km * 1000) / RANGE) * (PLOT.rayX1 - PLOT.rayX0);
---

<figure class="ssp" data-sound-channel data-z0={Z0}>
  <div class="ssp__panels">
    <svg class="ssp__profile" viewBox="0 0 260 300" role="img" aria-labelledby="ssp-title" focusable="false">
      <title id="ssp-title">
        Sound speed against depth. Speed falls from about 1,523 meters per second at the surface to 1,500 at 1,000 meters, the
        channel axis, then rises to about 1,540 at 4,000 meters.
      </title>
      <text x={sx0} y="12" class="ssp__axis-name">Sound speed (m/s)</text>
      {
        speedTicks.map((c) => (
          <g>
            <path d={`M ${sx(c)} ${PLOT.y0} V ${PLOT.y1}`} class="ssp__grid" />
            <text x={sx(c)} y={PLOT.y0 - 6} class="ssp__tick" text-anchor="middle">
              {c.toLocaleString('en-US')}
            </text>
          </g>
        ))
      }
      {
        depthTicks.map((z) => (
          <text x={sx0 - 7} y={depthY(z) + 3.5} class="ssp__tick" text-anchor="end">
            {z.toLocaleString('en-US')}
          </text>
        ))
      }
      <text x="4" y={PLOT.y1 + 24} class="ssp__axis-name">Depth (m)</text>
      <path d={`M ${sx0} ${PLOT.y0} V ${PLOT.y1}`} class="ssp__frame" />
      <path d={`M ${sx0} ${depthY(AXIS)} H ${sx1}`} class="ssp__channel" />
      <path d={curve} class="ssp__curve" />
      <circle cx={sx(1500)} cy={depthY(AXIS)} r="3.5" class="ssp__min" />
      <text x={sx(1500) + 8} y={depthY(AXIS) - 6} class="ssp__label">Channel axis</text>
      <g class="ssp__mark" data-ssp-mark style={`transform:translateY(${depthY(Z0) - depthY(AXIS)}px)`}>
        <path d={`M ${sx0} ${depthY(AXIS)} H ${sx1}`} class="ssp__src-line" />
        <circle cx={sx(speed(Z0))} cy={depthY(AXIS)} r="3" class="ssp__src-dot" data-ssp-dot />
      </g>
    </svg>

    <svg class="ssp__rays" viewBox="0 0 380 300" aria-labelledby="ssp-rays-title" role="group" focusable="false" data-ssp-svg>
      <title id="ssp-rays-title" data-ssp-rays-title>Ten rays traced from the source. {describe(Z0, first.held)}</title>
      <text x={PLOT.rayX0} y="12" class="ssp__axis-name">Range (km)</text>
      {
        rangeTicks.map((km) => (
          <g>
            <path d={`M ${rx(km)} ${PLOT.y0} V ${PLOT.y1}`} class="ssp__grid" />
            <text x={rx(km)} y={PLOT.y0 - 6} class="ssp__tick" text-anchor="middle">
              {km}
            </text>
          </g>
        ))
      }
      <path d={`M ${PLOT.rayX0} ${PLOT.y1} H ${PLOT.rayX1}`} class="ssp__floor" />
      <path d={`M ${PLOT.rayX0} ${depthY(AXIS)} H ${PLOT.rayX1}`} class="ssp__channel" />
      <g class="ssp__ray-set" data-ssp-rays>
        {first.paths.map((p) => <path d={p.d} class:list={['ssp__ray', p.bounced && 'ssp__ray--out']} />)}
      </g>
      <path d={`M ${PLOT.rayX0} ${PLOT.y0} V ${PLOT.y1}`} class="ssp__frame" />
      <g class="ssp__src" data-ssp-handle style={`transform:translateY(${depthY(Z0)}px)`}>
        <circle cx={PLOT.rayX0} cy="0" r="15" class="ssp__src-hit" />
        <circle cx={PLOT.rayX0} cy="0" r="6.5" class="ssp__src-knob" />
        <circle cx={PLOT.rayX0} cy="0" r="2.2" class="ssp__src-core" />
      </g>
    </svg>
  </div>
  <p class="ssp__readout mono" data-ssp-readout>{describe(Z0, first.held)}</p>
  <figcaption>
    Sound bends toward the slowest water, so near 1,000 m it can carry a very long way.
    <span class="ssp__how" hidden data-ssp-how>Drag the source up or down, or focus it and use the arrow keys.</span>
    A textbook profile, not project data.
  </figcaption>
</figure>

<style>
  .ssp {
    margin: 0;
  }

  /* Profile and rays side by side from tablet width, stacked on phones. */
  .ssp__panels {
    display: grid;
    gap: 0.5rem 0;
  }

  @media (min-width: 560px) {
    .ssp__panels {
      grid-template-columns: minmax(0, 0.68fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .ssp svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .ssp__axis-name,
  .ssp__tick,
  .ssp__label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    fill: var(--muted);
  }

  .ssp__axis-name {
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .ssp__label {
    fill: var(--amber-ink);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .ssp__grid {
    stroke: var(--line);
  }

  .ssp__frame,
  .ssp__floor {
    stroke: var(--line-strong);
  }

  .ssp__floor {
    stroke-width: 2;
  }

  .ssp__channel {
    stroke: var(--amber-line);
    stroke-dasharray: 3 5;
    stroke-opacity: 0.7;
  }

  .ssp__curve {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .ssp__min {
    fill: var(--amber-line);
  }

  .ssp__src-line {
    stroke: var(--accent);
    stroke-opacity: 0.45;
    stroke-dasharray: 1 3;
  }

  .ssp__src-dot {
    fill: var(--accent);
  }

  /* Rays held in the channel in teal; rays that reach the surface or the floor fade back. */
  .ssp__ray {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.2;
    stroke-opacity: 0.9;
    stroke-linejoin: round;
  }

  .ssp__ray--out {
    stroke: var(--muted);
    stroke-opacity: 0.45;
  }

  .ssp__src-hit {
    fill: transparent;
  }

  .ssp__src-knob {
    fill: var(--bg);
    stroke: var(--amber-line);
    stroke-width: 2;
  }

  .ssp__src-core {
    fill: var(--amber-line);
  }

  .ssp__src[role='slider'] {
    cursor: grab;
    outline: none;
    touch-action: none;
  }

  .ssp__src[role='slider']:active {
    cursor: grabbing;
  }

  .ssp__src[role='slider']:focus-visible .ssp__src-knob {
    stroke: var(--accent);
    stroke-width: 3;
  }

  .ssp__readout {
    margin-top: 0.6rem;
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: var(--text-soft);
  }

  figcaption {
    max-width: 38rem;
    margin-top: 0.5rem;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text-soft);
  }
</style>

<script>
  // The interaction loads only when the figure is near the screen.
  const fig = document.querySelector<HTMLElement>('[data-sound-channel]');
  if (fig && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        import('../scripts/sound-channel').then((m) => m.mountSoundChannel(fig));
      },
      { rootMargin: '300px 0px' },
    );
    io.observe(fig);
  }
</script>
