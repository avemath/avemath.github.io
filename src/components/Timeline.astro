---
import Icon from './Icon.astro';
import experience from '@/data/experience.json';
import { formatRange, formatMonth } from '@/lib/format';

const kindLabel: Record<string, string> = {
  research: 'Research',
  engineering: 'Engineering',
  web: 'Web',
  nonprofit: 'Nonprofit',
  land: 'Land',
  education: 'Education',
};

const entries = [
  ...experience.roles.map((r) => ({
    id: r.id,
    kind: r.kind,
    when: formatRange(r.start, r.end),
    sort: r.end ?? '9999',
    start: r.start,
    title: r.title,
    org: r.org,
    summary: r.summary,
    bullets: r.bullets,
    project: r.project,
  })),
].sort((a, b) => b.sort.localeCompare(a.sort) || b.start.localeCompare(a.start));
---

<section id="experience" class="section home-section" aria-labelledby="experience-title" data-section="experience">
  <div class="wrap">
    <div class="grid gap-10 min-[1100px]:grid-cols-[18rem_1fr]">
      <div class="min-[1100px]:sticky min-[1100px]:top-28 min-[1100px]:self-start md:grid md:grid-cols-[1fr_20rem] md:items-end md:gap-10 min-[1100px]:block">
        <div>
        <p class="eyebrow">Experience</p>
        <h2 id="experience-title" class="section-title">Land agent since 2020, researcher since 2026</h2>
        <p class="section-lede text-base">Open any entry for the details, or read the résumé.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="btn btn--small" href="/resume/">Résumé <Icon name="arrow-right" /></a>
          <button type="button" class="btn btn--small" data-timeline-all aria-pressed="false">Expand all</button>
        </div>
        </div>

        <div>
        <p class="label mt-8 md:mt-0 min-[1100px]:mt-8">Education</p>
        <ul class="mt-2 space-y-2 text-sm text-soft">
          {
            experience.education.map((e) => (
              <li>
                {e.degree}, {e.school}, {e.expected ? `expected ${formatMonth(e.end)}` : formatMonth(e.end)}
              </li>
            ))
          }
        </ul>
        </div>
      </div>

      <ol class="timeline" data-timeline>
        {
          entries.map((e, i) => (
            <li class={`tl tl--${e.kind}`} data-reveal>
              <details class="tl__details" open={i === 0}>
                <summary class="tl__summary">
                  <span class="tl__node" aria-hidden="true" />
                  <span class="tl__when mono">{e.when}</span>
                  <span class="tl__title">{e.title}</span>
                  <span class="tl__org">{e.org}</span>
                  <span class="tl__kind chip">{kindLabel[e.kind]}</span>
                  <span class="tl__toggle" aria-hidden="true">
                    <Icon name="arrow-right" class="h-4 w-4" />
                  </span>
                </summary>
                <div class="tl__body">
                  {e.summary && <p>{e.summary}</p>}
                  {e.bullets.length > 0 && (
                    <ul>
                      {e.bullets.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                  )}
                  {e.project && (
                    <a class="link mt-3 inline-flex items-center gap-1" href={`/work/${e.project}/`}>
                      Case study <Icon name="arrow-right" class="h-4 w-4" />
                    </a>
                  )}
                </div>
              </details>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: 0.75rem;
    padding-left: 1.75rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0.45rem;
    top: 0.75rem;
    bottom: 0.75rem;
    width: 1px;
    background: linear-gradient(var(--accent), var(--line) 60%);
    transform-origin: top;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      :global(html:not([data-motion='reduce'])) .timeline::before {
        animation: draw linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 60%;
      }
    }
  }

  @keyframes draw {
    from {
      scale: 1 0;
    }
  }

  .tl__details {
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--surface);
    transition:
      border-color 0.25s,
      box-shadow 0.25s;
    interpolate-size: allow-keywords;
  }

  .tl__details[open] {
    border-color: color-mix(in oklab, var(--accent) 45%, var(--line));
    box-shadow: var(--shadow);
  }

  .tl__details::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.4s var(--ease-out-expo),
      content-visibility 0.4s allow-discrete;
  }

  .tl__details[open]::details-content {
    block-size: auto;
  }

  .tl__summary {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.2rem 1rem;
    padding: 1rem 1.25rem;
    list-style: none;
    cursor: pointer;
  }

  .tl__summary::-webkit-details-marker {
    display: none;
  }

  .tl__node {
    position: absolute;
    left: calc(-1.75rem + 0.45rem - 0.4rem);
    top: 1.35rem;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    border: 2px solid var(--accent);
    background: var(--bg);
    transition: background-color 0.25s;
  }

  .tl__details[open] .tl__node {
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-wash);
  }

  .tl__when {
    grid-column: 1;
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .tl__title {
    grid-column: 1;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .tl__org {
    grid-column: 1;
    font-size: 0.92rem;
    color: var(--text-soft);
  }

  .tl__kind {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
  }

  .tl__toggle {
    grid-column: 2;
    grid-row: 2 / span 2;
    align-self: center;
    justify-self: end;
    color: var(--muted);
    transition: rotate 0.3s var(--ease-out-expo);
  }

  .tl__details[open] .tl__toggle {
    rotate: 90deg;
    color: var(--accent);
  }

  .tl__body {
    padding: 0 1.25rem 1.25rem;
    color: var(--text-soft);
    font-size: 0.97rem;
  }

  .tl__body ul {
    margin-top: 0.6rem;
    display: grid;
    gap: 0.4rem;
  }

  .tl__body li {
    position: relative;
    padding-left: 1rem;
  }

  .tl__body li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.45rem;
    height: 1px;
    background: var(--accent);
  }

  @media (max-width: 560px) {
    .tl__kind {
      display: none;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-timeline-all]');
  const all = [...document.querySelectorAll<HTMLDetailsElement>('[data-timeline] details')];
  const sync = () => {
    const allOpen = all.every((d) => d.open);
    if (!btn) return;
    btn.textContent = allOpen ? 'Collapse all' : 'Expand all';
    btn.setAttribute('aria-pressed', String(allOpen));
  };
  btn?.addEventListener('click', () => {
    const open = !all.every((d) => d.open);
    all.forEach((d) => (d.open = open));
    sync();
  });
  all.forEach((d) => d.addEventListener('toggle', sync));
  sync();
</script>
