---
// Right now, Research, Open to: three columns on white, each under a 2px rule.
const cols = [
  { label: 'Right now', text: 'Acoustic drowning detection for pools, my own project with Because of ADAM.' },
  { label: 'Research', text: 'Data management for distributed naval platforms, ONR funded, with Integer Technologies.' },
  { label: 'Open to', text: 'Summer 2027 internships in comms, embedded or DSP. Baton Rouge or remote.' },
];
---

<section class="status" aria-label="Right now">
  <div class="wrap status__grid">
    {
      cols.map((c) => (
        <div class="status__col">
          <h2 class="eyebrow status__label">{c.label}</h2>
          <p class="status__text">{c.text}</p>
          {c.label === 'Open to' && (
            <a class="status__next" href="#projects">
              See what I have built <span aria-hidden="true">↓</span>
            </a>
          )}
        </div>
      ))
    }
  </div>
</section>

<style>
  .status {
    padding-block: clamp(2.5rem, 5vw, 3.5rem) 0;
  }

  .status__grid {
    display: grid;
    gap: 1.75rem 2rem;
  }

  @media (min-width: 760px) {
    .status__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .status__col {
    padding-top: 0.9rem;
    border-top: 2px solid var(--text);
  }

  .status__label {
    font-family: var(--font-sans);
    font-variation-settings: normal;
    letter-spacing: 0;
    line-height: 1.3;
  }

  .status__next {
    display: inline-block;
    margin-top: 0.6rem;
    padding-block: 0.2rem;
    font-weight: 700;
    text-underline-offset: 0.25em;
  }

  .status__text {
    margin-top: 0.35rem;
    font-size: 1.125rem;
    line-height: 1.4;
  }
</style>
