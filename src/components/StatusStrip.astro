---
// Right now, Research, Position: three columns on white, each under a 2px rule.
// No availability line: Ave is not looking for a summer 2027 internship (Nov 9). The assistantship
// continues through the summer (Nov 10).
const cols = [
  { label: 'Right now', text: 'Acoustic drowning detection for pools, my own project.' },
  { label: 'Research', text: 'Data management for distributed naval platforms, ONR funded, with Integer Technologies.' },
  { label: 'Position', text: 'Graduate research assistant at LSU, including summers.' },
];
---

<section class="status band-sheet" aria-label="Right now">
  <div class="wrap status__grid">
    {
      cols.map((c) => (
        <div class="status__col">
          <h2 class="eyebrow status__label">{c.label}</h2>
          <p class="status__text">{c.text}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .status {
    padding-block: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .status__grid {
    display: grid;
    gap: 1.75rem 2rem;
  }

  @media (min-width: 760px) {
    .status__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .status__col {
    padding-top: 0.9rem;
    border-top: 2px solid var(--text);
  }

  .status__label {
    font-size: 1.125rem;
    font-weight: 600;
    font-family: var(--font-sans);
    font-variation-settings: normal;
    letter-spacing: 0;
    line-height: 1.3;
  }

  .status__text {
    margin-top: 0.35rem;
    font-size: 1.1875rem; /* body large: 19px at 1440 */
    line-height: 1.5;
    color: var(--text);
  }
</style>
