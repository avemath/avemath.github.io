---
// Project signatures: drawn covers for projects without screenshots, in one shared line style
// (a plain well, 1.5px teal strokes with one amber element, mono labels). Each one is tied to
// what the project is about. Research and hardware art is abstract on purpose: nothing here
// depicts real systems, data or results. Elements marked m-* move gently while the tile around
// them is hovered or focused, and never under reduced motion.
interface Props {
  slug: string;
  class?: string;
  // Kept so callers that show the same art twice on one page stay valid; the art has no ids.
  idPrefix?: string;
  // Tiles crop the art to fill; a wide frame shows all of it, centered.
  fit?: 'slice' | 'meet';
}

const { slug, class: className = '', fit = 'slice' } = Astro.props;
const W = 600;
const H = 375;

// Small deterministic random so art is stable between builds.
let seed = [...slug].reduce((a, c) => a + c.charCodeAt(0), 0) || 1;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const noise = () => (rand() + rand() + rand() - 1.5) * 0.3;

// V2V: two BPSK clusters around their ideal points.
const clusters = [-1, 1].map((s) => ({ cx: 300 + s * 110, pts: Array.from({ length: 34 }, () => ({ x: noise() * 110, y: noise() * 90 })) }));
// 52 used subcarriers, with the four pilots in amber.
const pilots = [5, 19, 32, 46];

// LED: 16 bands, a spectrum shape that falls off toward the treble.
const bands = Array.from({ length: 16 }, (_, i) => Math.max(2, Math.min(14, Math.round(13 - Math.abs(i - 4.5) * 1.1 + Math.sin(i * 1.3) * 2 + rand() * 2))));

// Signals playground: a chip sequence hopping across 13 tone pairs.
const hops = Array.from({ length: 14 }, () => ({ pair: Math.floor(rand() * 13), bit: rand() > 0.5 ? 1 : 0 }));

// ONR: distributed nodes with a few thin links.
const nodes = Array.from({ length: 7 }, () => ({ x: 80 + rand() * 440, y: 120 + rand() * 170 }));
const links: [number, number][] = [];
nodes.forEach((a, i) =>
  nodes.forEach((b, j) => {
    if (j > i && Math.hypot(a.x - b.x, a.y - b.y) < 200) links.push([i, j]);
  }),
);

const surface = (y0: number, amp: number, ph: number) => {
  let d = `M 0 ${y0}`;
  for (let x = 0; x <= W; x += 20) d += ` L ${x} ${(y0 + Math.sin(x / 70 + ph) * amp + Math.sin(x / 23 + ph * 2) * amp * 0.25).toFixed(1)}`;
  return d;
};

const burst = (y0: number, amp: number, f: number) => {
  let d = `M 0 ${y0}`;
  for (let x = 0; x <= W; x += 4) {
    const env = Math.exp(-(((x - 300) / 170) ** 2));
    d += ` L ${x} ${(y0 + Math.sin(x / f) * amp * env).toFixed(1)}`;
  }
  return d;
};

const drawn = ['v2v-bsm-ofdm', 'led-audio-spectrum', 'bellhop-sim', 'signals-playground', 'acoustic-pool-alarm', 'onr-intelligent-data-management', 'integer-internship', 'rampage', 'little-explorer-swim', 'plv-abstract-builder'];
---

<svg class={`art ${className}`} viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false" preserveAspectRatio={`xMidYMid ${fit}`}>
  <rect width={W} height={H} class="art-bg"></rect>

  {
    slug === 'v2v-bsm-ofdm' && (
      <g>
        <path d="M 100 170 H 500 M 300 70 V 270" class="art-faint" />
        <circle cx="300" cy="170" r="110" class="art-faint" stroke-dasharray="2 6" />
        {clusters.map((c) => (
          <g class="m-tight" style={`transform-origin:${c.cx}px 170px`}>
            {c.pts.map((p) => (
              <circle cx={(c.cx + p.x).toFixed(1)} cy={(170 + p.y).toFixed(1)} r="2.6" class="art-dot" />
            ))}
          </g>
        ))}
        <circle cx="190" cy="170" r="8" class="art-hot" />
        <circle cx="410" cy="170" r="8" class="art-hot" />
        <path d="M 24 318 H 576" class="art-faint" />
        {Array.from({ length: 52 }, (_, i) => {
          const h = 8 + ((i * 7) % 13);
          return <path d={`M ${30 + i * 10.6} 318 V ${318 - h}`} class={pilots.includes(i) ? 'art-hot' : 'art-line'} />;
        })}
        <text x="24" y="40" class="art-label">BPSK · 64-PT OFDM · 802.11P STYLE</text>
        <text x="24" y="352" class="art-label">48 DATA · 4 PILOTS · CP 16</text>
      </g>
    )
  }

  {
    slug === 'led-audio-spectrum' && (
      <g>
        <path d="M 60 310 H 540" class="art-faint" />
        {bands.map((b, i) => {
          const x = 72 + i * 29;
          const h = b * 16;
          return (
            <g>
              <rect x={x} y={310 - h} width="17" height={h} rx="2" class="art-line m-bar" style={`animation-delay:${i * 30}ms`} />
              <path d={`M ${x} ${300 - h} H ${x + 17}`} class="art-hot" />
            </g>
          );
        })}
        <text x="24" y="40" class="art-label">16 BANDS · 256 LEDS</text>
      </g>
    )
  }

  {
    // BELLHOP: rays leaving a source on the sound channel axis and bending back toward it.
    slug === 'bellhop-sim' && (
      <g>
        <path d={`M 0 188 H ${W}`} class="art-faint" stroke-dasharray="3 6" />
        {[0.35, 0.6, 0.85, 1.1, 1.35].map((a, i) =>
          [1, -1].map((s) => {
            const amp = 26 + a * 70;
            const per = 150 + a * 70;
            let d = `M 70 188`;
            for (let x = 70; x <= W; x += 6) d += ` L ${x} ${(188 - s * amp * Math.sin(((x - 70) / per) * Math.PI)).toFixed(1)}`;
            return <path d={d} class={i === 2 && s === 1 ? 'art-hot m-draw' : 'art-line m-draw'} stroke-opacity={i === 2 && s === 1 ? 1 : 0.9 - i * 0.13} style={`transform-origin:70px 188px;animation-delay:${i * 50}ms`} />;
          }),
        )}
        <circle cx="70" cy="188" r="5" class="art-dot" />
        <text x="24" y="40" class="art-label">RAY TRACE · SOUND CHANNEL AXIS</text>
      </g>
    )
  }

  {
    // Signals playground: time across, 13 tone pairs down. Each chip hops to a pair and sends its low or high tone.
    slug === 'signals-playground' && (
      <g>
        {Array.from({ length: 13 }, (_, p) => (
          <path d={`M 60 ${86 + p * 18} H 540`} class="art-faint" />
        ))}
        {hops.map((h, t) => (
          <rect x={64 + t * 34} y={80 + h.pair * 18 + (h.bit ? 0 : 7)} width="26" height="6" rx="1.5" class="art-line m-step" style={`animation-delay:${t * 45}ms`} />
        ))}
        <path
          d={hops.map((h, t) => `${t ? 'L' : 'M'} ${77 + t * 34} ${83 + h.pair * 18 + (h.bit ? 0 : 7)}`).join(' ')}
          class="art-hot m-fade"
          stroke-dasharray="4 5"
        />
        <text x="24" y="40" class="art-label">FH-BFSK · 13 TONE PAIRS</text>
        <text x="24" y="352" class="art-label">TIME →</text>
      </g>
    )
  }

  {
    // Pool alarm: a still surface with ripples spreading from one entry. It shows the problem
    // only, on purpose. Nothing here hints at sensors, placement or signals.
    slug === 'acoustic-pool-alarm' && (
      <g>
        {[0, 1, 2, 3, 4].map((i) => (
          <path d={surface(250 + i * 22, 3 - i * 0.4, i * 1.7)} class="art-line" stroke-opacity={0.32 - i * 0.05} />
        ))}
        <g class="m-ripple" style="transform-origin:300px 196px">
          {[18, 42, 72, 108, 150].map((r, i) => (
            <ellipse cx="300" cy="196" rx={r} ry={r * 0.28} class={i === 0 ? 'art-hot' : 'art-line'} stroke-opacity={i === 0 ? 1 : 0.9 - i * 0.17} />
          ))}
        </g>
        <text x="24" y="40" class="art-label">BACKYARD POOL · EARLY RESEARCH</text>
      </g>
    )
  }

  {
    slug === 'onr-intelligent-data-management' && (
      <g>
        {[0, 1, 2].map((i) => (
          <path d={surface(80 + i * 110, 8 + i * 3, i * 0.9)} class="art-faint" />
        ))}
        {links.map(([a, b]) => (
          <line x1={nodes[a].x} y1={nodes[a].y} x2={nodes[b].x} y2={nodes[b].y} class="art-line m-fade" stroke-opacity=".6" stroke-dasharray="3 6" />
        ))}
        {nodes.map((n, i) => (
          <g>
            <circle cx={n.x} cy={n.y} r={i === 2 ? 22 : 14} class={i === 2 ? 'art-hot' : 'art-line'} stroke-opacity={i === 2 ? 0.9 : 0.45} />
            <circle cx={n.x} cy={n.y} r="3.5" class="art-dot" />
          </g>
        ))}
        <text x="24" y="40" class="art-label">DISTRIBUTED · LIMITED LINKS · WHAT MATTERS</text>
      </g>
    )
  }

  {
    slug === 'integer-internship' && (
      <g>
        {[0, 1, 2, 3, 4, 5].map((i) => (
          <path d={`M 60 300 Q ${200 + i * 40} ${40 + i * 18} 560 ${120 + i * 34}`} class="art-line m-draw" stroke-opacity={0.25 + (i % 3) * 0.2} style={`transform-origin:60px 300px;animation-delay:${i * 50}ms`} />
        ))}
        <path d={burst(300, 40, 9)} class="art-hot" />
        <circle cx="60" cy="300" r="5" class="art-dot" />
        <path d="M 0 340 H 600" class="art-faint" />
        <text x="24" y="40" class="art-label">ACOUSTIC CHARACTERIZATION · NETWORK SIMULATION</text>
      </g>
    )
  }

  {
    slug === 'rampage' && (
      <g>
        <g transform="translate(150 50)" class="art-line">
          <rect x="40" y="20" width="220" height="230" rx="10" />
          <path d="M 40 250 L 0 300 L 300 300 L 260 250" class="art-hot" />
          <rect x="18" y="40" width="22" height="70" rx="4" stroke-opacity=".6" />
          <rect x="18" y="160" width="22" height="70" rx="4" stroke-opacity=".6" />
          <rect x="260" y="40" width="22" height="70" rx="4" stroke-opacity=".6" />
          <rect x="260" y="160" width="22" height="70" rx="4" stroke-opacity=".6" />
          <rect x="70" y="50" width="70" height="44" rx="3" />
          <rect x="160" y="50" width="70" height="44" rx="3" />
          <rect x="95" y="140" width="110" height="60" rx="30" stroke-opacity=".7" />
          <path d="M 105 94 V 140 M 195 94 V 120" class="m-fade" stroke-dasharray="3 4" stroke-opacity=".7" />
        </g>
        <text x="255" y="128" class="art-chip">PICO W</text>
        <text x="345" y="128" class="art-chip">PI 4B</text>
        <text x="300" y="223" class="art-chip">AIR</text>
        <text x="24" y="40" class="art-label">WEAPON · SAFETY · VIDEO</text>
        <text x="24" y="352" class="art-label">17 STRIKES · 500 MS COOLDOWN · 3 E-STOP PATHS</text>
      </g>
    )
  }

  {
    slug === 'little-explorer-swim' && (
      <g class="art-line">
        <g transform="translate(60 110)">
          <rect width="120" height="160" rx="8" />
          {[0, 1, 2, 3].map((i) => (
            <g>
              <rect x="16" y={22 + i * 32} width="14" height="14" rx="3" stroke-opacity=".7" />
              <path d={`M 40 ${29 + i * 32} H ${96 - (i % 2) * 18}`} stroke-opacity=".5" />
            </g>
          ))}
        </g>
        <path d="M 196 190 H 236" class="art-hot m-fade" stroke-dasharray="4 5" />
        <g transform="translate(240 110)">
          <rect width="120" height="160" rx="8" />
          {[0, 1, 2, 3, 4, 5].map((i) => (
            <path d={`M 0 ${26 + i * 22} H 120`} stroke-opacity=".3" />
          ))}
          {[0, 1, 2].map((i) => (
            <path d={`M ${40 + i * 27} 0 V 160`} stroke-opacity=".3" />
          ))}
        </g>
        <path d="M 376 190 H 416" class="art-hot m-fade" stroke-dasharray="4 5" />
        <g transform="translate(420 110)">
          <path d="M 0 10 Q 0 0 10 0 H 92 L 120 28 V 150 Q 120 160 110 160 H 10 Q 0 160 0 150 Z" />
          <path d="M 92 0 V 28 H 120" />
          {[0, 1, 2, 3].map((i) => (
            <path d={`M 18 ${50 + i * 24} H ${100 - (i % 2) * 20}`} stroke-opacity=".6" />
          ))}
        </g>
        <text x="24" y="40" class="art-label">FORM · SHEET · REPORT</text>
        <text x="24" y="352" class="art-label">PREFILLED LINKS · 3 TRIGGERS · ONE PDF PER CHILD</text>
      </g>
    )
  }

  {
    // Abstract builder: a stack of recorded documents, the run sheet with its check marks,
    // and the finished abstract with linked references. Drawn shapes only, no real records.
    slug === 'plv-abstract-builder' && (
      <g class="art-line">
        <g transform="translate(60 110)">
          {[2, 1, 0].map((i) => (
            <rect x={i * 8} y={i * -8} width="104" height="140" rx="4" class="art-fill" stroke-opacity={1 - i * 0.3} />
          ))}
          {[0, 1, 2, 3, 4].map((i) => (
            <path d={`M 14 ${24 + i * 20} H ${90 - (i % 3) * 14}`} stroke-opacity=".5" />
          ))}
        </g>
        <path d="M 196 190 H 236" class="art-hot m-fade" stroke-dasharray="4 5" />
        <g transform="translate(240 110)">
          <rect width="120" height="160" rx="6" />
          {[0, 1, 2, 3, 4, 5].map((i) => (
            <path d={`M 0 ${24 + i * 22} H 120`} stroke-opacity=".3" />
          ))}
          <path d="M 44 0 V 160 M 84 0 V 160" stroke-opacity=".3" />
          <path d="M 8 30 V 42" style="stroke-width:3" />
          <circle cx="10" cy="80" r="3" class="art-dot" />
          <circle cx="10" cy="124" r="3" class="art-dot" opacity=".5" />
        </g>
        <path d="M 376 190 H 416" class="art-hot m-fade" stroke-dasharray="4 5" />
        <g transform="translate(420 110)">
          <path d="M 0 10 Q 0 0 10 0 H 92 L 120 28 V 150 Q 120 160 110 160 H 10 Q 0 160 0 150 Z" />
          <path d="M 92 0 V 28 H 120" />
          {[0, 1, 2, 3].map((i) => (
            <g>
              <path d={`M 16 ${50 + i * 24} H ${64 - (i % 2) * 10}`} stroke-opacity=".5" />
              <rect x="72" y={44 + i * 24} width="32" height="12" rx="2" stroke-opacity=".8" stroke-dasharray="3 3" />
            </g>
          ))}
        </g>
        <text x="24" y="40" class="art-label">RECORDS · RUN SHEET · LINKED ABSTRACT</text>
        <text x="24" y="352" class="art-label">EVERY BOOK AND PAGE OPENS ITS DOCUMENT</text>
      </g>
    )
  }

  {
    // Anything else (client sites, the nonprofit, LandSpace) normally shows a screenshot. If
    // one is ever missing, this plain window outline stands in, with nothing made up inside it.
    !drawn.includes(slug) && (
      <g class="art-line">
        <rect x="110" y="70" width="380" height="235" rx="10" />
        <path d="M 110 102 H 490" />
        <circle cx="132" cy="86" r="4" class="art-dot" opacity=".5" />
        <circle cx="148" cy="86" r="4" class="art-dot" opacity=".5" />
        <circle cx="164" cy="86" r="4" class="art-dot" opacity=".5" />
        <path d="M 140 140 H 330" style="stroke-width:3" />
        <path d="M 140 168 H 400 M 140 188 H 380" stroke-opacity=".45" />
        <rect x="140" y="222" width="96" height="30" rx="5" class="art-hot" />
      </g>
    )
  }
</svg>

<style>
  .art {
    --art-bg: color-mix(in oklab, var(--surface-2) 70%, var(--bg));
    width: 100%;
    height: 100%;
    display: block;
  }

  .art-bg,
  .art-fill {
    fill: var(--art-bg);
  }

  .art-line,
  .art-line :global(*),
  .art-faint,
  .art-hot {
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .art-line,
  .art-line :global(*) {
    stroke: var(--accent);
  }

  .art-faint {
    stroke: var(--accent);
    stroke-opacity: 0.25;
  }

  .art .art-hot {
    stroke: var(--amber-line);
    stroke-width: 2;
  }

  .art .art-dot {
    fill: var(--accent);
    stroke: none;
  }

  .art .art-fill {
    fill: var(--art-bg);
  }

  .art-label,
  .art-chip {
    font-family: var(--font-mono);
    font-size: 11px;
    stroke: none;
  }

  .art-label {
    letter-spacing: 0.14em;
    fill: var(--muted);
  }

  .art-chip {
    letter-spacing: 0.08em;
    fill: var(--accent-ink);
    text-anchor: middle;
  }

  :global([data-theme='dark']) .art-chip {
    fill: var(--accent);
  }

  /* Each signature plays a short animation once while its tile is hovered or focused: the
     constellation settles in, bars rise, rays grow out along their paths, the hop pattern steps
     through, ripples spread. Transform and opacity only, under a second, nothing at rest, and
     none on touch screens or with reduced motion. */
  .m-tight,
  .m-ripple,
  .m-draw {
    transform-box: view-box;
  }

  .m-bar {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    :global(html:not([data-motion='reduce']) :is(.tile, .case__art):is(:hover, :focus-within)) .m-tight {
      animation: art-settle 0.8s var(--ease-out-expo) both;
    }

    :global(html:not([data-motion='reduce']) :is(.tile, .case__art):is(:hover, :focus-within)) .m-bar {
      animation: art-rise 0.5s var(--ease-out-expo) both;
    }

    :global(html:not([data-motion='reduce']) :is(.tile, .case__art):is(:hover, :focus-within)) .m-draw {
      animation: art-grow 0.6s var(--ease-out-expo) both;
    }

    :global(html:not([data-motion='reduce']) :is(.tile, .case__art):is(:hover, :focus-within)) .m-step {
      animation: art-step 0.25s ease-out both;
    }

    :global(html:not([data-motion='reduce']) :is(.tile, .case__art):is(:hover, :focus-within)) .m-ripple {
      animation: art-spread 0.9s var(--ease-out-expo) both;
    }

    :global(html:not([data-motion='reduce']) :is(.tile, .case__art):is(:hover, :focus-within)) .m-fade {
      animation: art-fade 0.6s ease-out both;
    }
  }

  @keyframes art-settle {
    from {
      opacity: 0.35;
      scale: 1.9;
    }
  }

  @keyframes art-rise {
    from {
      scale: 1 0.15;
    }
  }

  @keyframes art-grow {
    from {
      opacity: 0;
      scale: 0.05 1;
    }
  }

  @keyframes art-step {
    from {
      opacity: 0.15;
    }
  }

  @keyframes art-spread {
    from {
      opacity: 0.3;
      scale: 0.5;
    }
  }

  @keyframes art-fade {
    from {
      opacity: 0.1;
    }
  }
</style>
