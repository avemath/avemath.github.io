---
import skills from '@/data/skills.json';
---

<section id="skills" class="section section--tight home-section" aria-labelledby="skills-title" data-section="skills">
  <div class="wrap">
    <p class="eyebrow">Skills</p>
    <h2 id="skills-title" class="section-title section-title--sm">What I'd defend in an interview</h2>
    <p class="section-lede">No progress bars. If it's on this list, I've shipped something with it and I'm happy to talk through how.</p>

    <div class="skills">
      {
        skills.map((g, i) => (
          <div class="skill" data-reveal>
            <h3 class="skill__head">
              <span class="mono skill__idx" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              {g.group}
            </h3>
            <ul class="skill__list">
              {g.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* A spec sheet, not another card grid: one ruled row per group. */
  .skills {
    margin-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .skill {
    display: grid;
    gap: 0.5rem 2.5rem;
    padding: 1.1rem 0 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 720px) {
    .skill {
      grid-template-columns: 15rem minmax(0, 1fr);
    }
  }

  .skill__head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .skill__idx {
    font-size: 0.75rem;
    color: var(--accent-ink);
  }

  :global([data-theme='dark']) .skill__idx {
    color: var(--accent);
  }

  .skill__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
  }

  .skill__list li {
    font-size: 0.95rem;
    color: var(--text-soft);
  }

  /* The dot trails each item, so a wrapped line never starts with a stray separator. */
  .skill__list li:not(:last-child)::after {
    content: '·';
    margin-left: 0.9rem;
    color: var(--line-strong);
  }
</style>
