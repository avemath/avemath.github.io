---
// Skills as grouped chips: one row of chips per area. Filled chips are "Know well", outlined
// chips are "Have built with". Each chip is a native disclosure, so tapping it, or Enter or Space
// on it, shows the projects whose stack lists it (see src/lib/skills.ts), with no script at all.
// A small script adds opening on hover and focus, and keeps one open at a time.
import skills from '@/data/skills.json';
import { getProjects, projectHref } from '@/lib/projects';
import { areas, skillMap } from '@/lib/skills';

interface Props {
  /** Band variables from depth.ts, so the section sits in the page's descent. */
  zoneStyle?: string;
}

const { zoneStyle } = Astro.props;

const projects = await getProjects();
const usedIn = (skill: string) => {
  const terms = skillMap[skill]?.terms ?? [];
  return projects.filter((p) => p.data.stack.some((s) => terms.includes(s))).map((p) => ({ title: p.data.title, href: projectHref(p) }));
};

const [known, built] = skills;
const all = [...known.items.map((skill) => ({ skill, known: true })), ...built.items.map((skill) => ({ skill, known: false }))].map((s) => ({
  ...s,
  projects: usedIn(s.skill),
}));
// Within an area, the skills I know well come first.
const byArea = areas.map((a) => ({ ...a, skills: all.filter((s) => skillMap[s.skill]?.area === a.id) })).filter((a) => a.skills.length);
---

<section id="skills" class="section section--tight zone" style={zoneStyle} aria-labelledby="skills-title" data-section="skills">
  <div class="wrap">
    <p class="eyebrow">Skills</p>
    <h2 id="skills-title" class="section-title section-title--sm">What I know and what I've built with</h2>
    <p class="section-lede">Two groups. The first I can explain without notes. The second I've used to ship real projects and am still learning.</p>

    <p class="sk-legend">
      <span><i class="sk-key sk-key--known" aria-hidden="true"></i>Filled: {known.group.toLowerCase()}</span>
      <span><i class="sk-key" aria-hidden="true"></i>Outlined: {built.group.toLowerCase()}</span>
      <span class="sk-legend__hint">Open a skill to see the projects that use it.</span>
    </p>

    <div class="sk-areas" data-skills>
      {
        byArea.map((a) => (
          <div class="sk-area">
            <h3 class="sk-area__name">{a.label}</h3>
            <ul class="sk-chips">
              {a.skills.map((s) => (
                <li>
                  <details class:list={['skc', s.known ? 'skc--known' : 'skc--built']}>
                    <summary>
                      {s.skill}
                      <span class="sr-only">, {s.known ? known.group.toLowerCase() : built.group.toLowerCase()}</span>
                    </summary>
                    <div class="skc__pop">
                      {s.projects.length ? (
                        <>
                          <p class="skc__label">Used in:</p>
                          <ul>
                            {s.projects.map((p) => (
                              <li>
                                <a class="link" href={p.href}>{p.title}</a>
                              </li>
                            ))}
                          </ul>
                        </>
                      ) : (
                        <p class="skc__none">Not on a project page yet.</p>
                      )}
                    </div>
                  </details>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .sk-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin-top: 1.75rem;
    font-size: 0.88rem;
    color: var(--text-soft);
  }

  .sk-legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .sk-legend__hint {
    color: var(--muted);
  }

  .sk-key {
    width: 1.1rem;
    height: 0.75rem;
    border: 1.5px solid var(--accent);
    border-radius: 0.25rem;
  }

  .sk-key--known {
    border-color: var(--accent-ink);
    background: var(--accent-ink);
  }

  .sk-areas {
    display: grid;
    gap: 1.5rem 3rem;
    margin-top: 1.75rem;
  }

  @media (min-width: 900px) {
    .sk-areas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .sk-area__name {
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .sk-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.85rem;
  }

  .skc {
    position: relative;
  }

  .skc > summary {
    display: inline-flex;
    align-items: center;
    min-height: 2.1rem;
    padding: 0.3rem 0.75rem;
    border: 1.5px solid var(--accent);
    border-radius: 0.45rem;
    font-size: 0.88rem;
    line-height: 1.3;
    color: var(--text);
    cursor: pointer;
    list-style: none;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }

  .skc > summary::-webkit-details-marker {
    display: none;
  }

  /* Filled: know well. Text on the fill uses the band's own shade, which passes on both. */
  .skc--known > summary {
    border-color: var(--accent-ink);
    background: var(--accent-ink);
    color: var(--bg);
    font-weight: 500;
  }

  .skc--built > summary:hover {
    background: var(--accent-wash);
  }

  .skc[open] > summary {
    border-color: var(--amber-line);
  }

  .skc > summary:focus-visible {
    outline: 2px solid var(--amber-line);
    outline-offset: 2px;
  }

  /* The projects, in a small card under the chip. */
  .skc__pop {
    position: absolute;
    z-index: 5;
    top: calc(100% + 0.4rem);
    left: 0;
    width: max-content;
    max-width: min(20rem, calc(100vw - 2rem));
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.6rem;
    background: var(--surface);
    box-shadow: var(--shadow-lift);
    font-size: 0.86rem;
    translate: var(--shift, 0) 0;
  }

  .skc__label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .skc__pop ul {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.35rem;
  }

  .skc__pop a {
    display: inline-block;
    padding-block: 0.15rem;
  }

  .skc__none {
    color: var(--text-soft);
  }
</style>

<script>
  // Hover and focus open a chip as well as a tap or Enter. One chip is open at a time, Escape
  // closes it, and the card shifts left if it would run off the right edge of the screen.
  const root = document.querySelector<HTMLElement>('[data-skills]');
  if (root) {
    const chips = [...root.querySelectorAll<HTMLDetailsElement>('details.skc')];
    let pinned: HTMLDetailsElement | null = null;
    // Set while Escape hands focus back to a chip, so that focus does not open it again.
    let quiet = false;

    const fit = (d: HTMLDetailsElement) => {
      const pop = d.querySelector<HTMLElement>('.skc__pop');
      if (!pop) return;
      pop.style.removeProperty('--shift');
      const r = pop.getBoundingClientRect();
      const over = r.right - (document.documentElement.clientWidth - 16);
      if (over > 0) pop.style.setProperty('--shift', `${-over}px`);
    };
    const open = (d: HTMLDetailsElement) => {
      chips.forEach((c) => c !== d && c !== pinned && (c.open = false));
      if (!d.open) d.open = true;
      fit(d);
    };

    chips.forEach((d) => {
      d.addEventListener('toggle', () => {
        if (d.open) {
          chips.forEach((c) => c !== d && (c.open = false));
          fit(d);
        } else if (pinned === d) pinned = null;
      });
      // Hover and focus have usually opened the chip already, so a click (or Enter) pins it open
      // instead of toggling it shut, and a second click closes it.
      d.querySelector('summary')?.addEventListener('click', (e) => {
        e.preventDefault();
        if (pinned === d) {
          pinned = null;
          d.open = false;
        } else {
          if (pinned) pinned.open = false;
          pinned = d;
          open(d);
        }
      });
      d.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && open(d));
      d.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && pinned !== d && (d.open = false));
      d.addEventListener('focusin', () => !quiet && open(d));
      d.addEventListener('focusout', (e) => {
        if (!d.contains(e.relatedTarget as Node) && pinned !== d) d.open = false;
      });
      d.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || !d.open) return;
        d.open = false;
        pinned = null;
        quiet = true;
        d.querySelector<HTMLElement>('summary')?.focus();
        quiet = false;
      });
    });
  }
</script>
