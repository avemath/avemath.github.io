---
// Skills as a constellation: each skill is a point in its area's cluster. "Know well" skills sit
// tight around the area's ideal point and "Have built with" skills scatter further out, so the
// spread shows confidence honestly. Picking a skill lights up the projects whose stack lists it
// (see src/lib/skills.ts). The plain list below carries the same information and links, for
// screen readers, phones and readers without JavaScript.
import skills from '@/data/skills.json';
import { getProjects, projectHref } from '@/lib/projects';
import { areas, skillMap, place, FIELD, centers } from '@/lib/skills';

interface Props {
  /** Band variables from depth.ts, so the section sits in the page's descent. */
  zoneStyle?: string;
}

const { zoneStyle } = Astro.props;

const projects = await getProjects();
const usedIn = (skill: string) => {
  const terms = skillMap[skill]?.terms ?? [];
  return projects.filter((p) => p.data.stack.some((s) => terms.includes(s))).map((p) => ({ id: p.id, title: p.data.title, href: projectHref(p) }));
};

const [known, built] = skills;
const all = [
  ...known.items.map((skill) => ({ skill, known: true, group: known.group })),
  ...built.items.map((skill) => ({ skill, known: false, group: built.group })),
].map((s) => ({ ...s, projects: usedIn(s.skill) }));

const points = place(all).map((p) => ({ ...p, projects: all.find((s) => s.skill === p.skill)!.projects.map((x) => x.id) }));
// Projects any skill links to, for the strip that lights up under the constellation.
const linked = projects.filter((p) => all.some((s) => s.projects.some((x) => x.id === p.id)));
const byArea = areas.map((a) => ({ ...a, skills: all.filter((s) => skillMap[s.skill]?.area === a.id) }));
---

<section id="skills" class="section section--tight zone" style={zoneStyle} aria-labelledby="skills-title" data-section="skills">
  <div class="wrap">
    <p class="eyebrow">Skills</p>
    <h2 id="skills-title" class="section-title section-title--sm">What I know and what I've built with</h2>
    <p class="section-lede">Two groups. The first I can explain without notes. The second I've used to ship real projects and am still learning.</p>

    <div class="cst" data-cst data-points={JSON.stringify(points)}>
      <div class="cst__field">
        <svg viewBox={`0 0 ${FIELD.w} ${FIELD.h}`} aria-hidden="true" focusable="false">
          {
            areas.map((a) => {
              const [cx, cy] = centers[a.id];
              return (
                <g class="cst__area">
                  <ellipse cx={cx} cy={cy} rx="128" ry="104" class="cst__halo" />
                  <path d={`M ${cx - 9} ${cy} H ${cx + 9} M ${cx} ${cy - 9} V ${cy + 9}`} class="cst__ideal" />
                  <text x={cx} y={cy - 116} text-anchor="middle" class="cst__area-label">
                    {a.label}
                  </text>
                </g>
              );
            })
          }
          {
            points.map((p, i) => {
              const [cx, cy] = centers[p.area];
              return (
                <g class:list={['cst__pt', p.known ? 'cst__pt--known' : 'cst__pt--built']} data-pt={i}>
                  <path d={`M ${cx} ${cy} L ${p.x} ${p.y}`} class="cst__spoke" />
                  <circle cx={p.x} cy={p.y} r={p.known ? 6 : 5} class="cst__dot" />
                </g>
              );
            })
          }
        </svg>
        <div class="cst__hits" role="group" aria-label="Skills constellation. Use the arrow keys to move between skills." data-cst-hits></div>
      </div>

      <div class="cst__foot">
        <p class="cst__legend" aria-hidden="true">
          <span><i class="cst__key cst__key--known"></i>{known.group}: close to the ideal point</span>
          <span><i class="cst__key cst__key--built"></i>{built.group}: a looser cloud</span>
        </p>
        <p class="cst__panel" aria-live="polite" data-cst-panel>Pick a skill to see the projects that list it.</p>
        <ul class="cst__projects" aria-label="Projects">
          {
            linked.map((p) => (
              <li>
                <a href={projectHref(p)} class="cst__proj" data-proj={p.id}>
                  {p.data.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <details class="sk-list" open data-cst-list>
      <summary>All skills as a list, with the projects that use them</summary>
      <div class="sk-list__areas">
        {
          byArea.map((a) => (
            <div class="sk-area">
              <h3 class="sk-area__name">{a.label}</h3>
              <ul>
                {a.skills.map((s) => (
                  <li>
                    <span class="sk-name">{s.skill}</span>
                    <span class="sk-group mono">{s.group}</span>
                    {s.projects.length ? (
                      <span class="sk-used">
                        Used in{' '}
                        {s.projects.map((p, i) => (
                          <>{i > 0 && (i === s.projects.length - 1 ? ' and ' : ', ')}<a class="link" href={p.href}>{p.title}</a></>
                        ))}
                      </span>
                    ) : (
                      <span class="sk-used sk-used--none">No project on this site lists it in its stack.</span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </details>
  </div>
</section>

<style>
  /* The constellation needs room for clear targets, so it shows from 1024px. Below that, and
     without JavaScript, the list is the whole section. */
  .cst {
    display: none;
    margin-top: 2rem;
  }

  @media (min-width: 1024px) {
    .cst {
      display: block;
    }
  }

  .cst__field {
    position: relative;
    aspect-ratio: 1000 / 560;
  }

  .cst__field svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .cst__halo {
    fill: color-mix(in oklab, var(--accent) 5%, transparent);
    stroke: var(--line);
    stroke-dasharray: 2 5;
  }

  .cst__ideal {
    stroke: var(--amber-line);
    stroke-width: 1.5;
  }

  .cst__area-label {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    fill: var(--muted);
  }

  .cst__spoke {
    stroke: var(--accent);
    stroke-opacity: 0.16;
  }

  .cst__dot {
    stroke: var(--accent);
    stroke-width: 1.6;
    transition:
      r 0.25s var(--ease-out-expo),
      opacity 0.25s;
  }

  .cst__pt--known .cst__dot {
    fill: var(--accent);
  }

  .cst__pt--built .cst__dot {
    fill: var(--bg);
  }

  /* While a skill is picked, it and the skills it shares a project with stand out. */
  .cst[data-active] .cst__pt {
    opacity: 0.3;
  }

  .cst[data-active] .cst__pt[data-on] {
    opacity: 1;
  }

  .cst__pt[data-current] .cst__dot {
    r: 9;
    stroke: var(--amber-line);
    stroke-width: 2.5;
  }

  .cst__pt[data-current] .cst__spoke {
    stroke: var(--amber-line);
    stroke-opacity: 0.8;
  }

  .cst__hits {
    position: absolute;
    inset: 0;
  }

  .cst__hits :global(.cst__hit) {
    position: absolute;
    width: 28px;
    height: 28px;
    translate: -50% -50%;
    border-radius: 50%;
    cursor: pointer;
  }

  .cst__hits :global(.cst__hit:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  /* The name of the skill under the pointer or focus, next to its point. */
  .cst__hits :global(.cst__tip) {
    position: absolute;
    translate: -50% calc(-100% - 16px);
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    background: var(--surface);
    font-size: 0.78rem;
    white-space: nowrap;
    color: var(--text);
    pointer-events: none;
    box-shadow: var(--shadow);
  }

  .cst__foot {
    display: grid;
    gap: 0.9rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .cst__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .cst__legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .cst__key {
    width: 0.65rem;
    height: 0.65rem;
    border: 1.6px solid var(--accent);
    border-radius: 50%;
  }

  .cst__key--known {
    background: var(--accent);
  }

  .cst__panel {
    min-height: 1.6em;
    color: var(--text-soft);
  }

  .cst__panel :global(strong) {
    color: var(--text);
  }

  .cst__projects {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .cst__proj {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 0.4rem;
    font-size: 0.82rem;
    color: var(--text-soft);
    text-decoration: none;
    transition:
      border-color 0.2s,
      background-color 0.2s,
      opacity 0.2s;
  }

  .cst__proj:hover {
    border-color: var(--accent);
  }

  /* Dimmed by color, not opacity, so the names still pass contrast. */
  .cst[data-active] .cst__proj {
    color: var(--muted);
  }

  .cst[data-active] .cst__proj[data-on] {
    border-color: var(--amber-line);
    background: color-mix(in oklab, var(--amber) 14%, transparent);
    color: var(--text);
  }

  /* The plain list. Open by default; the script folds it away on wide screens once the
     constellation is ready, and it stays one click away. */
  .sk-list {
    margin-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .sk-list > summary {
    padding: 0.9rem 0;
    font-weight: 600;
    cursor: pointer;
  }

  .sk-list__areas {
    display: grid;
    gap: 1.5rem 2.5rem;
    padding-bottom: 0.5rem;
  }

  @media (min-width: 720px) {
    .sk-list__areas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .sk-area__name {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .sk-area li {
    display: grid;
    gap: 0.1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
  }

  .sk-name {
    font-weight: 500;
    color: var(--text);
  }

  .sk-group {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .sk-used {
    font-size: 0.88rem;
    color: var(--text-soft);
  }

  .sk-used--none {
    color: var(--muted);
  }
</style>

<script>
  // The interactive layer loads only when the constellation nears the screen.
  const cst = document.querySelector<HTMLElement>('[data-cst]');
  if (cst && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        import('../scripts/constellation').then((m) => m.mountConstellation(cst));
      },
      { rootMargin: '300px 0px' },
    );
    io.observe(cst);
  }
</script>
