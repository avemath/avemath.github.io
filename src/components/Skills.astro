---
import skills from '@/data/skills.json';
---

<section id="skills" class="section home-section" aria-labelledby="skills-title" data-section="skills">
  <div class="wrap">
    <p class="eyebrow">Skills</p>
    <h2 id="skills-title" class="section-title">What I'd defend in an interview</h2>
    <p class="section-lede">No progress bars. If it's on this list, I've shipped something with it and I'm happy to talk through how.</p>

    <div class="skills">
      {
        skills.map((g, i) => (
          <div class="skill card" data-reveal>
            <h3 class="skill__head">
              <span class="mono skill__idx" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              {g.group}
            </h3>
            <ul class="skill__list">
              {g.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skills {
    display: grid;
    gap: 1rem;
    margin-top: 2.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }

  .skill {
    padding: 1.4rem 1.4rem 1.5rem;
    box-shadow: none;
  }

  .skill__head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .skill__idx {
    font-size: 0.75rem;
    color: var(--accent-ink);
  }

  :global([data-theme='dark']) .skill__idx {
    color: var(--accent);
  }

  .skill__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }

  .skill__list li {
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    font-size: 0.86rem;
    color: var(--text-soft);
    background: var(--bg);
  }
</style>
