---
// The client sites as the large alternating showcase: a big browser frame (with the phone view)
// on one side, what the business needed, what I did and a few numbers on the other. Only sites
// whose owner gave permission (client.permission) are shown. Because of ADAM and Grace Mae each
// carry a working piece of the site, run from its real code (see src/components/live). A client's
// quote, when src/data/sites.json has one, gets its own pull-quote band after their site.
import BrowserFrame from './BrowserFrame.astro';
import Icon from './Icon.astro';
import AdamLive from './live/AdamLive.astro';
import GraceLive from './live/GraceLive.astro';
import sitesData from '@/data/sites.json';
import { getProjects, isWebsite, projectHref } from '@/lib/projects';

const sites = (await getProjects()).filter((p) => isWebsite(p) && p.data.cover && p.data.links.live && p.data.client?.permission);
const live: Partial<Record<string, typeof AdamLive>> = { 'because-of-adam': AdamLive, 'grace-mae-alterations': GraceLive };
// Each site's facts come from src/data/sites.json: things a visitor can judge (speed,
// accessibility, page weight, how long it has been live, what the owner edits), not commit
// counts. Figures are numbered after the skills matrix (Fig. 06).
// pagespeedMobile and accessibility are PageSpeed Insights mobile results from 2026-11-01.
// pageWeightKb is the home page's transferred size from a local Lighthouse mobile run that day.
interface Props {
  /** Only the site rows, for /work/, which has its own heading. */
  rowsOnly?: boolean;
  /** The figure number of the first site, so each page numbers its own figures. */
  firstFig?: number;
}

const { rowsOnly = false, firstFig = 7 } = Astro.props;
const FIRST_FIG = firstFig;
const Outer = rowsOnly ? 'div' : 'section';
const siteData = (id: string) => sitesData.find((s) => s.slug === id);
---

<Outer id={rowsOnly ? undefined : 'websites'} class={rowsOnly ? undefined : 'section'} aria-labelledby={rowsOnly ? undefined : 'websites-title'}>
  <div class:list={[!rowsOnly && 'wrap']}>
    {
      !rowsOnly && (
        <>
        <h2 id="websites-title" class="section-title web__title" data-decode>Websites I built and keep running</h2>
        <p class="section-lede sites-lede">Small businesses, a nonprofit and one engineer. Fast, accessible, and the owners update their own content.</p>
        </>
      )
    }

    <ol class="sites">
      {
        sites.map((p, i) => {
          const Live = live[p.id];
          const data = siteData(p.id);
          return (
            <>
              <li class:list={['site', i % 2 === 1 && 'site--flip']} data-reveal data-live-host={Live ? '' : undefined}>
                <div class="site__media">
                  <BrowserFrame
                    src={p.data.cover!}
                    mobile={p.data.mobile}
                    alt={p.data.coverAlt ?? ''}
                    url={p.data.links.live}
                    widths={[480, 640, 960, 1280, 1440]}
                    sizes="(min-width: 1216px) 42rem, (min-width: 960px) calc((100vw - 5rem) * 0.56), calc(100vw - 2rem)"
                    live={!!Live}
                  >
                    {Live && <Live />}
                  </BrowserFrame>
                </div>
                <div class="site__copy">
                  <p class="site__fig">
                    <span>Fig. {String(FIRST_FIG + i).padStart(2, '0')} / {new URL(p.data.links.live!).host}</span>
                  </p>
                  <p class="label site__kind">{p.data.client?.kind}</p>
                  <h3 class="site__title">{p.data.title}</h3>
                  <p class="site__summary">{p.data.summary}</p>
                  <div class="site__facts">
                    <dl class="site__did">
                      <dt class="label">What I did</dt>
                      <dd>{p.data.role}</dd>
                    </dl>
                    {data && (
                      <>
                        <dl class="site__metrics">
                          <div>
                            <dt class="label">Mobile performance</dt>
                            <dd class="site__metric">{data.pagespeedMobile}</dd>
                          </div>
                          <div>
                            <dt class="label">Accessibility</dt>
                            <dd class="site__metric">{data.accessibility}</dd>
                          </div>
                          <div>
                            <dt class="label">Home page weight</dt>
                            <dd class="site__metric">
                              {data.pageWeightKb}
                              <span class="site__unit">KB</span>
                            </dd>
                          </div>
                        </dl>
                        <dl class="site__more">
                          <div>
                            <dt class="label">Live since</dt>
                            <dd>{data.liveSince}</dd>
                          </div>
                          <div>
                            <dt class="label">Who edits it</dt>
                            <dd>{data.ownerEdits}</dd>
                          </div>
                        </dl>
                      </>
                    )}
                  </div>
                  <div class="site__links mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
                    <a class="btn btn--small" href={projectHref(p)}>
                      Read the case study <Icon name="arrow-right" />
                    </a>
                    <a class="link inline-flex items-center gap-1 text-sm" href={p.data.links.live}>
                      {p.data.linkLabel ?? `Visit ${new URL(p.data.links.live!).host}`} <Icon name="arrow-up-right" class="h-[0.9em] w-[0.9em]" />
                    </a>
                  </div>
                </div>
              </li>
              {data?.quote && (
                <li class="pq">
                  <figure>
                    <blockquote class="pq__text">
                      <p>{data.quote}</p>
                    </blockquote>
                    <figcaption class="pq__by">{data.quoteBy}</figcaption>
                  </figure>
                </li>
              )}
            </>
          );
        })
      }
    </ol>

    {
      !rowsOnly && (
        <div class="sites__how">
          <p>
            Five steps from the first conversation to the written guide, with a quote before I start and a preview link while I build. The
            services page has the details and the questions people ask.
          </p>
          <div class="flex flex-wrap items-center gap-3">
            <a class="btn btn--primary" href="/services/">See how I work</a>
            <a class="btn" href="/contact/?topic=website">Start a project</a>
            <a class="link sites__all" href="/work/#websites">All websites</a>
          </div>
        </div>
      )
    }
  </div>
</Outer>

<style>
  .sites {
    display: grid;
    gap: clamp(4rem, 8vw, 6.5rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .site {
    display: grid;
    gap: 2.25rem;
    align-items: center;
  }

  /* Desktop: media 7 columns, words 5, both halves centered on each other. The frame fills its
     column edge to edge; the rows alternate sides. */
  @media (min-width: 960px) {
    .site {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 2.5rem;
    }

    .site--flip {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    .site--flip .site__media {
      order: 2;
    }
  }

  .site__media {
    min-width: 0;
    width: 100%;
  }

  .site__media :global(.frame) {
    width: 100%;
  }

  /* Phones and small tablets: the media above the words, the full width of the container. */
  @media (max-width: 959px) {
    .sites {
      gap: 3rem;
    }

    .site__media {
      order: 0 !important;
    }
  }

  @media (max-width: 719px) {
    .sites {
      margin-top: 1.5rem;
    }

    .site__title {
      font-size: 1.6rem;
    }

    .site__metric {
      font-size: 1.5rem !important;
    }

    /* While a live version runs it needs the full width too. */
    .sites:has([data-live-on]) {
      align-items: flex-start;
    }
  }

  /* The phone mockup covers the bottom right corner, so Try it sits bottom left, at every width. */
  .site__media :global(.live__try) {
    right: auto;
    left: 0.7rem;
  }

  .web__title {
    max-width: 18ch;
  }

  /* The figure label: present, but quieter than the site itself. */
  .site__fig {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 0.9rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--text-soft);
  }

  .site__media :global(.frame__window) {
    border-radius: 0;
    border-color: var(--line);
    box-shadow: var(--shadow);
  }

  .site__title {
    margin-top: 0.6rem;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }

  /* A client's words, in a band of their own between the sites. */
  .pq {
    padding: clamp(1.5rem, 3vw, 2.25rem) 0;
    border-block: 1px solid var(--line);
  }

  .pq figure {
    position: relative;
    max-width: 46rem;
    margin: 0 auto;
    padding-left: clamp(2.5rem, 6vw, 4rem);
  }

  .pq__text::before {
    content: '\201C';
    position: absolute;
    left: 0;
    top: -0.35em;
    font-size: clamp(4rem, 9vw, 6rem);
    font-weight: 800;
    line-height: 1;
    color: var(--accent);
  }

  .pq__text p {
    font-size: clamp(1.375rem, 2.2vw, 1.625rem);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .pq__by {
    margin-top: 0.85rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .sites__all {
    margin-left: 0.5rem;
  }

  .site__summary {
    margin-top: 0.85rem;
    color: var(--text-soft);
  }

  .site__facts {
    display: grid;
    gap: 1.1rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .site__facts dd {
    margin-top: 0.25rem;
    font-size: 0.95rem;
  }

  .site__metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .site__metrics > div {
    display: flex;
    flex-direction: column;
  }

  .site__metrics .site__metric {
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .site__metric {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.6vw, 2.25rem) !important;
    font-weight: 800;
    font-variation-settings: 'wdth' 112;
    line-height: 1;
    letter-spacing: -0.035em;
    font-variant-numeric: tabular-nums;
  }

  .site__unit {
    margin-left: 0.2rem;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0;
  }

  .site__more {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem 1.5rem;
  }

  .site__more dd {
    margin-top: 0.15rem;
    font-size: 1rem;
  }

  .sites__how {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 1.5rem;
    border-top: 2px solid var(--text);
  }

  .sites__how p {
    max-width: 44rem;
    color: var(--text-soft);
  }

  @media (min-width: 960px) {
    .sites__how {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 2rem;
    }
  }
</style>
