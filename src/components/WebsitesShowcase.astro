---
// The client sites, two by two, on paper cards. Only sites whose owner gave permission
// (client.permission in the content collection) are shown. Because of ADAM and Grace Mae each
// carry a working piece of the site, run from its real code (see src/components/live).
import BrowserFrame from './BrowserFrame.astro';
import Icon from './Icon.astro';
import AdamLive from './live/AdamLive.astro';
import GraceLive from './live/GraceLive.astro';
import { getProjects, isWebsite, projectHref } from '@/lib/projects';
import sitesData from '@/data/sites.json';

const sites = (await getProjects()).filter((p) => isWebsite(p) && p.data.cover && p.data.links.live && p.data.client?.permission);
const live: Partial<Record<string, typeof AdamLive>> = { 'because-of-adam': AdamLive, 'grace-mae-alterations': GraceLive };
// The kind of client, short: the part of the kind line before the place.
const kindOf = (kind = '') => kind.split(',')[0].replace(/^./, (c) => c.toLowerCase());
// Each card's label row and quote come from src/data/sites.json: the site's mobile performance
// score and the owner's quote, shown only when filled. Figures are numbered after the skills
// matrix (Fig. 06).
// TODO(ave): re-measure. The scores are Lighthouse mobile runs from 2026-11-01, made locally
// because the PageSpeed Insights API was over its daily quota; refresh them on pagespeed.web.dev.
const FIRST_FIG = 7;
const siteData = (id: string) => sitesData.find((s) => s.slug === id);
---

<section id="websites" class="section web" aria-labelledby="websites-title">
  <div class="wrap">
    <div class="web__head">
      <h2 id="websites-title" class="section-title web__title" data-decode>Websites for people with better things to do</h2>
      <p class="web__lede">
        Small businesses, a nonprofit and one engineer. Static, fast, accessible, and cheap enough to keep running for years. Owners edit
        their own content.
      </p>
    </div>

    <ul class="sites">
      {
        sites.map((p, i) => {
          const Live = live[p.id];
          const data = siteData(p.id);
          return (
            <li class="site" data-live-host={Live ? '' : undefined}>
              <div class="site__media paper">
                <div class="fig__bar site__bar">
                  <p class="fig__label">Fig. {String(FIRST_FIG + i).padStart(2, '0')} / {new URL(p.data.links.live!).host}</p>
                  {data?.pagespeedMobile && (
                    <p class="fig__label">
                      Mobile performance <strong class="site__score">{data.pagespeedMobile}</strong>
                    </p>
                  )}
                </div>
                <BrowserFrame
                  src={p.data.cover!}
                  alt={p.data.coverAlt ?? ''}
                  url={p.data.links.live}
                  widths={[400, 560, 720, 960, 1200]}
                  sizes="(min-width: 1216px) 37rem, (min-width: 760px) calc(50vw - 3rem), calc(100vw - 2rem)"
                  live={!!Live}
                >
                  {Live && <Live />}
                </BrowserFrame>
              </div>
              <div class="site__row">
                <h3 class="site__title">
                  <a href={projectHref(p)}>{p.data.title}</a>
                </h3>
                <p class="site__kind">{kindOf(p.data.client?.kind)}</p>
              </div>
              <p class="site__summary">{p.data.summary}</p>
              {data?.quote && (
                <figure class="site__quote">
                  <blockquote>{data.quote}</blockquote>
                  <figcaption>{data.quoteBy}</figcaption>
                </figure>
              )}
              <p class="site__links">
                <a class="link" href={projectHref(p)}>
                  Case study
                </a>
                <a class="link" href={p.data.links.live}>
                  {p.data.linkLabel ?? `Visit ${new URL(p.data.links.live!).host}`} <Icon name="arrow-up-right" class="inline h-[0.85em] w-[0.85em]" />
                </a>
              </p>
            </li>
          );
        })
      }
    </ul>

    <p class="web__how">
      Five steps from the first conversation to the written guide, with a quote before I start.
      <a class="link" href="/services/">See how I work</a>
      or <a class="link" href="/contact/?topic=website">start a project</a>.
    </p>
  </div>
</section>

<style>
  .web__head {
    display: grid;
    gap: 1rem 3rem;
  }

  @media (min-width: 960px) {
    .web__head {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      align-items: end;
    }
  }

  .web__title {
    margin-top: 0;
    font-size: clamp(2.5rem, 4.6vw, 3.75rem);
  }

  .web__lede {
    max-width: 30rem;
    color: var(--muted);
  }

  .sites {
    display: grid;
    gap: 2.5rem 1.5rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 760px) {
    .sites {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* A site running its live version keeps its row neighbor at its own height. */
    .sites:has([data-live-on]) {
      align-items: start;
    }
  }

  .site {
    min-width: 0;
  }

  /* The browser frame sits inside a paper card, under the figure's label row. */
  .site__media :global(.frame__window) {
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .site__media :global(.frame) {
    margin: 0;
  }

  .site__bar {
    min-height: 2.75rem;
  }

  .site__score {
    color: var(--text);
    font-weight: 700;
  }

  .site__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-top: 0.9rem;
  }

  .site__title {
    font-size: 1.0625rem;
    font-weight: 800;
    font-variation-settings: 'wdth' 100;
    letter-spacing: 0;
  }

  .site__title a {
    text-decoration: none;
  }

  .site__title a:hover {
    text-decoration: underline;
  }

  .site__kind {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .site__summary {
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    color: var(--text-soft);
  }

  .site__quote {
    margin: 0.75rem 0 0;
    padding-left: 0.9rem;
    border-left: 2px solid var(--accent);
  }

  .site__quote blockquote {
    font-size: 1rem;
    color: var(--text);
  }

  .site__quote figcaption {
    margin-top: 0.3rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .site__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 0.5rem;
    font-size: 0.9375rem;
  }

  .site__links a {
    padding-block: 0.3rem;
  }

  .web__how {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1.25rem;
    border-top: 2px solid var(--text);
    color: var(--text-soft);
  }
</style>
