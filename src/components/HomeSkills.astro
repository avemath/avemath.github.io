---
// Fig. 06, where each skill was used: skills down the side ("Know well" first, then "Have built
// with"), projects across the top, and a dot wherever a real file in that project's repo shows
// the skill. Every dot links to its file. The data is `usedIn` in src/lib/skills.ts; a skill with
// no public file is left off. On a phone the table scrolls sideways with the skill names frozen.
import skills from '@/data/skills.json';
import { fileUrl, matrixProjects, skillMap } from '@/lib/skills';

const cols = matrixProjects.filter((p) => p.public);
const groups = skills.map((g) => ({
  name: g.group,
  rows: g.items
    .map((skill) => ({ skill, uses: (skillMap[skill]?.usedIn ?? []).filter((u) => cols.some((c) => c.id === u.project)) }))
    .filter((r) => r.uses.length),
}));
const total = groups.reduce((n, g) => n + g.rows.length, 0);
let row = 0;
---

<section id="skills" class="section skills" aria-labelledby="skills-title">
  <div class="wrap">
    <div class="skills__head">
      <h2 id="skills-title" class="section-title skills__title" data-decode>Skills</h2>
      <p class="skills__lede">Two groups. Nothing here I could not talk through at a whiteboard.</p>
    </div>

    <figure class="sm paper" data-sm style={`--rows:${total}`}>
      <div class="fig__bar">
        <p class="fig__label">Fig. 06 / Where each skill was used</p>
        <p class="fig__label"><span class="on-mouse">hover</span><span class="on-touch">tap</span> a dot to see the file</p>
      </div>
      <div class="sm__scroll" tabindex="0" role="region" aria-label="Skills by project, scrolls sideways">
        <table class="sm__table">
          <caption class="sr-only">Where each skill was used. Each mark links to a file in that project's code.</caption>
          <thead>
            <tr>
              <th scope="col" class="sm__corner"><span class="sr-only">Skill</span></th>
              {
                cols.map((c) => (
                  <th scope="col" class="sm__col">
                    <a href={c.href}>{c.label}</a>
                  </th>
                ))
              }
            </tr>
          </thead>
          {
            groups.map((g) => (
              <tbody class="sm__group">
                <tr>
                  <th scope="rowgroup" colspan={cols.length + 1} class="sm__groupname">
                    {g.name}
                  </th>
                </tr>
                {g.rows.map((r) => {
                  const i = row++;
                  return (
                    <tr style={`--r:${i}`}>
                      <th scope="row" class="sm__skill">
                        {r.skill}
                      </th>
                      {cols.map((c) => {
                        const use = r.uses.find((u) => u.project === c.id);
                        return (
                          <td class="sm__cell">
                            {use && (
                              <a class="sm__dot" href={fileUrl(use)} aria-label={`${r.skill} in ${c.label}: ${use.detail}. Opens the file on GitHub.`}>
                                <span class="sm__tip" aria-hidden="true">
                                  {use.detail}
                                </span>
                              </a>
                            )}
                          </td>
                        );
                      })}
                    </tr>
                  );
                })}
              </tbody>
            ))
          }
        </table>
      </div>
      <figcaption class="fig__note">Every dot is a file you can open.</figcaption>
    </figure>
  </div>
</section>

<style>
  .skills__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }

  .skills__title {
    margin-top: 0;
  }

  .skills__lede {
    max-width: 24rem;
    color: var(--muted);
  }

  .sm {
    margin: 1.5rem 0 0;
  }

  /* Phones: the table keeps its width and scrolls sideways; the skill names stay put. */
  .sm__scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }

  .sm__scroll:focus-visible {
    outline-offset: -3px;
  }

  .sm__table {
    width: 100%;
    min-width: 40rem;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.875rem;
  }

  .sm__table th,
  .sm__table td {
    border-bottom: 1px solid var(--line);
  }

  .sm__corner,
  .sm__skill,
  .sm__groupname {
    position: sticky;
    left: 0;
    z-index: 1;
    background: var(--surface);
    text-align: left;
  }

  .sm__skill {
    width: 34%;
    min-width: 12rem;
    max-width: 18rem;
    padding: 0.4rem 0.9rem;
    font-weight: 400;
    border-right: 1px solid var(--line);
  }

  .sm__col {
    padding: 0.55rem 0.3rem;
    font-size: 0.8125rem;
    font-weight: 700;
    text-align: center;
    white-space: nowrap;
  }

  .sm__col a {
    text-decoration: none;
  }

  .sm__col a:hover {
    text-decoration: underline;
  }

  .sm__groupname {
    padding: 0.9rem 0.9rem 0.4rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent-ink);
  }

  /* The rule between the two groups. */
  .sm__group + .sm__group .sm__groupname {
    border-top: 2px solid var(--text);
  }

  .sm__cell {
    position: relative;
    text-align: center;
    vertical-align: middle;
  }

  .sm__dot {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
  }

  .sm__dot::before {
    content: '';
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--text);
    transition: transform 0.15s;
  }

  .sm__dot:hover::before,
  .sm__dot:focus-visible::before {
    background: var(--accent);
    transform: scale(1.35);
  }

  .sm__tip {
    position: absolute;
    z-index: 3;
    bottom: calc(100% + 4px);
    left: 50%;
    display: none;
    padding: 0.35rem 0.55rem;
    background: var(--navy);
    color: var(--on-navy);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    white-space: nowrap;
    translate: -50% 0;
    pointer-events: none;
  }

  .sm__dot:hover .sm__tip,
  .sm__dot:focus-visible .sm__tip {
    display: block;
  }

  /* Dots draw in row by row, about 600 ms in all, the first time the figure is on screen. The
     script sets the pending state, so without it, or with reduced motion, every dot is there. */
  .sm.sm--pending .sm__dot::before {
    transform: scale(0);
  }

  .sm.sm--run .sm__dot::before {
    animation: sm-dot 0.18s ease-out both;
    animation-delay: calc(var(--r) * 420ms / var(--rows));
  }

  @keyframes sm-dot {
    from {
      transform: scale(0);
    }
  }
</style>

<script>
  import { prefersReducedMotion } from '../scripts/preferences';

  const sm = document.querySelector<HTMLElement>('[data-sm]');
  if (sm && !prefersReducedMotion() && 'IntersectionObserver' in window && sm.getBoundingClientRect().top > innerHeight) {
    sm.classList.add('sm--pending');
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        sm.classList.replace('sm--pending', 'sm--run');
      },
      { threshold: 0.15 },
    );
    io.observe(sm);
  }
</script>
