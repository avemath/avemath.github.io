---
// The way down: a sheet band with three faint eigenray lines, leading to the research page, which
// opens on the seafloor scene.
---

<section class="below" aria-labelledby="below-title" data-perch="below" data-perch-x="0.92 0.72">
  <svg class="below__rays" viewBox="0 0 1440 420" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 150 L1440 300" />
    <path d="M0 330 L1440 120" />
    <path d="M520 0 L1440 220" class="below__ray--hot" />
  </svg>
  <div class="wrap below__grid">
    <div>
      <p class="eyebrow">Below the surface</p>
      <h2 id="below-title" class="section-title below__title" data-decode>The research lives on its own page, and it goes&nbsp;underwater.</h2>
      <p class="below__text">
        Underwater acoustic channels, the ONR data management work, bellhopSim, and the pool alarm. It opens on a glowing seafloor you can
        look around, and the field notes decode when you tap them.
      </p>
      <a class="btn below__btn" href="/research/">Go below</a>
    </div>
  </div>
</section>

<style>
  .below {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 8vw, 6rem);
    background: var(--sheet);
    border-block: 1px solid var(--line);
  }

  .below__rays {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .below__rays path {
    fill: none;
    stroke: var(--rule);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .below__rays .below__ray--hot {
    stroke: var(--teal);
    opacity: 0.55;
  }

  .below__grid {
    position: relative;
    display: grid;
    gap: 2rem;
  }

  .below__title {
    max-width: 14ch;
    font-size: clamp(2.3rem, 5vw, 3.75rem);
  }

  .below__text {
    margin-top: 1.25rem;
    max-width: 36rem;
    color: var(--muted);
  }

  .below__btn {
    margin-top: 1.75rem;
    --btn-line: var(--text);
  }

</style>
