---
// A photo on the About page, printed as a Polaroid: an off-white frame with a thin border on three
// sides and a deep strip at the bottom (an 88-wide frame with a 23.5 strip), a caption written in
// marker, a soft shadow and a slight tilt that straightens on hover or focus. With no photo yet,
// the pin's line drawing goes in a square instead.
// Photos are never cropped. By default the frame takes the photo's own shape: fixed width, height
// follows. With fit="contain" (the datasheet's pin panel) the window stays square so the panel
// keeps its height, and the whole photo sits inside it on the panel tint, with side margins for a
// tall photo. With bare, a photo that is already a print (with its own border) shows as it is, at
// the same outer width as a framed print.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PrintArt from './PrintArt.astro';

interface Props {
  photo?: ImageMetadata;
  alt?: string;
  art?: 'latte' | 'bellows' | 'socket';
  /** A label for a drawing that carries meaning on its own; pin drawings are decorative. */
  artLabel?: string;
  caption?: string;
  /** A caption written on two (or more) lines, each its own line in the strip. */
  lines?: string[];
  /** Degrees; alternate the sign from print to print. */
  tilt?: number;
  sizes?: string;
  fit?: 'natural' | 'contain';
  bare?: boolean;
  class?: string;
}

const { photo, alt = '', art, artLabel, caption = '', lines, tilt = 2, sizes = '20rem', fit = 'natural', bare = false, class: cls } = Astro.props;
const shape = photo && fit === 'natural' ? `aspect-ratio:${photo.width}/${photo.height}` : '';
---

{
  bare && photo ? (
    <figure class:list={['pol-bare', cls]} style={`--tilt:${tilt}deg`}>
      <div class="pol-bare__box">
        <Picture src={photo} alt={alt} formats={['avif', 'webp']} widths={[320, 480, 640]} sizes={sizes} quality={80} loading="lazy" />
      </div>
    </figure>
  ) : (
    <figure class:list={['pol', `pol--${fit}`, cls]} style={`--tilt:${tilt}deg`}>
      <div class="pol__img" style={shape}>
        {photo ? (
          <Picture src={photo} alt={alt} formats={['avif', 'webp']} widths={[320, 480, 640]} sizes={sizes} quality={80} loading="lazy" />
        ) : (
          art && <PrintArt name={art} label={artLabel} />
        )}
      </div>
      {lines?.length ? (
        <figcaption class="pol__cap pol__cap--lines">
          {lines.map((l) => (
            <span>{l}</span>
          ))}
        </figcaption>
      ) : (
        <figcaption class="pol__cap">{caption}</figcaption>
      )}
    </figure>
  )
}

<style>
  .pol {
    width: 100%;
    margin: 0;
    padding: 5.1% 5.1% 0;
    background: var(--photo);
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--ink) 18%, transparent),
      0 12px 24px -12px color-mix(in srgb, var(--ink) 45%, transparent);
    rotate: var(--tilt);
    container-type: inline-size;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-motion='reduce'])) :is(.pol, .pol-bare) {
      transition: rotate 0.25s ease;
    }
  }

  .pol:hover,
  .pol:focus-within,
  .pol-bare:hover {
    rotate: 0deg;
  }

  .pol__img {
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--sheet);
  }

  .pol__img :global(picture) {
    display: contents;
  }

  .pol__img :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* The pin panel: a square window, the whole photo inside it on the panel tint. */
  .pol--contain .pol__img {
    background: var(--sheet);
  }

  .pol--contain .pol__img :global(img) {
    object-fit: contain;
  }

  /* The deep bottom strip: 23.5 of the frame's 88 wide, with the caption written in it. A long
     caption on a small print may take two lines; the strip grows rather than clip it. */
  .pol__cap {
    display: flex;
    align-items: center;
    min-height: 26.7cqw;
    padding-block: 0.2em;
    padding-inline: 0.15em;
    font-family: 'Kalam', 'Segoe Print', 'Bradley Hand', cursive;
    font-size: 1.25rem;
    line-height: 1.1;
    color: var(--photo-ink);
    overflow-wrap: anywhere;
  }

  /* Two handwritten lines: sized to the print's width so both always fit inside the strip
     (26.7cqw tall: two lines at 1.05 line height need the type at about 11cqw or less). */
  .pol__cap--lines {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    font-size: min(1.25rem, 10cqw);
    line-height: 1.05;
  }

  .pol__cap--lines span {
    display: block;
    white-space: nowrap;
  }

  /* A print that already has its own white border: no frame added, the whole print at the same
     outer width as the framed prints, with the print's own shadow. */
  .pol-bare {
    margin: 0;
    rotate: var(--tilt);
  }

  .pol-bare__box :global(picture) {
    display: contents;
  }

  .pol-bare__box :global(img) {
    display: block;
    width: 100%;
    height: auto;
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--ink) 18%, transparent),
      0 12px 24px -12px color-mix(in srgb, var(--ink) 45%, transparent);
  }
</style>
