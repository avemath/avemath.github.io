---
// Line drawings that stand in for photos on the About page's prints until a real one exists:
// 1.5px ink strokes and one accent stroke, the site's figure style. Each fills a square.
// Decorative unless a label is passed (the pin's text already says what it shows).
interface Props {
  name: 'latte' | 'bellows';
  label?: string;
}

const { name, label } = Astro.props;
---

<svg class="art" viewBox="0 0 100 100" focusable="false" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  {
    name === 'latte' && (
      <>
        <path d="M26 44 H70 V60 C70 72 62 78 48 78 C34 78 26 72 26 60 Z" />
        <path d="M70 49 C80 49 82 61 70 63" />
        <path d="M18 82 H78" />
        <path d="M38 34 C34 28 42 24 38 18 M50 34 C46 28 54 24 50 18 M62 34 C58 28 66 24 62 18" />
        <path class="hot" d="M48 56 C44 50 38 54 42 58 L48 63 L54 58 C58 54 52 50 48 56" />
      </>
    )
  }
  {
    name === 'bellows' && (
      <>
        <rect x="10" y="38" width="22" height="38" rx="2" />
        <path d="M32 42 L62 48 V68 L32 74 Z" />
        <path d="M38 43.2 V72.8 M44 44.4 V71.6 M50 45.6 V70.4 M56 46.8 V69.2" />
        <rect x="62" y="44" width="7" height="28" />
        <path d="M69 51 H78 V65 H69 M74 51 V65" />
        <path d="M8 80 H86 M40 80 L48 76 H72 L76 80" />
        <path d="M20 38 V28 H48 V22" />
        <circle cx="60" cy="20" r="14" />
        <circle cx="60" cy="20" r="9" />
        <path class="hot" d="M60 15 C63 15 65 17 65 20 C65 23 63 25 60 25 C57 25 55 23 55 20 C55 17 57 15 60 15 M58 25 V28 H62 V25" />
      </>
    )
  }
</svg>

<style>
  .art {
    display: block;
    width: 100%;
    height: 100%;
    background: #e6ede6;
  }

  .art :is(path, rect, circle) {
    fill: none;
    stroke: #1c2a25;
    stroke-width: 1.5px;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .art .hot {
    stroke: #8a5546;
    stroke-width: 2px;
  }

</style>
