---
// Line drawings that stand in for photos on the About page's prints until a real one exists:
// 1.5px ink strokes and one accent stroke, the site's figure style. Each fills a square.
// Decorative unless a label is passed (the pin's text already says what it shows).
interface Props {
  name: 'latte' | 'hanger';
  label?: string;
}

const { name, label } = Astro.props;
---

<svg class="art" viewBox="0 0 100 100" focusable="false" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  {
    name === 'latte' && (
      <>
        <path d="M26 44 H70 V60 C70 72 62 78 48 78 C34 78 26 72 26 60 Z" />
        <path d="M70 49 C80 49 82 61 70 63" />
        <path d="M18 82 H78" />
        <path d="M38 34 C34 28 42 24 38 18 M50 34 C46 28 54 24 50 18 M62 34 C58 28 66 24 62 18" />
        <path class="hot" d="M48 56 C44 50 38 54 42 58 L48 63 L54 58 C58 54 52 50 48 56" />
      </>
    )
  }
  {
    name === 'hanger' && (
      <>
        <path d="M50 38 V32 C50 26 58 26 58 20 C58 14 50 12 46 16" />
        <path d="M50 38 L14 64 C10 67 12 72 17 72 H83 C88 72 90 67 86 64 Z" />
        <path class="hot" d="M26 80 H74" />
      </>
    )
  }
</svg>

<style>
  .art {
    display: block;
    width: 100%;
    height: 100%;
    background: #e6ede6;
  }

  .art :is(path, rect, circle) {
    fill: none;
    stroke: #1c2a25;
    stroke-width: 1.5px;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .art .hot {
    stroke: #8a5546;
    stroke-width: 2px;
  }

</style>
