---
// The AVE-26 datasheet on /about/: a twelve-pin chip with pins 01 to 06 down the left and 07 to 12
// up the right, like a real DIP. Every pin is a button; pressing one slides its print out of the
// chip into the tray, with a handwritten note taped beside it, and lights its row in the
// characteristics table. Pin 08 (FILM) is out to start. Every pin, note, row and photo is in
// src/data/about.json; src/scripts/datasheet.ts does the pressing.
import type { ImageMetadata } from 'astro';
import about from '@/data/about.json';
import Polaroid from './Polaroid.astro';

type Art = 'latte' | 'bellows' | 'socket';
type Extra = { photo: string; alt: string; caption: string };

// Pin photos live in src/assets/about/ and src/assets/offclock/ (and one in the LED project's
// folder), named by their path under src/assets/. A pin with no photo shows its line drawing
// (NC, pin 12, is an empty socket on purpose).
// TODO(ave): a photo for THRIFT (the bellows camera); see about.json.
const files = import.meta.glob<{ default: ImageMetadata }>(['/src/assets/about/*.{jpg,jpeg,png,webp}', '/src/assets/offclock/*.{jpg,jpeg,png,webp}', '/src/assets/projects/led-audio-spectrum/*.jpg'], { eager: true });
const photoAt = (path: string) => (path ? files[`/src/assets/${path}`]?.default : undefined);

// A note may hold [words](/link/) for a link; everything else is plain text.
const parts = (text: string) =>
  text.split(/(\[[^\]]+\]\([^)]+\))/).map((s) => {
    const m = s.match(/^\[([^\]]+)\]\(([^)]+)\)$/);
    return m ? { text: m[1], href: m[2] } : { text: s };
  });

const START = 7; // pin 08, FILM
const pins = about.pins.map((p, i) => ({
  ...p,
  n: String(i + 1).padStart(2, '0'),
  i,
  photo: photoAt(p.photo),
  art: (p as { art?: Art }).art,
  frame: (p as { frame?: boolean }).frame !== false,
  extra: (p as { extra?: Extra }).extra,
  rowIndex: about.rows.findIndex((r) => r.key === p.row),
}));
const half = Math.ceil(pins.length / 2);
const left = pins.slice(0, half);
// Up the right side: the last pin at the top, the first of the right half at the bottom.
const right = pins.slice(half).reverse();
---

<section id="datasheet" class="ds wrap" aria-labelledby="ds-title">
  <div class="ds__sheet plate">
  <header class="ds__tb">
    <h2 id="ds-title" class="ds__title"><span class="ds__part">AVE-26</span> <em>Datasheet</em></h2>
    <p class="ds__note">The work lives on the Projects and Websites pages. This is everything else. Press a pin.</p>
    <dl class="ds__rev">
      <div><dt>Rev.</dt><dd>2026</dd></div>
      <div><dt>By</dt><dd>Matherne, A.</dd></div>
      <div><dt>Sheet</dt><dd>1 of 1</dd></div>
    </dl>
  </header>

  <div class="ds__body">
  <div class="ds__main" data-ds>
    <div class="dip" role="group" aria-label="AVE-26 pins">
      <ul class="dip__side dip__side--l">
        {
          left.map((p) => (
            <li>
              <button type="button" class="pin" data-pin={p.i} aria-pressed={p.i === START ? 'true' : 'false'} aria-controls="ds-tray">
                <span class="pin__nm">{p.label}</span>
                <span class="pin__num">
                  <span class="sr-only">pin </span>
                  {p.n}
                </span>
                <span class="pin__leg" aria-hidden="true" />
              </button>
            </li>
          ))
        }
      </ul>
      <div class="dip__body" aria-hidden="true" data-perch="chip" data-perch-x="0.5" data-perch-min="860">
        <strong>AVE-26</strong>
        <span>Matherne, A.<br />rev. 2026</span>
      </div>
      <ul class="dip__side dip__side--r">
        {
          right.map((p) => (
            <li>
              <button type="button" class="pin" data-pin={p.i} aria-pressed={p.i === START ? 'true' : 'false'} aria-controls="ds-tray">
                <span class="pin__leg" aria-hidden="true" />
                <span class="pin__num">
                  <span class="sr-only">pin </span>
                  {p.n}
                </span>
                <span class="pin__nm">{p.label}</span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="tray" id="ds-tray">
      {
        pins.map((p) => (
          <article class:list={['slip', { 'slip--two': p.extra }]} data-slip={p.i} hidden={p.i !== START} aria-labelledby={`slip-${p.i}`}>
            {p.extra && (
              <Polaroid
                photo={photoAt(p.extra.photo)}
                alt={p.extra.alt}
                caption={p.extra.caption}
                tilt={5}
                sizes="(min-width: 860px) 175px, 130px"
                class="slip__mini"
              />
            )}
            <div class="slip__grid">
              <Polaroid
                photo={p.photo}
                alt={p.alt}
                art={p.art}
                caption={p.caption}
                tilt={-2}
                bare={!p.frame}
                sizes="(min-width: 860px) 270px, 70vw"
                class:list={['slip__print', { 'slip__print--bare': !p.frame }]}
              />
              <div class="note">
                <span class="note__meta">
                  PIN {p.n} {p.label}
                </span>
                <h3 id={`slip-${p.i}`} class="note__title">
                  {p.title}
                </h3>
                <p class="note__text">{parts(p.note).map((s) => (s.href ? <a href={s.href}>{s.text}</a> : s.text))}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <table class="ch">
    <caption class="ch__cap">Characteristics</caption>
    <tbody>
      {
        about.rows.map((r, j) => {
          const on = pins.filter((p) => p.rowIndex === j);
          return (
            <tr data-row={j} class:list={{ 'is-on': pins[START].rowIndex === j }}>
              <th scope="row">
                {r.key}
                {on.length > 0 && <span class="ch__pins">pin{on.length > 1 ? 's' : ''} {on.map((p) => p.n).join(', ')}</span>}
              </th>
              <td>{r.value}</td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
  </div>
  </div>
  <script type="application/json" data-ds-rows set:html={JSON.stringify(pins.map((p) => p.rowIndex))} />
</section>

<script>
  import { initDatasheet } from '../../scripts/datasheet';
  initDatasheet();
</script>

<style>
  /* One datasheet page: a single plate with a title block across the top, the chip and its print
     tray on the left and the characteristics on the right (from 1200px; stacked below, the
     table directly under the tray). Sized so that, landed on #datasheet at 1440 by 900 or 1280 by
     800, the chip, the pressed pin's print and the first rows of the table all show at once. */
  .ds {
    padding-block: 2rem 1.5rem;
    /* html's scroll-padding-top already clears the header. */
    scroll-margin-top: 0;
    --ds-bg: var(--surface);
  }

  .ds__sheet {
    padding: clamp(18px, 2.2vw, 30px);
    background: var(--ds-bg);
  }

  /* The title block: part number, title, the note, and the revision box, like a datasheet header. */
  .ds__tb {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: end;
    gap: 0.75rem 2rem;
    padding: 0.25rem 0.5rem 0.9rem;
    border-bottom: 1px solid var(--rule);
  }

  .ds__title {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1;
  }

  .ds__part {
    font-family: var(--font-mono);
    font-size: 0.82em;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .ds__note {
    max-width: 34em;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .ds__rev {
    display: flex;
    margin: 0;
    border: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .ds__rev div {
    padding: 0.3rem 0.65rem;
  }

  .ds__rev div + div {
    border-left: 1px solid var(--rule);
  }

  .ds__rev dt {
    color: var(--muted);
  }

  .ds__rev dd {
    margin: 0;
    white-space: nowrap;
  }

  @media (max-width: 959px) {
    .ds__tb {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }

    .ds__rev {
      justify-self: start;
    }
  }

  .ds__body {
    display: grid;
    gap: 2rem 2.5rem;
    margin-top: 1rem;
  }

  @media (min-width: 1200px) {
    .ds__body {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      align-items: start;
    }
  }

  /* The chip and the tray side by side from 860px (6 to 5), stacked below. */
  .ds__main {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  /* On big screens the chip, its pins, the tray, the print that slides out, the note and the pirate
     print grow together, in proportion. (Sizes inside are px, so this zoom is the only thing
     scaling them.) The table shares the row now, so the growth is gentler than before. */
  @media (min-width: 1600px) {
    .ds__main {
      zoom: 1.08;
    }
  }

  @media (min-width: 1920px) {
    .ds__main {
      zoom: 1.2;
    }
  }

  @media (min-width: 2240px) {
    .ds__main {
      zoom: 1.32;
    }
  }

  @media (min-width: 2560px) {
    .ds__main {
      zoom: 1.42;
    }
  }

  /* The room above leaves the bit girl space to stand on the chip. */
  @media (min-width: 860px) {
    .ds__main {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: start;
      padding-top: 2.25rem;
    }
  }

  /* Beside the table the chip's column is narrower: a slimmer body and shorter legs keep every pin
     name clear of its number. */
  @media (min-width: 1200px) {
    .ds__body .dip__body {
      width: 136px;
    }

    .ds__body .pin__leg {
      flex-basis: 22px;
    }

    .ds__body .pin {
      gap: 7px;
    }
  }

  /* ---- The chip ---- */
  .dip {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    width: 100%;
    max-width: 36rem;
    margin-inline: auto;
  }

  .dip__side {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    gap: 6px;
    margin: 0;
    padding: 22px 0;
    list-style: none;
  }

  .dip__body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: clamp(120px, 15vw, 190px);
    min-height: 440px;
    padding: 24px 12px;
    border-radius: 6px;
    background: var(--chip);
    color: var(--chip-ink);
  }

  /* In dark mode the chip is darker than the page, so a hairline keeps its edge. */
  :global([data-theme='dark']) .dip__body {
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  /* The notch at the top and the pin 1 dot. */
  .dip__body::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 50%;
    width: 34px;
    height: 17px;
    border-radius: 0 0 17px 17px;
    background: var(--ds-bg);
    transform: translateX(-50%);
  }

  .dip__body::after {
    content: '';
    position: absolute;
    top: 22px;
    left: 16px;
    width: 10px;
    height: 10px;
    border: 1.5px solid var(--leg);
    border-radius: 50%;
  }

  .dip__body strong {
    font-family: var(--font-mono);
    font-size: clamp(20px, 2.2vw, 26px);
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  .dip__body span {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
    text-align: center;
    color: var(--screen-muted);
  }

  .pin {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    width: 100%;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }

  .dip__side--r .pin {
    justify-content: flex-start;
  }

  .pin__leg {
    flex: 0 0 34px;
    height: 12px;
    border-radius: 1px;
    background: var(--leg);
    transition: background 0.2s;
  }

  .pin__num {
    font-family: var(--font-mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .pin__nm {
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .pin:hover .pin__leg {
    background: var(--accent);
  }

  .pin:focus-visible {
    outline: none;
  }

  .pin:focus-visible .pin__nm {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .pin[aria-pressed='true'] .pin__leg {
    background: var(--rose);
  }

  .pin[aria-pressed='true'] .pin__nm {
    color: var(--rose-ink);
  }

  :global([data-theme='dark']) .pin[aria-pressed='true'] .pin__nm {
    color: var(--rose);
  }

  @media (max-width: 859px) {
    .dip__body {
      min-height: 452px;
    }
  }

  @media (max-width: 420px) {
    .pin {
      gap: 6px;
    }

    .pin__leg {
      flex-basis: 16px;
    }

    .pin__nm {
      font-size: 12.5px;
      letter-spacing: 0.02em;
    }

    .dip__body {
      width: 96px;
      padding-inline: 6px;
    }

    .dip__body strong {
      font-size: 17px;
    }
  }

  @media (max-width: 360px) {
    .pin {
      gap: 4px;
    }

    .pin__leg {
      flex-basis: 10px;
    }

    .dip__body {
      width: 84px;
    }

    .dip__body strong {
      font-size: 15px;
    }

    .dip__body span {
      font-size: 10px;
    }
  }

  /* ---- The tray: the pressed pin's print and its note ---- */
  .tray {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 470px;
    scroll-margin-top: 5rem;
  }

  @media (max-width: 859px) {
    .tray {
      min-height: 0;
    }
  }

  .slip {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transform-origin: 0 50%;
  }

  .slip[hidden] {
    display: none;
  }

  /* Slides out of the chip. Only when motion is welcome. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-motion='reduce'])) .slip.is-in {
      animation: slideout 0.55s cubic-bezier(0.2, 0.75, 0.2, 1);
    }
  }

  @keyframes slideout {
    from {
      opacity: 0;
      transform: translateX(-90px) scale(0.7) rotate(-9deg);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  .slip__grid {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
  }

  .slip :global(.slip__print) {
    position: relative;
    width: min(270px, 100%);
  }

  /* A photo that is already a print shows whole, with no frame of its own, at the same outer width
     as the framed prints (the .slip__print widths above apply to it too). */

  /* FAIRE: a second, larger print up top, overlapping the corner. */
  .slip :global(.slip__mini) {
    position: absolute;
    top: -18px;
    right: -6px;
    z-index: 3;
    width: 175px;
  }

  @media (max-width: 859px) {
    .slip :global(.slip__mini) {
      width: 130px;
    }
  }

  /* The note: lined paper, taped on, in Kalam. */
  .note {
    position: relative;
    z-index: 2;
    width: min(280px, 100%);
    margin: 44px 0 0 -26px;
    padding: 14px 18px 16px;
    transform: rotate(2.5deg);
    background: var(--note-paper) repeating-linear-gradient(var(--note-paper) 0 27px, var(--note-line) 27px 28px);
    box-shadow: 0 10px 22px rgb(30 15 40 / 0.18);
  }

  .note::before {
    content: '';
    position: absolute;
    top: -11px;
    left: 30%;
    width: 78px;
    height: 22px;
    transform: rotate(-5deg);
    background: repeating-linear-gradient(45deg, #c6b0ea 0 8px, rgb(255 255 255 / 0.45) 8px 12px);
    opacity: 0.85;
  }

  .note__meta {
    display: block;
    margin-bottom: 2px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--note-meta);
  }

  .note__title {
    margin: 0;
    font-family: var(--font-hand);
    font-size: 22px;
    font-weight: 400;
    line-height: 28px;
    letter-spacing: 0;
    color: var(--note-title);
  }

  .note__text {
    margin: 0;
    font-family: var(--font-hand);
    font-size: 17px;
    line-height: 28px;
    color: var(--note-ink);
  }

  .note__text a {
    color: var(--note-title);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .note__text a:focus-visible {
    outline: 2px solid var(--note-title);
    outline-offset: 2px;
  }

  /* Stacked: the note sits under the print, nudged right, clear of the print's caption. */
  @media (max-width: 859px) {
    .note {
      margin: 10px 0 0 18px;
    }
  }

  @media (max-width: 479px) {
    .slip--two .slip__grid {
      padding-top: 0;
    }

    .slip :global(.slip__print) {
      width: min(230px, 74%);
    }

    .slip :global(.slip__mini) {
      width: 110px;
      right: 0;
    }
  }

  /* ---- Characteristics ---- */
  .ch {
    width: 100%;
    border-collapse: collapse;
    border-top: 1px solid var(--line);
  }

  .ch__cap {
    padding: 0 0 0.625rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.125rem;
    text-align: left;
    color: var(--muted);
  }

  .ch tr {
    border-top: 1px solid var(--line);
  }

  .ch th,
  .ch td {
    padding: 0.7rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }

  .ch th {
    width: 13rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--muted);
  }

  /* The pins a row is about, by number, so the chip and the table read as one document. */
  .ch__pins {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.75rem;
    color: var(--accent-ink);
  }

  .ch td {
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .ch tr.is-on {
    border-top-color: var(--rose);
    background: var(--accent-wash-strong);
  }

  .ch tr.is-on th {
    color: var(--text);
  }

  /* Beside the chip the column is narrow: the key column narrows with it. */
  @media (min-width: 1200px) {
    .ch {
      margin-top: 2.25rem;
    }

    .ch th {
      width: 9.5rem;
      padding-inline: 0.5rem 0.75rem;
    }

    .ch td {
      padding-inline: 0 0.5rem;
      font-size: 0.875rem;
    }
  }

  @media (max-width: 479px) {
    .ch th {
      width: 8.5rem;
      padding-inline: 0.5rem;
    }

    .ch td {
      padding-inline: 0.5rem;
    }
  }
</style>
