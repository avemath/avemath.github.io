---
// The AVE-26 datasheet on /about/: a twelve-pin chip with pins 01 to 06 down the left and 07 to 12
// up the right, like a real DIP. Every pin is a button; pressing one slides its print out of the
// chip into the tray, with a handwritten note taped beside it, and lights its row in the
// characteristics table. Pin 08 (FILM) is out to start. Every pin, note, row and photo is in
// src/data/about.json; src/scripts/datasheet.ts does the pressing.
import type { ImageMetadata } from 'astro';
import about from '@/data/about.json';
import Polaroid from './Polaroid.astro';

type Art = 'latte' | 'socket';
type Extra = { photo: string; alt: string; caption: string };

// Pin photos live in src/assets/about/ and src/assets/offclock/ (and one in the LED project's
// folder), named by their path under src/assets/. A pin with no photo shows its line drawing
// (NC, pin 12, is an empty socket on purpose).
const files = import.meta.glob<{ default: ImageMetadata }>(['/src/assets/about/*.{jpg,jpeg,png,webp}', '/src/assets/offclock/*.{jpg,jpeg,png,webp}', '/src/assets/projects/led-audio-spectrum/*.jpg'], { eager: true });
const photoAt = (path: string) => (path ? files[`/src/assets/${path}`]?.default : undefined);

// A note may hold [words](/link/) for a link; everything else is plain text.
const parts = (text: string) =>
  text.split(/(\[[^\]]+\]\([^)]+\))/).map((s) => {
    const m = s.match(/^\[([^\]]+)\]\(([^)]+)\)$/);
    return m ? { text: m[1], href: m[2] } : { text: s };
  });

const START = 7; // pin 08, FILM
const pins = about.pins.map((p, i) => ({
  ...p,
  n: String(i + 1).padStart(2, '0'),
  i,
  photo: photoAt(p.photo),
  art: (p as { art?: Art }).art,
  frame: (p as { frame?: boolean }).frame !== false,
  extra: (p as { extra?: Extra }).extra,
  rowIndex: about.rows.findIndex((r) => r.key === p.row),
}));
const half = Math.ceil(pins.length / 2);
const left = pins.slice(0, half);
// Up the right side: the last pin at the top, the first of the right half at the bottom.
const right = pins.slice(half).reverse();
---

<section id="datasheet" class="ds wrap" aria-labelledby="ds-title">
  <div class="ds__sheet plate">
  <header class="ds__tb">
    <h2 id="ds-title" class="ds__title"><span class="ds__part">AVE-26</span> <em>Datasheet</em></h2>
    <p class="ds__note">The work lives on the Projects and Websites pages. This is everything else. Press a pin.</p>
    <dl class="ds__rev">
      <div><dt>Rev.</dt><dd>2026</dd></div>
      <div><dt>By</dt><dd>Matherne, A.</dd></div>
      <div><dt>Sheet</dt><dd>1 of 1</dd></div>
    </dl>
  </header>

  <div class="ds__body">
  <div class="ds__main" data-ds>
    <div class="dip-wrap">
    <div class="dip" role="group" aria-label="AVE-26 pins">
      <ul class="dip__side dip__side--l">
        {
          left.map((p) => (
            <li>
              <button type="button" class="pin" data-pin={p.i} aria-pressed={p.i === START ? 'true' : 'false'} aria-controls="ds-tray">
                <span class="pin__nm">{p.label}</span>
                <span class="pin__num">
                  <span class="sr-only">pin </span>
                  {p.n}
                </span>
                <span class="pin__leg" aria-hidden="true" />
              </button>
            </li>
          ))
        }
      </ul>
      <div class="dip__body" aria-hidden="true" data-perch="chip" data-perch-x="0.5" data-perch-min="860">
        <strong>AVE-26</strong>
        <span>Matherne, A.<br />rev. 2026</span>
      </div>
      <ul class="dip__side dip__side--r">
        {
          right.map((p) => (
            <li>
              <button type="button" class="pin" data-pin={p.i} aria-pressed={p.i === START ? 'true' : 'false'} aria-controls="ds-tray">
                <span class="pin__leg" aria-hidden="true" />
                <span class="pin__num">
                  <span class="sr-only">pin </span>
                  {p.n}
                </span>
                <span class="pin__nm">{p.label}</span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>
    </div>

    <div class="tray" id="ds-tray">
      {
        pins.map((p) => (
          <article class:list={['slip', { 'slip--two': p.extra }]} data-slip={p.i} hidden={p.i !== START} aria-labelledby={`slip-${p.i}`}>
            <div class="slip__prints">
              <Polaroid
                photo={p.photo}
                alt={p.alt}
                art={p.art}
                caption={p.caption}
                tilt={-2}
                bare={!p.frame}
                sizes={p.extra ? '(min-width: 860px) 210px, 56vw' : '(min-width: 860px) 260px, 70vw'}
                class:list={['slip__print', { 'slip__print--bare': !p.frame }]}
              />
              {p.extra && (
                <Polaroid
                  photo={photoAt(p.extra.photo)}
                  alt={p.extra.alt}
                  caption={p.extra.caption}
                  tilt={3}
                  sizes="(min-width: 860px) 150px, 38vw"
                  class="slip__mini"
                />
              )}
            </div>
            <div class="note">
              <span class="note__meta">
                PIN {p.n} {p.label}
              </span>
              <h3 id={`slip-${p.i}`} class="sr-only">
                {p.title}
              </h3>
              <p class="note__text">{parts(p.note).map((s) => (s.href ? <a href={s.href}>{s.text}</a> : s.text))}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <table class="ch">
    <caption class="ch__cap">Characteristics</caption>
    <tbody>
      {
        about.rows.map((r, j) => {
          const on = pins.filter((p) => p.rowIndex === j);
          return (
            <tr data-row={j} class:list={{ 'is-on': pins[START].rowIndex === j }}>
              <th scope="row">
                {r.key}
                {on.length > 0 && <span class="ch__pins">pin{on.length > 1 ? 's' : ''} {on.map((p) => p.n).join(', ')}</span>}
              </th>
              <td>{r.value}</td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
  </div>
  </div>
  <script type="application/json" data-ds-rows set:html={JSON.stringify(pins.map((p) => p.rowIndex))} />
</section>

<script>
  import { initDatasheet } from '../../scripts/datasheet';
  initDatasheet();
</script>

<style>
  /* One datasheet page: a single plate with a title block across the top, the chip with its print
     tray beside it (from 860px; stacked below), and the characteristics table under both. Sized so
     that, landed on #datasheet at 1440 by 900 or 1280 by 800, the chip, the pressed pin's print and
     note, and the first row of the table all show at once. */
  /* The datasheet is a container: it lays itself out by its own width (the sizes below are the sheet's,
     not the window's), so it is right wherever it sits and at any window size. */
  .ds {
    container: ds / inline-size;
    padding-block: 2rem 1.5rem;
    /* html's scroll-padding-top already clears the header. */
    scroll-margin-top: 0;
    --ds-bg: var(--surface);
  }

  .ds__sheet {
    padding: clamp(18px, 2.2vw, 30px);
    background: var(--ds-bg);
  }

  /* Small phones: the chip needs every pixel for its pin names. */
  @container ds (max-width: 347px) {
    .ds__sheet {
      padding: 12px 10px;
    }
  }

  /* The title block: part number, title, the note, and the revision box, like a datasheet header. */
  .ds__tb {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: end;
    gap: 0.75rem 2rem;
    padding: 0.25rem 0.5rem 0.9rem;
    border-bottom: 1px solid var(--rule);
  }

  .ds__title {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1;
  }

  .ds__part {
    font-family: var(--font-mono);
    font-size: 0.82em;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .ds__note {
    max-width: 34em;
    font-size: var(--fs-15);
    color: var(--muted);
  }

  .ds__rev {
    display: flex;
    margin: 0;
    border: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--fs-12);
  }

  .ds__rev div {
    padding: 0.3rem 0.65rem;
  }

  .ds__rev div + div {
    border-left: 1px solid var(--rule);
  }

  .ds__rev dt {
    color: var(--muted);
  }

  .ds__rev dd {
    margin: 0;
    white-space: nowrap;
  }

  @container ds (max-width: 882px) {
    .ds__tb {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }

    .ds__rev {
      justify-self: start;
    }
  }

  .ds__body {
    display: grid;
    gap: 2rem 2.5rem;
    margin-top: 1rem;
  }

  /* The chip and the tray side by side from 860px, stacked below; the characteristics table under
     both, across the sheet. */
  .ds__main {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  /* On big screens the chip, its pins, the tray, the print that slides out, the note and the pirate
     print grow together, in proportion. (Sizes inside are px, so this zoom is the only thing
     scaling them.) The table shares the row now, so the growth is gentler than before. */
  @container ds (min-width: 1219px) {
    .ds__main {
      zoom: 1.08;
    }
  }

  @container ds (min-width: 1386px) {
    .ds__main {
      zoom: 1.2;
    }
  }

  @container ds (min-width: 1553px) {
    .ds__main {
      zoom: 1.32;
    }
  }

  @container ds (min-width: 1720px) {
    .ds__main {
      zoom: 1.42;
    }
  }

  /* The room above leaves the bit girl space to stand on the chip. The chip keeps a set width; the
     tray takes the rest, room for the print and its note side by side. */
  @container ds (min-width: 791px) {
    .ds__main {
      grid-template-columns: minmax(0, 26rem) minmax(0, 1fr);
      align-items: start;
      padding-top: 1.75rem;
    }

    .ds__body {
      gap: 1rem;
    }

    .ds__main .dip__body {
      min-height: 400px;
    }
  }

  /* ---- The chip ---- */
  /* The chip sizes itself from its own width (cqi), so it is right at every width, not at a list of
     them: the body, the legs, the gaps and the type all scale smoothly. The body is a grid column
     between 48px and its full width, and gives way first, so a pin name never runs out of its pin
     (enlarged text included). */
  .dip-wrap {
    container: chip / inline-size;
    width: 100%;
    max-width: 36rem;
    margin-inline: auto;
  }

  .dip {
    display: grid;
    grid-template-columns: minmax(max-content, 1fr) minmax(48px, clamp(70px, 46cqi - 42px, 150px)) minmax(max-content, 1fr);
    width: 100%;
  }

  .dip__side {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    gap: 6px;
    margin: 0;
    padding: 22px 0;
    list-style: none;
  }

  .dip__body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-width: 0;
    min-height: 440px;
    padding: 24px clamp(4px, 3cqi, 12px);
    border-radius: var(--radius-6);
    background: var(--chip);
    color: var(--chip-ink);
  }

  /* In dark mode the chip is darker than the page, so a hairline keeps its edge. */
  :global([data-theme='dark']) .dip__body {
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  /* The notch at the top and the pin 1 dot. */
  .dip__body::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 50%;
    width: 34px;
    height: 17px;
    border-radius: 0 0 17px 17px;
    background: var(--ds-bg);
    transform: translateX(-50%);
  }

  .dip__body::after {
    content: '';
    position: absolute;
    top: 22px;
    left: 16px;
    width: 10px;
    height: 10px;
    border: 1.5px solid var(--leg);
    border-radius: 50%;
  }

  .dip__body strong {
    font-family: var(--font-mono);
    font-size: clamp(14px, 6.25cqi, 26px);
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  .dip__body span {
    font-family: var(--font-mono);
    font-size: clamp(10px, 2.7cqi, 11px);
    line-height: 1.5;
    text-align: center;
    color: var(--screen-muted);
  }

  .pin {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(3px, 2.4cqi - 2px, 10px);
    width: 100%;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }

  .dip__side--r .pin {
    justify-content: flex-start;
  }

  /* The leg shrinks first when room is short (down to a stub), then nothing else has to. */
  .pin__leg {
    flex: 0 1 clamp(6px, 13cqi - 20px, 34px);
    min-width: 4px;
    height: 12px;
    border-radius: 1px;
    background: var(--leg);
    transition: background 0.2s;
  }

  .pin__num {
    font-family: var(--font-mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .pin__nm {
    flex: none;
    font-family: var(--font-mono);
    font-size: clamp(11px, 2.4cqi + 4px, 14px);
    font-weight: 500;
    letter-spacing: clamp(0.01em, 0.2cqi, 0.04em);
    white-space: nowrap;
  }

  .pin:hover .pin__leg {
    background: var(--accent);
  }

  .pin:focus-visible {
    outline: none;
  }

  .pin:focus-visible .pin__nm {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
    border-radius: var(--radius-2);
  }

  .pin[aria-pressed='true'] .pin__leg {
    background: var(--rose);
  }

  .pin[aria-pressed='true'] .pin__nm {
    color: var(--rose-ink);
  }

  :global([data-theme='dark']) .pin[aria-pressed='true'] .pin__nm {
    color: var(--rose);
  }

  @container ds (max-width: 790px) {
    .dip__body {
      min-height: 452px;
    }
  }


  /* ---- The tray: the pressed pin's print and its note ---- */
  /* The tray is as tall as what is in it, so the sheet follows its tallest column. */
  .tray {
    position: relative;
    scroll-margin-top: 5rem;
  }

  .slip {
    position: relative;
    display: flex;
    transform-origin: 0 50%;
  }

  .slip[hidden] {
    display: none;
  }

  /* Slides out of the chip. Only when motion is welcome. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-motion='reduce'])) .slip.is-in {
      animation: slideout 0.55s cubic-bezier(0.2, 0.75, 0.2, 1);
    }
  }

  @keyframes slideout {
    from {
      opacity: 0;
      transform: translateX(-90px) scale(0.7) rotate(-9deg);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  /* The print (or FAIRE's two) and, beside it, the note taped to the sheet with a small gap: nothing
     covers a photo or a caption. Where the tray is too narrow for both, the note drops under the
     print, again with a gap. The tilts are small enough that the gaps hold. */
  .slip {
    flex-flow: row wrap;
    align-items: flex-start;
    gap: 24px 22px;
  }

  .slip__prints {
    display: flex;
    flex: 0 1 260px;
    align-items: flex-start;
    gap: 12px;
    min-width: 0;
  }

  .slip :global(.slip__print) {
    position: relative;
    width: 100%;
  }

  /* FAIRE: the two prints side by side, the pirate print smaller and a little lower, a gap between
     their frames. */
  .slip--two .slip__prints {
    flex-basis: 380px;
  }

  .slip--two :global(.slip__print) {
    width: 58%;
  }

  .slip :global(.slip__mini) {
    width: 39%;
    margin-top: 40px;
  }

  /* The note: lined paper, taped on, in Kalam. */
  .note {
    position: relative;
    flex: 1 1 210px;
    max-width: 280px;
    margin-top: 14px;
    padding: 14px 18px 16px;
    transform: rotate(2.5deg);
    background: var(--note-paper) repeating-linear-gradient(var(--note-paper) 0 27px, var(--note-line) 27px 28px);
    box-shadow: 0 10px 22px rgb(30 15 40 / 0.18);
  }

  .note::before {
    content: '';
    position: absolute;
    top: -11px;
    left: 56%;
    width: 78px;
    height: 22px;
    transform: rotate(-5deg);
    background: repeating-linear-gradient(45deg, #c6b0ea 0 8px, rgb(255 255 255 / 0.45) 8px 12px);
    opacity: 0.85;
  }

  .note__meta {
    display: block;
    margin-bottom: 2px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--note-meta);
  }

  .note__text {
    margin: 0;
    font-family: var(--font-hand);
    font-size: 17px;
    line-height: 28px;
    color: var(--note-ink);
  }

  .note__text a {
    color: var(--note-title);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .note__text a:focus-visible {
    outline: 2px solid var(--note-title);
    outline-offset: 2px;
  }

  /* Phones: the note under the print, as wide as the tray allows. */
  @container ds (max-width: 440px) {
    .note {
      max-width: none;
    }

    .slip__prints {
      flex-basis: min(240px, 100%);
    }

    .slip--two .slip__prints {
      flex-basis: 100%;
    }
  }

  /* ---- Characteristics ---- */
  .ch {
    width: 100%;
    border-collapse: collapse;
    border-top: 1px solid var(--line);
  }

  .ch__cap {
    padding: 0 0 0.625rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-18);
    text-align: left;
    color: var(--muted);
  }

  .ch tr {
    border-top: 1px solid var(--line);
  }

  .ch th,
  .ch td {
    padding: 0.7rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }

  .ch th {
    width: 13rem;
    font-family: var(--font-mono);
    font-size: var(--fs-13);
    font-weight: 400;
    line-height: 1.5;
    color: var(--muted);
  }

  /* The pins a row is about, by number, so the chip and the table read as one document. */
  .ch__pins {
    display: block;
    margin-top: 0.15rem;
    font-size: var(--fs-12);
    color: var(--accent-ink);
  }

  .ch td {
    font-size: var(--fs-15);
    line-height: 1.45;
  }

  .ch tr.is-on {
    border-top-color: var(--rose);
    background: var(--accent-wash-strong);
  }

  .ch tr.is-on th {
    color: var(--text);
  }

  @container ds (max-width: 440px) {
    .ch th {
      width: 8.5rem;
      padding-inline: 0.5rem;
    }

    .ch td {
      padding-inline: 0.5rem;
    }
  }
</style>
