---
import Terms from '@/components/Terms.astro';
// Recommendations on About, as a full-width deep green band right after "The longer version" (it
// breaks up the light page): each approved quote large on a lighter green card, with who said it.
// Light mode: the band is #0e2a22 with cards at #133a2f; dark mode lifts it to #15342a (cards
// #1c4135) so it still reads as a band against the dark page. Text pairs, lowest first: muted
// #9db0a6 on the dark card 4.95:1, the accent #7fd6a8 6.5:1, ink #e6efea 9.6:1. Only quotes their writers approved render (see
// docs/CONTENT-GUIDE.md); with none, the band does not render at all.
import testimonials from '@/data/testimonials.json';

const quotes = testimonials.filter((t) => t.approved);
---

{
  quotes.length > 0 && (
    <section id="recommendations" class="pq band-deep" aria-labelledby="pq-title">
      <div class="wrap">
        <h2 id="pq-title" class="pq__title">Recommendations</h2>
        <ul class="pq__list">
          {quotes.map((t) => (
            <li>
              <figure class="pq__item">
                <blockquote class="pq__quote">
                  <p>“{t.quote}”</p>
                </blockquote>
                <figcaption class="pq__who">
                  <span class="pq__name">{t.name}</span>
                  <span><Terms text={t.title} /></span>
                  <span class="pq__ctx">{t.context}</span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .pq {
    --pq-band: #0e2a22;
    --pq-card: #133a2f;
    margin: 0;
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
    background: var(--pq-band);
  }

  :global([data-theme='dark']) .pq {
    --pq-band: #15342a;
    --pq-card: #1c4135;
  }

  .pq__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.6vw, 2.75rem);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--deep-ink);
  }

  .pq__list {
    display: grid;
    gap: 1.5rem 2rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 960px) {
    .pq__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .pq__item {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    height: 100%;
    margin: 0;
    padding: clamp(1.25rem, 2.4vw, 2rem);
    border: 1px solid var(--deep-line);
    border-left: 3px solid var(--deep-accent);
    border-radius: 4px;
    background: var(--pq-card);
  }

  .pq__quote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .pq__quote {
    color: var(--deep-ink);
  }

  .pq__who {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-top: auto;
    font-size: 0.9375rem;
    color: var(--deep-ink);
  }

  .pq__name {
    font-weight: 700;
    color: var(--deep-accent);
  }

  .pq__ctx {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--deep-muted);
  }
</style>
