---
// The bit girl's canvas: fixed over the whole viewport, under the sticky header, never taking a
// click and hidden from assistive tech (she is decoration). The page marks her perches with
// data-perch attributes; src/scripts/bit-girl.ts explains them. Used on home, About and Research.
---

<canvas class="bit-girl" aria-hidden="true" data-bit-girl></canvas>

<style>
  .bit-girl {
    position: fixed;
    inset: 0;
    z-index: 39;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  @media print {
    .bit-girl {
      display: none;
    }
  }
</style>

<script>
  import { mountBitGirl } from '../scripts/bit-girl';
  // She arrives once the page has loaded and the browser is idle, so she never competes with it.
  const go = () => document.querySelectorAll<HTMLCanvasElement>('[data-bit-girl]').forEach(mountBitGirl);
  const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(go, { timeout: 2000 }) : setTimeout(go, 300));
  if (document.readyState === 'complete') idle();
  else addEventListener('load', idle, { once: true });
</script>
