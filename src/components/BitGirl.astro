---
// The bit girl's canvas: fixed over the whole viewport, under the sticky header, never taking a
// click and hidden from assistive tech (she is decoration). The page marks her perches with
// data-perch attributes; src/scripts/bit-girl.ts explains them. Used on home, About and Research.
---

<canvas class="bit-girl" aria-hidden="true" data-bit-girl></canvas>

<style>
  .bit-girl {
    position: fixed;
    inset: 0;
    z-index: 39;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  @media print {
    .bit-girl {
      display: none;
    }
  }
</style>

<script>
  import { mountBitGirl } from '../scripts/bit-girl';
  // She arrives once the page has loaded and the visitor first scrolls, touches, moves the pointer or
  // presses a key, in the browser's next idle moment: picking a perch measures the page's text, so a
  // page nobody is using yet never pays for it.
  let gone = false;
  const go = () => {
    if (gone) return;
    gone = true;
    document.querySelectorAll<HTMLCanvasElement>('[data-bit-girl]').forEach(mountBitGirl);
  };
  const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(go, { timeout: 600 }) : setTimeout(go, 100));
  const engage = () => {
    for (const ev of EVENTS) removeEventListener(ev, engage);
    if (document.readyState === 'complete') idle();
    else addEventListener('load', idle, { once: true });
  };
  const EVENTS = ['scroll', 'pointermove', 'pointerdown', 'touchstart', 'keydown', 'wheel'];
  for (const ev of EVENTS) addEventListener(ev, engage, { passive: true });
</script>
