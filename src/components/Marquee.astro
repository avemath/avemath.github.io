---
// The deep strip under the hero: project names and client domains, scrolling slowly. It is
// decoration, hidden from screen readers (every name is in the page below), and it holds still
// with reduced motion.
import { getProjects, isWebsite } from '@/lib/projects';
import { displayUrl } from '@/lib/format';

const domains = (await getProjects())
  .filter((p) => isWebsite(p) && p.data.links.live && p.data.client?.permission && !p.data.links.live.includes('github.io'))
  .map((p) => displayUrl(p.data.links.live!));
const items = [
  '30 lb combat robot',
  'V2V collision warning over OFDM',
  'bellhopSim ray tracing',
  'FH-BFSK playground',
  '16 by 16 LED spectrum',
  'Acoustic pool alarm, in progress',
  ...domains,
];
---

<div class="mq band-deep" aria-hidden="true">
  <div class="mq__track">
    {[0, 1].map(() => <ul class="mq__list">{items.map((t) => <li data-title>{t}</li>)}</ul>)}
  </div>
</div>

<style>
  .mq {
    overflow: hidden;
    border-block: 1px solid var(--deep-line);
    background: var(--deep);
    color: var(--deep-ink);
  }

  .mq__track {
    display: flex;
    width: max-content;
    animation: mq 60s linear infinite;
  }

  .mq__list {
    display: flex;
    flex: none;
  }

  /* Light ink on the deep band, in mono like the plate labels. */
  /* About 1.2 times the original 15px: 18px up to 1920 wide, in px so the large-screen root
     scaling does not stack on top, then a gentle rise to 21px at 2560. The band follows the text. */
  .mq__list li {
    padding: 0.7em 1.4em;
    font-family: var(--font-mono);
    font-size: clamp(18px, calc(18px + (100vw - 1920px) * 0.0047), 21px);
    font-weight: 500;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .mq__list li::after {
    content: '·';
    margin-left: 2.8em;
    color: var(--deep-accent);
  }

  /* Hovering holds it still, so a name can be read. */
  .mq:hover .mq__track {
    animation-play-state: paused;
  }

  @keyframes mq {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mq__track {
      animation: none;
    }
  }

  :global(html[data-motion='reduce']) .mq__track {
    animation: none;
  }
</style>
