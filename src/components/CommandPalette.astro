---
import { getProjects, projectHref, typeLabels } from '@/lib/projects';
import site from '@/data/site.json';
import testimonials from '@/data/testimonials.json';

const projects = await getProjects();
const onHome = Astro.url.pathname === '/';
// The Recommendations section only renders once a quote is approved (see Testimonials.astro).
const hasRecommendations = testimonials.some((t) => t.approved);

type Item = { id: string; group: string; label: string; hint?: string; href?: string; action?: string; keywords?: string };

const homeSections: Item[] = [
  ['featured', 'Featured work'],
  ['websites', "Websites I've built"],
  ['research', 'Research'],
  ['experience', 'Experience'],
  ['recommendations', 'Recommendations'],
  ['skills', 'Skills'],
  ['field-notes', 'Field notes'],
  ['contact', 'Contact'],
]
  .filter(([id]) => id !== 'recommendations' || hasRecommendations)
  .map(([id, label]) => ({ id: `s-${id}`, group: 'On this page', label, href: onHome ? `#${id}` : `/#${id}` }));

const items: Item[] = [
  { id: 'p-home', group: 'Pages', label: 'Home', href: '/' },
  { id: 'p-work', group: 'Pages', label: 'All work', href: '/work/', keywords: 'projects portfolio' },
  { id: 'p-services', group: 'Pages', label: 'Services', href: '/services/', keywords: 'hire website freelance pricing' },
  { id: 'p-about', group: 'Pages', label: 'About', href: '/about/' },
  { id: 'p-resume', group: 'Pages', label: 'Résumé', href: '/resume/', keywords: 'resume cv' },
  { id: 'p-contact', group: 'Pages', label: 'Contact', href: '/contact/', keywords: 'email message' },
  ...homeSections,
  ...projects.map((p) => ({
    id: `w-${p.id}`,
    group: 'Projects',
    label: p.data.title,
    hint: typeLabels[p.data.type],
    href: projectHref(p),
    keywords: [p.data.short, p.data.summary, p.data.outcome, ...p.data.keywords, ...p.data.stack, ...p.data.tags].filter(Boolean).join(' '),
  })),
  { id: 'a-theme', group: 'Actions', label: 'Switch light or dark theme', action: 'theme', keywords: 'dark light mode' },
  { id: 'a-motion', group: 'Actions', label: 'Turn reduced motion on or off', action: 'motion', keywords: 'animation accessibility' },
  { id: 'a-email', group: 'Actions', label: 'Copy my email address', hint: site.email, action: 'copy-email', keywords: 'mail contact' },
  { id: 'a-pdf', group: 'Actions', label: 'Download résumé PDF', href: site.resumePdf, action: 'download', keywords: 'resume cv pdf' },
  { id: 'a-gh', group: 'Actions', label: 'Open GitHub', href: site.socials.github, keywords: 'code repos' },
  { id: 'a-li', group: 'Actions', label: 'Open LinkedIn', href: site.socials.linkedin },
];
---

<dialog class="palette" data-palette data-email={site.email} aria-label="Jump to a page, project or action">
  <div class="palette__box" role="presentation">
    <div class="palette__search">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75"
        ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg
      >
      <input
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-list"
        aria-autocomplete="list"
        aria-label="Search pages, projects and actions"
        placeholder="Search pages, projects and actions"
        autocomplete="off"
        spellcheck="false"
        data-palette-input
      />
      <button type="button" class="palette__esc" data-palette-close>Esc</button>
    </div>
    <ul id="palette-list" role="listbox" class="palette__list" data-palette-list aria-label="Results">
      {
        items.map((item) => (
          <li
            id={item.id}
            role="option"
            aria-selected="false"
            data-group={item.group}
            data-href={item.href}
            data-action={item.action}
            data-search={`${item.label} ${item.hint ?? ''} ${item.keywords ?? ''} ${item.group}`.toLowerCase()}
          >
            <span class="palette__label">{item.label}</span>
            {item.hint && <span class="palette__hint">{item.hint}</span>}
            <span class="palette__group">{item.group}</span>
          </li>
        ))
      }
    </ul>
    <p class="palette__empty" data-palette-empty hidden>Nothing matches that. Try "website" or "radio".</p>
    <p class="palette__foot" aria-hidden="true"><kbd>↑</kbd><kbd>↓</kbd> move <kbd>Enter</kbd> open <kbd>Esc</kbd> close</p>
    <p class="sr-only" aria-live="polite" data-palette-status></p>
  </div>
</dialog>

<style>
  .palette {
    width: min(40rem, calc(100vw - 2rem));
    max-height: min(34rem, calc(100dvh - 4rem));
    margin: 10vh auto auto;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 1rem;
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-lift);
    overflow: hidden;
  }

  .palette[open] {
    display: flex;
  }

  .palette::backdrop {
    background: rgb(4 8 16 / 0.55);
    backdrop-filter: blur(3px);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-motion='reduce'])) .palette[open] {
      animation: palette-in 0.22s var(--ease-out-expo);
    }
  }

  @keyframes palette-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }

  .palette__box {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 0;
  }

  .palette__search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--line);
  }

  .palette__search svg {
    width: 1.15rem;
    height: 1.15rem;
    color: var(--muted);
    flex: none;
  }

  .palette__search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    font-size: 1rem;
    outline: none;
  }

  .palette__esc {
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
    cursor: pointer;
  }

  .palette__list {
    flex: 1;
    overflow-y: auto;
    padding: 0.4rem;
    overscroll-behavior: contain;
  }

  .palette__list li {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    column-gap: 1rem;
    padding: 0.6rem 0.75rem;
    border-radius: 0.6rem;
    cursor: pointer;
  }

  .palette__list li[aria-selected='true'] {
    background: var(--accent-wash);
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .palette__label {
    font-size: 0.95rem;
  }

  .palette__hint {
    grid-column: 1;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .palette__group {
    grid-column: 2;
    grid-row: 1 / span 2;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .palette__empty {
    padding: 1.5rem 1rem;
    color: var(--muted);
    text-align: center;
  }

  .palette__foot {
    display: flex;
    gap: 0.35rem;
    align-items: center;
    padding: 0.6rem 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .palette__foot kbd {
    padding: 0 0.35rem;
    border: 1px solid var(--line);
    border-radius: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .palette__foot kbd + kbd {
    margin-left: -0.15rem;
  }

  @media (hover: none) {
    .palette__foot {
      display: none;
    }
  }
</style>

<script>
  import { toggleTheme, toggleReducedMotion } from '../scripts/preferences';

  const dialog = document.querySelector<HTMLDialogElement>('[data-palette]')!;
  const input = dialog.querySelector<HTMLInputElement>('[data-palette-input]')!;
  const options = [...dialog.querySelectorAll<HTMLLIElement>('[role=option]')];
  const empty = dialog.querySelector<HTMLElement>('[data-palette-empty]')!;
  const status = dialog.querySelector<HTMLElement>('[data-palette-status]')!;
  const email = dialog.dataset.email ?? '';
  let opener: HTMLElement | null = null;
  let visible = options;
  let active = 0;

  function select(i: number) {
    if (!visible.length) return;
    active = (i + visible.length) % visible.length;
    visible.forEach((o, n) => o.setAttribute('aria-selected', String(n === active)));
    const el = visible[active];
    input.setAttribute('aria-activedescendant', el.id);
    el.scrollIntoView({ block: 'nearest' });
  }

  function filter() {
    const terms = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    visible = options.filter((o) => {
      const hay = o.dataset.search ?? '';
      const show = terms.every((t) => hay.includes(t));
      o.hidden = !show;
      return show;
    });
    empty.hidden = visible.length > 0;
    status.textContent = `${visible.length} result${visible.length === 1 ? '' : 's'}`;
    select(0);
  }

  function open() {
    if (dialog.open) return;
    opener = document.activeElement as HTMLElement;
    input.value = '';
    filter();
    dialog.showModal();
    input.focus();
  }

  function close() {
    dialog.close();
  }

  // Return focus to whatever opened the palette. If that was inside the phone menu, which
  // closes itself, focus the menu button instead so focus never drops to the page body.
  dialog.addEventListener('close', () => {
    if (!opener) return;
    const folded = opener.closest('details');
    if (folded && !folded.open) folded.querySelector<HTMLElement>('summary')?.focus();
    else opener.focus();
  });

  async function run(el: HTMLLIElement) {
    const { href, action } = el.dataset;
    if (action === 'theme') toggleTheme();
    else if (action === 'motion') toggleReducedMotion();
    else if (action === 'copy-email') {
      try {
        await navigator.clipboard.writeText(email);
        status.textContent = 'Email address copied';
        el.querySelector('.palette__label')!.textContent = 'Copied. Paste it anywhere.';
        setTimeout(close, 700);
        return;
      } catch {
        window.location.href = `mailto:${email}`;
      }
    } else if (action === 'download' && href) {
      const a = Object.assign(document.createElement('a'), { href, download: '' });
      a.click();
    } else if (href) {
      close();
      if (href.startsWith('#')) {
        const target = document.querySelector<HTMLElement>(href);
        target?.scrollIntoView();
        target?.setAttribute('tabindex', '-1');
        target?.focus({ preventScroll: true });
        history.replaceState(null, '', href);
      } else if (/^https?:/.test(href)) window.open(href, '_blank', 'noopener');
      else window.location.href = href;
      return;
    }
    close();
  }

  input.addEventListener('input', filter);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') (e.preventDefault(), select(active + 1));
    else if (e.key === 'ArrowUp') (e.preventDefault(), select(active - 1));
    else if (e.key === 'Home' && e.ctrlKey) (e.preventDefault(), select(0));
    else if (e.key === 'End' && e.ctrlKey) (e.preventDefault(), select(visible.length - 1));
    else if (e.key === 'Enter' && visible[active]) (e.preventDefault(), run(visible[active]));
  });

  options.forEach((o) => {
    o.addEventListener('click', () => run(o));
    o.addEventListener('mousemove', () => {
      const i = visible.indexOf(o);
      if (i !== active) select(i);
    });
  });

  // Close when the backdrop is clicked.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) close();
  });
  dialog.querySelector('[data-palette-close]')!.addEventListener('click', close);

  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-palette-open]')) open();
  });

  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dialog.open ? close() : open();
    } else if (e.key === '/' && !dialog.open) {
      const t = e.target as HTMLElement;
      if (!t.closest('input, textarea, select, [contenteditable]')) (e.preventDefault(), open());
    }
  });
</script>
