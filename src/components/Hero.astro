---
import SignalPanel from './SignalPanel.astro';
import Marquee from './Marquee.astro';
import site from '@/data/site.json';
---

<section id="top" class="hero on-navy dot-grid" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__text">
      <h1 id="hero-title" class="hero__title">{site.headline}</h1>
      <p class="hero__sub">
        M.S. student in Electrical and Computer Engineering. Research assistant on an ONR project about distributed naval platforms.
        Co-founder of Because of ADAM, a drowning awareness nonprofit.
      </p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="/work/">See my work</a>
        <a class="btn hero__resume" href={site.resumePdf}>Résumé (PDF)</a>
      </div>
    </div>

    <div class="hero__panel">
      <SignalPanel />
    </div>
  </div>
  <div class="hero__marquee"><Marquee /></div>
</section>

<style>
  /* The nav and the hero share one screen: the sentence, the subline, both buttons, the panel (on
     wide screens) and the top of the marquee fit in 100svh at 1366 by 768 and at 390 by 844. */
  .hero {
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - 4rem);
  }

  .hero__grid {
    flex: 1;
    display: grid;
    gap: 2rem;
    align-content: center;
    align-items: center;
    padding-block: clamp(1.5rem, 4vh, 3rem);
  }

  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2rem, 4vw, 4rem);
    }
  }

  .hero__title {
    font-size: clamp(34px, 4.2vw, 62px);
    line-height: 1.02;
    text-wrap: balance;
    hyphens: none;
  }

  .hero__sub {
    margin-top: 1.25rem;
    max-width: 36rem;
    font-size: 18px;
    color: var(--muted);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  /* Same weight and size as the accent button beside it, so the pair lines up. */
  .hero__resume {
    font-size: 1.1875rem;
    --btn-line: var(--on-navy);
  }

  /* The panel gives up height first when the screen is short. */
  .hero__panel :global(.sig__screen) {
    max-height: calc(100svh - 4rem - 13rem);
  }

  /* Phones and tablets: the sentence and buttons, then the marquee, then the panel, so the first
     screen ends on the marquee and the panel waits just below it. */
  @media (max-width: 1023px) {
    .hero {
      min-height: 0;
    }

    .hero__grid {
      display: contents;
    }

    .hero__text {
      order: 1;
      padding: 1.75rem var(--gutter);
    }

    .hero__marquee {
      order: 2;
    }

    .hero__panel {
      order: 3;
      padding: 1.75rem var(--gutter) 2.5rem;
    }

    .hero__panel :global(.sig__screen) {
      max-height: none;
    }
  }
</style>
