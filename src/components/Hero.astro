---
import site from '@/data/site.json';
import { CHIPS, CHIP_MS, DURATION_MS } from '@/lib/preamble';
import { F_HIGH, F_LOW, PAIRS } from '@/lib/fhbfsk';
---

<section id="top" class="hero on-navy dot-grid" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__text">
      <h1 id="hero-title" class="hero__title">{site.headline}</h1>
      <p class="hero__sub">
        M.S. student in Electrical and Computer Engineering. Research assistant on an ONR project about distributed naval platforms.
        Co-founder of Because of ADAM, a drowning awareness nonprofit.
      </p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="#projects">See the projects</a>
        <a class="btn hero__resume" href={site.resumePdf}>Résumé (PDF)</a>
      </div>
    </div>

    <figure class="sig" data-sig aria-labelledby="sig-cap">
      <div class="sig__screen" data-sig-screen>
        <canvas class="sig__canvas" aria-hidden="true"></canvas>
        <div class="sig__scope" data-sig-scope tabindex="0" role="img" aria-label={`A frequency hopping preamble: ${CHIPS} chips of ${CHIP_MS} ms, each one tone between ${F_LOW} and ${F_HIGH} Hz. Use the arrow keys to read chip by chip.`}></div>
        <span class="sig__cur sig__cur--v" data-sig-v aria-hidden="true"></span>
        <span class="sig__cur sig__cur--h" data-sig-h aria-hidden="true"></span>
        <p class="sig__read mono" data-sig-read aria-hidden="true"></p>
        <p class="sig__cap mono" id="sig-cap">FH-BFSK preamble, JANUS band, 2 kHz / div</p>
        <p class="sig__hint" data-sig-hint>move the mouse to read the signal</p>
        <button type="button" class="sig__play" data-sig-play aria-pressed="false">
          <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 1.5v9l8-4.5z" fill="currentColor"></path></svg>
          <span data-sig-play-label>Hear it, 2 s</span>
        </button>
      </div>
      <p class="sr-only" aria-live="polite" data-sig-live></p>
      <figcaption class="sig__note">
        <span class="sig__plain">
          This is the preamble an underwater modem sends before it talks.
          <span class="sig__do sig__do--mouse">Move your mouse to read it.</span><span class="sig__do sig__do--touch">Tap Hear it to listen.</span>
        </span>
        <span class="sig__tech">
          {DURATION_MS} ms on air, played ten times slower. The band, the {PAIRS} tone pairs and the chip length follow JANUS, the NATO
          standard for underwater modems; the hop order is the playground's own.
        </span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 4.5vw, 4rem) clamp(3rem, 6vw, 4.5rem);
  }

  .hero__grid {
    display: grid;
    gap: 2.75rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2rem, 4vw, 4rem);
    }
  }

  /* About 84px on a wide screen. Archivo at width 112 is wide, so phones get a size that keeps
     "communication" on one line at 390px. */
  .hero__title {
    font-size: clamp(2.3rem, 1.2rem + 5.2vw, 5.25rem);
    text-wrap: initial;
    hyphens: none;
  }

  .hero__sub {
    margin-top: 1.75rem;
    max-width: 36rem;
    font-size: 1.0625rem;
    color: var(--muted);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* Same weight and size as the accent button beside it, so the pair lines up. */
  .hero__resume {
    font-size: 1.1875rem;
    --btn-line: var(--on-navy);
  }

  /* ---- The signal panel ---- */
  .sig {
    margin: 0;
    min-width: 0;
  }

  .sig__screen {
    position: relative;
    aspect-ratio: 5 / 4;
    border: 1px solid var(--line);
    background: rgb(4 12 24 / 0.35);
    overflow: hidden;
    touch-action: pan-y;
  }

  /* The focusable layer over the plot, for reading it by keyboard. The button sits above it. */
  .sig__scope {
    position: absolute;
    inset: 0;
  }

  .sig__scope:focus-visible {
    outline-offset: -3px;
  }

  .sig__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .sig__cur {
    position: absolute;
    display: none;
    pointer-events: none;
    background: rgb(244 246 250 / 0.7);
  }

  .sig__cur--v {
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
  }

  .sig__cur--h {
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
  }

  .sig__screen[data-reading] .sig__cur {
    display: block;
  }

  .sig__read {
    position: absolute;
    top: 0;
    left: 0;
    display: none;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--on-navy-line-strong);
    background: var(--navy);
    font-size: 0.75rem;
    line-height: 1.45;
    white-space: pre;
    color: var(--on-navy);
    pointer-events: none;
    font-variant-numeric: tabular-nums;
  }

  .sig__screen[data-reading] .sig__read {
    display: block;
  }

  .sig__cap,
  .sig__hint {
    position: absolute;
    left: 0.75rem;
    font-size: 0.75rem;
    color: var(--muted);
    pointer-events: none;
  }

  .sig__cap {
    top: 0.6rem;
  }

  .sig__hint {
    bottom: 0.85rem;
  }

  /* Touch screens have no cursors to move. */
  @media (hover: none) {
    .sig__hint {
      visibility: hidden;
    }
  }

  .sig__play {
    position: absolute;
    z-index: 1;
    right: 0.75rem;
    bottom: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0.35rem 0.8rem;
    border: 2px solid var(--on-navy);
    background: var(--navy);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--on-navy);
    cursor: pointer;
  }

  .sig__play svg {
    width: 0.7rem;
    height: 0.7rem;
  }

  .sig__play[aria-pressed='true'] {
    border-color: var(--accent);
  }

  .sig__note {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.75rem;
    color: var(--muted);
  }

  .sig__plain {
    font-size: 0.9375rem;
  }

  .sig__tech {
    font-size: 0.8125rem;
  }

  /* The second sentence of the caption matches the device: a mouse reads, a finger listens. */
  .sig__do--touch {
    display: none;
  }

  @media (hover: none) {
    .sig__do--mouse {
      display: none;
    }

    .sig__do--touch {
      display: inline;
    }
  }
</style>

<script>
  import { mountSignalPanel } from '../scripts/signal-panel';

  // The panel draws after the first paint, so the headline is the first thing on screen.
  const fig = document.querySelector<HTMLElement>('[data-sig]');
  if (fig) requestAnimationFrame(() => setTimeout(() => mountSignalPanel(fig), 0));
</script>
