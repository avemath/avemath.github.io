---
import Icon from './Icon.astro';
import AudienceSwitcher from './AudienceSwitcher.astro';
import site from '@/data/site.json';
import { slotVars } from '@/lib/depth';
import { BIN_HZ, CHIRP, FIRST_BIN, FRAME_HZ, LEAD, LINES, SHOW_BINS, STILL, STRETCH, TEXT_BINS, VIEW_ROWS, holdFrame } from '@/lib/tx-signal';

// The still picture that shows until the live display takes over (and without JavaScript): the
// name where the live display holds it, centered, with the sweep below it. It uses the build-time
// estimate of the raster, so the cross-fade to the computed picture barely moves.
const hold = holdFrame(STILL.rows);
const top = VIEW_ROWS / 2 - STILL.rows / 2;
const mid = FIRST_BIN + TEXT_BINS / 2;
// Raster units: the group below stretches them by STRETCH in rows, as the live raster is.
const lines = LINES.map((text, i) => ({ text, y: 1 + STILL.cap + i * (STILL.cap + STILL.gap) }));
const chirp = { x1: CHIRP.f0 / BIN_HZ, y1: hold - LEAD, x2: CHIRP.f1 / BIN_HZ, y2: hold - (LEAD + CHIRP.frames) };
const kHz = [0, 1, 2, 3, 4];
const seconds = [0, 1, 2, 3, 4, 5, 6];
const rowsPerSecond = FRAME_HZ;
---

<section id="top" class="hero zone sunlit" aria-labelledby="hero-title" style={slotVars(0)}>
  <span class="spine" aria-hidden="true"></span>
  <div class="wrap hero__grid">
    <div class="hero__text">
      <p class="eyebrow" data-hero-eyebrow>{site.eyebrow}</p>
      <h1 id="hero-title" class="hero__title" data-hero-title>{site.name}</h1>
      <p class="hero__line" data-hero-line>{site.headline}</p>

      <div class="hero__ctas" data-hero-ctas>
        <a class="btn btn--primary" href="#featured" data-primary-cta>
          <span data-primary-cta-label>See my work</span>
          <Icon name="arrow-right" />
        </a>
        <a class="btn" href="/resume/" data-secondary-cta>
          <span data-secondary-cta-label>Résumé</span>
        </a>
      </div>

      <div data-hero-switcher>
        <AudienceSwitcher />
      </div>
    </div>

    <figure class="tx" data-tx>
      <div class="tx__bar">
        <p class="tx__title"><span class="tx__dot" aria-hidden="true"></span>TX · Spectrogram</p>
        <button type="button" class="tx__play" data-tx-play aria-pressed="false" hidden>
          <Icon name="volume" class="tx__icon tx__icon--on" />
          <Icon name="stop" class="tx__icon tx__icon--off" />
          <span data-tx-play-label>Hear it</span>
        </button>
      </div>
      <div class="tx__tabs" role="tablist" aria-label="Spectrogram view" data-tx-tabs>
        <button type="button" role="tab" id="tx-tab-display" aria-controls="tx-view-display" aria-selected="true" tabindex="0">Display</button>
        <button type="button" role="tab" id="tx-tab-how" aria-controls="tx-view-how" aria-selected="false" tabindex="-1">How it works</button>
      </div>
      <div class="tx__view" id="tx-view-display" role="tabpanel" aria-labelledby="tx-tab-display">
      <div class="tx__plot">
        <div class="tx__time" aria-hidden="true">
          {seconds.map((t) => <span style={`--at:${(t * rowsPerSecond) / VIEW_ROWS}`}>{t === 6 ? '6 s' : t}</span>)}
        </div>
        <div class="tx__screen" data-tx-screen>
          <svg class="tx__still" viewBox={`0 0 ${SHOW_BINS} ${VIEW_ROWS}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <g transform={`translate(0 ${top}) scale(1 ${STRETCH})`}>
              {
                lines.map((l, i) => (
                  <text x={mid} y={l.y} font-size={STILL.font} text-anchor="middle" {...(i === 1 ? { textLength: TEXT_BINS - 2, lengthAdjust: 'spacingAndGlyphs' } : {})}>
                    {l.text}
                  </text>
                ))
              }
            </g>
            <line x1={chirp.x1} y1={chirp.y1} x2={chirp.x2} y2={chirp.y2} />
          </svg>
          <canvas class="tx__canvas" width={SHOW_BINS} height={VIEW_ROWS} aria-hidden="true"></canvas>
          <span class="tx__grid" aria-hidden="true"></span>
          <span class="tx__cross" data-tx-cross aria-hidden="true" hidden></span>
        </div>
        <div class="tx__axis" aria-hidden="true">
          {kHz.map((t) => <span style={`--at:${t / 4}`}>{t === 4 ? '4 kHz' : t}</span>)}
        </div>
      </div>
      <div class="tx__foot">
        <p class="tx__readout" data-tx-readout aria-hidden="true">Point at the display to read it</p>
        <p class="sr-only" aria-live="polite" data-tx-live></p>
      </div>
      </div>
      {/* Filled in from src/scripts/how-it-works.ts the first time the tab opens. */}
      <div class="tx__view tx__how" id="tx-view-how" role="tabpanel" aria-labelledby="tx-tab-how" tabindex="0" hidden data-tx-how>
        <p class="tx__how-loading">Loading the walkthrough.</p>
      </div>
      <figcaption class="tx__caption">My name, sent as a real signal and drawn by an FFT as it arrives.</figcaption>
    </figure>
  </div>

</section>

<style>
  .hero {
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3.25rem, 7vw, 5.5rem) clamp(4.5rem, 8vw, 6.5rem);
  }

  .hero__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(2.5rem, 5vw, 4.5rem);
    }
  }

  .hero__title {
    margin-top: 1.25rem;
    font-size: clamp(3rem, 7.4vw, 5.75rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  /* On phones the name stays on one line in both the fallback and the web font, sized to the
     screen, so the font swap cannot rewrap it and push the page down. */
  @media (max-width: 639px) {
    .hero__title {
      font-size: min(3rem, calc((100vw - 2 * var(--gutter)) / 8));
      white-space: nowrap;
    }
  }

  .hero__line {
    margin-top: 1.5rem;
    max-width: 36rem;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.5;
    color: var(--text-soft);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 2.25rem;
  }

  /* ---- The transmitter's display ---- */
  .tx {
    --tx-ink: var(--accent);
    --tx-hot: var(--amber-line);
    --tx-screen: #061523;
    margin: 0;
    padding: 0.85rem 0.85rem 1rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: color-mix(in oklab, var(--surface), transparent 35%);
    box-shadow: var(--shadow);
    min-width: 0;
  }


  .tx__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    /* Room for the Hear it button before it is shown, so showing it moves nothing. */
    min-height: calc(2.25rem + 0.7rem);
    padding: 0 0.15rem 0.7rem;
  }

  .tx__title,
  .tx__readout {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .tx__title {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .tx__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--amber) 28%, transparent);
  }

  .tx__play {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.25rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .tx__play:hover {
    border-color: var(--accent);
  }

  .tx__play[aria-pressed='true'] {
    border-color: var(--amber-line);
    background: color-mix(in oklab, var(--amber) 16%, transparent);
  }

  .tx__play[hidden] {
    display: none;
  }

  .tx__play :global(.tx__icon) {
    width: 1rem;
    height: 1rem;
  }

  .tx__play :global(.tx__icon--off),
  .tx__play[aria-pressed='true'] :global(.tx__icon--on) {
    display: none;
  }

  .tx__play[aria-pressed='true'] :global(.tx__icon--off) {
    display: block;
  }

  /* Display and How it works, as tabs. They need JavaScript, so they only show once the head
     script has marked the page, before first paint. */
  .tx__tabs {
    display: none;
    gap: 0.25rem;
    margin: -0.1rem 0 0.75rem;
    padding: 0.2rem;
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    width: max-content;
    max-width: 100%;
  }

  :global(html.js) .tx__tabs {
    display: flex;
  }

  .tx__tabs button {
    min-height: 2rem;
    padding: 0.3rem 0.8rem;
    border-radius: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-soft);
    cursor: pointer;
  }

  .tx__tabs button[aria-selected='true'] {
    background: var(--accent-ink);
    color: var(--bg);
  }

  .tx__tabs button:focus-visible {
    outline: 2px solid var(--amber-line);
    outline-offset: 1px;
  }

  .tx__view[hidden] {
    display: none;
  }

  .tx__how:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .tx__how-loading {
    padding: 2rem 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  /* Time down the left (newest at the top), frequency along the bottom. */
  .tx__plot {
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr);
    grid-template-areas: 'time screen' '. freq';
  }

  /* 256 bins by 160 frames, scaled up: square pixels at this aspect ratio. */
  .tx__screen {
    grid-area: screen;
    position: relative;
    aspect-ratio: 256 / 160;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, #56b6d8 30%, transparent);
    border-radius: 0.4rem;
    background: var(--tx-screen);
    touch-action: pan-y;
    cursor: crosshair;
  }

  .tx__screen:focus-visible {
    outline-offset: 2px;
  }

  .tx__still,
  .tx__canvas,
  .tx__grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .tx__still {
    font-family: var(--font-display);
    font-weight: 600;
    fill: #4fb3c9;
    stroke: #f0a940;
    stroke-opacity: 0.8;
    stroke-width: 0.8;
    paint-order: stroke;
    transition: opacity 0.6s ease;
  }

  .tx__still text {
    stroke: none;
  }

  .tx__canvas {
    opacity: 0;
    transition: opacity 0.7s ease;
  }

  [data-live] .tx__canvas {
    opacity: 1;
  }

  [data-live] .tx__still {
    opacity: 0;
  }

  /* Between cycles the picture fades out, then the next transmission starts on quiet water. */
  .tx__screen[data-fade] .tx__canvas {
    opacity: 0;
  }

  /* A faint grid: one line per kilohertz, one per second. */
  .tx__grid {
    pointer-events: none;
    background:
      repeating-linear-gradient(90deg, rgb(150 210 230 / 0.09) 0 1px, transparent 1px 25%),
      repeating-linear-gradient(180deg, rgb(150 210 230 / 0.09) 0 1px, transparent 1px calc(100% * 16000 / 608 / 160));
  }

  .tx__cross {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(#e4f0f5, #e4f0f5) var(--x) 0 / 1px 100% no-repeat,
      linear-gradient(#e4f0f5, #e4f0f5) 0 var(--y) / 100% 1px no-repeat;
    opacity: 0.45;
  }

  .tx__axis {
    grid-area: freq;
    position: relative;
    height: 1.4rem;
    margin-top: 0.35rem;
  }

  .tx__axis span,
  .tx__time span {
    position: absolute;
    white-space: nowrap;
    text-transform: none;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .tx__axis span {
    top: 0.2rem;
    left: calc(var(--at) * 100%);
    translate: calc(var(--at) * -100%) 0;
  }

  .tx__time {
    grid-area: time;
    position: relative;
  }

  .tx__time span {
    right: 0.4rem;
    top: calc(var(--at) * 100%);
    translate: 0 calc(var(--at) * -100%);
  }

  .tx__foot {
    padding-left: 1.6rem;
    min-height: 1.3rem;
    margin-top: 0.15rem;
  }

  /* Units keep their real case: kHz and dBFS, not KHZ. */
  .tx__readout {
    text-transform: none;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    white-space: pre;
    color: var(--text-soft);
    font-variant-numeric: tabular-nums;
  }

  .tx__caption {
    margin-top: 0.6rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line);
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text-soft);
  }

  /* No entrance animation: the eyebrow, name, role line, buttons and switcher paint once, in
     their final state, so the first screen is ready as soon as the page renders. */
</style>

<script>
  import { prefersReducedMotion } from '../scripts/preferences';
  import { decode } from '../scripts/decode';
  import { whenSettled } from '../scripts/motion';

  // Tabs: Display and How it works, with arrow keys, Home and End. The walkthrough and its code
  // load only the first time its tab opens.
  const tablist = document.querySelector<HTMLElement>('[data-tx-tabs]');
  if (tablist) {
    const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    let loaded = false;
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        const on = i === j;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
      });
      if (focus) tabs[i].focus();
      const how = document.querySelector<HTMLElement>('[data-tx-how]');
      if (i === 1 && how && !loaded) {
        loaded = true;
        import('../scripts/how-it-works').then((m) => m.mountHowItWorks(how));
      }
    };
    tabs.forEach((t, i) => t.addEventListener('click', () => select(i)));
    tablist.addEventListener('keydown', (e) => {
      const at = tabs.indexOf(document.activeElement as HTMLButtonElement);
      const to = { ArrowRight: at + 1, ArrowLeft: at - 1, Home: 0, End: tabs.length - 1 }[e.key];
      if (to === undefined || at < 0) return;
      e.preventDefault();
      select((to + tabs.length) % tabs.length, true);
    });
  }

  // The first screen shows the still frame (the name centered) and stays still. The live display
  // is decorative, so its code loads only once the page has settled after the load event.
  const tx = document.querySelector<HTMLElement>('[data-tx]');
  if (tx) whenSettled(() => import('../scripts/spectrogram').then((m) => m.mountSpectrogram(tx)));

  // The eyebrow paints as plain text, then "acquires signal" once the page has settled.
  const eyebrow = document.querySelector<HTMLElement>('[data-hero-eyebrow]');
  if (eyebrow) {
    const text = eyebrow.textContent ?? '';
    whenSettled(() => !prefersReducedMotion() && decode(eyebrow, text, 1100));
  }
</script>
