---
import Icon from './Icon.astro';
import AudienceSwitcher from './AudienceSwitcher.astro';
import site from '@/data/site.json';
import { bitmap, BINS, BIN_HZ, BINS_PER_COL, CHIRP, FIRST_BIN, FRAMES_PER_ROW, NAME_START, STILL_TOP, VIEW_ROWS } from '@/lib/tx-signal';

// The still picture that shows until the live display takes over (and without JavaScript). It
// is laid out from the same plan the signal is built from, at the same place the live display
// opens on, so the swap is a cross-fade and nothing moves.
const rows = bitmap();
const still: { x: number; y: number; w: number }[] = [];
rows.forEach((row, r) => {
  const sent = rows.length - 1 - r;
  const y = STILL_TOP - (NAME_START + sent * FRAMES_PER_ROW + FRAMES_PER_ROW - 1);
  let c = 0;
  while (c < row.length) {
    if (!row[c]) {
      c++;
      continue;
    }
    const from = c;
    while (row[c]) c++;
    still.push({ x: FIRST_BIN + from * BINS_PER_COL, y, w: (c - from) * BINS_PER_COL });
  }
});
const chirp = {
  x1: CHIRP.f0 / BIN_HZ,
  y1: STILL_TOP - CHIRP.start,
  x2: CHIRP.f1 / BIN_HZ,
  y2: STILL_TOP - (CHIRP.start + CHIRP.frames),
};
const ticks = [0, 2, 4, 6, 8];
---

<section id="top" class="hero zone" aria-labelledby="hero-title" style={`--tag:"0 m · Surface"`}>
  <div class="wrap hero__grid">
    <div class="hero__text">
      <p class="eyebrow" data-hero-eyebrow>{site.eyebrow}</p>
      <h1 id="hero-title" class="hero__title" data-hero-title>{site.name}</h1>
      <p class="hero__line" data-hero-line>{site.headline}</p>

      <div class="hero__ctas" data-hero-ctas>
        <a class="btn btn--primary" href="#featured" data-primary-cta>
          <span data-primary-cta-label>See my work</span>
          <Icon name="arrow-right" />
        </a>
        <a class="btn" href="/resume/" data-secondary-cta>
          <span data-secondary-cta-label>Résumé</span>
        </a>
      </div>

      <div data-hero-switcher>
        <AudienceSwitcher />
      </div>
    </div>

    <figure class="tx" data-tx>
      <div class="tx__bar">
        <p class="tx__title"><span class="tx__dot" aria-hidden="true"></span>TX · Spectrogram</p>
        <button type="button" class="tx__play" data-tx-play aria-pressed="false" hidden>
          <Icon name="volume" class="tx__icon tx__icon--on" />
          <Icon name="stop" class="tx__icon tx__icon--off" />
          <span data-tx-play-label>Hear it</span>
        </button>
      </div>
      <div class="tx__screen" data-tx-screen>
        <svg class="tx__still" viewBox={`0 0 ${BINS} ${VIEW_ROWS}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
          {still.map((s) => <rect x={s.x} y={s.y} width={s.w} height={FRAMES_PER_ROW} />)}
          <line x1={chirp.x1} y1={chirp.y1} x2={chirp.x2} y2={chirp.y2} />
        </svg>
        <canvas class="tx__canvas" width={BINS} height={VIEW_ROWS} aria-hidden="true"></canvas>
        <span class="tx__cross" data-tx-cross aria-hidden="true" hidden></span>
      </div>
      <div class="tx__axis" aria-hidden="true">
        {ticks.map((t) => <span style={`--at:${t / 8}`}>{t === 8 ? '8 kHz' : t}</span>)}
      </div>
      <div class="tx__foot">
        <p class="tx__readout" data-tx-readout aria-hidden="true">Point at the display to read it</p>
        <p class="sr-only" aria-live="polite" data-tx-live></p>
      </div>
      <figcaption class="tx__caption">
        My name, sent as sound. Each row of the letters is one OFDM symbol, after a chirp to sync on, and the display is an FFT of
        that signal as it plays.
      </figcaption>
    </figure>
  </div>

  <svg class="hero__wave" viewBox="0 0 1440 48" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d="M0 26C180 10 300 10 480 24S780 42 960 28 1260 8 1440 22V48H0Z"></path>
  </svg>
</section>

<style>
  .hero {
    overflow: hidden;
    padding-block: clamp(3.25rem, 7vw, 5.5rem) clamp(4.5rem, 8vw, 6.5rem);
  }

  .hero__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(2.5rem, 5vw, 4.5rem);
    }
  }

  .hero__title {
    margin-top: 1.25rem;
    font-size: clamp(3rem, 7.4vw, 5.75rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  /* On phones the name stays on one line in both the fallback and the web font, sized to the
     screen, so the font swap cannot rewrap it and push the page down. */
  @media (max-width: 639px) {
    .hero__title {
      font-size: min(3rem, calc((100vw - 2 * var(--gutter)) / 8));
      white-space: nowrap;
    }
  }

  .hero__line {
    margin-top: 1.5rem;
    max-width: 36rem;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.5;
    color: var(--text-soft);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 2.25rem;
  }

  /* The soft wave into the Now strip, in the next band's shade. */
  .hero__wave {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: clamp(1.5rem, 3vw, 3rem);
    fill: color-mix(in oklab, var(--z-top), var(--z-floor) calc(100% / 11));
    pointer-events: none;
  }

  /* ---- The transmitter's display ---- */
  .tx {
    --tx-ink: var(--accent);
    --tx-hot: var(--amber-line);
    --tx-screen: var(--surface);
    margin: 0;
    padding: 0.85rem 0.85rem 1rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: color-mix(in oklab, var(--surface), transparent 35%);
    box-shadow: var(--shadow);
    min-width: 0;
  }

  :global([data-theme='dark']) .tx {
    --tx-screen: color-mix(in oklab, var(--bg), #000 45%);
  }

  .tx__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    /* Room for the Hear it button before it is shown, so showing it moves nothing. */
    min-height: calc(2.25rem + 0.7rem);
    padding: 0 0.15rem 0.7rem;
  }

  .tx__title,
  .tx__axis,
  .tx__readout {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .tx__title {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .tx__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--amber) 28%, transparent);
  }

  .tx__play {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.25rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .tx__play:hover {
    border-color: var(--accent);
  }

  .tx__play[aria-pressed='true'] {
    border-color: var(--amber-line);
    background: color-mix(in oklab, var(--amber) 16%, transparent);
  }

  .tx__play[hidden] {
    display: none;
  }

  .tx__play :global(.tx__icon) {
    width: 1rem;
    height: 1rem;
  }

  .tx__play :global(.tx__icon--off),
  .tx__play[aria-pressed='true'] :global(.tx__icon--on) {
    display: none;
  }

  .tx__play[aria-pressed='true'] :global(.tx__icon--off) {
    display: block;
  }

  /* 256 bins by 160 frames, scaled up: square pixels at this aspect ratio. */
  .tx__screen {
    position: relative;
    aspect-ratio: 256 / 160;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: var(--tx-screen);
    touch-action: pan-y;
    cursor: crosshair;
  }

  .tx__screen:focus-visible {
    outline-offset: 2px;
  }

  .tx__still,
  .tx__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .tx__still {
    fill: var(--tx-ink);
    fill-opacity: 0.85;
    stroke: var(--tx-ink);
    stroke-opacity: 0.7;
    stroke-width: 1.2;
    transition: opacity 0.6s ease;
  }

  .tx__canvas {
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  [data-live] .tx__canvas {
    opacity: 1;
  }

  [data-live] .tx__still {
    opacity: 0;
  }

  .tx__cross {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(var(--text), var(--text)) var(--x) 0 / 1px 100% no-repeat,
      linear-gradient(var(--text), var(--text)) 0 var(--y) / 100% 1px no-repeat;
    opacity: 0.35;
  }

  .tx__axis {
    position: relative;
    height: 1.4rem;
    margin-top: 0.35rem;
  }

  .tx__axis span {
    position: absolute;
    top: 0.2rem;
    left: calc(var(--at) * 100%);
    translate: calc(var(--at) * -100%) 0;
    white-space: nowrap;
    text-transform: none;
    font-size: 0.66rem;
    letter-spacing: 0.06em;
  }

  .tx__axis span::before {
    content: '';
    position: absolute;
    top: -0.3rem;
    left: calc(var(--at) * 100%);
    width: 1px;
    height: 0.25rem;
    background: var(--line-strong);
  }

  .tx__foot {
    min-height: 1.3rem;
    margin-top: 0.15rem;
  }

  /* Units keep their real case: kHz and dBFS, not KHZ. */
  .tx__readout {
    text-transform: none;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    white-space: pre;
    color: var(--text-soft);
    font-variant-numeric: tabular-nums;
  }

  .tx__caption {
    margin-top: 0.6rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line);
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text-soft);
  }

  /* Entrance: CSS only, so nothing waits on JavaScript. The headline and line
     never start invisible, which keeps Largest Contentful Paint fast. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-motion='reduce'])) .hero__title {
      animation: settle 1.1s var(--ease-out-expo) both;
    }

    :global(html:not([data-motion='reduce'])) .hero__line {
      animation: settle 1.1s 0.08s var(--ease-out-expo) both;
    }

    :global(html:not([data-motion='reduce'])) .hero__ctas {
      animation: rise 0.9s 0.25s var(--ease-out-expo) both;
    }

    :global(html:not([data-motion='reduce'])) [data-hero-switcher] {
      animation: rise 0.9s 0.38s var(--ease-out-expo) both;
    }
  }

  @keyframes settle {
    from {
      translate: 0 0.35em;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 12px;
    }
  }
</style>

<script>
  import { prefersReducedMotion } from '../scripts/preferences';
  import { decode } from '../scripts/decode';

  // The live display is decorative, so its code loads only once the page has done its real work.
  const tx = document.querySelector<HTMLElement>('[data-tx]');
  if (tx) {
    const mount = () => import('../scripts/spectrogram').then((m) => m.mountSpectrogram(tx));
    if ('requestIdleCallback' in window) requestIdleCallback(mount, { timeout: 2000 });
    else setTimeout(mount, 400);
  }

  // The eyebrow "acquires signal" once the page is idle.
  const eyebrow = document.querySelector<HTMLElement>('[data-hero-eyebrow]');
  if (eyebrow && !prefersReducedMotion()) {
    const text = eyebrow.textContent ?? '';
    const run = () => decode(eyebrow, text, 1100);
    if ('requestIdleCallback' in window) requestIdleCallback(run, { timeout: 1200 });
    else setTimeout(run, 500);
  }
</script>
