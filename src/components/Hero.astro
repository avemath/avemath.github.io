---
// The home hero: the name in Bodoni with the surname in green italic, the thesis, the lede, and
// Plate I beside it, the eigenray specimen (src/scripts/eigenrays.ts). The h1 is the largest thing on first paint, so it is the
// LCP element; the canvas draws after the browser is idle. Under the buttons, the signal panel: the
// preamble an underwater modem sends, read with scope cursors and heard with Hear it.
import site from '@/data/site.json';
import SignalPanel from './SignalPanel.astro';
---

<section id="top" class="hero band-paper topo" aria-labelledby="hero-title">
  <span class="plankton" aria-hidden="true"></span>
  <div class="wrap hero__grid">
    <div class="hero__text">
      <h1 id="hero-title" class="hero__title">Avery <em>Matherne</em></h1>
      <p class="hero__thesis">I study how sound travels through water.</p>
      <p class="hero__sub">
        M.S. student in Electrical and Computer Engineering. Research assistant on an ONR project about distributed naval platforms.
        Co-founder of Because of ADAM, a drowning awareness nonprofit.
      </p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="/work/">See my work</a>
        <a class="btn" href={site.resumePdf}>Résumé (PDF)</a>
      </div>
      <div class="hero__sig"><SignalPanel /></div>
    </div>

    <figure class="plate hero__plate">
      <div class="plate__head"><span>Plate I</span><span>bellhopSim</span></div>
      <div class="hero__cwrap">
        <canvas
          class="hero__rays"
          data-eigenrays
          tabindex="0"
          role="img"
          aria-label="Interactive 3D drawing of sound rays fanning out from a source at 1000 meters depth, bending around the sound channel axis near 1300 meters. Drag or use the arrow keys to rotate."
        ></canvas>
        <span class="hand hero__note hero__note--tr" aria-hidden="true">sound bends toward the slow water</span>
        <span class="hand hero__note hero__note--bl" aria-hidden="true">drag me around ♡</span>
      </div>
      <figcaption class="plate__cap">
        <b>Fig. 1.</b> Eigenrays from a source at 1000 m, Munk sound speed profile, 100 km of range. The gold curve is sound speed; its slowest
        point, near 1300 m, traps the rays in a channel.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-block: clamp(1.75rem, 4vw, 2rem) clamp(3rem, 7vw, 4.5rem);
  }

  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 3rem;
    }
  }

  /* The name is the largest thing on the first screen at every width, so it is the LCP element. */
  .hero__title {
    margin-bottom: 1.75rem;
    font-size: clamp(4rem, 7.4vw, 6.5rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
  }

  .hero__thesis {
    max-width: 22ch;
    margin-bottom: 1.1rem;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    line-height: 1.3;
    text-wrap: balance;
  }

  .hero__sub {
    max-width: 42ch;
    color: var(--muted);
  }

  @media (max-width: 599px) {
    .hero__sub {
      font-size: 1rem;
    }
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .hero__sig {
    margin-top: 1.75rem;
    max-width: 34rem;
  }

  .hero__cwrap {
    position: relative;
  }

  .hero__rays {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    cursor: grab;
    touch-action: pan-y;
  }

  .hero__rays:active {
    cursor: grabbing;
  }

  .hero__rays:focus-visible {
    outline-offset: -3px;
  }

  .hero__note {
    position: absolute;
    font-size: 1.0625rem;
    pointer-events: none;
  }

  .hero__note--tr {
    right: 14px;
    top: 8px;
    max-width: 14ch;
    text-align: right;
  }

  .hero__note--bl {
    left: 14px;
    bottom: 8px;
    max-width: 18ch;
  }

  @media (max-width: 860px) {
    .hero__note {
      font-size: 0.875rem;
    }
  }
</style>

<script>
  import { mountEigenrays } from '../scripts/eigenrays';
  document.querySelectorAll<HTMLCanvasElement>('[data-eigenrays]').forEach(mountEigenrays);
</script>
