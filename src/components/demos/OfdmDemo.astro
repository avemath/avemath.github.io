---
import DemoShell from './DemoShell.astro';

const stages = [
  { id: 'cfo', label: 'Coarse CFO correction', hint: 'Phase step between preamble symbols' },
  { id: 'lin', label: 'Linear phase fit and polarity', hint: 'Line through the training phase' },
  { id: 'pll', label: 'Costas loop', hint: 'Tracks what is left' },
  { id: 'mmse', label: 'MMSE equalizer', hint: 'Per-subcarrier channel estimate' },
];
---

<DemoShell
  id="ofdm"
  title="Clean up a received packet, one stage at a time"
  lede="Add a carrier frequency offset and noise, then switch on each receiver stage in order and watch the constellations snap into place. Left: the single-carrier sync symbols. Right: the 48 data subcarriers of the OFDM payload after a three-path channel."
  note="A simplified browser model of the MATLAB receiver, not the original code. It uses the same frame numbers (10 MHz, 16 samples per symbol, 64-point FFT, CP 16, 48 data and 4 pilot subcarriers) and the same channel delays (0, 100 and 250 ns at 0, −5 and −9 dB). The FFT window starts three samples into the cyclic prefix, a common choice that the channel estimate absorbs. The raw BER is counted before Viterbi decoding."
>
  <div class="ofdm" data-ofdm>
    <div class="ofdm__controls">
      <div class="slider">
        <div class="slider__top"><label for="ofdm-cfo">Carrier offset</label><output class="mono" for="ofdm-cfo" data-out="cfo">5.0 kHz</output></div>
        <input id="ofdm-cfo" type="range" min="0" max="12" step="0.5" value="5" data-in="cfo" />
      </div>
      <div class="slider">
        <div class="slider__top"><label for="ofdm-snr">SNR</label><output class="mono" for="ofdm-snr" data-out="snr">18 dB</output></div>
        <input id="ofdm-snr" type="range" min="0" max="30" step="1" value="18" data-in="snr" />
      </div>

      <fieldset class="stages">
        <legend class="label">Receiver stages</legend>
        {
          stages.map((s, i) => (
            <label class="stage">
              <input type="checkbox" data-stage={s.id} />
              <span class="stage__n mono">{i + 1}</span>
              <span>
                <span class="stage__label">{s.label}</span>
                <span class="stage__hint">{s.hint}</span>
              </span>
            </label>
          ))
        }
      </fieldset>

      <div class="flex flex-wrap gap-2">
        <button type="button" class="btn btn--small" data-act="all">All stages on</button>
        <button type="button" class="btn btn--small" data-act="none">All off</button>
        <button type="button" class="btn btn--small" data-act="new">New packet</button>
      </div>
    </div>

    <div class="ofdm__plots">
      <figure class="plot">
        <figcaption class="label">Sync symbols · 256 BPSK</figcaption>
        <canvas width="420" height="420" data-plot="sync" role="img" aria-label="Constellation of the training symbols"></canvas>
      </figure>
      <figure class="plot">
        <figcaption class="label">OFDM payload · 4 symbols × 48 subcarriers</figcaption>
        <canvas width="420" height="420" data-plot="ofdm" role="img" aria-label="Constellation of the OFDM data subcarriers"></canvas>
      </figure>
      <figure class="plot plot--wide">
        <figcaption class="label">Channel magnitude per subcarrier · pilots in amber</figcaption>
        <canvas width="860" height="150" data-plot="h" role="img" aria-label="Channel magnitude across 64 subcarriers"></canvas>
      </figure>
      <dl class="stats mono">
        <div><dt>True CFO</dt><dd data-s="cfo">5.00 kHz</dd></div>
        <div><dt>Estimated</dt><dd data-s="est">n/a</dd></div>
        <div><dt>Sync phase error</dt><dd data-s="ph">n/a</dd></div>
        <div><dt>Raw payload BER</dt><dd data-s="ber">n/a</dd></div>
      </dl>
      <p class="sr-only" aria-live="polite" data-ofdm-status></p>
    </div>
  </div>
</DemoShell>

<style>
  .ofdm {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 1000px) {
    .ofdm {
      grid-template-columns: 19rem 1fr;
    }
  }

  .ofdm__controls {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .slider {
    display: grid;
    gap: 0.4rem;
    font-size: 0.92rem;
  }

  .slider__top {
    display: flex;
    justify-content: space-between;
  }

  .slider input {
    width: 100%;
    accent-color: var(--accent);
  }

  .stages {
    display: grid;
    gap: 0.5rem;
    border: 0;
    padding: 0;
    margin: 0;
  }

  .stages legend {
    margin-bottom: 0.5rem;
  }

  .stage {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--bg);
    cursor: pointer;
  }

  .stage:has(input:checked) {
    border-color: var(--accent);
    background: var(--accent-wash);
  }

  .stage input {
    margin-top: 0.3rem;
    accent-color: var(--accent);
  }

  .stage__n {
    font-size: 0.72rem;
    color: var(--muted);
    margin-top: 0.15rem;
  }

  .stage__label {
    display: block;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .stage__hint {
    display: block;
    font-size: 0.78rem;
    color: var(--muted);
  }

  .ofdm__plots {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr 1fr;
  }

  .plot {
    margin: 0;
    padding: 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--bg);
  }

  .plot canvas {
    width: 100%;
    height: auto;
    margin-top: 0.5rem;
  }

  .plot--wide {
    grid-column: 1 / -1;
  }

  .stats {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.6rem;
  }

  .stats > div {
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--bg);
  }

  .stats dt {
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .stats dd {
    margin-top: 0.15rem;
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 640px) {
    .ofdm__plots {
      grid-template-columns: 1fr;
    }

    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<script>
  import { createReceiver, NFFT, NULLS, PILOTS, type C } from '../../lib/ofdm-rx';

  const root = document.querySelector<HTMLElement>('[data-ofdm]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const inCfo = q<HTMLInputElement>('[data-in="cfo"]');
    const inSnr = q<HTMLInputElement>('[data-in="snr"]');
    const outCfo = q<HTMLOutputElement>('[data-out="cfo"]');
    const outSnr = q<HTMLOutputElement>('[data-out="snr"]');
    const stages = [...root.querySelectorAll<HTMLInputElement>('[data-stage]')];
    const syncCanvas = q<HTMLCanvasElement>('[data-plot="sync"]');
    const ofdmCanvas = q<HTMLCanvasElement>('[data-plot="ofdm"]');
    const hCanvas = q<HTMLCanvasElement>('[data-plot="h"]');
    const s = (k: string) => q<HTMLElement>(`[data-s="${k}"]`);
    const status = q<HTMLElement>('[data-ofdm-status]');

    const abs2 = ([a, b]: C) => a * a + b * b;
    const receiver = createReceiver(42);

    function run() {
      const cfoHz = Number(inCfo.value) * 1000;
      const snrDb = Number(inSnr.value);
      outCfo.value = `${(cfoHz / 1000).toFixed(1)} kHz`;
      outSnr.value = `${snrDb} dB`;
      const on = Object.fromEntries(stages.map((x) => [x.dataset.stage!, x.checked])) as { cfo: boolean; lin: boolean; pll: boolean; mmse: boolean };
      const { rx, pts, H, Hhat, est, phaseErr, errors, bits, sync } = receiver.receive(cfoHz, snrDb, on);
      const p = { bits, sync };

      // ---- Draw ----
      drawConstellation(syncCanvas, rx, (n) => p.sync[n] > 0);
      drawConstellation(ofdmCanvas, pts, (i) => p.bits[i] === 1);
      drawChannel(hCanvas, H, on.mmse ? Hhat : null);

      s('cfo').textContent = `${(cfoHz / 1000).toFixed(2)} kHz`;
      s('est').textContent = on.cfo ? `${(est / 1000).toFixed(2)} kHz` : 'n/a';
      s('ph').textContent = `${((phaseErr * 180) / Math.PI).toFixed(1)}°`;
      const ber = errors / p.bits.length;
      s('ber').textContent = `${(ber * 100).toFixed(1)}%  (${errors}/${p.bits.length})`;
      status.textContent = `Raw bit error rate ${(ber * 100).toFixed(1)} percent.`;
    }

    function css(name: string) {
      return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    }

    function drawConstellation(canvas: HTMLCanvasElement, pts: C[], isOne: (i: number) => boolean) {
      const ctx = canvas.getContext('2d')!;
      const w = canvas.width, h = canvas.height;
      const sc = w / 4.4;
      ctx.clearRect(0, 0, w, h);
      ctx.strokeStyle = css('--line');
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(0, h / 2);
      ctx.lineTo(w, h / 2);
      ctx.moveTo(w / 2, 0);
      ctx.lineTo(w / 2, h);
      ctx.stroke();
      ctx.setLineDash([3, 5]);
      ctx.beginPath();
      ctx.arc(w / 2, h / 2, sc, 0, Math.PI * 2);
      ctx.stroke();
      ctx.setLineDash([]);
      const accent = css('--accent');
      const amber = css('--amber');
      pts.forEach((z, i) => {
        ctx.fillStyle = isOne(i) ? accent : amber;
        ctx.globalAlpha = 0.8;
        ctx.beginPath();
        ctx.arc(w / 2 + z[0] * sc, h / 2 - z[1] * sc, 3, 0, Math.PI * 2);
        ctx.fill();
      });
      ctx.globalAlpha = 1;
      ctx.strokeStyle = css('--text');
      [-1, 1].forEach((x) => {
        ctx.beginPath();
        ctx.arc(w / 2 + x * sc, h / 2, 7, 0, Math.PI * 2);
        ctx.stroke();
      });
    }

    function drawChannel(canvas: HTMLCanvasElement, H: C[], Hhat: C[] | null) {
      const ctx = canvas.getContext('2d')!;
      const w = canvas.width, h = canvas.height;
      ctx.clearRect(0, 0, w, h);
      const bw = w / NFFT;
      const max = 2.1;
      const order = Array.from({ length: NFFT }, (_, i) => (i + NFFT / 2) % NFFT); // show DC in the middle
      order.forEach((k, x) => {
        if (NULLS.has(k)) return;
        const mag = Math.sqrt(abs2(H[k]));
        const bh = (mag / max) * (h - 10);
        ctx.fillStyle = PILOTS.includes(k) ? css('--amber') : css('--accent');
        ctx.globalAlpha = 0.75;
        ctx.fillRect(x * bw + 1, h - bh, bw - 2, bh);
        if (Hhat) {
          const mh = (Math.sqrt(abs2(Hhat[k])) / max) * (h - 10);
          ctx.globalAlpha = 1;
          ctx.fillStyle = css('--text');
          ctx.fillRect(x * bw + 1, h - mh - 1, bw - 2, 2);
        }
      });
      ctx.globalAlpha = 1;
    }

    const rerun = () => requestAnimationFrame(run);
    [inCfo, inSnr, ...stages].forEach((el) => el.addEventListener('input', rerun));
    q('[data-act="all"]').addEventListener('click', () => (stages.forEach((x) => (x.checked = true)), run()));
    q('[data-act="none"]').addEventListener('click', () => (stages.forEach((x) => (x.checked = false)), run()));
    q('[data-act="new"]').addEventListener('click', () => {
      receiver.newPacket();
      run();
    });
    window.addEventListener('themechange', run);

    run();
  }
</script>
