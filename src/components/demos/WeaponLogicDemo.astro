---
import DemoShell from './DemoShell.astro';
---

<DemoShell
  id="weapon"
  title="Drive the weapon controller"
  lede="A line-for-line simulation of the Pico W firmware's main loop: the same thresholds, timeouts, firing sequence, shot budget and E-stop rules. Flip the switches on the transmitter and watch the robot respond, including the log lines the real board printed."
  note="Simulated in your browser on a 20 ms loop, like the firmware. Pulse widths are idealized; the real receiver jitters a few microseconds."
>
  <div class="wl" data-weapon>
    <div class="wl__tx card">
      <p class="label">Transmitter · FlySky FS-i6X</p>

      <div class="wl__switches">
        <button type="button" class="sw" role="switch" aria-checked="false" data-sw="kill">
          <span class="sw__body" aria-hidden="true"><span class="sw__lever"></span></span>
          <span class="sw__text">
            <span class="sw__name">SwA · Kill switch</span>
            <span class="sw__ch mono">CH5 · <span data-pwm="kill">1000</span> µs</span>
          </span>
        </button>
        <button type="button" class="sw" role="switch" aria-checked="false" data-sw="trigger">
          <span class="sw__body" aria-hidden="true"><span class="sw__lever"></span></span>
          <span class="sw__text">
            <span class="sw__name">SwD · Weapon trigger</span>
            <span class="sw__ch mono">CH6 · <span data-pwm="trigger">1000</span> µs</span>
          </span>
        </button>
        <button type="button" class="sw" role="switch" aria-checked="true" data-sw="power">
          <span class="sw__body" aria-hidden="true"><span class="sw__lever"></span></span>
          <span class="sw__text">
            <span class="sw__name">Transmitter power</span>
            <span class="sw__ch mono">turn off to drop the link</span>
          </span>
        </button>
      </div>

      <div class="mt-5 flex flex-wrap gap-2">
        <button type="button" class="btn btn--small" data-act="fire">Flick the trigger</button>
        <button type="button" class="btn btn--small" data-act="reboot">Power cycle the robot</button>
      </div>
    </div>

    <div class="wl__bot card">
      <div class="wl__state">
        <span class="wl__led" data-led aria-hidden="true"></span>
        <div>
          <p class="label">Pico W state</p>
          <p class="wl__state-name" data-state aria-live="polite">Starting up</p>
        </div>
      </div>

      <div class="wl__valves">
        <div class="valve" data-valve="main">
          <span class="label">Main / exhaust · GP14</span>
          <span class="valve__val mono" data-valve-val="main">OPEN</span>
        </div>
        <div class="valve" data-valve="piston">
          <span class="label">Piston · GP15</span>
          <span class="valve__val mono" data-valve-val="piston">CLOSED</span>
        </div>
      </div>

      <div class="wl__plow" aria-hidden="true">
        <svg viewBox="0 0 200 60">
          <rect x="10" y="20" width="110" height="26" rx="5" class="plow__body"></rect>
          <g class="plow__blade" data-plow>
            <path d="M 120 46 L 150 46 L 182 14 L 168 10 Z"></path>
          </g>
          <line x1="20" y1="54" x2="190" y2="54" class="plow__floor"></line>
        </svg>
      </div>

      <div>
        <p class="label">Air budget · <span data-shots-text>17 of 17 left</span></p>
        <ol class="shots" data-shots aria-hidden="true"></ol>
      </div>
    </div>

    <div class="wl__log card">
      <p class="label">Serial console</p>
      <div class="log mono" role="log" aria-label="Firmware console output" data-log-box><ol data-log></ol></div>
    </div>
  </div>

  <details class="wl__try">
    <summary>Things to try</summary>
    <ul>
      <li>Flick the trigger 18 times. Shot 17 empties the tank, and the firmware refuses to fire on empty air.</li>
      <li>Turn the transmitter off. After one second with no pulses the board declares signal loss and safes both valves.</li>
      <li>Power cycle with the kill switch on. The startup interlock catches it.</li>
      <li>
        Flip the kill switch on, then the trigger on, then the kill switch off. The plow fires on reset. That's a real bug in the
        firmware: the trigger's last state isn't tracked during an E-stop, so a trigger left on looks like a fresh press. The fix is to
        re-arm only after the trigger has been seen off.
      </li>
    </ul>
  </details>
</DemoShell>

<style>
  .wl {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 960px) {
    .wl {
      grid-template-columns: 1fr 1fr;
    }

    .wl__log {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1200px) {
    .wl {
      grid-template-columns: 1fr 1fr 1.1fr;
    }

    .wl__log {
      grid-column: auto;
    }
  }

  .wl > .card {
    padding: 1.25rem;
    box-shadow: none;
  }

  .wl__switches {
    display: grid;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .sw {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--bg);
    text-align: left;
    cursor: pointer;
  }

  .sw:hover {
    border-color: var(--accent);
  }

  .sw__body {
    position: relative;
    flex: none;
    width: 1.6rem;
    height: 2.6rem;
    border-radius: 0.5rem;
    background: var(--surface-2);
    border: 1px solid var(--line-strong);
  }

  .sw__lever {
    position: absolute;
    left: 50%;
    width: 0.5rem;
    height: 1.25rem;
    margin-left: -0.25rem;
    border-radius: 0.25rem;
    background: var(--muted);
    bottom: 0.2rem;
    transition:
      bottom 0.18s var(--ease-out-expo),
      background-color 0.18s;
  }

  .sw[aria-checked='true'] .sw__lever {
    bottom: 1.05rem;
    background: var(--accent);
  }

  .sw[data-sw='kill'][aria-checked='true'] .sw__lever {
    background: var(--danger);
  }

  .sw__name {
    display: block;
    font-weight: 600;
    font-size: 0.92rem;
  }

  .sw__ch {
    display: block;
    font-size: 0.72rem;
    color: var(--muted);
  }

  .wl__state {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .wl__led {
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: #2a3346;
    border: 1px solid var(--line-strong);
    flex: none;
  }

  .wl__led[data-on] {
    background: #5fe3a6;
    box-shadow:
      0 0 12px #5fe3a6,
      0 0 2px #fff inset;
  }

  .wl__state-name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
  }

  .wl__state-name[data-tone='bad'] {
    color: var(--danger);
  }

  .wl__state-name[data-tone='warn'] {
    color: var(--amber-ink);
  }

  .wl__valves {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }

  .valve {
    display: grid;
    gap: 0.2rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--bg);
  }

  .valve__val {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .valve[data-open] {
    border-color: var(--accent);
  }

  .valve[data-open] .valve__val {
    color: var(--accent-ink);
  }

  :global([data-theme='dark']) .valve[data-open] .valve__val {
    color: var(--accent);
  }

  .wl__plow {
    margin-block: 1rem;
  }

  .wl__plow svg {
    width: 100%;
    max-width: 18rem;
  }

  .plow__body {
    fill: var(--surface-2);
    stroke: var(--line-strong);
  }

  .plow__blade path {
    fill: var(--amber);
  }

  .plow__blade {
    transform-origin: 150px 46px;
    transition: rotate 0.12s ease-out;
  }

  .plow__blade[data-up] {
    rotate: -28deg;
  }

  .plow__floor {
    stroke: var(--line-strong);
  }

  .shots {
    display: grid;
    grid-template-columns: repeat(17, 1fr);
    gap: 0.25rem;
    margin-top: 0.5rem;
  }

  .shots :global(li) {
    height: 0.7rem;
    border-radius: 0.2rem;
    background: var(--accent);
  }

  .shots :global(li[data-spent]) {
    background: var(--line);
  }

  .log {
    height: 16rem;
    margin-top: 0.75rem;
    padding: 0.75rem;
    border-radius: 0.6rem;
    background: #05070c;
    color: #9fb3d1;
    font-size: 0.72rem;
    line-height: 1.6;
    overflow-y: auto;
  }

  .log :global(li[data-kind='warn']) {
    color: #ffc670;
  }

  .log :global(li[data-kind='bad']) {
    color: #ff8a7a;
  }

  .log :global(li[data-kind='ok']) {
    color: #5fe3a6;
  }

  .log :global(time) {
    color: #4f5e79;
    margin-right: 0.5rem;
  }

  .wl__try {
    margin-top: 1.25rem;
    padding: 0.9rem 1.1rem;
    border: 1px dashed var(--line-strong);
    border-radius: 0.75rem;
    font-size: 0.92rem;
    color: var(--text-soft);
  }

  .wl__try summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--text);
  }

  .wl__try ul {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.75rem;
    padding-left: 1.1rem;
    list-style: disc;
  }
</style>

<script>
  // ---- Constants from pico_direct.py ----
  const SWITCH_ON_THRESHOLD = 1700;
  const SIGNAL_TIMEOUT = 1000;
  const STARTUP_DELAY = 3000;
  const KILL_SWITCH_DEBOUNCE = 300;
  const MAX_WEAPON_ACTIVATIONS = 17;
  const WEAPON_COOLDOWN = 500;
  const SOLENOID_ACTIVATION_TIME = 400;
  const SOLENOID_SEQUENCE_DELAY = 50;
  const LOOP_MS = 20;

  const root = document.querySelector<HTMLElement>('[data-weapon]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const sw = { kill: $('[data-sw="kill"]'), trigger: $('[data-sw="trigger"]'), power: $('[data-sw="power"]') };
    const ledEl = $('[data-led]');
    const stateEl = $('[data-state]');
    const logEl = $('[data-log]');
    const logBox = $('[data-log-box]');
    const shotsEl = $('[data-shots]');
    const shotsText = $('[data-shots-text]');
    const plow = root.querySelector<SVGGElement>('[data-plow]')!;
    const valve = { main: $('[data-valve="main"]'), piston: $('[data-valve="piston"]') };
    const valveVal = { main: $('[data-valve-val="main"]'), piston: $('[data-valve-val="piston"]') };
    const pwmEl = { kill: $('[data-pwm="kill"]'), trigger: $('[data-pwm="trigger"]') };

    for (let i = 0; i < MAX_WEAPON_ACTIVATIONS; i++) shotsEl.append(document.createElement('li'));

    // Transmitter inputs.
    const tx = { kill: false, trigger: false, power: true };

    // Firmware globals.
    let t = 0; // virtual ms since boot
    let ch5 = 0, ch6 = 0, ch5Last = -1e9, ch6Last = -1e9;
    let startupTime = 0;
    let estop = false;
    let cause: 'none' | 'kill_switch' | 'signal_loss' | 'startup' = 'none';
    let killLastChange = 0;
    let signalLossTime = 0;
    let activations = 0;
    let cooldownEnd = 0;
    let depleted = false;
    let plowActive = false;
    let triggerLast = false;
    let mainOpen = true;
    let pistonOpen = false;
    let led = false;
    let phase: 'boot' | 'startup' | 'run' = 'boot';
    let busyUntil = 0; // the firmware blocks in sleep_ms while firing or blinking
    let queue: { at: number; fn: () => void }[] = [];
    let running = false;
    let raf = 0;
    let lastReal = 0;

    const fmt = (ms: number) => (ms / 1000).toFixed(2).padStart(6, ' ');
    function log(text: string, kind: 'info' | 'warn' | 'bad' | 'ok' = 'info') {
      const li = document.createElement('li');
      li.dataset.kind = kind;
      const time = document.createElement('time');
      time.textContent = fmt(t);
      li.append(time, text);
      logEl.append(li);
      while (logEl.children.length > 80) logEl.firstElementChild?.remove();
      logBox.scrollTop = logBox.scrollHeight;
    }

    // The receiver sends a pulse every ~20 ms while the transmitter is on.
    function receive() {
      if (!tx.power) return;
      ch5 = tx.kill ? 2000 : 1000;
      ch6 = tx.trigger ? 2000 : 1000;
      ch5Last = ch6Last = t;
    }

    function readSwitch(width: number, last: number): [boolean, boolean] {
      if (t - last > SIGNAL_TIMEOUT) {
        if (t - startupTime < STARTUP_DELAY) return [false, false];
        return [false, true];
      }
      return [width > SWITCH_ON_THRESHOLD, false];
    }

    function schedule(after: number, fn: () => void) {
      queue.push({ at: t + after, fn });
    }

    function activateWeapon() {
      if (estop || t < cooldownEnd || depleted) return;
      activations++;
      log(`Activating weapon (${activations}/${MAX_WEAPON_ACTIVATIONS})`, 'warn');
      cooldownEnd = t + WEAPON_COOLDOWN;
      if (activations >= MAX_WEAPON_ACTIVATIONS) {
        depleted = true;
        log('WARNING: Weapon system depleted', 'bad');
      }
      plowActive = true;
      led = true;
      // Same blocking sequence as the firmware, replayed on the virtual clock.
      mainOpen = true;
      schedule(SOLENOID_SEQUENCE_DELAY, () => (mainOpen = false));
      schedule(SOLENOID_SEQUENCE_DELAY * 2, () => (pistonOpen = true));
      schedule(SOLENOID_SEQUENCE_DELAY * 2 + SOLENOID_ACTIVATION_TIME, () => {
        pistonOpen = false;
        mainOpen = true;
        plowActive = false;
        led = false;
      });
      busyUntil = t + SOLENOID_SEQUENCE_DELAY * 2 + SOLENOID_ACTIVATION_TIME;
    }

    function triggerEstop(c: typeof cause) {
      if (estop) return;
      log(`EMERGENCY STOP ACTIVATED: ${c}`, 'bad');
      estop = true;
      cause = c;
      killLastChange = t;
      mainOpen = true;
      pistonOpen = false;
      busyUntil = t + 1000; // ten 100 ms blinks
    }

    function canReset() {
      const [killOn, killLost] = readSwitch(ch5, ch5Last);
      if (cause === 'signal_loss') {
        const [, trigLost] = readSwitch(ch6, ch6Last);
        return !(killLost || trigLost) && t - signalLossTime > 1000;
      }
      return !killOn && !killLost && t - killLastChange > KILL_SWITCH_DEBOUNCE;
    }

    function reboot() {
      t = 0;
      ch5 = ch6 = 0;
      ch5Last = ch6Last = -1e9;
      estop = false;
      cause = 'none';
      activations = 0;
      cooldownEnd = 0;
      depleted = false;
      plowActive = false;
      triggerLast = false;
      mainOpen = true;
      pistonOpen = false;
      queue = [];
      phase = 'boot';
      startupTime = 0;
      killLastChange = 0;
      signalLossTime = 0;
      logEl.replaceChildren();
      log('===== RAMpage Combat Robot - Main Pico Code =====');
      log('Solenoids initialized on pins 14 and 15');
      log('RC receiver interrupts configured for kill switch (GP18) and weapon trigger (GP19)');
      log('===== STARTING WEAPON CONTROL SYSTEM =====');
      log('Waiting for RC signals to stabilize...');
      busyUntil = 1200; // three 400 ms blinks
    }

    function tick() {
      receive();
      // Run anything the blocking sequence scheduled.
      queue = queue.filter((q) => (q.at <= t ? (q.fn(), false) : true));
      if (t < busyUntil) {
        if (phase === 'boot') led = Math.floor(t / 200) % 2 === 0;
        else if (estop && cause !== 'none' && !plowActive) led = Math.floor(t / 50) % 2 === 0;
        return;
      }

      if (phase === 'boot') {
        phase = 'startup';
        startupTime = t;
        killLastChange = t;
        signalLossTime = t;
      }

      if (phase === 'startup') {
        led = t % 500 < 250;
        const [killOn] = readSwitch(ch5, ch5Last);
        if (killOn) {
          log('Kill switch is ON during startup - must turn OFF to operate', 'bad');
          triggerEstop('startup');
          finishStartup();
          return;
        }
        if (t - startupTime >= STARTUP_DELAY) finishStartup();
        return;
      }

      const [killOn, killLost] = readSwitch(ch5, ch5Last);
      const [trigOn, trigLost] = readSwitch(ch6, ch6Last);

      if (killOn && !estop) {
        log('Kill switch activated', 'bad');
        triggerEstop('kill_switch');
        return;
      }
      if ((killLost || trigLost) && !estop) {
        log('Signal lost - emergency stop', 'bad');
        signalLossTime = t;
        triggerEstop('signal_loss');
        return;
      }
      if (estop && canReset()) {
        log(`Emergency stop reset (${cause === 'signal_loss' ? 'signal restored' : cause === 'kill_switch' ? 'kill switch now OFF' : 'generic'})`, 'ok');
        estop = false;
        cause = 'none';
        busyUntil = t + 800; // two 400 ms blinks
        log('Emergency stop reset - system ready', 'ok');
        return;
      }
      if (estop) {
        led = t % 500 < 250;
        return;
      }

      if (trigOn && !triggerLast && !plowActive && !depleted) activateWeapon();
      triggerLast = trigOn;

      if (!plowActive) {
        const m = t % 1000;
        if (depleted) led = m < 100 || (m > 200 && m < 300);
        else led = t % 2000 < 500;
      }
    }

    function finishStartup() {
      phase = 'run';
      log('System initialized');
      log(`Maximum weapon activations: ${MAX_WEAPON_ACTIVATIONS}`);
      log('To RESET emergency stop: Simply turn the kill switch OFF');
    }

    function stateLabel(): [string, string] {
      if (phase !== 'run') return ['Starting up', ''];
      if (estop) {
        const why = { kill_switch: 'kill switch', signal_loss: 'signal lost', startup: 'startup interlock', none: '' }[cause];
        return [`E-stop: ${why}`, 'bad'];
      }
      if (plowActive) return ['Firing', 'warn'];
      if (depleted) return ['Out of air', 'bad'];
      if (t < cooldownEnd) return ['Cooling down', 'warn'];
      if (t < busyUntil) return ['Resetting', 'warn'];
      return ['Armed', ''];
    }

    function paint() {
      ledEl.toggleAttribute('data-on', led);
      const [name, tone] = stateLabel();
      if (stateEl.textContent !== name) stateEl.textContent = name;
      stateEl.dataset.tone = tone;
      valve.main.toggleAttribute('data-open', mainOpen);
      valve.piston.toggleAttribute('data-open', pistonOpen);
      valveVal.main.textContent = mainOpen ? 'OPEN' : 'CLOSED';
      valveVal.piston.textContent = pistonOpen ? 'OPEN' : 'CLOSED';
      plow.toggleAttribute('data-up', pistonOpen);
      pwmEl.kill.textContent = tx.power ? String(tx.kill ? 2000 : 1000) : '---';
      pwmEl.trigger.textContent = tx.power ? String(tx.trigger ? 2000 : 1000) : '---';
      [...shotsEl.children].forEach((li, i) => li.toggleAttribute('data-spent', i < activations));
      shotsText.textContent = `${MAX_WEAPON_ACTIVATIONS - activations} of ${MAX_WEAPON_ACTIVATIONS} left`;
    }

    function frame(now: number) {
      let dt = Math.min(250, now - lastReal);
      lastReal = now;
      while (dt >= LOOP_MS) {
        t += LOOP_MS;
        tick();
        dt -= LOOP_MS;
      }
      lastReal -= dt;
      paint();
      raf = requestAnimationFrame(frame);
    }

    function start() {
      if (running) return;
      running = true;
      lastReal = performance.now();
      raf = requestAnimationFrame(frame);
    }

    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    function flip(name: keyof typeof tx, value = !tx[name]) {
      tx[name] = value;
      sw[name].setAttribute('aria-checked', String(value));
    }

    (Object.keys(sw) as (keyof typeof tx)[]).forEach((k) => sw[k].addEventListener('click', () => flip(k)));

    root.querySelector('[data-act="fire"]')!.addEventListener('click', () => {
      flip('trigger', true);
      setTimeout(() => flip('trigger', false), 160);
    });
    root.querySelector('[data-act="reboot"]')!.addEventListener('click', reboot);

    // This is a user-driven simulation, so it runs whenever it's on screen.
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop())).observe(root);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    reboot();
    paint();
  }
</script>
