{
  "name": "avemath.github.io",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint:copy": "node scripts/lint-copy.mjs",
    "test:comms": "node scripts/check-comms.mjs",
    "test:seafloor": "node scripts/check-seafloor.mjs",
    "test:physics": "node scripts/check-physics.mjs",
    "verify": "npm run lint:copy && npm run test:comms && npm run test:physics && npm run test:seafloor && npm run check && npm run build",
    "test:a11y": "node scripts/check-a11y.mjs && node scripts/check-labels.mjs",
    "assets": "node scripts/render-assets.mjs",
    "test:layout": "node scripts/check-layout.mjs && node scripts/check-interactions.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "tailwindcss": "^4.3.3",
    "three": "^0.187.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "axe-core": "^4.13.0",
    "playwright": "^1.63.0"
  }
